				<div class="pb-section-subtitle">Stroke</div>
				<color-control label="Color" :setting-key="pathState==='normal'?'pathStrokeColor':'pathStrokeColorHover'" :node="node" />
				<size-control label="Width" :base="pathState==='normal'?'pathStrokeWidth':'pathStrokeWidthHover'" :control-id="'text-path-path-width-'+pathState" fallback="1px" :node="node" :editor="editor" :min="0" :max="20" :allowed-units="['px']" />
