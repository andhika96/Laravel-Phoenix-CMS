				<div class="pb-form-group pb-toggle-label-row"><label class="pb-form-label mb-0">Show Path</label><div class="pb-toggle-switch-wrap"><div class="pb-toggle-wrap"><input :id="'text-path-show-'+node.id" type="checkbox" class="pb-toggle" v-model="node.settings.showPath"><label :for="'text-path-show-'+node.id"></label></div><span class="pb-toggle-state">{{node.settings.showPath?'On':'Off'}}</span></div></div>
			</div></details>
		</div>

		<div v-show="editor.settingsTab==='style'" class="pb-tab-content">
			<details class="pb-collapsible" open><summary>Text Path</summary><div class="pb-collapsible-body">
				<size-control label="Size" base="size" control-id="text-path-size" fallback="500px" :node="node" :editor="editor" :min="50" :max="1200" :allowed-units="['px']" />
				<size-control label="Rotate" base="rotate" control-id="text-path-rotate" fallback="0deg" :node="node" :editor="editor" :min="0" :max="360" :allowed-units="['deg']" />
				<div class="pb-section-subtitle">Text</div>
				<component :is="editor.typographyControl" aria-label="Typography" :settings="node.settings" prefix="text" :responsive-device="editor.responsiveDevice" control-id="text-path-typography" @responsive-device="editor.setResponsiveDevice" />
				<component :is="editor.textStrokeControl" aria-label="Text Stroke" :settings="node.settings" :responsive-device="editor.responsiveDevice" width-key="textStrokeWidth" color-key="textStrokeColor" control-id="text-path-stroke" :open="activeEffect==='text-path-stroke'" @request-open="activeEffect=$event" @responsive-device="editor.setResponsiveDevice" />
