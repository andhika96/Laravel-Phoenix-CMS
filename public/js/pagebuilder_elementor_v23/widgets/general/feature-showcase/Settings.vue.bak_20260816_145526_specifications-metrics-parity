<template>
	<div class="pb-widget-settings pb-widget-settings--general-new pb-widget-settings--feature-showcase">
		<div class="pb-tab-nav"><button type="button" class="pb-tab-btn pb-tab-btn-icon" :class="{active:editor.settingsTab==='content'}" @click="editor.settingsTab='content'"><i class="fas fa-edit"></i><span>Content</span></button><button type="button" class="pb-tab-btn pb-tab-btn-icon" :class="{active:editor.settingsTab==='style'}" @click="editor.settingsTab='style'"><i class="fas fa-adjust"></i><span>Style</span></button><button type="button" class="pb-tab-btn pb-tab-btn-icon" :class="{active:editor.settingsTab==='advanced'}" @click="editor.settingsTab='advanced'"><i class="fas fa-gear"></i><span>Advanced</span></button></div>

		<div v-if="editor.settingsTab==='content'" class="pb-tab-content">
			<details class="pb-collapsible" open><summary>Feature Showcase</summary><div class="pb-collapsible-body">
				<div class="pb-form-group"><label class="pb-form-label">Template</label><select class="pb-select" v-model="node.settings.template"><option v-for="option in templateOptions" :key="option.value" :value="option.value">{{ option.label }}</option></select><div class="pb-form-note">{{ templateDescription }}</div></div>
				<div class="pb-form-group"><label class="pb-form-label">Title</label><input class="pb-input" v-model="node.settings.title" placeholder="Section title"></div>
				<div class="pb-form-group"><label class="pb-form-label">Subtitle</label><input class="pb-input" v-model="node.settings.subtitle" placeholder="Optional subtitle"></div>
				<div class="pb-form-group"><label class="pb-form-label">Description</label><textarea class="pb-input" rows="5" v-model="node.settings.description" placeholder="Optional description"></textarea></div>
			</div></details>

			<details v-if="showMetrics" class="pb-collapsible" open><summary>Metrics</summary><div class="pb-collapsible-body">
				<div v-for="(metric,index) in metrics" :key="'showcase-metric-'+index" class="pb-feature-metric-card"><div class="pb-feature-metric-card__title">Metric #{{ index + 1 }}</div><div class="pb-form-row pb-form-row--three"><div class="pb-form-group"><label class="pb-form-label">Label</label><input class="pb-input" v-model="metric.label" placeholder="Wheelbase"></div><div class="pb-form-group"><label class="pb-form-label">Value</label><input class="pb-input" v-model="metric.value" placeholder="2680"></div><div class="pb-form-group"><label class="pb-form-label">Unit</label><input class="pb-input" v-model="metric.unit" placeholder="MM"></div></div></div>
			</div></details>

			<details class="pb-collapsible" open><summary>Media</summary><div class="pb-collapsible-body">
				<media-slot v-for="slot in visibleMediaSlots" :key="'showcase-media-'+slot" :slot="slot" :media="mediaAt(slot - 1)" :editor="editor" />
				<div class="pb-form-note">Media slot count follows the selected template. Images stay as fixed slots so responsive positioning does not change the content structure.</div>
			</div></details>
		</div>

		<div v-if="editor.settingsTab==='style'" class="pb-tab-content">
			<details class="pb-collapsible" open><summary>Layout</summary><div class="pb-collapsible-body">
				<responsive-choice label="Text Position" base="textPosition" control-id="feature-showcase-text-position" :node="node" :editor="editor" :options="positionOptions" />
				<responsive-choice label="Image Position" base="imagePosition" control-id="feature-showcase-image-position" :node="node" :editor="editor" :options="positionOptions" />
				<responsive-choice label="Text Alignment" base="textAlign" control-id="feature-showcase-text-align" :node="node" :editor="editor" :options="alignmentOptions" />
				<responsive-choice label="Vertical Alignment" base="verticalAlign" control-id="feature-showcase-vertical-align" :node="node" :editor="editor" :options="verticalOptions" />
				<responsive-choice v-if="showSplitWidths" label="Mobile Order" base="mobileOrder" control-id="feature-showcase-mobile-order" :node="node" :editor="editor" :options="mobileOrderOptions" />
				<size-control v-if="showSplitWidths" label="Content Width" base="contentWidth" control-id="feature-showcase-content-width" fallback="42%" :node="node" :editor="editor" :min="0" :max="100" />
				<size-control v-if="showSplitWidths" label="Image Width" base="imageWidth" control-id="feature-showcase-image-width" fallback="58%" :node="node" :editor="editor" :min="0" :max="100" />
				<responsive-select v-if="showContentPosition" label="Content Position" base="textPosition" control-id="feature-showcase-content-position" :node="node" :editor="editor" fallback="top" :options="contentPositionOptions" />
				<responsive-select v-if="node.settings.template==='exterior_gallery'" label="Featured Image Position" base="featuredImagePosition" control-id="feature-showcase-featured-image" :node="node" :editor="editor" fallback="1" :options="imageSlotOptions" />
				<responsive-choice v-if="node.settings.template==='performance_collage'" label="Tall Image Position" base="tallImagePosition" control-id="feature-showcase-tall-image" :node="node" :editor="editor" :options="sideOptions" />
				<div v-if="showMediaOrder" class="pb-form-group"><div class="pb-label-row pb-label-row-device"><label class="pb-form-label mb-0">Media Order</label><responsive-menu :editor="editor" id="feature-showcase-media-order" /></div><div class="pb-form-row pb-form-row--three pb-feature-order-row"><label v-for="(slot,index) in [0,1,2]" :key="'feature-order-'+index" class="pb-feature-order-field"><span>Position {{ index + 1 }}</span><select class="pb-select" :value="node.settings.mediaOrder?.[index] || String(index + 1)" @change="setMediaOrder(index,$event.target.value)"><option v-for="option in imageSlotOptions" :key="'feature-order-option-'+index+'-'+option.value" :value="option.value">{{ option.label }}</option></select></label></div></div>
			</div></details>

			<details class="pb-collapsible" open><summary>Section</summary><div class="pb-collapsible-body">
				<size-control label="Container Width" base="containerWidth" control-id="feature-showcase-container-width" fallback="1140px" :node="node" :editor="editor" :min="320" :max="1600" />
				<size-control label="Gap" base="gap" control-id="feature-showcase-gap" fallback="24px" :node="node" :editor="editor" :min="0" :max="120" />
				<size-control label="Image Radius" base="imageRadius" control-id="feature-showcase-image-radius" fallback="45px" :node="node" :editor="editor" :min="0" :max="120" />
				<color-field label="Background Color" setting-key="backgroundColor" :node="node" />
				<template v-if="node.settings.template==='performance_collage'"><color-field label="Performance Background" setting-key="performanceBackgroundColor" :node="node" /><div class="pb-form-row pb-form-row--two"><color-field label="Heading Gradient Start" setting-key="headingGradientStart" :node="node" /><color-field label="Heading Gradient End" setting-key="headingGradientEnd" :node="node" /></div></template>
			</div></details>

			<details class="pb-collapsible"><summary>Typography</summary><div class="pb-collapsible-body">
				<color-field label="Title Color" setting-key="titleColor" :node="node" />
				<component :is="editor.typographyControl" prefix="title" :settings="node.settings" :responsive-device="editor.responsiveDevice" :font-families="editor.fontFamilies" :reset-defaults="{FontSize:'48px',FontWeight:'700',LineHeight:'1.2em'}" @responsive-device="editor.setResponsiveDevice" />
				<color-field label="Subtitle Color" setting-key="subtitleColor" :node="node" />
				<component :is="editor.typographyControl" prefix="subtitle" :settings="node.settings" :responsive-device="editor.responsiveDevice" :font-families="editor.fontFamilies" :reset-defaults="{FontSize:'20px',FontWeight:'400',LineHeight:'1.5em'}" @responsive-device="editor.setResponsiveDevice" />
				<color-field label="Description Color" setting-key="descriptionColor" :node="node" />
				<component :is="editor.typographyControl" prefix="description" :settings="node.settings" :responsive-device="editor.responsiveDevice" :font-families="editor.fontFamilies" :reset-defaults="{FontSize:'16px',FontWeight:'400',LineHeight:'1.5em'}" @responsive-device="editor.setResponsiveDevice" />
				<component :is="editor.textShadowControl" aria-label="Text Shadow" :model-value="node.settings.titleTextShadow" control-id="feature-showcase-title-shadow" :open="activeEffect==='title-shadow'" @request-open="activeEffect=$event" @update:modelValue="node.settings.titleTextShadow=$event" />
			</div></details>
		</div>

		<div v-if="editor.settingsTab==='advanced'" class="pb-tab-content"><component :is="editor.widgetAdvancedControls" :node="node" :responsive-device="editor.responsiveDevice" :show-display-conditions="false" :show-cache-settings="false" :elementor-choices="true" @responsive-device="editor.setResponsiveDevice" @choose-media="editor.chooseMedia(node.settings,$event)" @clear-media="editor.clearMedia(node.settings,$event)" @unavailable-ai="editor.showUnsupportedControlNotice('Animate With AI', 'AI service is not connected to this page builder.')" /></div>
	</div>
</template>

<script>
const ResponsiveMenu = { props: ['editor', 'id'], template: `<div class="pb-control-device-wrap"><button type="button" class="pb-control-device-btn" @click.stop="editor.openControlResponsiveMenu(id)" :title="'Responsive: '+editor.responsiveDeviceLabel()"><i :class="editor.responsiveDeviceIcon()"></i></button><div v-if="editor.isControlResponsiveMenuOpen(id)" class="pb-control-device-menu"><button v-for="device in editor.responsiveDevices" :key="id+'-'+device.value" type="button" class="pb-control-device-item" :class="{active:editor.responsiveDevice===device.value}" @click.stop="editor.applyResponsiveDevice(id,device.value)"><i :class="device.icon"></i><span>{{editor.deviceOptionLabel(device)}}</span></button></div></div>` };
const ResponsiveChoice = { components: { ResponsiveMenu }, props: ['label', 'base', 'controlId', 'node', 'editor', 'options'], template: `<div class="pb-form-group"><div class="pb-label-row pb-label-row-device"><label class="pb-form-label mb-0">{{label}}</label><responsive-menu :editor="editor" :id="controlId"/></div><div class="pb-btn-group pb-compact-choice"><button v-for="option in options" :key="base+'-'+option.value" type="button" class="pb-seg-btn" :class="{active:node.settings[editor.activeResponsiveKey(base)]===option.value}" :title="option.label" :aria-label="option.label" @click.prevent="editor.setResponsiveSetting(node.settings,base,option.value)"><i :class="option.icon"></i><span v-if="option.text">{{option.text}}</span></button></div></div>` };
const ResponsiveSelect = { components: { ResponsiveMenu }, props: ['label', 'base', 'controlId', 'fallback', 'node', 'editor', 'options'], template: `<div class="pb-form-group"><div class="pb-label-row pb-label-row-device"><label class="pb-form-label mb-0">{{label}}</label><responsive-menu :editor="editor" :id="controlId"/></div><select class="pb-select" :value="node.settings[editor.activeResponsiveKey(base)] || fallback" @change="editor.setResponsiveSetting(node.settings,base,$event.target.value)"><option v-for="option in options" :key="base+'-'+option.value" :value="option.value">{{option.label}}</option></select></div>` };
const SizeControl = { components: { ResponsiveMenu }, props: { label: String, base: String, controlId: String, fallback: String, node: Object, editor: Object, min: { type: Number, default: 0 }, max: { type: Number, default: 120 } }, template: `<div class="pb-form-group"><div class="pb-label-row pb-label-row-device"><label class="pb-form-label mb-0">{{label}}</label><responsive-menu :editor="editor" :id="controlId"/></div><div class="pb-range-value-row"><input class="pb-range" type="range" :min="min" :max="max" :step="editor.sizeControlStep(node,base,fallback)" :value="editor.sizeControlDisplayValue(node,base,fallback)" @input="editor.onSizeControlInput(node,base,$event,{fallback,min,max})"><div class="pb-value-with-unit"><input class="pb-input pb-input-compact" type="number" :min="min" :max="max" :value="editor.sizeControlDisplayValue(node,base,fallback)" @input="editor.onSizeControlInput(node,base,$event,{fallback,min,max})"><select class="pb-mini-unit" :value="editor.sizeControlUnit(node,base,fallback)" @change="editor.setSizeControlUnit(node,base,$event.target.value,{fallback})"><option v-for="unit in editor.sizeControlUnits" :key="base+'-'+unit" :value="unit">{{unit}}</option></select></div></div></div>` };
const ColorField = { props: ['label', 'settingKey', 'node'], template: `<div class="pb-form-group"><label class="pb-form-label">{{label}}</label><input class="pb-input coloris pb-coloris-input" v-model="node.settings[settingKey]"></div>` };
const MediaSlot = { props: ['slot', 'media', 'editor'], computed: { safeUrl() { const url = String(this.media?.url || '').trim(); return /^(?:https?:\/\/|\/)/i.test(url) && !url.startsWith('//') && !/^(?:javascript|vbscript|data):/i.test(url) ? url : ''; }, previewStyle() { return this.safeUrl ? { backgroundImage: `url("${this.safeUrl.replace(/"/g, '%22')}")` } : {}; } }, template: `<div class="pb-feature-media-slot"><div class="pb-form-group"><label class="pb-form-label">Image Slot {{slot}}</label><div class="pb-bg-media-field pb-widget-settings__media-field" :class="{'has-image':!!safeUrl}"><div class="pb-bg-media-preview" :style="previewStyle"><button type="button" class="pb-bg-media-center-btn" :title="safeUrl?'Change Image':'Choose Image'" @click="editor.chooseMedia(media,'url')"><i :class="safeUrl?'fas fa-pen':'fas fa-plus'"></i></button></div><div class="pb-bg-media-actions"><button type="button" class="pb-bg-media-choose" @click="editor.chooseMedia(media,'url')">Choose Image</button><button type="button" class="pb-bg-media-remove" :disabled="!safeUrl" title="Remove Image" @click="editor.clearMedia(media,'url')"><i class="fas fa-trash-alt"></i></button></div></div></div><div class="pb-form-group"><label class="pb-form-label">Alt Text</label><input class="pb-input" v-model="media.alt" placeholder="Describe the image"></div></div>` };

export default {
	name: 'GeneralFeatureShowcaseSettings',
	props: { node: { type: Object, required: true }, editor: { type: Object, required: true } },
	components: { ResponsiveMenu, ResponsiveChoice, ResponsiveSelect, SizeControl, ColorField, MediaSlot },
	data() { return { activeEffect: '' }; },
	computed: {
		templateOptions() { return [{ value: 'specifications_metrics', label: 'Specifications — Metrics' }, { value: 'specifications_hero', label: 'Specifications — Hero' }, { value: 'performance_collage', label: 'Performance Collage' }, { value: 'exterior_gallery', label: 'Exterior Gallery' }, { value: 'feature_image', label: 'Feature Image' }]; },
		metrics() { if (!Array.isArray(this.node.settings.metrics)) this.node.settings.metrics = []; while (this.node.settings.metrics.length < 3) this.node.settings.metrics.push({ label: '', value: '', unit: '' }); return this.node.settings.metrics.slice(0, 3); },
		showMetrics() { return ['specifications_metrics', 'specifications_hero'].includes(this.node.settings.template); },
		showSplitWidths() { return ['specifications_metrics', 'specifications_hero'].includes(this.node.settings.template); },
		showContentPosition() { return ['performance_collage', 'exterior_gallery', 'feature_image'].includes(this.node.settings.template); },
		showMediaOrder() { return ['performance_collage', 'exterior_gallery'].includes(this.node.settings.template); },
		visibleMediaSlots() { if (['performance_collage', 'exterior_gallery'].includes(this.node.settings.template)) return [1, 2, 3]; return [1]; },
		templateDescription() { const option = this.templateOptions.find((item) => item.value === this.node.settings.template); return option ? ({ specifications_metrics: 'Metrics on one side and a large image on the opposite side.', specifications_hero: 'Heading and subtitle above a responsive metrics and image split.', performance_collage: 'Dark performance section with one tall image and two supporting images.', exterior_gallery: 'Large featured image with two supporting images below.', feature_image: 'Text content paired with one full-width feature image.' }[option.value]) : ''; },
		positionOptions() { return [{ value: 'left', label: 'Left', icon: 'fas fa-arrow-left' }, { value: 'right', label: 'Right', icon: 'fas fa-arrow-right' }, { value: 'top', label: 'Top', icon: 'fas fa-arrow-up' }, { value: 'bottom', label: 'Bottom', icon: 'fas fa-arrow-down' }]; },
		alignmentOptions() { return [{ value: 'left', label: 'Left', icon: 'fas fa-align-left' }, { value: 'center', label: 'Center', icon: 'fas fa-align-center' }, { value: 'right', label: 'Right', icon: 'fas fa-align-right' }]; },
		verticalOptions() { return [{ value: 'start', label: 'Start', icon: 'fas fa-arrow-up' }, { value: 'center', label: 'Center', icon: 'fas fa-arrows-alt-v' }, { value: 'end', label: 'End', icon: 'fas fa-arrow-down' }]; },
		mobileOrderOptions() { return [{ value: 'text-first', label: 'Text First', icon: 'fas fa-font', text: 'Text' }, { value: 'image-first', label: 'Image First', icon: 'far fa-image', text: 'Image' }]; },
		contentPositionOptions() { return [{ value: 'top', label: 'Top' }, { value: 'bottom', label: 'Bottom' }]; },
		sideOptions() { return [{ value: 'left', label: 'Left', icon: 'fas fa-arrow-left' }, { value: 'right', label: 'Right', icon: 'fas fa-arrow-right' }]; },
		imageSlotOptions() { return [{ value: '1', label: 'Image Slot 1' }, { value: '2', label: 'Image Slot 2' }, { value: '3', label: 'Image Slot 3' }]; },
	},
	methods: {
		mediaAt(index) { if (!Array.isArray(this.node.settings.images)) this.node.settings.images = []; while (this.node.settings.images.length < 3) this.node.settings.images.push({ url: '', alt: '' }); return this.node.settings.images[index]; },
		setMediaOrder(index, value) { const order = Array.isArray(this.node.settings.mediaOrder) ? [...this.node.settings.mediaOrder] : ['1', '2', '3']; const target = order.indexOf(String(value)); if (target < 0 || target === index) return; [order[index], order[target]] = [order[target], order[index]]; this.node.settings.mediaOrder = order; },
	},
};
</script>

<style scoped>
.pb-widget-settings--feature-showcase .pb-form-row{display:grid;gap:12px}.pb-widget-settings--feature-showcase .pb-form-row--two{grid-template-columns:repeat(2,minmax(0,1fr))}.pb-widget-settings--feature-showcase .pb-form-row--three{grid-template-columns:repeat(3,minmax(0,1fr))}.pb-widget-settings--feature-showcase .pb-compact-choice{display:grid;grid-template-columns:repeat(4,minmax(34px,1fr));gap:7px}.pb-widget-settings--feature-showcase .pb-compact-choice .pb-seg-btn{min-width:0;height:32px;padding:0 8px}.pb-widget-settings--feature-showcase .pb-form-group{margin-bottom:14px}.pb-widget-settings--feature-showcase .pb-form-row .pb-form-group{margin-bottom:0}.pb-widget-settings--feature-showcase .pb-collapsible-body{padding-top:13px}.pb-widget-settings--feature-showcase .pb-form-label{line-height:1.25}.pb-widget-settings--feature-showcase .pb-input,.pb-widget-settings--feature-showcase .pb-select{min-height:36px}.pb-feature-metric-card{padding:12px;border:1px solid var(--line,#e4e7ec);border-radius:8px;background:var(--soft,#f7f8fc);margin-bottom:12px}.pb-feature-metric-card__title{font-size:12px;font-weight:700;color:var(--muted,#667085);margin-bottom:10px}.pb-feature-media-slot{padding-bottom:6px}.pb-feature-order-field{display:grid;gap:6px;min-width:0}.pb-feature-order-field span{font-size:12px;color:var(--muted,#667085)}.pb-feature-showcase-settings-note{font-size:12px;color:var(--muted,#667085)}@media(max-width:420px){.pb-widget-settings--feature-showcase .pb-form-row--two,.pb-widget-settings--feature-showcase .pb-form-row--three{grid-template-columns:1fr}.pb-widget-settings--feature-showcase .pb-compact-choice{grid-template-columns:repeat(2,minmax(34px,1fr))}}
</style>
