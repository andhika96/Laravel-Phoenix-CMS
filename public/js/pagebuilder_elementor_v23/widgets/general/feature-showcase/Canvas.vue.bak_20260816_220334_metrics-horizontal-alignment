const VERTICAL_ALIGNMENTS = Object.freeze(['start', 'center', 'end']);
const SPECIFICATION_METRICS_DEFAULTS = Object.freeze([
	Object.freeze({ label: 'Wheelbase', value: '2680', unit: 'MM' }),
	Object.freeze({ label: 'Max Horsepower', value: '114', unit: 'PS' }),
	Object.freeze({ label: 'Max Torque', value: '150', unit: 'NM' }),
	Object.freeze({ label: '', value: '', unit: '' }),
