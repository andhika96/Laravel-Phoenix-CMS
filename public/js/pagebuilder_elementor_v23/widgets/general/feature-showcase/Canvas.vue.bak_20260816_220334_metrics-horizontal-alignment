			const imageLeftFactor = ['specifications_metrics', 'specifications_hero'].includes(this.template) && this.imagePosition === 'left' ? this.metricAutoFitFactor() : 1;
			if (imageLeftFactor < 1) style.fontSize = this.autoFitMetricFontSize(style.fontSize, imageLeftFactor);
			if (prefix === 'metricValue' && this.responsiveDevice === 'mobile' && !this.hasResponsiveSetting('metricValueFontSize')) {
				const match = String(style.fontSize || '').match(/^(\d+(?:\.\d+)?)px$/i);
