			return style;
		},
		metricAutoFitFactor() {
			const width = String(this.responsiveValue('contentWidth', '42%')).trim();
			const match = width.match(/^(\d+(?:\.\d+)?)%$/);
			return match ? Math.min(1, Math.max(0.72, (Number(match[1]) / 42) * 0.88)) : 0.88;
		},
		autoFitMetricFontSize(value, factor) {
			const match = String(value || '').trim().match(/^(\d+(?:\.\d+)?)(px|%|rem|em|vw|vh)$/i);
			if (!match) return value;
			const scaled = Math.max(0.01, Number(match[1]) * factor);
			return `${Number(scaled.toFixed(2))}${match[2]}`;
		},
		hasResponsiveSetting(base) {
			const suffix = this.responsiveDevice === 'tablet' ? 'Tablet' : (this.responsiveDevice === 'mobile' ? 'Mobile' : '');
			return String(this.settings[base + suffix] ?? '').trim() !== '';
		},
		typographyStyle(prefix, additions = {}) {
			const defaults = { title: { size: '48px', lineHeight: '1.2em', weight: '700' }, subtitle: { size: '20px', lineHeight: '1.5em', weight: '400' }, description: { size: '16px', lineHeight: '1.5em', weight: '400' }, metricLabel: { size: '20px', lineHeight: '1.3em', weight: '400' }, metricValue: { size: '74px', lineHeight: '1em', weight: '700' }, metricUnit: { size: '20px', lineHeight: '1em', weight: '400' } }[prefix] || { size: '16px', lineHeight: '1.5em', weight: '400' };
			return { fontFamily: String(this.settings[prefix + 'FontFamily'] || 'inherit'), fontSize: this.cssSize(this.responsiveValue(prefix + 'FontSize', defaults.size), defaults.size), fontWeight: String(this.settings[prefix + 'FontWeight'] || defaults.weight), lineHeight: this.cssSize(this.responsiveValue(prefix + 'LineHeight', defaults.lineHeight), defaults.lineHeight), letterSpacing: this.cssSize(this.responsiveValue(prefix + 'LetterSpacing', '0px'), '0px'), wordSpacing: this.cssSize(this.responsiveValue(prefix + 'WordSpacing', '0px'), '0px'), textTransform: ['none', 'uppercase', 'lowercase', 'capitalize'].includes(this.settings[prefix + 'TextTransform']) ? this.settings[prefix + 'TextTransform'] : 'none', fontStyle: ['normal', 'italic', 'oblique'].includes(this.settings[prefix + 'FontStyle']) ? this.settings[prefix + 'FontStyle'] : 'normal', textDecoration: ['none', 'underline', 'overline', 'line-through'].includes(this.settings[prefix + 'TextDecoration']) ? this.settings[prefix + 'TextDecoration'] : 'none', ...additions };
		},
	},
};
