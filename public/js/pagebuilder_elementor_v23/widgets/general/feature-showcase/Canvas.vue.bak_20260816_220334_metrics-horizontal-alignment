export default {
	name: 'GeneralFeatureShowcase',
	props: { item: { type: Object, required: true }, responsiveDevice: { type: String, default: 'desktop' } },
	computed: {
		settings() { return this.item.settings || {}; },
		template() { const value = String(this.settings.template || 'specifications_metrics'); return TEMPLATES.includes(value) ? value : 'specifications_metrics'; },
		metrics() {
			const source = Array.isArray(this.settings.metrics) ? this.settings.metrics : [];
			const count = source.length === 0 ? 3 : Math.min(4, Math.max(1, source.length));
			return Array.from({ length: count }, (_, index) => {
				const preset = SPECIFICATION_METRICS_DEFAULTS[index] || SPECIFICATION_METRICS_DEFAULTS[3];
				const metric = source[index] || {};
				return {
					label: String(metric.label || preset.label),
					value: String(metric.value || preset.value),
					unit: String(metric.unit || preset.unit),
				};
			});
		},
		heroMetrics() { return this.metrics.slice(1, 3); },
		threeMetricPosition() { const value = this.responsiveValue('threeMetricPosition', 'left'); return ['left', 'center'].includes(value) ? value : 'left'; },
		metricsPositionClass() { return this.template === 'specifications_metrics' && this.metrics.length === 3 && this.threeMetricPosition === 'center' ? 'is-three-center' : ''; },
		images() { const source = Array.isArray(this.settings.images) ? this.settings.images : []; return [0, 1, 2].map((index) => ({ url: String(source[index]?.url || ''), alt: String(source[index]?.alt || '') })); },
		orderedMedia() {
			const order = Array.isArray(this.settings.mediaOrder) ? this.settings.mediaOrder.map((value) => String(value)) : ['1', '2', '3'];
			return order.map((slot) => ({ slot, image: this.images[Number(slot) - 1] || { url: '', alt: '' } }));
		},
		primaryMedia() { return this.orderedMedia[0]?.image || { url: '', alt: '' }; },
		featuredMedia() { const slot = String(this.responsiveValue('featuredImagePosition', '1')); return this.orderedMedia.find((media) => media.slot === slot) || this.orderedMedia[0] || { slot: '1', image: { url: '', alt: '' } }; },
		secondaryMedia() { return this.orderedMedia.filter((media) => media.slot !== this.featuredMedia.slot).slice(0, 2); },
		tallMedia() { return this.orderedMedia[0] || null; },
		sideMedia() { return this.orderedMedia.slice(1, 3); },
		description() { return String(this.settings.description || ''); },
		displaySubtitle() { return String(this.settings.subtitle || ''); },
		heroSubtitle() { return this.displaySubtitle || 'Redefining the meaning of driving MG 5 GT'; },
		textPosition() { const value = this.responsiveValue('textPosition', 'left'); return POSITIONS.includes(value) ? value : 'left'; },
		imagePosition() { const value = this.responsiveValue('imagePosition', 'right'); const safe = POSITIONS.includes(value) ? value : 'right'; return this.responsiveDevice === 'mobile' ? ({ left: 'top', right: 'bottom' }[safe] || safe) : safe; },
		textAlign() { const value = this.responsiveValue('textAlign', 'left'); return ALIGNMENTS.includes(value) ? value : 'left'; },
		verticalAlign() { const value = this.responsiveValue('verticalAlign', 'center'); return VERTICAL_ALIGNMENTS.includes(value) ? value : 'center'; },
		horizontalAlign() { const value = this.responsiveValue('horizontalAlign', 'center'); return ALIGNMENTS.includes(value) ? value : 'center'; },
		responsiveDeviceClass() { return ['desktop', 'tablet', 'mobile'].includes(this.responsiveDevice) ? this.responsiveDevice : 'desktop'; },
		imageHeight() { const fallback = { desktop: '420px', tablet: '340px', mobile: '220px' }[this.responsiveDeviceClass] || '420px'; return this.cssSize(this.responsiveValue('imageHeight', fallback), fallback); },
		templateClasses() { return [`pb-feature-showcase--${this.template}`, `pb-feature-showcase--text-${this.textPosition}`, `pb-feature-showcase--image-${this.imagePosition}`, `pb-feature-showcase--device-${this.responsiveDeviceClass}`]; },
		splitClasses() { return [`is-text-${this.textPosition}`, `is-image-${this.imagePosition}`, `is-vertical-${this.verticalAlign}`, `is-horizontal-${this.horizontalAlign}`]; },
		contentPositionClass() { return this.textPosition === 'bottom' ? 'is-content-bottom' : 'is-content-top'; },
		featureMediaClass() { return this.textPosition === 'bottom' ? 'is-image-top' : 'is-image-bottom'; },
		tallImageClass() { return this.responsiveValue('tallImagePosition', 'left') === 'right' ? 'is-tall-right' : 'is-tall-left'; },
		rootStyle() { return { '--pb-feature-container-width': this.cssSize(this.settings.containerWidth, '1140px'), '--pb-feature-gap': this.cssSize(this.responsiveValue('gap', '24px'), '24px'), '--pb-feature-radius': this.cssSize(this.responsiveValue('imageRadius', '45px'), '45px'), '--pb-feature-content-width': this.cssSize(this.responsiveValue('contentWidth', '42%'), '42%'), '--pb-feature-image-width': this.cssSize(this.responsiveValue('imageWidth', '58%'), '58%'), '--pb-feature-image-height': this.imageHeight, '--pb-feature-background': this.safeColor(this.settings.backgroundColor, '#fff'), '--pb-feature-performance-background': this.safeColor(this.settings.performanceBackgroundColor, '#212529'), '--pb-feature-gradient-start': this.safeColor(this.settings.headingGradientStart, '#0099d5'), '--pb-feature-gradient-end': this.safeColor(this.settings.headingGradientEnd, '#2be581') }; },
