<script>
const DIMENSION_PATTERN = /^(-?\d+(?:\.\d+)?)(px|pt|%|em|rem|vw|vh)?$/i;
const DIMENSION_UNITS = ['px', 'pt', '%', 'em', 'rem', 'vw', 'vh'];
function parseDimension(value, fallback = '0px') { const f=String(fallback||'0px').trim().match(DIMENSION_PATTERN); const m=String(value||'').trim().match(DIMENSION_PATTERN); const unit=m?.[2]||f?.[2]||'px'; return {value:Number(m?.[1]??f?.[1]??0),unit:DIMENSION_UNITS.includes(unit)?unit:'px'}; }
function expandBoxValue(value, fallback) { const t=String(value||fallback||'0px').trim().split(/\s+/).filter(Boolean); if(t.length===1)return[t[0],t[0],t[0],t[0]];if(t.length===2)return[t[0],t[1],t[0],t[1]];if(t.length===3)return[t[0],t[1],t[2],t[1]];return t.length>=4?t.slice(0,4):['0px','0px','0px','0px']; }
function dimensionLimit(unit){if(unit==='%')return 100;if(unit==='em'||unit==='rem')return 30;if(unit==='vw'||unit==='vh')return 100;return 400;}
function dimensionStep(unit){return unit==='em'||unit==='rem'?0.01:1;}
const ResponsiveMenu={props:{editor:Object,controlId:String},template:`<div class="pb-control-device-wrap"><button type="button" class="pb-control-device-btn" :title="'Responsive: '+editor.responsiveDeviceLabel()" @click.stop="editor.openControlResponsiveMenu(controlId)"><i :class="editor.responsiveDeviceIcon()"></i></button><div v-if="editor.isControlResponsiveMenuOpen(controlId)" class="pb-control-device-menu"><button v-for="device in editor.responsiveDevices" :key="controlId+'-'+device.value" type="button" class="pb-control-device-item" :class="{active:editor.responsiveDevice===device.value}" @click.stop="editor.applyResponsiveDevice(controlId,device.value)"><i :class="device.icon"></i><span>{{editor.deviceOptionLabel(device)}}</span></button></div></div>`};
const ResponsiveChoice={components:{ResponsiveMenu},props:{label:String,base:String,controlId:String,node:Object,editor:Object,options:Array},computed:{settingKey(){return this.editor.activeResponsiveKey(this.base);},value(){return this.node.settings[this.settingKey]||this.node.settings[this.base]||this.options?.[0]?.value||'';}},template:`<div class="pb-form-group pb-tabs-inline-control"><div class="pb-label-row pb-label-row-device"><div class="pb-tabs-control-label"><label class="pb-form-label mb-0">{{label}}</label><responsive-menu :editor="editor" :control-id="controlId"/></div><div class="pb-seg-group"><button v-for="option in options" :key="option.value" type="button" class="pb-seg-btn" :class="{active:value===option.value}" :title="option.label" :aria-label="option.label" @click="node.settings[settingKey]=option.value"><i :class="option.icon"></i></button></div></div></div>`};
const ResponsiveSelect={components:{ResponsiveMenu},props:{label:String,base:String,controlId:String,node:Object,editor:Object,options:Array},computed:{settingKey(){return this.editor.activeResponsiveKey(this.base);}},template:`<div class="pb-form-group"><div class="pb-label-row pb-label-row-device"><label class="pb-form-label mb-0">{{label}}</label><responsive-menu :editor="editor" :control-id="controlId"/></div><select class="pb-select" v-model="node.settings[settingKey]"><option v-for="option in options" :key="String(option.value)" :value="option.value">{{option.label}}</option></select></div>`};
const ResponsiveDimensionControl={components:{ResponsiveMenu},props:{label:String,base:String,controlId:String,fallback:String,node:Object,editor:Object,min:{type:Number,default:0},max:{type:Number,default:400}},computed:{settingKey(){return this.editor.activeResponsiveKey(this.base);},parsed(){return parseDimension(this.node.settings[this.settingKey],this.fallback);},maxValue(){return Math.min(this.max,dimensionLimit(this.parsed.unit));},stepValue(){return dimensionStep(this.parsed.unit);}},methods:{setValue(raw){const value=Number(raw);if(Number.isFinite(value))this.node.settings[this.settingKey]=`${Math.min(this.maxValue,Math.max(this.min,value))}${this.parsed.unit}`;},setUnit(unit){const safe=DIMENSION_UNITS.includes(unit)?unit:'px';this.node.settings[this.settingKey]=`${this.parsed.value}${safe}`;}},template:`<div class="pb-form-group pb-tabs-dimension-control"><div class="pb-label-row pb-label-row-device"><label class="pb-form-label mb-0">{{label}}</label><div class="pb-label-tools"><responsive-menu :editor="editor" :control-id="controlId"/></div></div><div class="pb-range-value-row"><input class="pb-range" type="range" :min="min" :max="maxValue" :step="stepValue" :value="parsed.value" @input="setValue($event.target.value)"><div class="pb-value-with-unit"><input class="pb-input pb-input-compact" type="number" :min="min" :max="maxValue" :step="stepValue" :value="parsed.value" @input="setValue($event.target.value)"><select class="pb-mini-unit" :value="parsed.unit" :aria-label="label+' unit'" @change="setUnit($event.target.value)"><option v-for="unit in ['px','pt','%','em','rem','vw','vh']" :key="unit" :value="unit">{{unit}}</option></select></div></div></div>`};
const ResponsiveBoxControl={components:{ResponsiveMenu},props:{label:String,base:String,controlId:String,fallback:String,kind:{type:String,default:'edges'},node:Object,editor:Object},data(){return{linked:true};},computed:{sides(){return this.kind==='corners'?[{key:'TL',label:'Top Left'},{key:'TR',label:'Top Right'},{key:'BR',label:'Bottom Right'},{key:'BL',label:'Bottom Left'}]:[{key:'Top',label:'Top'},{key:'Right',label:'Right'},{key:'Bottom',label:'Bottom'},{key:'Left',label:'Left'}];},baseValue(){return this.node.settings[this.editor.activeResponsiveKey(this.base)]||this.node.settings[this.base]||this.fallback;},unit(){return this.value(0).unit;},maxValue(){return dimensionLimit(this.unit);},stepValue(){return dimensionStep(this.unit);}},methods:{settingKey(side){return this.editor.activeResponsiveKey(this.base+side.key);},value(index){const side=this.sides[index],fallback=expandBoxValue(this.baseValue,this.fallback)[index];return parseDimension(this.node.settings[this.settingKey(side)]||fallback,fallback);},setValue(index,raw){const n=Number(raw);if(!Number.isFinite(n))return;const safe=Math.min(this.maxValue,Math.max(0,n));if(this.linked)this.sides.forEach(side=>{this.node.settings[this.settingKey(side)]=`${safe}${this.unit}`;});else this.node.settings[this.settingKey(this.sides[index])]=`${safe}${this.unit}`;},setUnit(unit){const safe=DIMENSION_UNITS.includes(unit)?unit:'px';this.sides.forEach((side,index)=>{this.node.settings[this.settingKey(side)]=`${this.value(index).value}${safe}`;});}},template:`<div class="pb-form-group pb-tabs-box-control"><div class="pb-label-row pb-label-row-device"><label class="pb-form-label mb-0">{{label}}</label><div class="pb-label-tools"><responsive-menu :editor="editor" :control-id="controlId"/><select class="pb-mini-unit" :value="unit" :aria-label="label+' unit'" @change="setUnit($event.target.value)"><option v-for="option in ['px','pt','%','em','rem','vw','vh']" :key="option" :value="option">{{option}}</option></select></div></div><div class="pb-four-sides pb-four-sides-with-link"><label v-for="(side,index) in sides" :key="side.key" class="pb-side-input"><input class="pb-input" type="number" min="0" :max="maxValue" :step="stepValue" :value="value(index).value" @input="setValue(index,$event.target.value)"><span>{{side.label}}</span></label><div class="pb-side-link-cell"><button type="button" class="pb-link-btn" :class="{active:linked}" :title="linked?'Unlink values':'Link values'" @click="linked=!linked"><i class="fas" :class="linked?'fa-link':'fa-unlink'"></i></button></div></div></div>`};
const BackgroundControl={props:{prefix:String,node:Object},computed:{typeKey(){return this.prefix+'BackgroundType';},colorKey(){return this.prefix+'BackgroundColor';}},template:`<div class="pb-tabs-background-control"><div class="pb-form-group pb-tabs-inline-control"><div class="pb-label-row"><label class="pb-form-label mb-0">Background Type</label><div class="pb-seg-group"><button type="button" class="pb-seg-btn" :class="{active:node.settings[typeKey]==='classic'}" title="Classic" @click="node.settings[typeKey]='classic'"><i class="fas fa-paint-brush"></i></button><button type="button" class="pb-seg-btn" :class="{active:node.settings[typeKey]==='gradient'}" title="Gradient" @click="node.settings[typeKey]='gradient'"><i class="fas fa-adjust"></i></button></div></div></div><div v-if="node.settings[typeKey]==='gradient'" class="pb-tabs-gradient-fields"><div class="pb-form-group pb-tabs-color-control"><label class="pb-form-label">First Color</label><input class="pb-input coloris pb-coloris-input" v-model="node.settings[prefix+'GradientColorOne']"></div><div class="pb-form-group pb-tabs-color-control"><label class="pb-form-label">Second Color</label><input class="pb-input coloris pb-coloris-input" v-model="node.settings[prefix+'GradientColorTwo']"></div><div class="pb-form-group"><label class="pb-form-label">Type</label><select class="pb-select" v-model="node.settings[prefix+'GradientType']"><option value="linear">Linear</option><option value="radial">Radial</option></select></div><div v-if="node.settings[prefix+'GradientType']!=='radial'" class="pb-form-group"><label class="pb-form-label">Angle</label><input class="pb-input" type="number" min="0" max="360" v-model.number="node.settings[prefix+'GradientAngle']"></div><div v-else class="pb-form-group"><label class="pb-form-label">Position</label><select class="pb-select" v-model="node.settings[prefix+'GradientPosition']"><option value="center center">Center Center</option><option value="center top">Center Top</option><option value="center bottom">Center Bottom</option><option value="left center">Left Center</option><option value="right center">Right Center</option></select></div></div><div v-else class="pb-form-group pb-tabs-color-control"><label class="pb-form-label">Color</label><input class="pb-input coloris pb-coloris-input" v-model="node.settings[colorKey]"></div></div>`};
const BoxShadowControl={props:{prefix:String,node:Object},computed:{enabledKey(){return this.prefix+'BoxShadowEnabled';}},template:`<details class="pb-tabs-inline-editor"><summary><span>Box Shadow</span><span class="pb-tabs-edit-button">Edit</span></summary><div class="pb-tabs-inline-editor__body"><div class="pb-form-group pb-toggle-label-row"><label class="pb-form-label mb-0">Enable</label><div class="pb-toggle-wrap"><input :id="prefix+'-shadow'" type="checkbox" class="pb-toggle" v-model="node.settings[enabledKey]"><label :for="prefix+'-shadow'"></label></div></div><div v-if="node.settings[enabledKey]" class="pb-tabs-shadow-options"><div class="pb-form-group"><label class="pb-form-label">Color</label><input class="pb-input coloris pb-coloris-input" v-model="node.settings[prefix+'BoxShadowColor']"></div><div class="pb-tabs-shadow-grid"><label v-for="field in ['X','Y','Blur','Spread']" :key="field"><span>{{field}}</span><input class="pb-input" v-model="node.settings[prefix+'BoxShadow'+field]"></label></div><div class="pb-form-group pb-toggle-label-row"><label class="pb-form-label mb-0">Inset</label><div class="pb-toggle-wrap"><input :id="prefix+'-shadow-inset'" type="checkbox" class="pb-toggle" v-model="node.settings[prefix+'BoxShadowInset']"><label :for="prefix+'-shadow-inset'"></label></div></div></div></div></details>`};

