				<label class="pb-image-toggle"><span>Box Shadow</span><input type="checkbox" v-model="node.settings.imageBoxShadowEnabled"></label>
				<div v-if="node.settings.imageBoxShadowEnabled" class="pb-image-shadow-controls"><label><span>Color</span><input class="pb-input coloris pb-coloris-input" v-model="node.settings.imageBoxShadowColor"></label><label v-for="field in shadowFields" :key="field.key"><span>{{ field.label }}</span><input class="pb-input" v-model="node.settings[field.key]"></label></div>
			</div></details>

			<details v-if="node.settings.captionType!=='none'" class="pb-collapsible"><summary>Caption</summary><div class="pb-collapsible-body">
				<ResponsiveChoice label="Alignment" base="captionAlignment" control-id="image-caption-alignment" :node="node" :editor="editor" :options="captionAlignmentOptions" />
				<div class="pb-form-group"><label class="pb-form-label">Text Color</label><input class="pb-input coloris pb-coloris-input" v-model="node.settings.captionColor"></div>
				<div class="pb-form-group"><label class="pb-form-label">Background Color</label><input class="pb-input coloris pb-coloris-input" v-model="node.settings.captionBackgroundColor"></div>
				<component :is="editor.typographyControl" prefix="caption" :settings="node.settings" :responsive-device="editor.responsiveDevice" :font-families="editor.fontFamilies" :reset-defaults="{FontSize:'16px',FontWeight:'400',LineHeight:'1.5em'}" @responsive-device="editor.setResponsiveDevice" />
				<component :is="editor.textShadowControl" aria-label="Text Shadow" :model-value="node.settings.captionTextShadow" control-id="image-caption-shadow" :open="activeTextEffect==='image-caption-shadow'" @request-open="activeTextEffect=$event" @update:modelValue="node.settings.captionTextShadow=$event" />
				<SizeControl label="Spacing" base="captionSpacing" control-id="image-caption-spacing" fallback="8px" :units="['px','em','rem']" :node="node" :editor="editor" />
			</div></details>
		</div>

		<div v-show="editor.settingsTab==='advanced'" class="pb-tab-content"><component :is="editor.widgetAdvancedControls" :node="node" :responsive-device="editor.responsiveDevice" :show-display-conditions="false" :show-cache-settings="false" :elementor-choices="true" @responsive-device="editor.setResponsiveDevice" @choose-media="editor.chooseMedia(node.settings,$event)" @clear-media="editor.clearMedia(node.settings,$event)" @unavailable-ai="editor.showUnsupportedControlNotice('Animate With AI', 'AI service is not connected to this page builder.')" /></div>
	</div>
</template>

<script>
const ResponsiveMenu={props:['editor','id'],template:`<div class="pb-control-device-wrap"><button type="button" class="pb-control-device-btn" @click.stop="editor.openControlResponsiveMenu(id)" :title="'Responsive: '+editor.responsiveDeviceLabel()"><i :class="editor.responsiveDeviceIcon()"></i></button><div v-if="editor.isControlResponsiveMenuOpen(id)" class="pb-control-device-menu"><button v-for="device in editor.responsiveDevices" :key="id+'-'+device.value" type="button" class="pb-control-device-item" :class="{active:editor.responsiveDevice===device.value}" @click.stop="editor.applyResponsiveDevice(id,device.value)"><i :class="device.icon"></i><span>{{editor.deviceOptionLabel(device)}}</span></button></div></div>`};
const ResponsiveChoice={components:{ResponsiveMenu},props:['label','base','controlId','node','editor','options'],methods:{activeKey(){return typeof this.editor.activeResponsiveKey==='function'?this.editor.activeResponsiveKey(this.base):this.base;},setValue(value){if(typeof this.editor.setResponsiveSetting==='function')this.editor.setResponsiveSetting(this.node.settings,this.base,value);else this.node.settings[this.base]=value;}},template:`<div class="pb-form-group"><div class="pb-label-row pb-label-row-device"><label class="pb-form-label mb-0">{{label}}</label><ResponsiveMenu :editor="editor" :id="controlId"/></div><div class="pb-btn-group pb-image-segmented"><button v-for="option in options" :key="base+'-'+option.value" type="button" class="pb-seg-btn" :class="{active:node.settings[activeKey()]===option.value}" :title="option.label" @click="setValue(option.value)"><i :class="option.icon"></i></button></div></div>`};
const SizeControl={components:{ResponsiveMenu},props:{label:String,base:String,controlId:String,fallback:String,units:Array,node:Object,editor:Object,allowEmpty:Boolean,emptyToken:String},computed:{options(){return{fallback:this.fallback,allowedUnits:this.units,allowEmpty:this.allowEmpty,emptyToken:this.emptyToken||this.fallback};}},template:`<div class="pb-form-group"><div class="pb-label-row pb-label-row-device"><label class="pb-form-label mb-0">{{label}}</label><ResponsiveMenu :editor="editor" :id="controlId"/></div><div class="pb-range-value-row"><input class="pb-range" type="range" min="0" :max="editor.sizeControlMax(node,base,fallback,options)" :step="editor.sizeControlStep(node,base,fallback,options)" :value="editor.sizeControlDisplayValue(node,base,fallback,options)||0" @input="editor.onSizeControlInput(node,base,$event,options)"><div class="pb-value-with-unit"><input class="pb-input pb-input-compact" type="number" min="0" :max="editor.sizeControlMax(node,base,fallback,options)" :step="editor.sizeControlStep(node,base,fallback,options)" :value="editor.sizeControlDisplayValue(node,base,fallback,options)" :placeholder="allowEmpty?emptyToken:''" @input="editor.onSizeControlInput(node,base,$event,options)"><select class="pb-mini-unit" :value="editor.sizeControlUnit(node,base,fallback,options)" @change="editor.setSizeControlUnit(node,base,$event.target.value,options)"><option v-for="unit in units" :key="base+'-'+unit" :value="unit">{{unit}}</option></select></div></div></div>`};

export default {
	name:'BasicImageSettings', components:{ResponsiveMenu,ResponsiveChoice,SizeControl}, props:{node:{type:Object,required:true},editor:{type:Object,required:true}},
	data(){return{imageState:'normal',activeTextEffect:'',resolutionOptions:[{value:'thumbnail',label:'Thumbnail - 150 x 150'},{value:'medium',label:'Medium - 300 x 300'},{value:'medium_large',label:'Medium Large - 768 x 0'},{value:'large',label:'Large - 1024 x 1024'},{value:'1536x1536',label:'1536 x 1536'},{value:'2048x2048',label:'2048 x 2048'},{value:'full',label:'Full'},{value:'custom',label:'Custom'}],imageAlignmentOptions:[{value:'left',label:'Left',icon:'fas fa-align-left'},{value:'center',label:'Center',icon:'fas fa-align-center'},{value:'right',label:'Right',icon:'fas fa-align-right'}],captionAlignmentOptions:[{value:'left',label:'Left',icon:'fas fa-align-left'},{value:'center',label:'Center',icon:'fas fa-align-center'},{value:'right',label:'Right',icon:'fas fa-align-right'},{value:'justify',label:'Justified',icon:'fas fa-align-justify'}],objectPositionOptions:['center center','center left','center right','top center','top left','top right','bottom center','bottom left','bottom right'],hoverAnimationOptions:['none','grow','shrink','pulse','pulse-grow','pulse-shrink','push','pop','bounce-in','bounce-out','rotate','grow-rotate','float','sink','bob','hang','skew','skew-forward','skew-backward','wobble-vertical','wobble-horizontal','wobble-to-bottom-right','wobble-to-top-right','wobble-top','wobble-bottom','wobble-skew','buzz','buzz-out'].map(value=>({value,label:value==='none'?'None':value.split('-').map(part=>part[0].toUpperCase()+part.slice(1)).join(' ')})),shadowFields:[{key:'imageBoxShadowX',label:'Horizontal'},{key:'imageBoxShadowY',label:'Vertical'},{key:'imageBoxShadowBlur',label:'Blur'},{key:'imageBoxShadowSpread',label:'Spread'}]};},
	created(){if(!this.node.settings||typeof this.node.settings!=='object')this.node.settings={};if(!this.node.settings.dynamicBindings||typeof this.node.settings.dynamicBindings!=='object'||Array.isArray(this.node.settings.dynamicBindings))this.node.settings.dynamicBindings={};if(!Array.isArray(this.node.settings.linkCustomAttributes))this.node.settings.linkCustomAttributes=[];},
	computed:{imageSource(){return this.node.settings?.imageSource==='url'?'url':'ckfinder';},hasCustomHeight(){const value=String(this.activeValue('height','auto')).trim().toLowerCase();return value!==''&&value!=='auto';},activeObjectFit(){return String(this.activeValue('objectFit','default'));},usesBorder(){return ['solid','double','dotted','dashed','groove'].includes(this.node.settings.imageBorderType);}},
	methods:{setImageSource(value){this.node.settings.imageSource=value==='url'?'url':'ckfinder';},activeValue(base,fallback=''){const key=typeof this.editor.activeResponsiveKey==='function'?this.editor.activeResponsiveKey(base):base;const value=this.node.settings[key];if(value!==''&&value!=null)return value;return this.node.settings[base]!==''&&this.node.settings[base]!=null?this.node.settings[base]:fallback;},titleCase(value){return String(value).replace(/\b\w/g,letter=>letter.toUpperCase());}},
};
</script>

<style scoped>
.pb-image-custom-resolution{display:grid;grid-template-columns:1fr 1fr;gap:10px}.pb-image-custom-resolution .pb-form-note{grid-column:1/-1}.pb-image-custom-resolution label,.pb-image-shadow-controls label{display:grid;gap:6px;color:#475467;font-size:11px}.pb-image-segmented{display:grid;grid-template-columns:repeat(4,minmax(0,1fr))}.pb-image-state-fields{margin-bottom:11px}.pb-image-toggle{min-height:40px;display:flex;align-items:center;justify-content:space-between;color:#344054;font-size:11px}.pb-image-shadow-controls{display:grid;grid-template-columns:1fr 1fr;gap:10px}.pb-image-shadow-controls label:first-child{grid-column:1/-1}
</style>
