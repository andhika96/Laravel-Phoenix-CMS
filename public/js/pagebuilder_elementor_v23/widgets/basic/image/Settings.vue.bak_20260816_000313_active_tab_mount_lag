				<div v-if="node.settings.captionType==='custom'" class="pb-form-group"><div class="pb-label-row"><label class="pb-form-label mb-0">Custom Caption</label><component :is="editor.dynamicTagControl" v-model="node.settings.dynamicBindings.customCaption" :allowed-values="['page_title','page_excerpt','site_title','user_display_name']" /></div><textarea class="pb-input" rows="3" v-model="node.settings.customCaption" placeholder="Enter your image caption"></textarea></div>
				<div class="pb-form-group"><label class="pb-form-label">Link</label><select class="pb-select" v-model="node.settings.linkType"><option value="none">None</option><option value="media">Media File</option><option value="custom">Custom URL</option></select></div>
				<div v-if="node.settings.linkType==='media'" class="pb-form-group"><label class="pb-form-label">Lightbox</label><select class="pb-select" v-model="node.settings.lightbox"><option value="default">Default</option><option value="yes">Yes</option><option value="no">No</option></select></div>
				<div v-if="node.settings.linkType==='custom'" class="pb-form-group"><div class="pb-label-row"><label class="pb-form-label mb-0">Custom URL</label><component :is="editor.dynamicTagControl" v-model="node.settings.dynamicBindings.customLinkUrl" :allowed-values="['page_url','site_url']" /></div><div class="pb-subsection-title">Link Options</div><component :is="editor.linkControl" :url="node.settings.customLinkUrl" :target="node.settings.linkTarget" :nofollow="node.settings.linkNofollow" :custom-attributes="node.settings.linkCustomAttributes" @update:url="node.settings.customLinkUrl=$event" @update:target="node.settings.linkTarget=$event" @update:nofollow="node.settings.linkNofollow=$event" @update:customAttributes="node.settings.linkCustomAttributes=$event" /></div>
			</div></details>
		</div>

		<div v-show="editor.settingsTab==='style'" class="pb-tab-content">
			<details class="pb-collapsible" open><summary>Image</summary><div class="pb-collapsible-body">
				<ResponsiveChoice label="Alignment" base="alignment" control-id="image-alignment" :node="node" :editor="editor" :options="imageAlignmentOptions" />
				<SizeControl label="Width" base="width" control-id="image-width" fallback="100%" :units="['px','%','em','rem','vw']" :node="node" :editor="editor" />
				<SizeControl label="Max Width" base="maxWidth" control-id="image-max-width" fallback="100%" :units="['px','%','em','rem','vw']" :node="node" :editor="editor" />
				<SizeControl label="Height" base="height" control-id="image-height" fallback="auto" :units="['px','%','em','rem','vh']" allow-empty empty-token="auto" :node="node" :editor="editor" />
				<div v-if="hasCustomHeight" class="pb-form-group"><div class="pb-label-row pb-label-row-device"><label class="pb-form-label mb-0">Object Fit</label><ResponsiveMenu :editor="editor" id="image-object-fit" /></div><select class="pb-select" :value="activeValue('objectFit','default')" @change="editor.setResponsiveSetting(node.settings,'objectFit',$event.target.value)"><option value="default">Default</option><option value="fill">Fill</option><option value="cover">Cover</option><option value="contain">Contain</option><option value="scale-down">Scale Down</option></select></div>
				<div v-if="hasCustomHeight && ['cover','contain'].includes(activeObjectFit)" class="pb-form-group"><div class="pb-label-row pb-label-row-device"><label class="pb-form-label mb-0">Object Position</label><ResponsiveMenu :editor="editor" id="image-object-position" /></div><select class="pb-select" :value="activeValue('objectPosition','center center')" @change="editor.setResponsiveSetting(node.settings,'objectPosition',$event.target.value)"><option v-for="position in objectPositionOptions" :key="position" :value="position">{{ titleCase(position) }}</option></select></div>

				<div class="pb-state-tabs pb-state-tabs--two"><button type="button" :class="{active:imageState==='normal'}" @click="imageState='normal'">Normal</button><button type="button" :class="{active:imageState==='hover'}" @click="imageState='hover'">Hover</button></div>
				<div v-show="imageState==='normal'" class="pb-image-state-fields"><component :is="editor.cssFilterControl" v-model="node.settings.imageNormalFilter" /><div class="pb-form-group"><label class="pb-form-label">Opacity</label><div class="pb-range-value-row"><input class="pb-range" type="range" min="0" max="1" step="0.01" v-model.number="node.settings.imageNormalOpacity"><input class="pb-input pb-input-compact" type="number" min="0" max="1" step="0.01" v-model.number="node.settings.imageNormalOpacity"></div></div></div>
				<div v-show="imageState==='hover'" class="pb-image-state-fields"><component :is="editor.cssFilterControl" v-model="node.settings.imageHoverFilter" /><div class="pb-form-group"><label class="pb-form-label">Opacity</label><div class="pb-range-value-row"><input class="pb-range" type="range" min="0" max="1" step="0.01" v-model.number="node.settings.imageHoverOpacity"><input class="pb-input pb-input-compact" type="number" min="0" max="1" step="0.01" v-model.number="node.settings.imageHoverOpacity"></div></div><div class="pb-form-group"><label class="pb-form-label">Transition Duration (s)</label><div class="pb-range-value-row"><input class="pb-range" type="range" min="0" max="5" step="0.1" v-model.number="node.settings.imageHoverTransition"><input class="pb-input pb-input-compact" type="number" min="0" max="10" step="0.1" v-model.number="node.settings.imageHoverTransition"></div></div><div class="pb-form-group"><label class="pb-form-label">Hover Animation</label><select class="pb-select" v-model="node.settings.imageHoverAnimation"><option v-for="animation in hoverAnimationOptions" :key="animation.value" :value="animation.value">{{ animation.label }}</option></select></div></div>

				<div class="pb-form-group"><label class="pb-form-label">Border Type</label><select class="pb-select" v-model="node.settings.imageBorderType"><option value="default">Default</option><option value="none">None</option><option value="solid">Solid</option><option value="double">Double</option><option value="dotted">Dotted</option><option value="dashed">Dashed</option><option value="groove">Groove</option></select></div>
