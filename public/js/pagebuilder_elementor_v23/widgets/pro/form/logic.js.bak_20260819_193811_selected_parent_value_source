const ALLOWED_OPERATORS = new Set([
    "equals",
    "not_equals",
    "contains",
    "empty",
    "not_empty",
]);

function normalizedValue(value) {
    if (Array.isArray(value)) return value.map((entry) => String(entry ?? "").trim());
    return String(value ?? "").trim();
}

function isEmpty(value) {
    const normalized = normalizedValue(value);
    return Array.isArray(normalized)
        ? normalized.length === 0 || normalized.every((entry) => entry === "")
        : normalized === "";
}

function ruleMatches(rule, values) {
    const actual = values?.[rule.fieldId];
    const expected = String(rule.value ?? "").trim();
    const normalized = normalizedValue(actual);
    switch (rule.operator) {
        case "contains":
            return Array.isArray(normalized)
                ? normalized.includes(expected)
                : String(normalized).toLowerCase().includes(expected.toLowerCase());
        case "empty":
            return isEmpty(actual);
        case "not_empty":
            return !isEmpty(actual);
        case "not_equals":
            return Array.isArray(normalized)
                ? !normalized.includes(expected)
                : String(normalized).toLowerCase() !== expected.toLowerCase();
        default:
            return Array.isArray(normalized)
                ? normalized.includes(expected)
                : String(normalized).toLowerCase() === expected.toLowerCase();
    }
}

export function normalizeConditionalLogic(logic = {}, fieldId = "") {
    const source = logic && typeof logic === "object" ? logic : {};
    const relation = source.relation === "any" ? "any" : "all";
    const rules = Array.isArray(source.rules)
        ? source.rules
              .filter((rule) => rule && typeof rule === "object")
              .map((rule) => ({
                  fieldId: String(rule.fieldId ?? "").trim(),
                  operator: ALLOWED_OPERATORS.has(rule.operator) ? rule.operator : "equals",
                  value: String(rule.value ?? ""),
              }))
              .filter((rule) => rule.fieldId && rule.fieldId !== fieldId)
        : [];

    return {
        enabled: source.enabled === true && rules.length > 0,
        relation,
        rules,
    };
}

export function fieldIsVisible(field = {}, values = {}) {
    const logic = normalizeConditionalLogic(field.conditionalLogic, field.id);
    if (!logic.enabled) return true;
    const results = logic.rules.map((rule) => ruleMatches(rule, values));
    return logic.relation === "any" ? results.some(Boolean) : results.every(Boolean);
}

export function resolveDatasetOptions(nodes = [], parentValue = null) {
    const list = Array.isArray(nodes) ? nodes : [];
    const parent = parentValue === null || parentValue === undefined || parentValue === ""
        ? null
        : list.find((node) => String(node?.id ?? "") === String(parentValue) || String(node?.value ?? "") === String(parentValue));
    const parentId = parent ? String(parent.id) : null;
    return list
        .filter((node) => node && node.active !== false && (node.parentId ?? null) === parentId)
        .sort((left, right) => (Number(left.sortOrder) || 0) - (Number(right.sortOrder) || 0) || String(left.label ?? "").localeCompare(String(right.label ?? "")));
}
