                if (!allowed.has(element.nodeName.toLowerCase())) {
                    element.remove();
                    return;
                }
                Array.from(element.attributes).forEach((attribute) => {
                    const name = attribute.name.toLowerCase();
                    if (
                        name.startsWith("on") ||
                        name === "style" ||
                        name.includes("href")
