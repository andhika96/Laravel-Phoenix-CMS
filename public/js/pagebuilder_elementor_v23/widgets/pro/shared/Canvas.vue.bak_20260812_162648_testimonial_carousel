        responsiveBoxValue(base, fallback) {
            return ["Top", "Right", "Bottom", "Left"]
                .map((side) =>
                    this.safeLength(
                        this.responsiveValue(base + side, fallback),
                        fallback,
                    ),
                )
                .join(" ");
