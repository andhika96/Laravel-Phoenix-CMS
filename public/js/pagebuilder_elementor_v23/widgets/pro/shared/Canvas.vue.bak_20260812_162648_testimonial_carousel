                ? iconClass
                : fallback;
        },
        safeInputType(value) {
            return [
                "text",
                "email",
                "number",
                "tel",
                "url",
                "date",
                "time",
                "file",
                "hidden",
                "checkbox",
                "radio",
            ].includes(value)
                ? value
