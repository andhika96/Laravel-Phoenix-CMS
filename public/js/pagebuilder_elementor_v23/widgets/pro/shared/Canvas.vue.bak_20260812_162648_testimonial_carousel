                        else {
                            clean(node);
                            node.replaceWith(...node.childNodes);
                        }
                        return;
                    }
                    Array.from(node.attributes).forEach((attribute) => {
                        const name = attribute.name.toLowerCase();
                        if (
                            node.tagName !== "A" ||
                            !["href", "target", "rel"].includes(name)
