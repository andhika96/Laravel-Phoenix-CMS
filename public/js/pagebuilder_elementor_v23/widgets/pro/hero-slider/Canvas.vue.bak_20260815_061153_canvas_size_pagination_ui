<script>
export default {
    name: 'HeroSliderCanvas',
    props: { item: { type: Object, required: true }, responsiveDevice: { type: String, default: 'desktop' } },
    data() { return { activeIndex: 0 }; },
    computed: {
        settings() { return this.item.settings || {}; },
        slides() { return Array.isArray(this.settings.slides) && this.settings.slides.length ? this.settings.slides : [{ id: 'empty', mediaType: 'image' }]; },
        direction() { return this.enumValue(this.responsiveValue('direction', 'horizontal'), ['horizontal', 'vertical'], 'horizontal'); },
        configJson() { return JSON.stringify(this.settings); },
        rootStyle() { return { minHeight: this.cssLength(this.responsiveValue('minHeight', '420px'), '420px'), height: this.settings.heightMode === 'fixed' ? this.cssLength(this.settings.fixedHeight, '520px') : undefined, '--hero-slider-gap': this.cssLength(this.settings.gap, '0px'), '--hero-slider-padding': this.cssLength(this.settings.padding, '0px'), '--hero-slider-overlay': this.safeColor(this.settings.overlayColor, 'rgba(0,0,0,.2)'), '--hero-slider-title-color': this.safeColor(this.settings.titleColor, '#fff'), '--hero-slider-subtitle-color': this.safeColor(this.settings.subtitleColor, '#fff'), '--hero-slider-button-color': this.safeColor(this.settings.buttonTextColor, '#fff'), '--hero-slider-button-bg': this.safeColor(this.settings.buttonBackground, '#30343a'), '--hero-slider-button-hover-bg': this.safeColor(this.settings.buttonBackgroundHover, '#1f2328'), '--hero-slider-button-radius': this.cssLength(this.settings.buttonRadius, '999px'), '--hero-slider-button-pad-x': this.cssLength(this.settings.buttonPaddingX, '18px'), '--hero-slider-button-pad-y': this.cssLength(this.settings.buttonPaddingY, '10px') }; },
        trackStyle() { return this.settings.transition === 'fade' ? {} : { transform: this.direction === 'vertical' ? `translate3d(0,-${this.activeIndex * 100}%,0)` : `translate3d(-${this.activeIndex * 100}%,0,0)`, transitionDuration: `${Math.max(0, Number(this.settings.transitionSpeed) || 600)}ms` }; },
    },
    methods: {
        responsiveValue(base, fallback = '') { const keys = this.responsiveDevice === 'mobile' ? [base + 'Mobile', base + 'Tablet', base] : (this.responsiveDevice === 'tablet' ? [base + 'Tablet', base] : [base]); for (const key of keys) { if (this.settings[key] !== '' && this.settings[key] != null) return this.settings[key]; } return fallback; },
        enumValue(value, allowed, fallback) { return allowed.includes(value) ? value : fallback; },
        cssLength(value, fallback) { const raw = String(value ?? '').trim(); return /^-?\d+(?:\.\d+)?(?:px|pt|%|em|rem|vw|vh)?$/i.test(raw) ? raw : fallback; },
        safeColor(value, fallback) { const raw = String(value || '').trim(); return raw && /^[#a-z0-9(),.%\s-]+$/i.test(raw) ? raw : fallback; },
        safeMedia(value) { const raw = String(value || '').trim(); return /^(?:https?:\/\/|\/)[^\u0000-\u001f"'()\\]*$/i.test(raw) ? raw : ''; },
        safeLink(value) { return this.safeMedia(value); },
        imageUrl(slide) { return this.safeMedia(slide.imageUrl); },
        posterUrl(slide) { return this.safeMedia(slide.videoPoster); },
        extractId(provider, value) { const raw = String(value || '').trim(); if (provider === 'youtube') { const match = raw.match(/(?:youtu\.be\/|[?&]v=|embed\/)([^?&/]+)/i); return match ? match[1] : raw; } if (provider === 'vimeo') { const match = raw.match(/(?:video\/|vimeo\.com\/)(\d+)/i); return match ? match[1] : raw.replace(/\D+/g, ''); } if (provider === 'dailymotion') { const match = raw.match(/(?:video\/|dai\.ly\/)([^_?&/]+)/i); return match ? match[1] : raw; } return ''; },
        isIframe(slide) { return ['youtube', 'vimeo', 'dailymotion', 'embed'].includes(String(slide.videoProvider || '')); },
        videoUrl(slide) { const provider = String(slide.videoProvider || 'self_hosted'); const raw = this.safeMedia(slide.videoUrl); if (provider === 'self_hosted' || provider === 'embed') return raw; const id = this.extractId(provider, raw); if (!id) return raw; if (provider === 'youtube') return 'https://' + (this.settings.videoPrivacyMode ? 'www.youtube-nocookie.com' : 'www.youtube.com') + '/embed/' + encodeURIComponent(id) + '?enablejsapi=1&playsinline=1&rel=0'; if (provider === 'vimeo') return 'https://player.vimeo.com/video/' + encodeURIComponent(id) + '?api=1&autopause=0&playsinline=1'; return 'https://www.dailymotion.com/embed/video/' + encodeURIComponent(id) + '?api=postMessage'; },
        goTo(index) { this.activeIndex = Math.max(0, Math.min(this.slides.length - 1, Number(index) || 0)); },
        next() { this.goTo(this.activeIndex + 1 >= this.slides.length ? (this.settings.loop ? 0 : this.activeIndex) : this.activeIndex + 1); },
        previous() { this.goTo(this.activeIndex - 1 < 0 ? (this.settings.loop ? this.slides.length - 1 : 0) : this.activeIndex - 1); },
    },
};
