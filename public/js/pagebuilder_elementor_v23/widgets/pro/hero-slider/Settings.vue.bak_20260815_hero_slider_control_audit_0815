                    <div class="pb-form-group"><label class="pb-form-label">Video Autoplay Fallback</label><select class="pb-select" v-model="settings.videoAutoplayFallback"><option value="interval">Use slider interval</option></select></div>
                    <ToggleField :id="'hero-slider-video-muted-'+node.id" label="Muted autoplay" v-model="settings.videoMutedAutoplay" />
