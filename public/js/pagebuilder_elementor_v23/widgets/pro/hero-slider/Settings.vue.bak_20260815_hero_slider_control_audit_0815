                    <div class="pb-form-group"><label class="pb-form-label">Transition</label><select class="pb-select" v-model="settings.transition"><option value="slide">Slide</option><option value="fade">Fade</option></select></div>
                    <div class="pb-hero-slider-grid"><div class="pb-form-group"><label class="pb-form-label">Interval (ms)</label><input class="pb-input" type="number" min="100" v-model.number="settings.autoplaySpeed"></div><div class="pb-form-group"><label class="pb-form-label">Transition Speed</label><input class="pb-input" type="number" min="0" v-model.number="settings.transitionSpeed"></div><div class="pb-form-group"><label class="pb-form-label">Slides per move</label><input class="pb-input" type="number" min="1" v-model.number="settings.perMove"></div></div>
                    <ToggleField :id="'hero-slider-autoplay-'+node.id" label="Slider Autoplay" v-model="settings.autoplay" />
                    <ToggleField :id="'hero-slider-loop-'+node.id" label="Loop Slides" v-model="settings.loop" />
                    <ToggleField :id="'hero-slider-rewind-'+node.id" label="Rewind at end" v-model="settings.rewind" />
                    <ToggleField :id="'hero-slider-hover-'+node.id" label="Pause on Hover" v-model="settings.pauseOnHover" />
                    <ToggleField :id="'hero-slider-focus-'+node.id" label="Pause on Focus" v-model="settings.pauseOnFocus" />
                    <ToggleField :id="'hero-slider-interaction-'+node.id" label="Pause on Interaction" v-model="settings.pauseOnInteraction" />
                    <ToggleField :id="'hero-slider-arrows-'+node.id" label="Arrows" v-model="settings.arrows" />
                    <ToggleField :id="'hero-slider-pagination-'+node.id" label="Pagination" v-model="settings.pagination" />
                    <ToggleField :id="'hero-slider-progress-'+node.id" label="Progress Bar" v-model="settings.progress" />
                    <ToggleField :id="'hero-slider-keyboard-'+node.id" label="Keyboard Navigation" v-model="settings.keyboard" />
                    <ToggleField :id="'hero-slider-drag-'+node.id" label="Drag" v-model="settings.drag" />
                    <ToggleField :id="'hero-slider-wheel-'+node.id" label="Mouse Wheel" v-model="settings.mouseWheel" />
                    <ToggleField :id="'hero-slider-wheel-release-'+node.id" label="Wheel release" v-model="settings.wheelRelease" />
                    <ToggleField :id="'hero-slider-lazy-'+node.id" label="Lazy-load media" v-model="settings.lazyLoad" />
                    <div class="pb-subsection-title pb-subsection-title--spaced">Pagination Position</div>
                    <div class="pb-hero-slider-grid pb-hero-slider-pagination-settings">
                        <div class="pb-form-group"><label class="pb-form-label">Horizontal Slider Position</label><select class="pb-select" :value="responsiveValue('paginationPositionHorizontal','bottom-center')" @change="setResponsive('paginationPositionHorizontal',$event.target.value)"><option v-for="position in paginationPositions" :key="'horizontal-'+position.value" :value="position.value">{{position.label}}</option></select></div>
                        <div class="pb-form-group"><label class="pb-form-label">Vertical Slider Position</label><select class="pb-select" :value="responsiveValue('paginationPositionVertical','center-right')" @change="setResponsive('paginationPositionVertical',$event.target.value)"><option v-for="position in paginationPositions" :key="'vertical-'+position.value" :value="position.value">{{position.label}}</option></select></div>
                    </div>
                    <div class="pb-form-note">Dots stay centered below horizontal slides by default and form a centered side rail for vertical slides. Choose a position independently for each direction.</div>
                    <div v-if="currentDevice!=='desktop'" class="pb-form-note">Direction overrides inherit Desktop when left empty.</div>
                </div>
            </details>

            <details class="pb-collapsible" open>
                <summary>Video Playback</summary>
                <div class="pb-collapsible-body">
                    <ToggleField :id="'hero-slider-video-autoplay-'+node.id" label="Global Video Autoplay" v-model="settings.videoAutoplay" />
