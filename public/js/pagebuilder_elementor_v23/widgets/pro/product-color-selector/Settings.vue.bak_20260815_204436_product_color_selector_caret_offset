</template>

<script>
const DeviceTabs = { props: ['editor'], template: `<div class="pb-pcs-devices"><button v-for="device in editor.responsiveDevices" :key="device.value" type="button" class="pb-seg-btn" :class="{active:editor.responsiveDevice===device.value}" :aria-pressed="editor.responsiveDevice===device.value" @click="editor.setResponsiveDevice(device.value)"><i :class="device.icon"></i><span>{{device.label}}</span></button></div>` };
const ColorField = { props: ['label', 'modelValue'], emits: ['update:modelValue'], template: `<div class="pb-form-group"><label class="pb-form-label">{{label}}</label><input class="pb-input coloris pb-coloris-input" :value="modelValue" @input="$emit('update:modelValue',$event.target.value)"></div>` };
const ToggleField = { props: { id: String, label: String, modelValue: Boolean }, emits: ['update:modelValue'], template: `<div class="pb-form-group pb-toggle-label-row pb-widget-settings__compact-toggle"><label class="pb-form-label mb-0" :for="id">{{label}}</label><div class="pb-toggle-switch-wrap"><div class="pb-toggle-wrap"><input :id="id" class="pb-toggle" type="checkbox" :checked="modelValue" @change="$emit('update:modelValue',$event.target.checked)"><label :for="id"></label></div><span class="pb-toggle-state">{{modelValue?'On':'Off'}}</span></div></div>` };
const ChoiceField = { props: ['label', 'value', 'options'], emits: ['change'], methods: { formatChoiceLabel(value) { return String(value || '').replace(/[-_]+/g, ' ').replace(/\b\w/g, character => character.toUpperCase()); } }, template: `<div class="pb-form-group"><label class="pb-form-label">{{label}}</label><div class="pb-btn-group pb-pcs-choice"><button v-for="option in options" :key="option" type="button" class="pb-seg-btn" :class="{active:value===option}" @click="$emit('change',option)">{{formatChoiceLabel(option)}}</button></div></div>` };
const ResponsiveLength = { components: { DeviceTabs }, props: ['label', 'base', 'settings', 'editor', 'fallback', 'min', 'max'], computed: { value() { return this.editor.sizeControlDisplayValue({ settings: this.settings }, this.base, this.fallback, { allowedUnits: ['px','%','em','rem','vw','vh'] }); }, unit() { return this.editor.sizeControlUnit({ settings: this.settings }, this.base, this.fallback, { allowedUnits: ['px','%','em','rem','vw','vh'] }); }, numeric() { const value = Number.parseFloat(String(this.value)); return Number.isFinite(value) ? value : 0; } }, methods: { input(event) { this.editor.onSizeControlInput({ settings: this.settings }, this.base, event, { fallback: this.fallback, allowedUnits: ['px','%','em','rem','vw','vh'] }); }, setUnit(event) { this.editor.setSizeControlUnit({ settings: this.settings }, this.base, event.target.value, { fallback: this.fallback, allowedUnits: ['px','%','em','rem','vw','vh'] }); } }, template: `<div class="pb-form-group pb-pcs-size"><label class="pb-form-label">{{label}}</label><div class="pb-range-value-row"><input class="pb-range" type="range" :min="min" :max="max" :value="numeric" @input="input"><div class="pb-value-with-unit"><input class="pb-input pb-input-compact" type="number" :min="min" :max="max" :value="numeric" @input="input"><select class="pb-mini-unit" :value="unit" @change="setUnit"><option v-for="option in ['px','%','em','rem','vw','vh']" :key="option" :value="option">{{option}}</option></select></div></div></div>` };

export default {
    name: 'ProductColorSelectorSettings',
    components: { DeviceTabs, ColorField, ToggleField, ChoiceField, ResponsiveLength },
    props: { node: { type: Object, required: true }, editor: { type: Object, required: true } },
    data() { return { expandedItemId: '', titleTags: ['h1','h2','h3','h4','h5','h6','div'], descriptionTags: ['p','div','span'], imagePositions: ['left top','left center','left bottom','center top','center center','center bottom','right top','right center','right bottom'] }; },
    computed: {
        settings() { return this.node.settings; },
        currentDevice() { const value = String(this.editor.responsiveDevice || 'desktop').toLowerCase(); return ['tablet','mobile'].includes(value) ? value : 'desktop'; },
        durationNumber() { const raw = String(this.settings.transitionDuration ?? '300').replace(/ms$/i, ''); const value = Number(raw); return Number.isFinite(value) ? value : 300; },
        responsiveAlignment() { const position = this.responsiveValue('listPosition', 'bottom'); const options = ['left','right'].includes(position) ? ['auto','top','center','bottom'] : ['auto','left','center','right']; const value = this.responsiveValue('listAlignment', 'auto'); return options.includes(value) ? value : 'auto'; },
        alignmentOptions() { return ['left','right'].includes(this.responsiveValue('listPosition', 'bottom')) ? ['auto','top','center','bottom'] : ['auto','left','center','right']; },
    },
    mounted() { if (this.settings.items?.length && !this.expandedItemId) this.expandedItemId = this.settings.items[0].id; },
    methods: {
        activeKey(base) { const suffix = this.currentDevice === 'mobile' ? 'Mobile' : (this.currentDevice === 'tablet' ? 'Tablet' : ''); return base + suffix; },
        responsiveValue(base, fallback = '') { const suffix = this.currentDevice === 'mobile' ? 'Mobile' : (this.currentDevice === 'tablet' ? 'Tablet' : ''); if (suffix && this.settings[base + suffix] !== '' && this.settings[base + suffix] != null) return this.settings[base + suffix]; return this.settings[base] === '' || this.settings[base] == null ? fallback : this.settings[base]; },
        setResponsive(base, value) { this.settings[this.activeKey(base)] = value; },
        setDuration(value) { const number = Math.max(0, Math.min(2000, Number(value) || 0)); this.settings.transitionDuration = `${number}ms`; },
        itemValue(item, base, fallback = '') { const suffix = this.currentDevice === 'mobile' ? 'Mobile' : (this.currentDevice === 'tablet' ? 'Tablet' : ''); if (suffix && item[base + suffix] !== '' && item[base + suffix] != null) return item[base + suffix]; return item[base] === '' || item[base] == null ? fallback : item[base]; },
        setItemResponsive(item, base, value) { item[this.activeKey(base)] = value; },
        chooseItemMedia(item) { this.setItemResponsive(item, 'imageSource', 'ckfinder'); this.editor.chooseMedia(item, this.activeKey('imageUrl')); },
        resetItemOverride(item) { ['imageSource','imageUrl','imageAlt'].forEach(base => { if (this.currentDevice !== 'desktop') item[this.activeKey(base)] = ''; }); },
        toggleItem(id) { this.expandedItemId = this.expandedItemId === id ? '' : id; },
        newItem(index, source = {}) { const item = { id: `product-color-${Date.now()}-${index}`, name: `Color ${index + 1}`, description: '', swatchColor: ['#f1c232','#ce3d43','#575d59'][index % 3], imageSource: 'ckfinder', imageUrl: '', imageAlt: '', imageSourceTablet: '', imageUrlTablet: '', imageAltTablet: '', imageSourceMobile: '', imageUrlMobile: '', imageAltMobile: '', ...JSON.parse(JSON.stringify(source)) }; item.id = `product-color-${Date.now()}-${index}-${Math.random().toString(36).slice(2,7)}`; return item; },
        addItem() { const item = this.newItem(this.settings.items.length); this.settings.items.push(item); this.expandedItemId = item.id; },
        duplicateItem(index) { const source = this.settings.items[index]; if (!source) return; const item = this.newItem(index, source); item.name = `${source.name || 'Color '+(index+1)} Copy`; this.settings.items.splice(index + 1, 0, item); this.expandedItemId = item.id; },
        removeItem(index) { if (this.settings.items.length <= 1) return; const removed = this.settings.items.splice(index, 1)[0]; if (this.settings.defaultItemId === removed?.id) this.settings.defaultItemId = this.settings.items[0]?.id || ''; if (this.expandedItemId === removed?.id) this.expandedItemId = this.settings.items[0]?.id || ''; },
        moveItem(index, direction) { const target = index + direction; if (target < 0 || target >= this.settings.items.length) return; const list = this.settings.items; [list[index], list[target]] = [list[target], list[index]]; },
    },
};
</script>

