            <details class="pb-collapsible" open><summary>Swatches</summary><div class="pb-collapsible-body"><ResponsiveLength label="Swatch Width" base="swatchWidth" :settings="node.settings" :editor="editor" fallback="180px" :min="80" :max="500"/><ResponsiveLength label="Swatch Height" base="swatchHeight" :settings="node.settings" :editor="editor" fallback="104px" :min="40" :max="300"/><ResponsiveLength label="Swatch Radius" base="swatchRadius" :settings="node.settings" :editor="editor" fallback="0px" :min="0" :max="100"/><ResponsiveLength label="Text Gap" base="itemTextGap" :settings="node.settings" :editor="editor" fallback="8px" :min="0" :max="40"/><ColorField label="Active Indicator Color" v-model="settings.activeIndicatorColor"/><ResponsiveLength label="Active Indicator Size" base="activeIndicatorSize" :settings="node.settings" :editor="editor" fallback="34px" :min="16" :max="80"/></div></details>
