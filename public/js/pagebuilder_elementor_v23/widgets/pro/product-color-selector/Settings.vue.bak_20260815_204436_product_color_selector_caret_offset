            <details class="pb-collapsible" open>
                <summary>Selection & Layout</summary>
                <div class="pb-collapsible-body">
                    <div class="pb-form-group"><label class="pb-form-label">Default Active Color</label><select class="pb-select" v-model="settings.defaultItemId"><option v-for="(item,index) in settings.items" :key="item.id" :value="item.id">{{item.name || 'Color '+(index+1)}}</option></select></div>
                    <DeviceTabs :editor="editor" />
                    <ChoiceField label="List Position" :value="responsiveValue('listPosition','bottom')" :options="['top','right','bottom','left']" @change="setResponsive('listPosition',$event)" />
                    <ChoiceField label="List Alignment" :value="responsiveAlignment" :options="alignmentOptions" @change="setResponsive('listAlignment',$event)" />
                    <ResponsiveLength label="List Gap" base="listGap" :settings="node.settings" :editor="editor" fallback="0px" :min="0" :max="80" />
                    <div class="pb-form-group"><label class="pb-form-label">Image Aspect Ratio</label><select class="pb-select" :value="responsiveValue('imageAspectRatio','16 / 9')" @change="setResponsive('imageAspectRatio',$event.target.value)"><option value="16 / 9">16:9</option><option value="4 / 3">4:3</option><option value="3 / 2">3:2</option><option value="1 / 1">1:1</option><option value="21 / 9">21:9</option></select></div>
                    <div class="pb-form-group"><label class="pb-form-label">Image Fit</label><select class="pb-select" :value="responsiveValue('imageFit','contain')" @change="setResponsive('imageFit',$event.target.value)"><option value="contain">Contain</option><option value="cover">Cover</option><option value="fill">Fill</option></select></div>
                    <div class="pb-form-group"><label class="pb-form-label">Image Position</label><select class="pb-select" :value="responsiveValue('imagePosition','center center')" @change="setResponsive('imagePosition',$event.target.value)"><option v-for="value in imagePositions" :key="value" :value="value">{{value}}</option></select></div>
                    <div class="pb-form-group"><label class="pb-form-label">Transition</label><select class="pb-select" v-model="settings.transition"><option value="fade">Fade</option><option value="none">None</option></select></div>
                    <div class="pb-form-group"><label class="pb-form-label">Transition Duration</label><div class="pb-number-unit"><input class="pb-input" type="number" min="0" max="2000" step="50" :value="durationNumber" @input="setDuration($event.target.value)"><span>ms</span></div></div>
