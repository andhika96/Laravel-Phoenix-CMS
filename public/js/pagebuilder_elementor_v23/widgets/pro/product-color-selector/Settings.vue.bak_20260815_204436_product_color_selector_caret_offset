                                <div class="pb-form-group"><label class="pb-form-label">Image Source</label><select class="pb-select" :value="itemValue(item,'imageSource','ckfinder')" @change="setItemResponsive(item,'imageSource',$event.target.value)"><option value="ckfinder">CKFinder / Media Library</option><option value="url">External URL</option></select></div>
                                <div class="pb-form-group"><label class="pb-form-label">Image URL</label><div class="pb-media-field" :class="{'has-action':itemValue(item,'imageSource','ckfinder')!=='url'}"><input class="pb-input" :value="itemValue(item,'imageUrl','')" @input="setItemResponsive(item,'imageUrl',$event.target.value)"><button v-if="itemValue(item,'imageSource','ckfinder')!=='url'" type="button" title="Choose image" @click="chooseItemMedia(item)"><i class="fas fa-folder-open"></i></button></div></div>
                                <div class="pb-form-group"><label class="pb-form-label">Alt Text</label><input class="pb-input" :value="itemValue(item,'imageAlt','')" @input="setItemResponsive(item,'imageAlt',$event.target.value)"></div>
                                <button v-if="currentDevice!=='desktop'" type="button" class="pb-reset-btn" @click="resetItemOverride(item)"><i class="fas fa-undo"></i> Reset Device Override</button>
