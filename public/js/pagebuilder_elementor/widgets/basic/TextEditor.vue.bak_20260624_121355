<template>
	<div :class="['basic-text-editor', customClass]" v-html="html"></div>
</template>

<script>
export default {
	name: 'BasicTextEditor',
	props: {
		item: {
			type: Object,
			required: true,
		},
	},
	computed: {
		customClass() {
			return this.item.settings?.cssClass || '';
		},
		html() {
			return this.item.settings?.html || '<p>Text editor content</p>';
		},
	},
};
</script>
