(function (registry) {
	'use strict';
	const defaults = () => ({ style: 'solid', width: '100%', thickness: 2, thicknessUnit: 'px', color: '#d0d7e6', cssClass: '' });
	registry.register({
		type: 'divider', label: 'Divider', category: 'basic', icon: 'fas fa-minus', toolbox: true,
		canvas: '/js/pagebuilder_elementor/widgets/basic/divider/Canvas.vue',
		settings: '/js/pagebuilder_elementor/widgets/basic/divider/Settings.vue',
		defaults,
		normalize(node) {
			const incoming = node.settings || {};
			node.settings = { ...defaults(), ...incoming };
			const rawThickness = String(node.settings.thickness ?? '').trim();
			const legacyUnit = rawThickness.match(/[a-z%]+$/i)?.[0]?.toLowerCase();
			if (!incoming.thicknessUnit && ['px', 'em', 'rem'].includes(legacyUnit)) node.settings.thicknessUnit = legacyUnit;
			if (typeof node.settings.thickness === 'string') {
				const numericThickness = Number.parseFloat(node.settings.thickness);
				if (Number.isFinite(numericThickness)) node.settings.thickness = numericThickness;
			}
			return node;
		},
	});
})(window.PageBuilderElementorWidgets);
