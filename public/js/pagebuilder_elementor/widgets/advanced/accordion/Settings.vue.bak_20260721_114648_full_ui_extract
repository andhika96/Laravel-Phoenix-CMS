<template>
	<div class="pb-accordion-settings pb-widget-settings pb-widget-settings--accordion">
		<div class="pb-tab-nav"><button v-for="tab in tabs" :key="tab.value" type="button" class="pb-tab-btn pb-tab-btn-icon" :class="{active:editor.settingsTab===tab.value}" @click="editor.settingsTab=tab.value"><i :class="tab.icon"></i><span>{{ tab.label }}</span></button></div>
		<div v-show="editor.settingsTab==='content'" class="pb-tab-content">
			<details class="pb-collapsible" open><summary>Layout</summary><div class="pb-collapsible-body">
				<div class="pb-form-group"><label class="pb-form-label">Items</label><component :is="editor.draggable" v-model="node.accordionItems" item-key="id" :group="{name:'pb-accordion-items',pull:false,put:false}" handle=".pb-accordion-item-drag" class="pb-accordion-items-list"><template #item="{element:item,index}"><div class="pb-accordion-item-row" :class="{active:editor.accordionRuntimeForNode(node).editingItemId===item.id}"><span class="pb-accordion-item-drag"><i class="fas fa-grip-vertical"></i></span><button type="button" class="pb-accordion-item-main" @click="editor.selectAccordionItem(node,item.id)">{{ editor.accordionItemSummary(item,index) }}</button><button type="button" class="pb-accordion-item-action" @click="editor.duplicateAccordionItem(node,item.id)"><i class="far fa-copy"></i></button><button type="button" class="pb-accordion-item-action" :disabled="editor.accordionItemsForNode(node).length<=1" @click="editor.removeAccordionItem(node,item.id)"><i class="fas fa-times"></i></button></div></template></component><button type="button" class="pb-btn pb-accordion-add-btn" @click="editor.addAccordionItem(node)"><i class="fas fa-plus"></i><span>Add Item</span></button></div>
				<div v-if="editor.accordionEditingItem(node)" class="pb-accordion-item-fields"><div class="pb-form-group"><label class="pb-form-label">Title</label><input class="pb-input" v-model="editor.accordionEditingItem(node).title"></div><div class="pb-form-group"><label class="pb-form-label">CSS ID</label><input class="pb-input" v-model="editor.accordionEditingItem(node).cssId"></div></div>
				<div class="pb-form-group"><label class="pb-form-label">Item Position</label><select class="pb-select" v-model="node.settings[editor.activeResponsiveKey('itemPosition')]"><option value="">Default</option><option v-for="value in ['start','center','end','stretch']" :key="value" :value="value">{{ value }}</option></select></div>
				<div class="pb-form-group"><label class="pb-form-label">Icon Position</label><select class="pb-select" v-model="node.settings[editor.activeResponsiveKey('iconPosition')]"><option value="">Default</option><option value="start">Start</option><option value="end">End</option></select></div>
				<IconSource label="Expand Icon" prefix="expand" :node="node" :editor="editor"/><IconSource label="Collapse Icon" prefix="collapse" :node="node" :editor="editor"/>
				<div class="pb-form-group"><label class="pb-form-label">Title HTML Tag</label><select class="pb-select" v-model="node.settings.titleTag"><option v-for="tag in ['h1','h2','h3','h4','h5','h6','div','span','p']" :key="tag" :value="tag">{{ tag.toUpperCase() }}</option></select></div>
				<div class="pb-form-group pb-toggle-label-row"><label class="pb-form-label mb-0">FAQ Schema</label><div class="pb-toggle-wrap"><input :id="'accordion-faq-'+node.id" type="checkbox" class="pb-toggle" v-model="node.settings.faqSchema"><label :for="'accordion-faq-'+node.id"></label></div></div>
			</div></details>
			<details class="pb-collapsible" open><summary>Interactions</summary><div class="pb-collapsible-body"><div class="pb-form-group"><label class="pb-form-label">Default State</label><select class="pb-select" v-model="node.settings.defaultState" @change="editor.resetAccordionRuntimeFromDefaults(node)"><option value="first-expanded">First Expanded</option><option value="all-collapsed">All Collapsed</option></select></div><div class="pb-form-group"><label class="pb-form-label">Max Items Expanded</label><select class="pb-select" v-model="node.settings.maxExpanded" @change="editor.accordionRuntimeForNode(node)"><option value="one">One</option><option value="multiple">Multiple</option></select></div><div class="pb-form-group"><label class="pb-form-label">Animation Duration <span class="pb-form-hint">{{ node.settings.animationDuration }}ms</span></label><div class="pb-range-value-row"><input type="range" class="pb-range" min="0" max="2000" step="50" v-model.number="node.settings.animationDuration"><input class="pb-input pb-input-compact" type="number" min="0" max="5000" step="50" v-model.number="node.settings.animationDuration"></div></div></div></details>
		</div>
		<div v-show="editor.settingsTab==='style'" class="pb-tab-content pb-accordion-style-settings"><details class="pb-collapsible" open><summary>All Style Options</summary><div class="pb-collapsible-body"><template v-for="field in scalarSettings" :key="field.key"><div class="pb-form-group" v-if="field.type==='boolean'"><div class="pb-toggle-label-row"><label class="pb-form-label mb-0">{{ field.label }}</label><input type="checkbox" v-model="node.settings[field.key]"></div></div><div class="pb-form-group" v-else><label class="pb-form-label">{{ field.label }}</label><input v-if="field.type==='number'" class="pb-input" type="number" v-model.number="node.settings[field.key]"><input v-else class="pb-input" v-model="node.settings[field.key]"></div></template></div></details></div>
		<div v-show="editor.settingsTab==='advanced'" class="pb-tab-content pb-accordion-advanced-settings"><component :is="editor.widgetAdvancedControls" :node="node" :responsive-device="editor.responsiveDevice" @responsive-device="editor.setResponsiveDevice" @unavailable-ai="editor.showUnsupportedControlNotice('Animate With AI','AI service is not connected to this page builder.')" /></div>
	</div>
</template>
<script>
const IconSource={props:{label:String,prefix:String,node:Object,editor:Object},computed:{sourceKey(){return this.prefix+'IconSource'},classKey(){return this.prefix+'IconClass'}},template:`<div class="pb-form-group"><label class="pb-form-label">{{label}}</label><select class="pb-select" v-model="node.settings[sourceKey]"><option value="none">None</option><option value="library">Icon Library</option><option value="svg">Upload SVG</option></select><button v-if="node.settings[sourceKey]==='library'" type="button" class="pb-btn pb-icon-source-btn" @click="editor.openAccordionIconLibrary(prefix,node)"><i :class="node.settings[classKey]"></i><span>Choose from Library</span></button><button v-if="node.settings[sourceKey]==='svg'" type="button" class="pb-btn pb-icon-source-btn" @click="editor.chooseAccordionSvg(prefix,node)"><i class="fas fa-upload"></i><span>Choose SVG</span></button></div>`};
export default{name:'AccordionWidgetSettings',components:{IconSource},props:{node:{type:Object,required:true},editor:{type:Object,required:true}},data:()=>({tabs:[{value:'content',label:'Content',icon:'fas fa-edit'},{value:'style',label:'Style',icon:'fas fa-adjust'},{value:'advanced',label:'Advanced',icon:'fas fa-gear'}]}),computed:{scalarSettings(){return Object.entries(this.node.settings||{}).filter(([,value])=>['string','number','boolean'].includes(typeof value)).map(([key,value])=>({key,type:typeof value,label:key.replace(/([A-Z])/g,' $1').replace(/^./,letter=>letter.toUpperCase())}));}}};
</script>
