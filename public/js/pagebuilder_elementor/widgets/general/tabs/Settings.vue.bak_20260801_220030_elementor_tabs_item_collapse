<script>
const DIMENSION_PATTERN = /^(-?\d+(?:\.\d+)?)(px|pt|%|em|rem|vw|vh)?$/i;
const DIMENSION_UNITS = ['px', 'pt', '%', 'em', 'rem', 'vw', 'vh'];

function parseDimension(value, fallback = '0px') {
	const fallbackMatch = String(fallback || '0px').trim().match(DIMENSION_PATTERN);
	const match = String(value || '').trim().match(DIMENSION_PATTERN);
	const unit = match?.[2] || fallbackMatch?.[2] || 'px';
	return {
		value: Number(match?.[1] ?? fallbackMatch?.[1] ?? 0),
		unit: DIMENSION_UNITS.includes(unit) ? unit : 'px',
	};
}

function expandBoxValue(value, fallback) {
	const tokens = String(value || fallback || '0px').trim().split(/\s+/).filter(Boolean);
	if (tokens.length === 1) return [tokens[0], tokens[0], tokens[0], tokens[0]];
	if (tokens.length === 2) return [tokens[0], tokens[1], tokens[0], tokens[1]];
	if (tokens.length === 3) return [tokens[0], tokens[1], tokens[2], tokens[1]];
	if (tokens.length >= 4) return tokens.slice(0, 4);
	return ['0px', '0px', '0px', '0px'];
}

function dimensionLimit(unit) {
	if (unit === '%') return 100;
	if (unit === 'em' || unit === 'rem') return 30;
	if (unit === 'vw' || unit === 'vh') return 100;
	return 400;
}

function dimensionStep(unit) {
	return unit === 'em' || unit === 'rem' ? 0.01 : 1;
}

const ResponsiveMenu = {
	props: { editor: { type: Object, required: true }, controlId: { type: String, required: true } },
	template: `<div class="pb-control-device-wrap"><button type="button" class="pb-control-device-btn" :title="'Responsive: ' + editor.responsiveDeviceLabel()" @click.stop="editor.openControlResponsiveMenu(controlId)"><i :class="editor.responsiveDeviceIcon()"></i></button><div v-if="editor.isControlResponsiveMenuOpen(controlId)" class="pb-control-device-menu"><button v-for="device in editor.responsiveDevices" :key="controlId + '-' + device.value" type="button" class="pb-control-device-item" :class="{active: editor.responsiveDevice === device.value}" @click.stop="editor.applyResponsiveDevice(controlId, device.value)"><i :class="device.icon"></i><span>{{ editor.deviceOptionLabel(device) }}</span></button></div></div>`,
};

const ResponsiveDimensionControl = {
	components: { ResponsiveMenu },
	props: { label: String, base: String, controlId: String, fallback: String, node: Object, editor: Object, min: { type: Number, default: 0 }, max: { type: Number, default: 400 } },
	computed: {
		settingKey() { return this.editor.activeResponsiveKey(this.base); },
		parsed() { return parseDimension(this.node.settings[this.settingKey], this.fallback); },
		maxValue() { return Math.min(this.max, dimensionLimit(this.parsed.unit)); },
		stepValue() { return dimensionStep(this.parsed.unit); },
	},
	methods: {
		setValue(raw) {
			const value = Number(raw);
			if (!Number.isFinite(value)) return;
			this.node.settings[this.settingKey] = `${Math.min(this.maxValue, Math.max(this.min, value))}${this.parsed.unit}`;
		},
		setUnit(unit) {
			const safeUnit = DIMENSION_UNITS.includes(unit) ? unit : 'px';
			this.node.settings[this.settingKey] = `${this.parsed.value}${safeUnit}`;
		},
	},
	template: `<div class="pb-form-group pb-tabs-dimension-control"><div class="pb-label-row pb-label-row-device"><label class="pb-form-label mb-0">{{ label }}</label><div class="pb-label-tools"><responsive-menu :editor="editor" :control-id="controlId"/><select class="pb-mini-unit" :value="parsed.unit" :aria-label="label + ' unit'" @change="setUnit($event.target.value)"><option v-for="unit in ['px','pt','%','em','rem','vw','vh']" :key="unit" :value="unit">{{ unit }}</option></select></div></div><div class="pb-range-value-row"><input class="pb-range" type="range" :min="min" :max="maxValue" :step="stepValue" :value="parsed.value" @input="setValue($event.target.value)"><input class="pb-input pb-input-compact" type="number" :min="min" :max="maxValue" :step="stepValue" :value="parsed.value" @input="setValue($event.target.value)"></div></div>`,
};

const ResponsiveBoxControl = {
	components: { ResponsiveMenu },
	props: { label: String, base: String, controlId: String, fallback: String, kind: { type: String, default: 'edges' }, node: Object, editor: Object },
	data() { return { linked: true }; },
	computed: {
		sides() { return this.kind === 'corners' ? [{key:'TL',label:'Top Left'},{key:'TR',label:'Top Right'},{key:'BR',label:'Bottom Right'},{key:'BL',label:'Bottom Left'}] : [{key:'Top',label:'Top'},{key:'Right',label:'Right'},{key:'Bottom',label:'Bottom'},{key:'Left',label:'Left'}]; },
		baseValue() { return this.node.settings[this.editor.activeResponsiveKey(this.base)] || this.node.settings[this.base] || this.fallback; },
		unit() { return this.value(0).unit; },
		maxValue() { return dimensionLimit(this.unit); },
		stepValue() { return dimensionStep(this.unit); },
	},
	methods: {
		settingKey(side) { return this.editor.activeResponsiveKey(this.base + side.key); },
		value(index) {
			const side = this.sides[index];
			const fallbackToken = expandBoxValue(this.baseValue, this.fallback)[index];
			return parseDimension(this.node.settings[this.settingKey(side)] || fallbackToken, fallbackToken);
		},
		setValue(index, raw) {
			const numeric = Number(raw);
			if (!Number.isFinite(numeric)) return;
			const safe = Math.min(this.maxValue, Math.max(0, numeric));
			if (this.linked) this.sides.forEach((side) => { this.node.settings[this.settingKey(side)] = `${safe}${this.unit}`; });
			else this.node.settings[this.settingKey(this.sides[index])] = `${safe}${this.unit}`;
		},
		setUnit(unit) {
			const safeUnit = DIMENSION_UNITS.includes(unit) ? unit : 'px';
			this.sides.forEach((side, index) => { this.node.settings[this.settingKey(side)] = `${this.value(index).value}${safeUnit}`; });
		},
	},
	template: `<div class="pb-form-group pb-tabs-box-control"><div class="pb-label-row pb-label-row-device"><label class="pb-form-label mb-0">{{ label }}</label><div class="pb-label-tools"><responsive-menu :editor="editor" :control-id="controlId"/><select class="pb-mini-unit" :value="unit" :aria-label="label + ' unit'" @change="setUnit($event.target.value)"><option v-for="option in ['px','pt','%','em','rem','vw','vh']" :key="option" :value="option">{{ option }}</option></select></div></div><div class="pb-four-sides pb-four-sides-with-link"><label v-for="(side, index) in sides" :key="side.key" class="pb-side-input"><input class="pb-input" type="number" min="0" :max="maxValue" :step="stepValue" :value="value(index).value" @input="setValue(index, $event.target.value)"><span>{{ side.label }}</span></label><div class="pb-side-link-cell"><button type="button" class="pb-link-btn" :class="{active: linked}" :title="linked ? 'Unlink values' : 'Link values'" @click="linked = !linked"><i class="fas" :class="linked ? 'fa-link' : 'fa-unlink'"></i></button></div></div></div>`,
};

export default {
	name: 'TabsWidgetSettings',
	components: { ResponsiveDimensionControl, ResponsiveBoxControl },
	props: { node: { type: Object, required: true }, editor: { type: Object, required: true } },
	data() {
		return {
			tabState: 'normal',
			tabStates: [{value:'normal',label:'Normal'},{value:'hover',label:'Hover'},{value:'active',label:'Active'}],
			borderTypes: ['none', 'solid', 'double', 'dotted', 'dashed', 'groove'],
			titleTypographyDefaults: { FontFamily:'inherit', FontSize:'14px', FontWeight:'500', TextTransform:'none', FontStyle:'normal', TextDecoration:'none', LineHeight:'1.3em', LetterSpacing:'0px', WordSpacing:'0px' },
			contentTypographyDefaults: { FontFamily:'inherit', FontSize:'16px', FontWeight:'inherit', TextTransform:'none', FontStyle:'normal', TextDecoration:'none', LineHeight:'1.5em', LetterSpacing:'0px', WordSpacing:'0px' },
		};
	},
	computed: {
		activeItem() { return this.editor.tabsActiveItem(this.node); },
	},
	methods: {
		tabStateKey(field) { return `tabs${this.tabState.charAt(0).toUpperCase()}${this.tabState.slice(1)}${field}`; },
		borderTypeLabel(type) { return type === 'none' ? 'None' : type.charAt(0).toUpperCase() + type.slice(1); },
	},
};
</script>

