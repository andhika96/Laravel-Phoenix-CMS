<template>
	<div class="pb-image-carousel" :class="rootClasses" :style="rootStyle" role="region" tabindex="0" :aria-label="settings.carouselName || 'Image Carousel'" @mouseenter="hovered=true" @mouseleave="hovered=false" @keydown.left.prevent="previous(true)" @keydown.right.prevent="next(true)">
		<div v-if="!images.length" class="pb-image-carousel__empty"><i class="far fa-images"></i><span>Add images to your carousel</span></div>
		<template v-else>
			<div class="pb-image-carousel__viewport">
				<div class="pb-image-carousel__track" :style="trackStyle">
