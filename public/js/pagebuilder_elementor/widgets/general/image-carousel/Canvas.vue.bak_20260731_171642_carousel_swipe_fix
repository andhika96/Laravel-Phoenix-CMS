						<img v-else :src="image.url" :alt="image.alt" :loading="settings.lazyload?'lazy':'eager'" :style="imageStyle">
						<figcaption v-if="captionFor(image)" class="pb-image-carousel__caption" :style="captionStyle">{{ captionFor(image) }}</figcaption>
					</figure>
				</div>
			</div>
			<button v-if="showsArrows" type="button" class="pb-image-carousel__arrow pb-image-carousel__arrow--previous" aria-label="Previous slide" :disabled="previousDisabled" data-pb-interactive="true" @click.stop="previous(true)"><i :class="settings.previousArrowIcon"></i></button>
			<button v-if="showsArrows" type="button" class="pb-image-carousel__arrow pb-image-carousel__arrow--next" aria-label="Next slide" :disabled="nextDisabled" data-pb-interactive="true" @click.stop="next(true)"><i :class="settings.nextArrowIcon"></i></button>
			<div v-if="showsDots" class="pb-image-carousel__pagination" role="tablist" aria-label="Carousel pagination"><button v-for="page in pageCount" :key="page" type="button" class="pb-image-carousel__dot" :class="{'is-active':dotIndex===page-1}" :aria-label="'Go to slide '+page" :aria-selected="dotIndex===page-1" data-pb-interactive="true" @click.stop="goTo((page-1)*slidesToScroll,true)"></button></div>
		</template>
		<div v-if="lightboxUrl" class="pb-image-carousel-lightbox" role="dialog" aria-modal="true" @click.self="lightboxUrl=''" @keydown.esc="lightboxUrl=''"><button type="button" aria-label="Close lightbox" @click="lightboxUrl=''">&times;</button><img :src="lightboxUrl" alt=""></div>
	</div>
</template>

<script>
const BORDER_TYPES=['none','solid','double','dotted','dashed','groove'];
export default{
	name: 'GeneralImageCarousel',props:{item:{type:Object,required:true},responsiveDevice:{type:String,default:'desktop'}},
	data(){return{activeIndex:0,timer:null,hovered:false,interactionPaused:false,lightboxUrl:'',resolvedImages:[],renditionRequest:0};},
	computed:{
		settings(){return this.item.settings||{};},
		customResolutionIsValid(){if(String(this.settings.imageResolution||'thumbnail')!=='custom')return true;return[this.settings.customImageWidth,this.settings.customImageHeight].every(value=>{const dimension=Number(value);return Number.isInteger(dimension)&&dimension>=1&&dimension<=4096;});},
		images(){return this.resolvedImages.length?this.resolvedImages:(Array.isArray(this.settings.images)?this.settings.images:[]).map((image,index)=>({...image,id:image.id||`image-${index}`,url:this.safeUrl(image.url)})).filter(image=>image.url);},
		visibleSlides(){const value=Number(this.responsiveValue('slidesToShow','default'));return Math.max(1,Math.min(this.images.length||1,Number.isFinite(value)&&value>0?value:Math.min(3,this.images.length||1)));},
		slidesToScroll(){const value=Number(this.responsiveValue('slidesToScroll','default'));return Math.max(1,Math.min(this.visibleSlides,Number.isFinite(value)&&value>0?value:1));},
		maxIndex(){return Math.max(0,this.images.length-this.visibleSlides);},
		pageCount(){return Math.max(1,Math.ceil(this.maxIndex/this.slidesToScroll)+1);},
		dotIndex(){return Math.min(this.pageCount-1,Math.round(this.activeIndex/this.slidesToScroll));},
		showsArrows(){return ['arrows_dots','arrows'].includes(this.settings.navigation)&&this.images.length>this.visibleSlides;},
		showsDots(){return ['arrows_dots','dots'].includes(this.settings.navigation)&&this.images.length>this.visibleSlides;},
		previousDisabled(){return !this.settings.infiniteLoop&&this.activeIndex<=0;},
		nextDisabled(){return !this.settings.infiniteLoop&&this.activeIndex>=this.maxIndex;},
		usesLightbox(){return this.settings.linkType==='media'&&this.settings.lightbox!=='no';},
		rootClasses(){return[`is-arrows-${this.settings.arrowPosition||'inside'}`,`is-pagination-${this.settings.paginationPosition||'outside'}`];},
		rootStyle(){return{'--pb-carousel-arrow-size':this.cssSize(this.responsiveValue('arrowSize','20px'),'20px'),'--pb-carousel-arrow-color':this.safeColor(this.settings.arrowColor,'#69727d'),'--pb-carousel-dot-size':this.cssSize(this.responsiveValue('dotSize','8px'),'8px'),'--pb-carousel-dot-gap':this.cssSize(this.responsiveValue('dotSpacing','8px'),'8px'),'--pb-carousel-dot-color':this.safeColor(this.settings.dotColor,'#c4c7cf'),'--pb-carousel-dot-active':this.safeColor(this.settings.dotActiveColor,'#69727d'),'--pb-carousel-image-gap':this.settings.imageSpacingMode==='custom'?this.cssSize(this.responsiveValue('imageSpacing','20px'),'20px'):'20px','--pb-carousel-transition':`${Math.max(0,Number(this.settings.animationSpeed)||0)}ms`};},
		trackStyle(){return{transform:`translate3d(-${this.activeIndex*(100/this.visibleSlides)}%,0,0)`};},
		slideStyle(){return{flex:`0 0 ${100/this.visibleSlides}%`,paddingInline:`calc(var(--pb-carousel-image-gap) / 2)`,alignSelf:({start:'flex-start',end:'flex-end'}[this.responsiveValue('imageVerticalAlign','center')]||'center')};},
		imageStyle(){const type=BORDER_TYPES.includes(this.settings.imageBorderType)?this.settings.imageBorderType:'none';const widths=this.responsiveSideValues('imageBorderWidth');const radii=this.responsiveSideValues('imageBorderRadius');const preview=this.resolutionPreviewStyle();return{width:this.settings.imageStretch?'100%':preview.width,height:this.settings.imageStretch?'auto':preview.height,objectFit:this.settings.imageStretch?'contain':preview.objectFit,borderStyle:type,borderTopWidth:type==='none'?'0':widths[0],borderRightWidth:type==='none'?'0':widths[1],borderBottomWidth:type==='none'?'0':widths[2],borderLeftWidth:type==='none'?'0':widths[3],borderColor:this.safeColor(this.settings.imageBorderColor,'transparent'),borderRadius:radii.join(' ')};},
		captionStyle(){return{color:this.safeColor(this.settings.captionColor,'inherit'),textAlign:this.responsiveValue('captionAlignment','center'),fontFamily:String(this.settings.captionFontFamily||'inherit'),fontSize:this.cssSize(this.responsiveValue('captionFontSize','16px'),'16px'),fontWeight:String(this.settings.captionFontWeight||'400'),lineHeight:this.cssSize(this.responsiveValue('captionLineHeight','1.5em'),'1.5em'),letterSpacing:this.cssSize(this.responsiveValue('captionLetterSpacing','0px'),'0px'),wordSpacing:this.cssSize(this.responsiveValue('captionWordSpacing','0px'),'0px'),textTransform:this.settings.captionTextTransform||'none',fontStyle:this.settings.captionFontStyle||'normal',textDecoration:this.settings.captionTextDecoration||'none',textShadow:String(this.settings.captionTextShadow||'none'),marginTop:this.cssSize(this.responsiveValue('captionSpacing','8px'),'8px')};},
	},
	watch:{'settings.images':{deep:true,immediate:true,handler(){this.resolveImageRenditions();}},'settings.imageResolution'(){this.resolveImageRenditions();},'settings.customImageWidth'(){this.resolveImageRenditions();},'settings.customImageHeight'(){this.resolveImageRenditions();},responsiveDevice(){this.clampIndex();},maxIndex(){this.clampIndex();},'settings.autoplay'(){this.interactionPaused=false;this.startAutoplay();},'settings.autoplaySpeed'(){this.startAutoplay();},'settings.pauseOnHover'(){this.startAutoplay();},'settings.pauseOnInteraction'(){if(!this.settings.pauseOnInteraction){this.interactionPaused=false;this.startAutoplay();}},'settings.direction'(){this.startAutoplay();},hovered(){this.startAutoplay();}},
	mounted(){this.startAutoplay();},beforeUnmount(){this.stopAutoplay();},
	methods:{
		responsiveValue(base,fallback=''){const device=['tablet','mobile'].includes(this.responsiveDevice)?this.responsiveDevice:'desktop';const keys=device==='mobile'?[base+'Mobile',base+'Tablet',base]:device==='tablet'?[base+'Tablet',base]:[base];for(const key of keys){const value=this.settings[key];if(value!==''&&value!==null&&value!==undefined)return value;}return fallback;},
		responsiveSideValues(base){return ['Top','Right','Bottom','Left'].map(side=>this.cssSize(this.responsiveValue(base+side,'0px'),'0px'));},
		safeUrl(value){const url=String(value||'').trim();return /^(https?:\/\/|\/|#)/i.test(url)&&!url.startsWith('//')?url:'';},
		safeColor(value,fallback){const raw=String(value||'').trim();return raw&&/^[#a-z0-9(),.%\s-]+$/i.test(raw)?raw:fallback;},
		cssSize(value,fallback='0px'){const raw=String(value??'').trim();return /^-?\d+(?:\.\d+)?(?:px|%|em|rem|vw|vh)?$/i.test(raw)?raw:fallback;},
		resolutionPreviewStyle(){const size=String(this.settings.imageResolution||'thumbnail');if(size==='custom'){if(!this.customResolutionIsValid)return{width:'auto',height:'auto',objectFit:'contain'};return{width:`${Number(this.settings.customImageWidth)}px`,height:`${Number(this.settings.customImageHeight)}px`,objectFit:'cover'};}const widths={thumbnail:150,medium:300,medium_large:768,large:1024,'1536x1536':1536,'2048x2048':2048};const width=widths[size];return Number.isFinite(width)?{width:`${width}px`,height:'auto',objectFit:'contain'}:{width:'auto',height:'auto',objectFit:'contain'};},
		captionFor(image){const key=this.settings.captionType;return ['title','caption','description'].includes(key)?String(image[key]||''):'';},
		linkFor(image){if(this.settings.linkType==='media')return this.safeUrl(image.url);if(this.settings.linkType==='custom')return this.safeUrl(this.settings.customLinkUrl);return'';},
		onImageClick(event,image){if(!this.usesLightbox)return;if(event)event.preventDefault();this.lightboxUrl=this.safeUrl(image.url);},
		clampIndex(){this.activeIndex=Math.max(0,Math.min(this.activeIndex,this.maxIndex));},
		goTo(index,interactive=false){let nextIndex=Number(index)||0;if(this.settings.infiniteLoop&&this.maxIndex>0){if(nextIndex>this.maxIndex)nextIndex=0;if(nextIndex<0)nextIndex=this.maxIndex;}else nextIndex=Math.max(0,Math.min(nextIndex,this.maxIndex));this.activeIndex=nextIndex;if(interactive&&this.settings.pauseOnInteraction){this.interactionPaused=true;this.stopAutoplay();}else this.startAutoplay();},
		next(interactive=false){this.goTo(this.activeIndex+this.slidesToScroll,interactive);},previous(interactive=false){this.goTo(this.activeIndex-this.slidesToScroll,interactive);},
		stopAutoplay(){if(this.timer){window.clearInterval(this.timer);this.timer=null;}},
		startAutoplay(){this.stopAutoplay();if(!this.settings.autoplay||this.maxIndex<=0||this.interactionPaused||(this.settings.pauseOnHover&&this.hovered)||window.matchMedia?.('(prefers-reduced-motion: reduce)').matches)return;this.timer=window.setInterval(()=>{this.settings.direction==='right'?this.previous(false):this.next(false);},Math.max(100,Number(this.settings.autoplaySpeed)||5000));},
		async resolveImageRenditions(){const request=++this.renditionRequest;const source=Array.isArray(this.settings.images)?this.settings.images:[];const originals=source.map((image,index)=>({...image,id:image.id||`image-${index}`,url:this.safeUrl(image.url)})).filter(image=>image.url);this.resolvedImages=originals;this.clampIndex();this.startAutoplay();if(!originals.length||!this.customResolutionIsValid)return;const endpoint=String(window.PAGE_BUILDER_ELEMENTOR_CONTEXT?.imageRenditionUrl||'');const size=String(this.settings.imageResolution||'thumbnail');const resolved=await Promise.all(originals.map(async(base)=>{if(!endpoint||!window.axios||size==='full')return base;try{const params={url:base.url,size};if(size==='custom'){params.width=this.settings.customImageWidth;params.height=this.settings.customImageHeight;}const response=await window.axios.get(endpoint,{params});return{...base,url:this.safeUrl(response.data?.url)||base.url};}catch(_){return base;}}));if(request===this.renditionRequest){this.resolvedImages=resolved.filter(image=>image.url);this.clampIndex();this.startAutoplay();}},
	},
};
</script>

<style scoped>
.pb-image-carousel{position:relative;width:100%;min-width:0;outline:none}.pb-image-carousel__empty{min-height:150px;display:grid;place-items:center;align-content:center;gap:8px;background:#eef1f4;color:#98a2b3}.pb-image-carousel__empty i{font-size:28px}.pb-image-carousel__viewport{position:relative;overflow:hidden}.pb-image-carousel__track{display:flex;align-items:stretch;transition:transform var(--pb-carousel-transition,500ms) ease;will-change:transform}.pb-image-carousel__slide{margin:0;min-width:0}.pb-image-carousel__slide img{display:block;max-width:100%;margin:auto}.pb-image-carousel__caption{padding-inline:4px}.pb-image-carousel__arrow{position:absolute;top:50%;z-index:2;transform:translateY(-50%);border:0;background:rgba(255,255,255,.8);color:var(--pb-carousel-arrow-color);font-size:var(--pb-carousel-arrow-size);width:calc(var(--pb-carousel-arrow-size) + 20px);height:calc(var(--pb-carousel-arrow-size) + 20px);border-radius:50%}.pb-image-carousel__arrow:disabled{opacity:.35;cursor:not-allowed}.pb-image-carousel__arrow--previous{left:8px}.pb-image-carousel__arrow--next{right:8px}.pb-image-carousel.is-arrows-outside{padding-inline:calc(var(--pb-carousel-arrow-size) + 24px)}.is-arrows-outside .pb-image-carousel__arrow--previous{left:0}.is-arrows-outside .pb-image-carousel__arrow--next{right:0}.pb-image-carousel__pagination{display:flex;justify-content:center;gap:var(--pb-carousel-dot-gap);padding:10px}.is-pagination-inside .pb-image-carousel__pagination{position:absolute;left:0;right:0;bottom:0;z-index:2}.pb-image-carousel__dot{width:var(--pb-carousel-dot-size);height:var(--pb-carousel-dot-size);padding:0;border:0;border-radius:50%;background:var(--pb-carousel-dot-color)}.pb-image-carousel__dot.is-active{background:var(--pb-carousel-dot-active)}.pb-image-carousel-lightbox{position:fixed;inset:0;z-index:99999;display:grid;place-items:center;background:rgba(0,0,0,.85);padding:40px}.pb-image-carousel-lightbox img{max-width:90vw;max-height:85vh}.pb-image-carousel-lightbox button{position:absolute;top:16px;right:20px;border:0;background:transparent;color:#fff;font-size:36px}@media (prefers-reduced-motion: reduce){.pb-image-carousel__track{transition:none!important}}
</style>
