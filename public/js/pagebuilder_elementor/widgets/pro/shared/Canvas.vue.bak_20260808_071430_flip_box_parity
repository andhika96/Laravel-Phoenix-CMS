                background: this.s.boxBackground || "#101828",
                color: this.s.digitColor || "#fff",
                padding: this.safeLength(this.s.boxPadding, "18px"),
                borderRadius: this.safeLength(this.s.boxRadius, "4px"),
                border:
                    this.safeLength(this.s.boxBorderWidth, "0px") +
                    " solid " +
                    (this.s.boxBorderColor || "transparent"),
