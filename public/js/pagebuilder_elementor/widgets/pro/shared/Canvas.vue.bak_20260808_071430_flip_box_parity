        flipFrontStyle() {
            return {
                background: this.s.frontBackground || "#14b8a6",
                padding: this.safeLength(this.s.frontPadding, "30px"),
                color: this.s.frontTitleColor || "#fff",
                textAlign: this.s.frontAlignment || "center",
