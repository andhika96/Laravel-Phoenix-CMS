                    }"
                >
                    {{ s.description }}
                </p>
                <span class="pb-pro-button" :style="buttonStyle">{{
                    s.buttonText
                }}</span>
            </div>
            <span
                v-if="s.showRibbon"
                class="pb-pro-cta__ribbon"
                :class="'is-' + s.ribbonPosition"
