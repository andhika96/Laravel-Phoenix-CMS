            this.startSliderAutoplay();
        },
        stopSliderAutoplay() {
            window.clearInterval(this.sliderTimer);
            this.sliderTimer = 0;
        },
        startSliderAutoplay() {
            this.stopSliderAutoplay();
            if (
                !["slides", "carousel"].includes(this.type) ||
                !this.s.autoplay ||
                this.reducedMotion ||
                this.sliderInteractionPaused ||
                (this.s.pauseOnHover && this.sliderHovered) ||
                this.maxIndex <= 0
