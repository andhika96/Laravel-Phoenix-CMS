                background: this.s.slideBackground || "#fff",
                padding: this.safeLength(this.s.slidePadding, "20px"),
                borderRadius: this.safeLength(this.s.slideRadius, "8px"),
                border:
                    this.safeLength(this.s.slideBorderWidth, "1px") +
                    " solid " +
                    (this.s.slideBorderColor || "#e4e7ec"),
                height: this.s.equalHeight ? "auto" : "max-content",
