                backgroundImage: slide.backgroundImage
                    ? `linear-gradient(#0005,#0005),url(${this.safeCssUrl(slide.backgroundImage)})`
                    : "linear-gradient(135deg,#6979f8,#8b5cf6)",
                color: "#fff",
            };
        },
        typographyStyle(
            prefix,
            size = "16px",
            weight = "400",
            lineHeight = "1.4em",
        ) {
            return {
                fontFamily: this.safeFontFamily(this.s[prefix + "FontFamily"]),
                fontSize: this.safeLength(
                    this.responsiveValue(prefix + "FontSize", size),
                    size,
