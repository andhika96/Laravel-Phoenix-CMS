                slides: "normal",
                priceTable: "normal",
                cta: "normal",
                flipBox: "normal",
            },
        };
    },
    computed: {
        type() {
            return this.node.type;
        },
        s() {
            return this.node.settings || {};
        },
        fieldTypes() {
            return [
                "text",
                "email",
                "textarea",
                "number",
                "tel",
                "url",
                "select",
                "checkbox",
                "radio",
                "date",
                "time",
                "file",
                "hidden",
            ].map((v) => option(v, v[0].toUpperCase() + v.slice(1)));
        },
        sizeOptions() {
            return [
                "extra-small",
                "small",
                "medium",
                "large",
                "extra-large",
            ].map((v) => option(v, v.replace("-", " ")));
        },
        widthOptions() {
            return [20, 25, 30, 33, 40, 50, 60, 66, 70, 75, 80, 100].map((v) =>
                option(String(v), v + "%"),
