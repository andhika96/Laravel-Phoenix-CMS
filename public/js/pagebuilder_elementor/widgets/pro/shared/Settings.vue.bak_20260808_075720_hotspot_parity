                "move-left",
                "move-right",
                "move-up",
                "move-down",
            ].map((v) => option(v));
        },
    },
    methods: {
        addItem(key) {
            const id = key + "-" + Date.now();
            const templates = {
                fields: {
                    id,
                    label: "New Field",
                    type: "text",
                    placeholder: "",
                    required: false,
                    width: 100,
                },
                slides: {
                    id,
                    title: "New Slide",
                    description: "Slide description",
                    buttonText: "Click Here",
                    linkUrl: "",
                    backgroundImage: "",
