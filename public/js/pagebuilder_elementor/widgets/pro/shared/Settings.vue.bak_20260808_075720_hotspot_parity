        },
        stepTypes() {
            return [
                "none",
                "text",
                "icon",
                "number",
                "progress",
                "number-text",
                "icon-text",
            ].map((v) => option(v));
        },
        shapeOptions() {
            return ["circle", "square", "rounded", "none"].map((v) =>
                option(v),
