    name: "ProWidgetSettings",
    props: {
        node: { type: Object, required: true },
        editor: { type: Object, required: true },
    },
    components: {
        SectionBox,
        TextControl,
        TextareaControl,
        NumberControl,
        SelectControl,
        ToggleControl,
        ColorControl,
        MediaControl,
        LinkField,
        SizeControl,
