<!doctype html>
<html lang="en">
<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<title>Page Builder Column Label Chrome Lab</title>
	<link href="../assets/plugins/fontawesome/6.5.1/css/all.min.css" rel="stylesheet">
	<style>
		:root {
			--pb-primary: #5b6cff;
			--pb-primary-soft: #eef2ff;
			--pb-text: #10203f;
			--pb-muted: #63708a;
			--pb-border: #d8e0f0;
			--pb-lavender: #e3a6ff;
			--pb-lavender-strong: #cbbdff;
			--pb-stage: #eef3fa;
			--pb-panel: #ffffff;
		}

		* {
			box-sizing: border-box;
		}

		body {
			margin: 0;
			font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
			background: var(--pb-stage);
			color: var(--pb-text);
			letter-spacing: 0;
		}

		button {
			font: inherit;
		}

		.pb-lab-shell {
			min-height: 100vh;
			display: grid;
			grid-template-rows: 64px 1fr;
		}

		.pb-lab-topbar {
			display: flex;
			align-items: center;
			justify-content: space-between;
			padding: 0 18px;
			background: #fff;
			border-bottom: 1px solid #dbe2ee;
		}

		.pb-lab-title {
			display: flex;
			align-items: center;
			gap: 12px;
			font-size: 15px;
			font-weight: 700;
		}

		.pb-brand {
			width: 32px;
			height: 32px;
			border-radius: 8px;
			display: inline-flex;
			align-items: center;
			justify-content: center;
			background: linear-gradient(135deg, #4776ff, #7957ff);
			color: #fff;
			font-weight: 800;
			font-size: 12px;
		}

		.pb-lab-actions {
			display: flex;
			align-items: center;
			gap: 10px;
		}

		.pb-btn {
			border: 1px solid #cfdaeb;
			background: #fff;
			color: #40506b;
			height: 34px;
			padding: 0 12px;
			border-radius: 7px;
			display: inline-flex;
			align-items: center;
			gap: 7px;
			cursor: pointer;
			transition: border-color 120ms ease, color 120ms ease, background-color 120ms ease;
		}

		.pb-btn:hover,
		.pb-btn.is-active {
			border-color: var(--pb-primary);
			color: #3848d9;
			background: #f7f9ff;
		}

		.pb-lab-body {
			display: grid;
			grid-template-columns: 320px 1fr;
			min-height: 0;
		}

		.pb-sidebar {
			background: #fff;
			border-right: 1px solid #dbe2ee;
			padding: 18px 14px;
			overflow: auto;
		}

		.pb-sidebar-heading {
			display: flex;
			align-items: center;
			gap: 10px;
			font-weight: 700;
			margin-bottom: 14px;
		}

		.pb-side-note {
			color: #63708a;
			font-size: 12px;
			line-height: 1.5;
			margin: 0 0 16px;
		}

		.pb-option-stack {
			display: grid;
			gap: 8px;
		}

		.pb-option {
			border: 1px solid #d6dfef;
			background: #fff;
			border-radius: 8px;
			padding: 10px;
			text-align: left;
			cursor: pointer;
		}

		.pb-option.is-active {
			border-color: var(--pb-primary);
			background: #f7f9ff;
			box-shadow: inset 3px 0 0 var(--pb-primary);
		}

		.pb-option-title {
			display: flex;
			align-items: center;
			justify-content: space-between;
			gap: 10px;
			font-size: 12px;
			font-weight: 700;
			margin-bottom: 4px;
		}

		.pb-option-text {
			font-size: 11px;
			color: #68748b;
			line-height: 1.45;
		}

		.pb-lab-fieldset {
			margin-top: 18px;
			padding-top: 16px;
			border-top: 1px solid #e1e7f2;
		}

		.pb-toggle-row {
			display: grid;
			grid-template-columns: 1fr auto;
			align-items: center;
			gap: 10px;
			font-size: 12px;
			margin-bottom: 10px;
		}

		.pb-switch {
			width: 42px;
			height: 24px;
			border: 1px solid #cfd9ea;
			border-radius: 999px;
			background: #f3f6fb;
			padding: 2px;
			cursor: pointer;
		}

		.pb-switch::before {
			content: "";
			display: block;
			width: 18px;
			height: 18px;
			border-radius: 999px;
			background: #fff;
			box-shadow: 0 2px 7px rgba(15, 23, 42, 0.2);
			transition: transform 140ms ease;
		}

		.pb-switch.is-on {
			background: #e9edff;
			border-color: #aab8ff;
		}

		.pb-switch.is-on::before {
			transform: translateX(18px);
		}

		.pb-stage-wrap {
			padding: 24px 34px 44px;
			overflow: auto;
		}

		.pb-stage-toolbar {
			width: fit-content;
			margin: 0 auto 26px;
			padding: 8px;
			display: flex;
			align-items: center;
			gap: 6px;
			border-radius: 999px;
			background: #fff;
			box-shadow: 0 14px 30px rgba(30, 45, 75, 0.11);
			border: 1px solid #e1e7f2;
		}

		.pb-device-btn {
			width: 30px;
			height: 30px;
			border: 0;
			border-radius: 999px;
			background: transparent;
			color: #61708d;
			display: inline-flex;
			align-items: center;
			justify-content: center;
			cursor: pointer;
		}

		.pb-device-btn.is-active {
			color: #3445d8;
			background: var(--pb-primary-soft);
		}

		.pb-width-pill {
			height: 30px;
			border: 0;
			border-left: 1px solid #e1e7f2;
			background: transparent;
			padding: 0 10px 0 14px;
			color: #52617b;
			font-size: 12px;
			font-weight: 700;
			display: inline-flex;
			align-items: center;
			gap: 8px;
		}

		.pb-canvas-card {
			width: min(1320px, 100%);
			min-height: 560px;
			margin: 0 auto;
			background: var(--pb-panel);
			border-radius: 6px;
			box-shadow: 0 22px 50px rgba(48, 63, 90, 0.13);
			padding: 14px;
		}

		.pb-root-followup {
			margin-top: 18px;
			min-height: 130px;
			border: 1px dashed #d4dced;
			border-radius: 10px;
			background: #fbfcff;
			display: flex;
			align-items: center;
			justify-content: center;
			color: #74819b;
			font-size: 13px;
		}

		.pb-node {
			position: relative;
			border: 1px solid transparent;
			border-radius: 8px;
			margin-bottom: 8px;
			background: transparent;
			overflow: visible;
			transition: border-color 120ms ease, box-shadow 120ms ease, background-color 120ms ease;
		}

		.pb-node.pb-node-container,
		.pb-node.pb-node-container_fluid,
		.pb-node.pb-node-grid,
		.pb-node.pb-node-row_grid {
			border-radius: 0;
		}

		.pb-node.active {
			border-color: #b3c2ec;
			box-shadow: 0 0 0 1px rgba(86, 120, 212, 0.32);
		}

		.pb-node-toolbar {
			position: absolute;
			inset: 0;
			z-index: 10;
			pointer-events: none;
			opacity: 1;
			transition: opacity 120ms ease;
		}

		.pb-node-label {
			position: absolute;
			top: -12px;
			left: 12px;
			padding: 6px 12px;
			border: 1px solid var(--pb-lavender);
			border-radius: 14px 14px 14px 4px;
			background: #fff;
			box-shadow: 0 10px 24px rgba(57, 42, 102, 0.12);
			font-size: 11px;
			font-weight: 600;
			display: inline-flex;
			align-items: center;
			gap: 7px;
			color: #6f4aa0;
			pointer-events: auto;
			cursor: pointer;
			white-space: nowrap;
		}

		.pb-node-actions {
			position: absolute;
			top: -12px;
			right: 12px;
			transform: none;
			display: inline-flex;
			flex-direction: row;
			align-items: center;
			justify-content: center;
			gap: 2px;
			padding: 4px 5px;
			border: 1px solid var(--pb-lavender);
			border-radius: 16px 16px 5px 16px;
			background: #fff;
			box-shadow: 0 10px 24px rgba(57, 42, 102, 0.12);
			pointer-events: auto;
			cursor: pointer;
		}

		.pb-node-btn {
			width: 28px;
			height: 28px;
			border: none;
			background: transparent;
			border-radius: 999px;
			font-size: 13px;
			color: #3a2f57;
			display: inline-flex;
			align-items: center;
			justify-content: center;
			cursor: pointer;
			transition: background 100ms ease;
		}

		.pb-node-btn:hover {
			background: rgba(227, 166, 255, 0.25);
		}

		.pb-node-btn.remove {
			color: #8b2340;
		}

		.pb-node-content {
			padding: 0;
			cursor: grab;
			user-select: none;
			touch-action: none;
		}

		.el-layout-container {
			display: block;
			width: 100%;
			min-height: 88px;
			box-sizing: border-box;
		}

		.el-cont-columns {
			display: flex;
			flex-direction: row;
			flex-wrap: nowrap;
			column-gap: 20px;
			width: 100%;
			min-height: inherit;
			height: 100%;
		}

		.pb-grid-col {
			border: 1px dashed #cfdbf5;
			border-radius: 0;
			background: #fff;
			padding: 8px;
			position: relative;
			display: flex;
			flex-direction: column;
			min-width: 96px;
			width: auto;
			height: auto;
			box-sizing: border-box;
			overflow: visible;
			transition: border-color 120ms ease, background-color 120ms ease;
		}

		.pb-grid-col:hover,
		.pb-grid-col.is-hovered-col {
			border-color: #dce3f2;
			background: rgba(249, 251, 255, 0.9);
		}

		.pb-grid-col.is-selected-col,
		.pb-grid-col.is-selected-col > .pb-dropzone-col {
			border-color: var(--pb-lavender-strong);
			background: #fff;
		}

		.pb-grid-col-label {
			font-size: 11px;
			color: #6f4aa0;
			margin-bottom: 0;
			padding: 6px 12px;
			font-weight: 600;
			display: flex;
			align-items: center;
			justify-content: flex-start;
			gap: 7px;
			min-height: 0;
			user-select: none;
			position: absolute;
			top: -13px;
			left: 12px;
			z-index: 9;
			border: 1px solid var(--pb-lavender);
			background: #fff;
			border-radius: 14px 14px 14px 4px;
			box-shadow: 0 10px 24px rgba(57, 42, 102, 0.12);
			opacity: 0;
			pointer-events: none;
			transform: translateY(2px);
			transition: opacity 120ms ease, transform 120ms ease, border-color 120ms ease, color 120ms ease, box-shadow 120ms ease, left 120ms ease, top 120ms ease;
		}

		.pb-grid-col-label-button {
			cursor: pointer;
		}

		.pb-grid-col-label-badge {
			width: 16px;
			height: 16px;
			border-radius: 999px;
			display: inline-flex;
			align-items: center;
			justify-content: center;
			background: var(--pb-primary-soft);
			color: #6b4ce6;
			font-size: 9px;
			flex: 0 0 auto;
		}

		.pb-grid-col-label-button.is-active {
			color: #6b4ce6;
			border-color: var(--pb-lavender-strong);
			box-shadow: 0 10px 22px rgba(107, 76, 230, 0.14);
		}

		.pb-grid-col:hover > .pb-grid-col-label,
		.pb-grid-col.is-selected-col > .pb-grid-col-label,
		.pb-grid-col.is-drag-over-col > .pb-grid-col-label,
		.pb-grid-col.is-hovered-col > .pb-grid-col-label {
			opacity: 1;
			pointer-events: auto;
			transform: translateY(-1px);
		}

		.pb-col-resizer {
			--pb-col-resizer-hit-size: 52px;
			position: absolute;
			top: -8px;
			bottom: -8px;
			right: calc((var(--pb-col-resizer-hit-size, 52px) + 20px) / -2);
			width: var(--pb-col-resizer-hit-size, 52px);
			height: auto;
			border: 0;
			border-radius: 0;
			background: transparent;
			color: #6f7e9e;
			display: inline-flex;
			align-items: center;
			justify-content: center;
			box-shadow: none;
			cursor: ew-resize;
			opacity: 1;
			pointer-events: auto;
			z-index: 8;
		}

		.pb-col-resizer::before {
			content: "";
			position: absolute;
			top: 10px;
			bottom: 10px;
			left: 50%;
			width: 2px;
			border-radius: 999px;
			background: var(--pb-lavender-strong);
			opacity: 0.32;
			transform: translateX(-50%);
		}

		.pb-col-resizer i {
			position: relative;
			width: 28px;
			height: 28px;
			border: 1px solid var(--pb-lavender-strong);
			border-radius: 999px;
			background: #fff;
			display: inline-flex;
			align-items: center;
			justify-content: center;
			box-shadow: 0 10px 20px rgba(15, 23, 42, 0.12);
			opacity: 0.78;
			pointer-events: none;
			transform: scale(1);
		}

		.pb-dropzone {
			min-height: 32px;
			border: 1px dashed transparent;
			border-radius: 8px;
			padding: 2px;
			background: transparent;
			display: flex;
			flex-direction: column;
			flex: 1 1 auto;
			transition: border-color 120ms ease, background-color 120ms ease, box-shadow 120ms ease;
		}

		.pb-dropzone-col {
			gap: 8px;
			padding: 0;
			border-radius: 0;
			position: relative;
		}

		.pb-grid-col > .pb-dropzone-col.is-empty {
			min-height: 68px;
			flex: 1 1 auto;
		}

		.pb-dropzone-col.is-sequential-locked {
			border-color: #e2e8f7;
			background: #f6f8fd;
		}

		.pb-dropzone-empty {
			font-size: 12px;
			color: #8a95ac;
			text-align: center;
			padding: 0;
			display: flex;
			flex-direction: column;
			align-items: center;
			gap: 8px;
		}

		.pb-grid-col-empty-hint {
			position: absolute;
			inset: 0;
			padding: 8px 10px;
			min-height: 100%;
			display: flex;
			flex-direction: column;
			align-items: center;
			justify-content: center;
			pointer-events: none;
			z-index: 0;
		}

		.pb-inline-add {
			border: 1px dashed #d7c8f4;
			background: #fff;
			color: #7a57b2;
			border-radius: 999px;
			height: 26px;
			padding: 0 10px;
			display: inline-flex;
			align-items: center;
			gap: 6px;
			font-size: 11px;
			font-weight: 600;
			line-height: 1;
		}

		.pb-dropzone-lock-text {
			font-size: 11px;
			font-weight: 600;
			color: #8663c5;
		}

		.pb-dropzone-empty-text {
			font-size: 12px;
			color: #8a95ac;
		}

		.pb-dropzone-col > .pb-node {
			margin-bottom: 0;
			position: relative;
			z-index: 1;
		}

		.pb-widget-preview {
			min-height: 48px;
			border: 1px solid #d9e2f0;
			background: #fff;
			display: flex;
			align-items: center;
			justify-content: center;
			color: #66748d;
			font-size: 12px;
		}

		.pb-node.is-drop-hover-node > .pb-node-content,
		.pb-grid-col.is-drag-over-col {
			border-color: #e4b4fb;
			background: #fff;
			box-shadow: 0 0 0 1px rgba(228, 180, 251, 0.34);
		}

		.lab-mode-current .pb-grid-col-label {
			top: -13px;
			left: 12px;
			padding: 6px 12px;
			box-shadow: 0 10px 24px rgba(57, 42, 102, 0.12);
		}

		.lab-mode-inset .pb-grid-col.has-flex-col-controls {
			padding-top: 30px;
		}

		.lab-mode-inset .pb-grid-col-label {
			top: 7px;
			left: 10px;
			padding: 4px 9px;
			font-size: 10px;
			border-color: #d8c8ff;
			border-radius: 11px;
			box-shadow: 0 8px 16px rgba(57, 42, 102, 0.1);
		}

		.lab-mode-inset .pb-grid-col-label-badge {
			width: 14px;
			height: 14px;
			font-size: 8px;
		}

		.lab-mode-inset .pb-grid-col.has-flex-col-controls > .pb-dropzone-col {
			padding-top: 0;
		}

		.lab-mode-inset .pb-grid-col-empty-hint {
			padding-top: 20px;
		}

		.lab-mode-rail .pb-grid-col {
			padding-left: 30px;
		}

		.lab-mode-rail .pb-grid-col-label {
			top: 9px;
			left: 7px;
			width: 22px;
			height: calc(100% - 18px);
			min-height: 48px;
			padding: 4px 0;
			border-radius: 999px;
			justify-content: center;
			box-shadow: 0 8px 18px rgba(57, 42, 102, 0.11);
		}

		.lab-mode-rail .pb-grid-col-label span:last-child {
			writing-mode: vertical-rl;
			transform: rotate(180deg);
			font-size: 9px;
			line-height: 1;
		}

		.lab-mode-rail .pb-grid-col-label-badge {
			display: none;
		}

		.lab-mode-dropzone .pb-grid-col {
			padding-top: 8px;
		}

		.lab-mode-dropzone .pb-grid-col-label {
			top: 9px;
			left: 10px;
			padding: 3px 8px;
			border-radius: 10px;
			font-size: 10px;
			box-shadow: none;
			background: rgba(255, 255, 255, 0.92);
		}

		.lab-mode-dropzone .pb-grid-col.has-flex-col-controls > .pb-dropzone-col {
			padding-top: 26px;
		}

		.lab-mode-dropzone .pb-grid-col-empty-hint {
			padding-top: 28px;
		}

		.pb-lab-status {
			margin: 14px auto 0;
			width: min(1320px, 100%);
			display: grid;
			grid-template-columns: repeat(4, minmax(0, 1fr));
			gap: 10px;
		}

		.pb-status-card {
			background: rgba(255, 255, 255, 0.72);
			border: 1px solid #dce4f1;
			border-radius: 8px;
			padding: 10px;
			font-size: 12px;
			color: #63708a;
			line-height: 1.45;
		}

		.pb-status-card strong {
			display: block;
			color: #263657;
			margin-bottom: 4px;
		}

		@media (max-width: 1100px) {
			.pb-lab-body {
				grid-template-columns: 1fr;
			}

			.pb-sidebar {
				border-right: 0;
				border-bottom: 1px solid #dbe2ee;
			}

			.pb-lab-status {
				grid-template-columns: 1fr 1fr;
			}
		}

		@media (max-width: 760px) {
			.pb-lab-topbar {
				align-items: flex-start;
				height: auto;
				padding: 14px;
				gap: 10px;
				flex-direction: column;
			}

			.pb-stage-wrap {
				padding: 18px 14px 32px;
			}

			.el-cont-columns {
				flex-direction: column;
			}

			.pb-col-resizer {
				display: none;
			}

			.pb-lab-status {
				grid-template-columns: 1fr;
			}
		}
	</style>
</head>
<body>
	<div class="pb-lab-shell">
		<header class="pb-lab-topbar">
			<div class="pb-lab-title">
				<span class="pb-brand">PB</span>
				<span>Column Label Chrome Mockup</span>
			</div>
			<div class="pb-lab-actions">
				<button class="pb-btn" type="button" id="resetBtn"><i class="fa-solid fa-rotate-left"></i> Reset</button>
				<button class="pb-btn is-active" type="button"><i class="fa-solid fa-floppy-disk"></i> Save mock choice</button>
			</div>
		</header>

		<main class="pb-lab-body">
			<aside class="pb-sidebar">
				<div class="pb-sidebar-heading">
					<i class="fa-solid fa-cube"></i>
					<span>Container label test</span>
				</div>
				<p class="pb-side-note">
					Mockup ini memakai class chrome dari page builder baru. Pilih varian, lalu klik column untuk melihat active state.
				</p>

				<div class="pb-option-stack" id="modeOptions">
					<button class="pb-option" type="button" data-mode="current">
						<span class="pb-option-title">Current overlap <i class="fa-solid fa-triangle-exclamation"></i></span>
						<span class="pb-option-text">Simulasi kondisi sekarang: Container dan Column sama-sama di top-left.</span>
					</button>
					<button class="pb-option is-active" type="button" data-mode="inset">
						<span class="pb-option-title">Inset column badge <i class="fa-solid fa-check"></i></span>
						<span class="pb-option-text">Column badge masuk sedikit ke dalam kolom. Hierarki jelas, chrome tetap ringan.</span>
					</button>
					<button class="pb-option" type="button" data-mode="rail">
						<span class="pb-option-title">Side rail badge <i class="fa-solid fa-grip-lines-vertical"></i></span>
						<span class="pb-option-text">Column jadi label vertikal kecil di kiri kolom. Sangat tidak bertabrakan.</span>
					</button>
					<button class="pb-option" type="button" data-mode="dropzone">
						<span class="pb-option-title">Dropzone header badge <i class="fa-solid fa-layer-group"></i></span>
						<span class="pb-option-text">Column badge menjadi header tipis di dalam dropzone kosong.</span>
					</button>
				</div>

				<div class="pb-lab-fieldset">
					<div class="pb-toggle-row">
						<span>Show container active</span>
						<button class="pb-switch is-on" type="button" data-toggle="containerActive" aria-label="Toggle container active"></button>
					</div>
					<div class="pb-toggle-row">
						<span>Show column hover</span>
						<button class="pb-switch is-on" type="button" data-toggle="columnHover" aria-label="Toggle column hover"></button>
					</div>
					<div class="pb-toggle-row">
						<span>Show drag over column</span>
						<button class="pb-switch" type="button" data-toggle="dragOver" aria-label="Toggle drag over"></button>
					</div>
					<div class="pb-toggle-row">
						<span>Column 1 has widget</span>
						<button class="pb-switch" type="button" data-toggle="hasWidget" aria-label="Toggle widget"></button>
					</div>
				</div>
			</aside>

			<section class="pb-stage-wrap">
				<div class="pb-stage-toolbar" aria-label="Preview toolbar">
					<button class="pb-device-btn" type="button" title="Mobile"><i class="fa-solid fa-mobile-screen-button"></i></button>
					<button class="pb-device-btn" type="button" title="Tablet"><i class="fa-solid fa-tablet-screen-button"></i></button>
					<button class="pb-device-btn is-active" type="button" title="Desktop"><i class="fa-solid fa-desktop"></i></button>
					<button class="pb-width-pill" type="button"><i class="fa-solid fa-arrows-left-right"></i> 1320px <i class="fa-solid fa-chevron-down"></i></button>
				</div>

				<div class="pb-canvas-card lab-mode-inset" id="canvas">
					<div
						class="pb-node pb-node-container active is-toolbar-visible pb-grid-outline-enabled"
						data-node-type="container"
						data-node-id="mock-container"
					>
						<div class="pb-node-toolbar">
							<div class="pb-node-label"><i class="fa-solid fa-cube"></i> Container</div>
							<div class="pb-node-actions">
								<button class="pb-node-btn" type="button" title="Structure"><i class="fa-solid fa-table-columns"></i></button>
								<button class="pb-node-btn" type="button" title="Duplicate"><i class="fa-regular fa-copy"></i></button>
								<button class="pb-node-btn remove" type="button" title="Delete"><i class="fa-solid fa-trash"></i></button>
							</div>
						</div>

						<div class="pb-node-content">
							<div class="el-layout-container">
								<div class="el-cont-columns">
									<div
										class="el-grid-col pb-grid-col has-flex-col-controls is-selected-col is-hovered-col"
										data-col-index="0"
										data-parent-node-id="mock-container"
										style="flex: 1 1 0;"
									>
										<button type="button" class="pb-grid-col-label pb-grid-col-label-button is-active" data-column="0">
											<span class="pb-grid-col-label-badge"><i class="fa-regular fa-square"></i></span>
											<span>Column 1</span>
										</button>
										<button type="button" class="pb-col-resizer" title="Drag to resize columns">
											<i class="fa-solid fa-left-right"></i>
										</button>
										<div class="pb-dropzone pb-dropzone-col is-empty" data-dropzone="0">
											<div class="pb-dropzone-empty pb-grid-col-empty-hint">
												<button type="button" class="pb-inline-add"><i class="fa-solid fa-plus"></i><span>Add</span></button>
												<div class="pb-dropzone-empty-text">Drop here</div>
											</div>
										</div>
									</div>

									<div
										class="el-grid-col pb-grid-col has-flex-col-controls"
										data-col-index="1"
										data-parent-node-id="mock-container"
										style="flex: 1 1 0;"
									>
										<button type="button" class="pb-grid-col-label pb-grid-col-label-button" data-column="1">
											<span class="pb-grid-col-label-badge"><i class="fa-regular fa-square"></i></span>
											<span>Column 2</span>
										</button>
										<div class="pb-dropzone pb-dropzone-col is-empty is-sequential-locked" data-dropzone="1">
											<div class="pb-dropzone-empty pb-grid-col-empty-hint">
												<div class="pb-dropzone-lock-text">Fill previous column first</div>
												<div class="pb-dropzone-empty-text">Locked</div>
											</div>
										</div>
									</div>
								</div>
							</div>
						</div>
					</div>

					<div class="pb-root-followup">
						<i class="fa-solid fa-plus"></i>
						<span style="margin-left: 8px;">Drag Container, Grid, or Widget here to continue building</span>
					</div>
				</div>

				<div class="pb-lab-status">
					<div class="pb-status-card"><strong>HTML parity</strong> Uses the same BuilderNode wrapper, toolbar, column label, dropzone, empty hint, and resize handle class names.</div>
					<div class="pb-status-card"><strong>CSS scope</strong> Mock changes stay in lab mode classes so production CSS can be patched surgically later.</div>
					<div class="pb-status-card"><strong>Interaction</strong> Click labels to select columns; toggles simulate hover, drag-over, active, and filled states.</div>
					<div class="pb-status-card"><strong>Safe transfer</strong> If one variant feels right, it should mainly map to `pagebuilder_elementor.css` with little or no JS change.</div>
				</div>
			</section>
		</main>
	</div>

	<script>
		(() => {
			const canvas = document.getElementById('canvas');
			const optionButtons = Array.from(document.querySelectorAll('[data-mode]'));
			const toggleButtons = Array.from(document.querySelectorAll('[data-toggle]'));
			const containerNode = document.querySelector('.pb-node-container');
			const columns = Array.from(document.querySelectorAll('.pb-grid-col'));
			const dropzones = Array.from(document.querySelectorAll('[data-dropzone]'));

			const state = {
				mode: 'inset',
				containerActive: true,
				columnHover: true,
				dragOver: false,
				hasWidget: false,
				selectedColumn: 0,
			};

			function setMode(mode) {
				state.mode = mode;
				canvas.classList.remove('lab-mode-current', 'lab-mode-inset', 'lab-mode-rail', 'lab-mode-dropzone');
				canvas.classList.add('lab-mode-' + mode);
				optionButtons.forEach((button) => {
					button.classList.toggle('is-active', button.dataset.mode === mode);
				});
			}

			function renderColumnState() {
				columns.forEach((column, index) => {
					const isSelected = index === state.selectedColumn;
					column.classList.toggle('is-selected-col', isSelected);
					column.classList.toggle('is-hovered-col', state.columnHover && isSelected);
					column.classList.toggle('is-drag-over-col', state.dragOver && isSelected);

					const label = column.querySelector('.pb-grid-col-label');
					if (label) label.classList.toggle('is-active', isSelected);
				});
			}

			function renderContainerState() {
				containerNode.classList.toggle('active', state.containerActive);
				containerNode.classList.toggle('is-toolbar-visible', state.containerActive);
			}

			function renderWidgetState() {
				const firstDropzone = dropzones[0];
				const secondDropzone = dropzones[1];

				if (!firstDropzone) return;

				if (state.hasWidget) {
					firstDropzone.classList.remove('is-empty');
					firstDropzone.innerHTML = '<div class="pb-node pb-node-widget pb-node-heading active" data-node-type="heading"><div class="pb-node-content"><div class="pb-widget-preview"><i class="fa-solid fa-heading"></i><span style="margin-left:8px;">Heading widget</span></div></div></div>';
					if (secondDropzone) {
						secondDropzone.classList.remove('is-sequential-locked');
						secondDropzone.innerHTML = '<div class="pb-dropzone-empty pb-grid-col-empty-hint"><button type="button" class="pb-inline-add"><i class="fa-solid fa-plus"></i><span>Add</span></button><div class="pb-dropzone-empty-text">Drop here</div></div>';
					}
					return;
				}

				firstDropzone.classList.add('is-empty');
				firstDropzone.innerHTML = '<div class="pb-dropzone-empty pb-grid-col-empty-hint"><button type="button" class="pb-inline-add"><i class="fa-solid fa-plus"></i><span>Add</span></button><div class="pb-dropzone-empty-text">Drop here</div></div>';
				if (secondDropzone) {
					secondDropzone.classList.add('is-sequential-locked');
					secondDropzone.innerHTML = '<div class="pb-dropzone-empty pb-grid-col-empty-hint"><div class="pb-dropzone-lock-text">Fill previous column first</div><div class="pb-dropzone-empty-text">Locked</div></div>';
				}
			}

			function syncToggles() {
				toggleButtons.forEach((button) => {
					button.classList.toggle('is-on', !!state[button.dataset.toggle]);
				});
			}

			function render() {
				setMode(state.mode);
				renderContainerState();
				renderColumnState();
				renderWidgetState();
				syncToggles();
			}

			optionButtons.forEach((button) => {
				button.addEventListener('click', () => {
					state.mode = button.dataset.mode;
					render();
				});
			});

			toggleButtons.forEach((button) => {
				button.addEventListener('click', () => {
					const key = button.dataset.toggle;
					state[key] = !state[key];
					render();
				});
			});

			document.addEventListener('click', (event) => {
				const label = event.target.closest('[data-column]');
				if (!label) return;
				state.selectedColumn = Number(label.dataset.column) || 0;
				render();
			});

			document.getElementById('resetBtn').addEventListener('click', () => {
				Object.assign(state, {
					mode: 'inset',
					containerActive: true,
					columnHover: true,
					dragOver: false,
					hasWidget: false,
					selectedColumn: 0,
				});
				render();
			});

			render();
		})();
	</script>
</body>
</html>
