.header-navigation-editor {
			--mock-content-bg: #ffffff;
			--mock-soft-bg: #f8fafc;
			--mock-border: #d8dee8;
			--mock-border-soft: #edf1f6;
			--mock-primary: #e01d24;
			--mock-primary-dark: #b9161d;
			--mock-muted: #667085;
			--mock-ink: #182230;
			--mock-heading: #101828;
			--mock-ring: rgba(224, 29, 36, .15);
			--mock-shadow-sm: 0 1px 2px rgba(16, 24, 40, .04);
			--mock-shadow-md: 0 12px 30px rgba(17, 24, 39, .08);
			--mock-shadow-lg: 0 18px 50px rgba(17, 24, 39, .12);
			--mock-sidebar-min: 380px;
			--mock-sidebar-width: 380px;
			--mock-panel-height: calc(100vh - 137px);
			--mock-control-height: 34px;
			--mock-control-font-size: 12.5px;
			--mock-label-font-size: 12px;
			--mock-label-color: #2f3f56;
			--box-input-height: 34px;
			--box-label-height: 20px;
			--header-bg: #ffffff;
			--header-text: #101828;
			--link-color: #273142;
			--link-hover: #e01d24;
			--link-hover-text: #ffffff;
			--link-focus: #c4121a;
			--link-focus-text: #ffffff;
			--link-active: #e01d24;
			--link-active-text: #ffffff;
			--link-hover-border: #e01d24;
			--link-focus-border: #c4121a;
			--link-active-border: #e01d24;
			--link-active-shadow: none;
			--transparent-header-text: #ffffff;
			--transparent-link-color: #ffffff;
			--transparent-hover-bg: #e01d24;
			--transparent-hover-text: #ffffff;
			--transparent-hover-border: #e01d24;
			--transparent-focus-bg: #c4121a;
			--transparent-focus-text: #ffffff;
			--transparent-focus-border: #c4121a;
			--transparent-active-bg: #e01d24;
			--transparent-active-text: #ffffff;
			--transparent-active-border: #e01d24;
			--scrolled-bg: #ffffff;
			--header-height: 76px;
			--header-radius: 18px 18px 18px 18px;
			--header-padding: 10px 24px 10px 24px;
			--header-container-margin-top: 0px;
			--header-container-margin-right: 0px;
			--header-container-margin-bottom: 0px;
			--header-container-margin-left: 0px;
			--nav-radius: 0px 0px 0px 0px;
		}

		.header-navigation-editor {
			margin: 0;
			color: var(--mock-ink);
			font-family: var(--ph-font-family, inherit);
			font-size: 14px;
			line-height: 1.5;
		}

		.header-navigation-editor .ph-content {
			background: var(--mock-content-bg);
			border: 1px solid var(--mock-border-soft);
			box-shadow: var(--mock-shadow-md);
		}

		.header-navigation-editor .ph-content.rounded {
			border-radius: 8px !important;
		}

		.mock-topbar {
			display: flex;
			align-items: center;
			justify-content: space-between;
			gap: 16px;
			min-height: 48px;
		}

		.mock-title {
			color: var(--mock-heading);
			font-size: 19px;
			font-weight: 800;
			margin: 0;
		}

		.mock-subtitle {
			color: var(--mock-muted);
			margin: 4px 0 0;
			font-size: 13px;
		}

		.mock-status {
			display: inline-flex;
			align-items: center;
			gap: 8px;
			border: 1px solid #f3c3c5;
			color: var(--mock-primary);
			background: #fff7f7;
			border-radius: 999px;
			padding: 8px 12px;
			font-size: 12px;
			font-weight: 700;
			white-space: nowrap;
			box-shadow: inset 0 1px 0 rgba(255, 255, 255, .7);
		}

		.mock-workspace-grid {
			display: grid;
			grid-template-columns: minmax(var(--mock-sidebar-min), var(--mock-sidebar-width)) minmax(0, 1fr);
			gap: 16px;
			align-items: start;
		}

		.mock-control-pane,
		.mock-preview-pane {
			min-width: 0;
		}

		.control-scroll {
			color: #253247;
			font-family: var(--ph-font-family, inherit);
			font-size: var(--mock-control-font-size);
			height: var(--mock-panel-height);
			line-height: 1.38;
			overflow: auto;
			scrollbar-color: #c7d0dd transparent;
			scrollbar-width: thin;
		}

		.control-scroll::-webkit-scrollbar,
		.device-stage::-webkit-scrollbar,
		.json-output::-webkit-scrollbar {
			width: 9px;
			height: 9px;
		}

		.control-scroll::-webkit-scrollbar-track,
		.device-stage::-webkit-scrollbar-track,
		.json-output::-webkit-scrollbar-track {
			background: transparent;
		}

		.control-scroll::-webkit-scrollbar-thumb,
		.device-stage::-webkit-scrollbar-thumb,
		.json-output::-webkit-scrollbar-thumb {
			background: #c7d0dd;
			border: 2px solid transparent;
			border-radius: 999px;
			background-clip: padding-box;
		}

		.header-settings-accordion {
			display: grid;
			gap: 16px;
		}

		.header-setting-group {
			margin: 0;
			border: 0;
		}

		.header-setting-summary {
			display: flex;
			align-items: center;
			justify-content: space-between;
			gap: 16px;
			padding: 0 0 12px;
			border-bottom: 1px solid var(--mock-border);
			color: #162338;
			cursor: pointer;
			list-style: none;
		}

		.header-setting-summary::-webkit-details-marker {
			display: none;
		}

		.header-setting-summary:focus-visible {
			outline: 2px solid color-mix(in srgb, var(--mock-primary) 62%, transparent);
			outline-offset: 4px;
			border-radius: 4px;
		}

		.header-setting-summary-title {
			display: inline-flex;
			align-items: center;
			gap: 9px;
			font-size: .86rem;
			font-weight: 800;
			line-height: 1.25;
		}

		.header-setting-summary-title > i {
			width: 18px;
			color: var(--mock-primary);
			text-align: center;
		}

		.header-setting-summary-chevron {
			color: #76817d;
			font-size: .9rem;
			transition: transform .18s ease;
		}

		.header-setting-group[open] .header-setting-summary-chevron {
			transform: rotate(180deg);
		}

		.header-setting-panel {
			padding: 18px 0 22px;
		}

		.header-setting-panel > .row:not(.gy-lg-4) {
			--bs-gutter-x: 12px;
			--bs-gutter-y: 16px;
		}

		.header-setting-panel .transparent-custom-fields .row {
			--bs-gutter-x: 12px;
			--bs-gutter-y: 16px;
		}

		.header-setting-panel .form-label {
			margin-bottom: 8px;
		}

		.header-setting-panel > .mb-3 {
			margin-bottom: 20px !important;
		}

		.header-setting-panel > .form-check {
			margin-bottom: 16px !important;
		}

		.form-label {
			display: block;
			font-size: var(--mock-label-font-size);
			font-weight: 600;
			line-height: 1.25;
			color: var(--mock-label-color);
			margin-bottom: 6px;
		}

		.form-control,
		.form-select {
			font-size: var(--mock-control-font-size);
			font-weight: 500;
			line-height: 1.25;
			border-color: var(--mock-border);
			border-radius: 7px;
			color: var(--mock-ink);
			box-shadow: var(--mock-shadow-sm);
			min-height: var(--mock-control-height);
			transition: border-color .18s ease, box-shadow .18s ease, background .18s ease;
		}

		.control-scroll .form-control,
		.control-scroll .form-select,
		.control-scroll .form-control-sm,
		.control-scroll .form-select-sm,
		.control-scroll .input-group-sm > .form-control,
		.control-scroll .input-group-sm > .btn {
			font-size: var(--mock-control-font-size);
			font-weight: 500;
			line-height: 1.25;
		}

		.form-control:focus,
		.form-select:focus {
			border-color: var(--mock-primary);
			box-shadow: 0 0 0 3px var(--mock-ring);
		}

		.input-group-sm > .form-control,
		.input-group-sm > .btn {
			min-height: var(--mock-control-height);
		}

		.btn-outline-danger {
			border-color: #f0b6ba;
			color: var(--mock-primary);
			background: #fff;
			box-shadow: var(--mock-shadow-sm);
		}

		.btn-outline-danger:hover,
		.btn-outline-danger:focus {
			border-color: var(--mock-primary);
			background: #fff3f4;
			color: var(--mock-primary-dark);
		}

		.form-control-color {
			width: 48px;
			min-width: 48px;
			height: 35px;
			padding: 4px;
		}

		.input-pair {
			display: grid;
			grid-template-columns: 48px 1fr;
			gap: 8px;
			align-items: center;
		}

		.coloris-control .clr-field {
			--coloris-thumbnail-radius: 5px;
			display: block;
			width: 100%;
		}

		.coloris-control .clr-field input {
			width: 100%;
			height: var(--mock-control-height);
			padding-left: 42px;
			font-size: var(--mock-control-font-size);
			border-color: var(--mock-border);
			border-radius: 7px;
			box-shadow: var(--mock-shadow-sm);
		}

		.coloris-control .clr-field button {
			left: 6px;
			right: auto;
			width: 24px;
			height: 24px;
			border-radius: var(--coloris-thumbnail-radius);
			transform: translateY(-50%);
			box-shadow: inset 0 0 0 1px rgba(16, 24, 40, .08);
		}

		.coloris-control.is-disabled,
		.form-check.is-disabled {
			opacity: .56;
		}

		.control-scroll .form-check.form-switch {
			display: flex;
			align-items: center;
			gap: 10px;
			min-height: 28px;
			padding-left: 0;
		}

		.control-scroll .form-check-input {
			flex: 0 0 auto;
			margin-left: 0;
			margin-top: 0;
		}

		.control-scroll .form-check-label {
			color: #2d3b4f;
			font-size: 13px;
			font-weight: 400;
			line-height: 1.3;
		}

		.coloris-control.is-disabled .clr-field button {
			pointer-events: none;
		}

		.link-color-control {
			display: grid;
			grid-template-columns: minmax(0, 1fr) minmax(0, 1fr) 36px;
			overflow: hidden;
			border: 1px solid var(--mock-border);
			border-radius: 8px;
			background: #fff;
			box-shadow: var(--mock-shadow-sm);
		}

		.link-color-field {
			min-width: 0;
			padding: 10px;
			border-right: 1px solid var(--mock-border-soft);
		}

		.link-color-label {
			display: block;
			margin-bottom: 8px;
			color: #667085;
			font-size: 10px;
			font-weight: 700;
			line-height: 1;
		}

		.link-color-field .coloris-control .clr-field input {
			height: 34px;
			border-radius: 6px;
			box-shadow: none;
		}

		.link-color-control .box-link-toggle {
			border-left: 1px solid var(--mock-border-soft);
		}

		.color-state-start {
			margin-top: 8px;
			padding-top: 24px;
			border-top: 1px solid var(--mock-border-soft);
		}

		.shadow-control {
			display: grid;
			gap: 12px;
			padding: 12px;
			border: 1px solid var(--mock-border);
			border-radius: 8px;
			background: #fff;
			box-shadow: var(--mock-shadow-sm);
		}

		.shadow-control-header {
			display: flex;
			align-items: center;
			justify-content: space-between;
			gap: 10px;
		}

		.shadow-control-row {
			grid-template-columns: repeat(4, minmax(0, 1fr));
			box-shadow: none;
		}

		.shadow-control-meta {
			display: grid;
			grid-template-columns: minmax(0, 1fr) auto;
			gap: 10px;
			align-items: end;
		}

		.shadow-control.is-disabled .shadow-control-row,
		.shadow-control.is-disabled .shadow-control-meta {
			opacity: .56;
		}

		.shadow-inset-check {
			min-height: 36px;
			display: flex;
			align-items: center;
			margin-bottom: 0;
			white-space: nowrap;
		}

		.transparent-color-panel {
			display: grid;
			gap: 14px;
			margin: -2px 0 14px 28px;
			padding: 12px;
			border: 1px solid var(--mock-border-soft);
			border-radius: 8px;
			background: #f8fafc;
		}

		.transparent-color-panel[hidden],
		.transparent-custom-fields[hidden] {
			display: none !important;
		}

		.transparent-custom-fields {
			display: grid;
			gap: 10px;
			padding-top: 2px;
		}

		.form-range:disabled {
			opacity: .45;
		}

		.form-check-input {
			cursor: pointer;
			border-color: #c7d0dd;
			box-shadow: var(--mock-shadow-sm);
		}

		.form-check-input:checked {
			background-color: var(--mock-primary);
			border-color: var(--mock-primary);
		}

		.form-check-input:focus {
			border-color: var(--mock-primary);
			box-shadow: 0 0 0 3px var(--mock-ring);
		}

		.form-range {
			accent-color: var(--mock-primary);
		}

		.clr-picker {
			z-index: 1100;
			border-color: #d0d5dd;
			box-shadow: 0 18px 40px rgba(16, 24, 40, .18);
		}

		.clr-picker.clr-pill {
			border-radius: 8px;
		}

		.clr-picker.clr-pill .clr-gradient {
			border-radius: 6px 0 0 6px;
		}

		.unit-control {
			display: grid;
			grid-template-columns: minmax(0, 1fr) 76px;
			gap: 8px;
			align-items: center;
		}

		.unit-control input,
		.unit-control select {
			height: var(--mock-control-height);
		}

		.number-stepper {
			display: grid;
			grid-template-columns: 30px minmax(0, 1fr) 30px;
			align-items: stretch;
			min-width: 0;
			height: var(--mock-control-height);
			border: 1px solid var(--mock-border);
			border-radius: 7px;
			background: #fff;
			overflow: hidden;
			transition: border-color .18s ease, box-shadow .18s ease;
			box-shadow: var(--mock-shadow-sm);
		}

		.number-stepper:focus-within {
			border-color: var(--mock-primary);
			box-shadow: 0 0 0 3px var(--mock-ring);
		}

		.number-stepper .form-control {
			height: calc(var(--mock-control-height) - 2px);
			border: 0;
			border-radius: 0;
			box-shadow: none;
			text-align: center;
			padding-left: 6px;
			padding-right: 6px;
			background: transparent;
		}

		.number-stepper .form-control:focus {
			box-shadow: none;
		}

		.number-stepper input[type="number"] {
			appearance: textfield;
			-moz-appearance: textfield;
		}

		.number-stepper input[type="number"]::-webkit-outer-spin-button,
		.number-stepper input[type="number"]::-webkit-inner-spin-button {
			-webkit-appearance: none;
			margin: 0;
		}

		.stepper-btn {
			display: inline-flex;
			align-items: center;
			justify-content: center;
			border: 0;
			background: #f7f9fc;
			color: #475467;
			font-size: 10px;
			transition: background .18s ease, color .18s ease;
		}

		.stepper-btn:first-child {
			border-right: 1px solid #eef2f6;
		}

		.stepper-btn:last-child {
			border-left: 1px solid #eef2f6;
		}

		.stepper-btn:hover,
		.stepper-btn:focus {
			background: #fff3f4;
			color: var(--mock-primary);
			outline: none;
		}

		.stepper-btn:active {
			background: #e4e7ec;
		}

		.box-control {
			display: grid;
			gap: 12px;
		}

		.box-control-header {
			display: flex;
			align-items: center;
			justify-content: space-between;
			gap: 8px;
		}

		.box-control-header .form-label {
			display: inline-flex;
			align-items: center;
			color: var(--mock-label-color);
			font-size: var(--mock-label-font-size);
			font-weight: 600;
			line-height: 1.2;
			margin-bottom: 0;
		}

		.box-unit-select {
			width: 64px;
			height: var(--box-input-height);
			min-height: var(--box-input-height);
			border: 1px solid var(--mock-border);
			border-radius: 7px;
			background-color: #fff;
			background-position: right 9px center;
			background-size: 10px 8px;
			box-shadow: var(--mock-shadow-sm);
			color: #273142;
			font-size: var(--mock-control-font-size);
			font-weight: 500;
			line-height: 1.2;
			padding: 4px 26px 4px 10px;
		}

		.box-unit-select:focus {
			border-color: var(--mock-primary);
			background-color: #fff;
			box-shadow: 0 0 0 2px var(--mock-ring);
		}

		.box-unit-select option {
			font-size: 13px;
		}

		.responsive-mode-control {
			position: relative;
			display: inline-flex;
			align-items: center;
			margin-left: auto;
		}

		.responsive-mode-trigger {
			display: inline-flex;
			align-items: center;
			justify-content: center;
			width: 36px;
			height: var(--box-input-height);
			border: 1px solid var(--mock-border);
			border-radius: 7px;
			background: #fff;
			color: #667085;
			font-size: 12px;
			line-height: 1;
			box-shadow: var(--mock-shadow-sm);
			transition: background .18s ease, border-color .18s ease, color .18s ease, box-shadow .18s ease;
		}

		.responsive-mode-trigger:hover,
		.responsive-mode-trigger:focus,
		.responsive-mode-control.is-open .responsive-mode-trigger {
			background: #fff;
			border-color: var(--mock-primary);
			color: var(--mock-primary);
			box-shadow: 0 0 0 2px var(--mock-ring);
			outline: 0;
		}

		.responsive-mode-trigger.has-override::after {
			position: absolute;
			top: 3px;
			right: 3px;
			width: 5px;
			height: 5px;
			content: "";
			border-radius: 50%;
			background: var(--mock-primary);
		}

		.responsive-mode-menu {
			position: absolute;
			top: calc(100% + 6px);
			right: 0;
			z-index: 35;
			display: grid;
			min-width: 154px;
			gap: 4px;
			padding: 6px;
			border: 1px solid #d4deef;
			border-radius: 8px;
			background: #fff;
			box-shadow: 0 10px 20px rgba(33, 43, 67, .12);
		}

		.responsive-mode-menu[hidden] {
			display: none;
		}

		.responsive-mode-option {
			position: relative;
			display: flex;
			align-items: center;
			gap: 8px;
			width: 100%;
			height: 30px;
			padding: 0 8px;
			border: 1px solid transparent;
			border-radius: 6px;
			background: #fff;
			color: #44546f;
			font-size: 12px;
			font-weight: 500;
			line-height: 1.15;
			text-align: left;
			white-space: nowrap;
			transition: background .18s ease, border-color .18s ease, color .18s ease;
		}

		.responsive-mode-option i {
			width: 12px;
			font-size: 12px;
			line-height: 1;
			text-align: center;
		}

		.responsive-mode-option:hover,
		.responsive-mode-option:focus {
			background: #eef3ff;
			color: #233657;
			outline: 0;
		}

		.responsive-mode-option.is-active {
			background: #e6edff;
			border-color: #b9c9f5;
			color: #213c85;
		}

		.box-control-row {
			display: grid;
			grid-template-columns: repeat(4, minmax(0, 1fr)) 30px;
			grid-template-rows: var(--box-input-height) var(--box-label-height);
			gap: 0;
			background: transparent;
			box-shadow: none;
			overflow: visible;
		}

		.box-side {
			display: contents;
		}

		.box-side-stepper {
			display: grid;
			grid-template-columns: minmax(0, 1fr);
			grid-row: 1;
			min-height: var(--box-input-height);
			min-width: 0;
			border-top: 1px solid var(--mock-border);
			border-bottom: 1px solid var(--mock-border);
			border-left: 1px solid var(--mock-border);
			background: #fff;
			box-shadow: var(--mock-shadow-sm);
		}

		.box-side:nth-child(1) .box-side-stepper,
		.box-side:nth-child(1) .box-side-label {
			grid-column: 1;
		}

		.box-side:nth-child(2) .box-side-stepper,
		.box-side:nth-child(2) .box-side-label {
			grid-column: 2;
		}

		.box-side:nth-child(3) .box-side-stepper,
		.box-side:nth-child(3) .box-side-label {
			grid-column: 3;
		}

		.box-side:nth-child(4) .box-side-stepper,
		.box-side:nth-child(4) .box-side-label {
			grid-column: 4;
		}

