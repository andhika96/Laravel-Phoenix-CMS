/* =============================================================================
   FRONTEND ELEMENTOR CSS
   Sinkron dengan struktur render frontend pagebuilder_elementor.
   ============================================================================= */

.el-page-wrapper,
.el-page-wrapper *,
.el-page-wrapper *::before,
.el-page-wrapper *::after {
	box-sizing: border-box;
}

.el-page-wrapper {
	width: 100%;
	font-family: Inter, sans-serif;
}

/* Layout: Container */
.el-layout-container,
.el-layout-container-fluid {
	width: 100%;
	box-sizing: border-box;
}

.el-cont-columns {
	width: 100%;
	box-sizing: border-box;
}

.el-cont-columns > .el-layout-container,
.el-cont-columns > .el-layout-container-fluid {
	min-width: 0;
	max-width: 100%;
	box-sizing: border-box;
}

.el-cont-columns > :not(.el-layout-container):not(.el-layout-container-fluid):not(.el-grid-col) {
	width: 100%;
	min-width: 0;
	max-width: 100%;
	box-sizing: border-box;
}

.el-cont-columns[style*="display: grid"] > .el-layout-container,
.el-cont-columns[style*="display:grid"] > .el-layout-container,
.el-cont-columns[style*="display: grid"] > .el-layout-container-fluid,
.el-cont-columns[style*="display:grid"] > .el-layout-container-fluid {
	width: 100%;
}

.el-cont-columns > .el-grid-col {
	min-width: 0;
	min-height: 0;
	box-sizing: border-box;
}

.el-cont-columns[style*="flex-direction: row"] > .el-grid-col,
.el-cont-columns[style*="flex-direction:row"] > .el-grid-col,
.el-cont-columns[style*="flex-direction: row-reverse"] > .el-grid-col,
.el-cont-columns[style*="flex-direction:row-reverse"] > .el-grid-col {
	flex: 1 1 0;
}

.el-cont-columns[style*="flex-direction: column"] > .el-grid-col,
.el-cont-columns[style*="flex-direction:column"] > .el-grid-col,
.el-cont-columns[style*="flex-direction: column-reverse"] > .el-grid-col,
.el-cont-columns[style*="flex-direction:column-reverse"] > .el-grid-col {
	flex: 0 0 auto;
	width: 100%;
}

.el-cont-columns[style*="display: grid"] > .el-grid-col,
.el-cont-columns[style*="display:grid"] > .el-grid-col {
	flex: none;
	width: 100%;
	height: auto;
	justify-self: stretch;
	align-self: stretch;
}

/* Layout: Grid */
.el-layout-grid {
	width: 100%;
	flex: 1 1 100%;
	min-width: 0;
	box-sizing: border-box;
}

.el-layout-row-grid {
	width: 100%;
	box-sizing: border-box;
}

.el-grid-columns {
	display: grid;
	width: 100%;
	box-sizing: border-box;
	align-items: stretch;
}

.el-grid-col {
	box-sizing: border-box;
	min-width: 0;
	width: 100%;
	display: flex;
	flex-direction: column;
}

/* Widgets */
.el-widget-heading {
	width: 100%;
	box-sizing: border-box;
	line-height: 1.3;
	margin: 0;
}

.el-widget-text-editor {
	width: 100%;
	box-sizing: border-box;
	line-height: 1.7;
}

.el-widget-text-editor p {
	margin: 0 0 1em;
}

.el-widget-text-editor p:last-child {
	margin-bottom: 0;
}

.el-widget-image {
	width: 100%;
	box-sizing: border-box;
	display: block;
}

.el-widget-image img {
	display: block;
	max-width: 100%;
	height: auto;
}

.el-widget-video {
	width: 100%;
	box-sizing: border-box;
}

.el-widget-video-wrapper {
	position: relative;
	width: 100%;
	overflow: hidden;
}

.el-widget-video-wrapper iframe,
.el-widget-video-wrapper video {
	position: absolute;
	top: 0;
	left: 0;
	width: 100%;
	height: 100%;
	border: none;
}

.el-video-overlay {
	position: absolute;
	inset: 0;
	border: 0;
	padding: 0;
	width: 100%;
	height: 100%;
	background-color: #111827;
	background-position: center;
	background-repeat: no-repeat;
	background-size: cover;
	display: inline-flex;
	align-items: center;
	justify-content: center;
	cursor: pointer;
}

.el-video-overlay::after {
	content: '';
	position: absolute;
	inset: 0;
	background: linear-gradient(180deg, rgba(15, 23, 42, 0.12) 0%, rgba(15, 23, 42, 0.48) 100%);
}

.el-video-overlay-play {
	position: relative;
	z-index: 1;
	width: 68px;
	height: 68px;
	border-radius: 999px;
	background: rgba(255, 255, 255, 0.92);
	box-shadow: 0 12px 28px rgba(15, 23, 42, 0.22);
}

.el-video-overlay-play::before {
	content: '';
	position: absolute;
	top: 50%;
	left: 50%;
	transform: translate(-40%, -50%);
	border-style: solid;
	border-width: 12px 0 12px 20px;
	border-color: transparent transparent transparent #111827;
}

.el-widget-icon {
	display: inline-flex;
	align-items: center;
	justify-content: flex-start;
	max-width: 100%;
	box-sizing: border-box;
}

.el-widget-icon-link {
	display: inline-flex;
	align-items: center;
	justify-content: center;
	color: #6f7f94;
	text-decoration: none;
}

.el-widget-icon-link:hover {
	color: #54657d;
	text-decoration: none;
}

.el-widget-icon > .el-widget-icon-link > i,
.el-widget-icon .el-widget-icon-box > i {
	font-size: 52px;
	line-height: 1;
}

.el-widget-icon .el-widget-icon-box {
	width: 104px;
	height: 104px;
	display: inline-flex;
	align-items: center;
	justify-content: center;
	border-radius: 999px;
}

.el-widget-icon.is-view-default .el-widget-icon-link {
	padding: 0;
}

.el-widget-icon.is-view-stacked .el-widget-icon-link {
	color: #ffffff;
}

.el-widget-icon.is-view-stacked .el-widget-icon-box {
	background: #7b8796;
}

.el-widget-icon.is-view-framed .el-widget-icon-box {
	border: 3px solid #7b8796;
	color: #7b8796;
	background: transparent;
}

.el-widget-icon.is-shape-rounded .el-widget-icon-box {
	border-radius: 18px;
}

.el-widget-icon.is-shape-square .el-widget-icon-box {
	border-radius: 0;
}

.el-widget-tabs {
	--pb-tabs-layout-direction: column;
	--pb-tabs-nav-direction: row;
	--pb-tabs-justify: flex-start;
	--pb-tabs-title-align: center;
	--pb-tabs-title-justify: center;
	--pb-tabs-gap: 8px;
	--pb-tabs-content-distance: 16px;
	--pb-tabs-nav-wrap: wrap;
	--pb-tabs-nav-overflow-x: visible;
	--pb-tabs-normal-text-color: #4f5f78;
	--pb-tabs-normal-background: #f3f5fa;
	--pb-tabs-normal-border-style: solid;
	--pb-tabs-normal-border-width: 1px;
	--pb-tabs-normal-border-color: #dde3ef;
	--pb-tabs-normal-border-radius: 0;
	--pb-tabs-normal-padding: 14px 20px;
	--pb-tabs-hover-text-color: #4f5ec9;
	--pb-tabs-hover-background: #eef1ff;
	--pb-tabs-hover-border-style: solid;
	--pb-tabs-hover-border-width: 1px;
	--pb-tabs-hover-border-color: #c9d3f3;
	--pb-tabs-hover-border-radius: 0;
	--pb-tabs-hover-padding: 14px 20px;
	--pb-tabs-active-text-color: #ffffff;
	--pb-tabs-active-background: #4f5ec9;
	--pb-tabs-active-border-style: solid;
	--pb-tabs-active-border-width: 1px;
	--pb-tabs-active-border-color: #4f5ec9;
	--pb-tabs-active-border-radius: 0;
	--pb-tabs-active-padding: 14px 20px;
	--pb-tabs-title-font-family: inherit;
	--pb-tabs-title-font-size: 14px;
	--pb-tabs-title-font-weight: 500;
	--pb-tabs-title-line-height: 1.3;
	--pb-tabs-title-letter-spacing: 0;
	--pb-tabs-title-word-spacing: 0;
	--pb-tabs-title-text-transform: none;
	--pb-tabs-title-font-style: normal;
	--pb-tabs-title-text-decoration: none;
	--pb-tabs-icon-size: 14px;
	--pb-tabs-icon-spacing: 10px;
	--pb-tabs-icon-direction: row;
	--pb-tabs-content-background: transparent;
	--pb-tabs-content-text-color: inherit;
	--pb-tabs-content-border-style: none;
	--pb-tabs-content-border-width: 0;
	--pb-tabs-content-border-color: transparent;
	--pb-tabs-content-border-radius: 0;
	--pb-tabs-content-padding: 0;
	--pb-tabs-content-font-family: inherit;
	--pb-tabs-content-font-size: 16px;
	--pb-tabs-content-font-weight: inherit;
	--pb-tabs-content-line-height: 1.5;
	--pb-tabs-content-letter-spacing: 0;
	--pb-tabs-content-word-spacing: 0;
	--pb-tabs-content-text-transform: none;
	--pb-tabs-content-font-style: normal;
	--pb-tabs-content-text-decoration: none;
	width: 100%;
	box-sizing: border-box;
	display: flex;
	flex-direction: var(--pb-tabs-layout-direction);
	min-width: 0;
	gap: var(--pb-tabs-content-distance);
}

.el-widget-tabs.is-direction-row {
	--pb-tabs-layout-direction: column;
	--pb-tabs-nav-direction: row;
}

.el-widget-tabs.is-direction-row-reverse {
	--pb-tabs-layout-direction: column-reverse;
	--pb-tabs-nav-direction: row;
}

.el-widget-tabs.is-direction-column {
	--pb-tabs-layout-direction: row;
	--pb-tabs-nav-direction: column;
	align-items: stretch;
}

.el-widget-tabs.is-direction-column-reverse {
	--pb-tabs-layout-direction: row-reverse;
	--pb-tabs-nav-direction: column;
	align-items: stretch;
}

.el-widget-tabs__nav {
	display: flex;
	flex-direction: var(--pb-tabs-nav-direction);
	justify-content: var(--pb-tabs-justify);
	flex-wrap: var(--pb-tabs-nav-wrap);
	overflow-x: var(--pb-tabs-nav-overflow-x);
	overflow-y: hidden;
	gap: var(--pb-tabs-gap);
	min-width: 0;
}

.el-widget-tabs__accordion {
	display: flex;
	flex-direction: column;
	width: 100%;
	min-width: 0;
}

.el-widget-tabs.is-direction-column .el-widget-tabs__nav,
.el-widget-tabs.is-direction-column-reverse .el-widget-tabs__nav {
	flex-direction: column;
	flex: 0 0 220px;
}

.el-widget-tabs.is-scroll-enabled.is-direction-row .el-widget-tabs__nav,
.el-widget-tabs.is-scroll-enabled.is-direction-row-reverse .el-widget-tabs__nav {
	-webkit-overflow-scrolling: touch;
	padding-bottom: 4px;
}

.el-widget-tabs__tab {
	appearance: none;
	border-style: var(--pb-tabs-normal-border-style);
	border-width: var(--pb-tabs-normal-border-width);
	border-color: var(--pb-tabs-normal-border-color);
	background: var(--pb-tabs-normal-background);
	color: var(--pb-tabs-normal-text-color);
	border-radius: var(--pb-tabs-normal-border-radius);
	padding: var(--pb-tabs-normal-padding);
	font-family: var(--pb-tabs-title-font-family);
	font-size: var(--pb-tabs-title-font-size);
	font-weight: var(--pb-tabs-title-font-weight);
	line-height: var(--pb-tabs-title-line-height);
	letter-spacing: var(--pb-tabs-title-letter-spacing);
	word-spacing: var(--pb-tabs-title-word-spacing);
	text-transform: var(--pb-tabs-title-text-transform);
	font-style: var(--pb-tabs-title-font-style);
	text-decoration: var(--pb-tabs-title-text-decoration);
	display: inline-flex;
	flex-direction: var(--pb-tabs-icon-direction);
	align-items: center;
	justify-content: var(--pb-tabs-title-justify);
	text-align: var(--pb-tabs-title-align);
	gap: var(--pb-tabs-icon-spacing);
	box-shadow: var(--pb-tabs-normal-box-shadow, none);
	text-shadow: var(--pb-tabs-normal-text-shadow, none);
	-webkit-text-stroke-width: var(--pb-tabs-normal-stroke-width, 0);
	-webkit-text-stroke-color: var(--pb-tabs-normal-stroke-color, currentColor);
	cursor: pointer;
	transition: color .25s ease, background-color .25s ease, border-color .25s ease, border-radius .25s ease, padding .25s ease;
}

.el-widget-tabs.is-justify-stretch .el-widget-tabs__tab {
	flex: 1 1 0;
}

.el-widget-tabs__tab.has-icon {
	justify-content: var(--pb-tabs-title-justify);
}

.el-widget-tabs__tab i,
.el-widget-tabs__icon-svg {
	font-size: var(--pb-tabs-icon-size);
	width: var(--pb-tabs-icon-size);
	height: var(--pb-tabs-icon-size);
	flex: 0 0 var(--pb-tabs-icon-size);
	line-height: 1;
}

.el-widget-tabs__tab i { color: var(--pb-tabs-normal-icon-color, currentColor); }
.el-widget-tabs__icon-svg { display: block; object-fit: contain; }

.el-widget-tabs__tab:hover:not(.is-active) {
	border-style: var(--pb-tabs-hover-border-style);
	border-width: var(--pb-tabs-hover-border-width);
	border-color: var(--pb-tabs-hover-border-color);
	border-radius: var(--pb-tabs-hover-border-radius);
	background: var(--pb-tabs-hover-background);
	color: var(--pb-tabs-hover-text-color);
	padding: var(--pb-tabs-hover-padding);
	box-shadow: var(--pb-tabs-hover-box-shadow, none);
	text-shadow: var(--pb-tabs-hover-text-shadow, none);
	-webkit-text-stroke-width: var(--pb-tabs-hover-stroke-width, 0);
	-webkit-text-stroke-color: var(--pb-tabs-hover-stroke-color, currentColor);
}

.el-widget-tabs__tab:hover:not(.is-active) i { color: var(--pb-tabs-hover-icon-color, currentColor); }

.el-widget-tabs__tab.is-active {
	border-style: var(--pb-tabs-active-border-style);
	border-width: var(--pb-tabs-active-border-width);
	border-color: var(--pb-tabs-active-border-color);
	border-radius: var(--pb-tabs-active-border-radius);
	background: var(--pb-tabs-active-background);
	color: var(--pb-tabs-active-text-color);
	padding: var(--pb-tabs-active-padding);
	box-shadow: var(--pb-tabs-active-box-shadow, none);
	text-shadow: var(--pb-tabs-active-text-shadow, none);
	-webkit-text-stroke-width: var(--pb-tabs-active-stroke-width, 0);
	-webkit-text-stroke-color: var(--pb-tabs-active-stroke-color, currentColor);
}

.el-widget-tabs__tab.is-active i { color: var(--pb-tabs-active-icon-color, currentColor); }

.el-widget-tabs__accordion-title {
	display: none;
	width: 100%;
	justify-content: center;
}

.el-widget-tabs__accordion-item {
	min-width: 0;
	width: 100%;
}

@media (max-width: 1024px) {
	.el-widget-tabs.is-breakpoint-tablet .el-tabs-nav {
		display: none;
	}

	.el-widget-tabs.is-breakpoint-tablet .el-widget-tabs__accordion-title {
		display: inline-flex;
	}

	.el-widget-tabs.is-breakpoint-tablet .el-widget-tabs__pane--accordion {
		padding: 0;
	}
}

@media (max-width: 767px) {
	.el-widget-tabs.is-breakpoint-mobile .el-tabs-nav {
		display: none;
	}

	.el-widget-tabs.is-breakpoint-mobile .el-widget-tabs__accordion-title {
		display: inline-flex;
	}

	.el-widget-tabs.is-breakpoint-mobile .el-widget-tabs__pane--accordion {
		padding: 0;
	}
}

.el-widget-tabs__pane {
	min-width: 0;
	width: 100%;
	box-sizing: border-box;
	border-style: var(--pb-tabs-content-border-style);
	border-width: var(--pb-tabs-content-border-width);
	border-color: var(--pb-tabs-content-border-color);
	border-radius: var(--pb-tabs-content-border-radius);
	background: var(--pb-tabs-content-background);
	color: var(--pb-tabs-content-text-color);
	padding: var(--pb-tabs-content-padding);
	font-family: var(--pb-tabs-content-font-family);
	font-size: var(--pb-tabs-content-font-size);
	font-weight: var(--pb-tabs-content-font-weight);
	line-height: var(--pb-tabs-content-line-height);
	letter-spacing: var(--pb-tabs-content-letter-spacing);
	word-spacing: var(--pb-tabs-content-word-spacing);
	text-transform: var(--pb-tabs-content-text-transform);
	font-style: var(--pb-tabs-content-font-style);
	text-decoration: var(--pb-tabs-content-text-decoration);
}

.el-widget-tabs__pane--accordion {
	padding: var(--pb-tabs-content-padding);
}

.el-widget-tabs.is-direction-column .el-widget-tabs__pane,
.el-widget-tabs.is-direction-column-reverse .el-widget-tabs__pane {
	flex: 1 1 auto;
}

.el-widget-tabs.align-title-left .el-widget-tabs__tab {
	text-align: left;
}

.el-widget-tabs.align-title-center .el-widget-tabs__tab {
	text-align: center;
}

.el-widget-tabs.align-title-right .el-widget-tabs__tab {
	text-align: right;
}

@media (max-width: 1024px) {
	.el-widget-tabs.is-breakpoint-tablet.is-direction-row,
	.el-widget-tabs.is-breakpoint-tablet.is-direction-row-reverse {
		flex-direction: column;
	}

	.el-widget-tabs.is-breakpoint-tablet.is-direction-row .el-widget-tabs__nav,
	.el-widget-tabs.is-breakpoint-tablet.is-direction-row-reverse .el-widget-tabs__nav {
		overflow-x: visible;
		flex-direction: column;
		flex-wrap: nowrap;
		gap: 0;
	}

	.el-widget-tabs.is-breakpoint-tablet.is-direction-row .el-widget-tabs__tab,
	.el-widget-tabs.is-breakpoint-tablet.is-direction-row-reverse .el-widget-tabs__tab {
		width: 100% !important;
		flex: 0 0 auto !important;
	}
}

@media (max-width: 767px) {
	.el-widget-tabs.is-breakpoint-mobile.is-direction-row,
	.el-widget-tabs.is-breakpoint-mobile.is-direction-row-reverse {
		flex-direction: column;
	}

	.el-widget-tabs.is-breakpoint-mobile.is-direction-row .el-widget-tabs__nav,
	.el-widget-tabs.is-breakpoint-mobile.is-direction-row-reverse .el-widget-tabs__nav {
		overflow-x: visible;
		flex-direction: column;
		flex-wrap: nowrap;
		gap: 0;
	}

	.el-widget-tabs.is-breakpoint-mobile.is-direction-row .el-widget-tabs__tab,
	.el-widget-tabs.is-breakpoint-mobile.is-direction-row-reverse .el-widget-tabs__tab {
		width: 100% !important;
		flex: 0 0 auto !important;
	}
}

.el-widget-button {
	box-sizing: border-box;
	display: inline-flex;
}

.el-widget-divider {
	width: 100%;
	box-sizing: border-box;
	display: flex;
	align-items: center;
}

.el-widget-divider hr {
	margin: 0;
	border: none;
	flex: 1;
}

.el-widget-spacer {
	display: block;
	width: 100%;
	box-sizing: border-box;
}

.el-flex-row-justify-item {
	width: 100%;
	max-width: 100%;
	min-width: 0;
}

.el-flex-row-justify-item > * {
	max-width: 100%;
	min-width: 0;
}

.el-flex-row-justify-item.is-shrink > .el-widget-heading {
	width: auto;
	max-width: 100%;
}

/* Advanced: responsive visibility + motion */
@media (min-width: 1025px) {
	.pb-hide-desktop {
		display: none !important;
	}
	.pb-scroll-off-desktop.pb-motion-scroll {
		will-change: auto;
		transform: none !important;
	}
	.pb-mouse-off-desktop.pb-motion-mouse {
		transition: none;
		transform: none !important;
		box-shadow: none !important;
	}
	.pb-sticky-off-desktop {
		position: relative !important;
		top: auto !important;
		bottom: auto !important;
	}
}

@media (min-width: 768px) and (max-width: 1024px) {
	.pb-hide-tablet {
		display: none !important;
	}
	.pb-scroll-off-tablet.pb-motion-scroll {
		will-change: auto;
		transform: none !important;
	}
	.pb-mouse-off-tablet.pb-motion-mouse {
		transition: none;
		transform: none !important;
		box-shadow: none !important;
	}
	.pb-sticky-off-tablet {
		position: relative !important;
		top: auto !important;
		bottom: auto !important;
	}
}

@media (max-width: 767px) {
	.pb-hide-mobile {
		display: none !important;
	}
	.pb-scroll-off-mobile.pb-motion-scroll {
		will-change: auto;
		transform: none !important;
	}
	.pb-mouse-off-mobile.pb-motion-mouse {
		transition: none;
		transform: none !important;
		box-shadow: none !important;
	}
	.pb-sticky-off-mobile {
		position: relative !important;
		top: auto !important;
		bottom: auto !important;
	}
}

.pb-motion-mouse {
	transition: transform 220ms ease, box-shadow 220ms ease;
}

.pb-motion-mouse:hover {
	transform: translateY(-2px);
	box-shadow: 0 10px 28px rgba(23, 35, 61, 0.16);
}

.pb-motion-scroll {
	will-change: transform, opacity;
}

.pb-entrance-anim {
	animation-duration: 0.7s;
	animation-fill-mode: both;
}

.pb-anim-fadeIn { animation-name: pbFadeIn; }
.pb-anim-fadeInUp { animation-name: pbFadeInUp; }
.pb-anim-fadeInDown { animation-name: pbFadeInDown; }
.pb-anim-fadeInLeft { animation-name: pbFadeInLeft; }
.pb-anim-fadeInRight { animation-name: pbFadeInRight; }
.pb-anim-zoomIn { animation-name: pbZoomIn; }
.pb-anim-slideInUp { animation-name: pbSlideInUp; }
.pb-anim-slideInDown { animation-name: pbSlideInDown; }
.pb-anim-slideInLeft { animation-name: pbSlideInLeft; }
.pb-anim-slideInRight { animation-name: pbSlideInRight; }
.pb-anim-bounceIn { animation-name: pbBounceIn; }

@keyframes pbFadeIn {
	from { opacity: 0; }
	to { opacity: 1; }
}

@keyframes pbFadeInUp {
	from { opacity: 0; transform: translate3d(0, 20px, 0); }
	to { opacity: 1; transform: translate3d(0, 0, 0); }
}

@keyframes pbFadeInDown {
	from { opacity: 0; transform: translate3d(0, -20px, 0); }
	to { opacity: 1; transform: translate3d(0, 0, 0); }
}

@keyframes pbFadeInLeft {
	from { opacity: 0; transform: translate3d(-20px, 0, 0); }
	to { opacity: 1; transform: translate3d(0, 0, 0); }
}

