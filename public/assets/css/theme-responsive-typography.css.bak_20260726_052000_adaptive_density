/*
 * Shared CMS typography contract.
 *
 * This mirrors the Bootstrap RFS output imported by File Manager V2
 * (`bootstrap/scss/vendor/rfs`). Values at and below the RFS 1.25rem
 * threshold remain stable; only display-level headings scale fluidly.
 */

:root
{
	--ph-fmv2-rfs-h1: calc(1.375rem + 1.5vw);
	--ph-fmv2-rfs-h2: calc(1.325rem + .9vw);
	--ph-fmv2-rfs-h3: calc(1.3rem + .6vw);
	--ph-fmv2-rfs-h4: calc(1.275rem + .3vw);
}

@media (min-width: 1200px)
{
	:root
	{
		--ph-fmv2-rfs-h1: 2.5rem;
		--ph-fmv2-rfs-h2: 2rem;
		--ph-fmv2-rfs-h3: 1.75rem;
		--ph-fmv2-rfs-h4: 1.5rem;
	}
}

/* Main content areas of the Arunika and Awesome Admin shells. */
body :is(.ph-content, .ph-scrollable-content, .arv7-main-side, .arv7-main-content, .arv7-content, main) :is(h1, .h1)
{
	font-size: var(--ph-fmv2-rfs-h1);
}

body :is(.ph-content, .ph-scrollable-content, .arv7-main-side, .arv7-main-content, .arv7-content, main) :is(h2, .h2)
{
	font-size: var(--ph-fmv2-rfs-h2);
}

body :is(.ph-content, .ph-scrollable-content, .arv7-main-side, .arv7-main-content, .arv7-content, main) :is(h3, .h3)
{
	font-size: var(--ph-fmv2-rfs-h3);
}

body :is(.ph-content, .ph-scrollable-content, .arv7-main-side, .arv7-main-content, .arv7-content, main) :is(h4, .h4)
{
	font-size: var(--ph-fmv2-rfs-h4);
}

/* Bootstrap overlays and expandable panels can be teleported outside main. */
body :is(.modal, .dropdown-menu, .collapse, .collapsing, .accordion) :is(h1, .h1)
{
	font-size: var(--ph-fmv2-rfs-h1);
}

body :is(.modal, .dropdown-menu, .collapse, .collapsing, .accordion) :is(h2, .h2)
{
	font-size: var(--ph-fmv2-rfs-h2);
}

body :is(.modal, .dropdown-menu, .collapse, .collapsing, .accordion) :is(h3, .h3)
{
	font-size: var(--ph-fmv2-rfs-h3);
}

body :is(.modal, .dropdown-menu, .collapse, .collapsing, .accordion) :is(h4, .h4)
{
	font-size: var(--ph-fmv2-rfs-h4);
}
