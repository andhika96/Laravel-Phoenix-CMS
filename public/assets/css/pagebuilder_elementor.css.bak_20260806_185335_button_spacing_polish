:root {
	--pb-bg: #f4f6fb;
	--pb-panel: #ffffff;
	--pb-border: #dfe5f0;
	--pb-text: #243047;
	--pb-subtle: #6f7b91;
	--pb-primary: #5b6cff;
	--pb-danger: #dc3545;
	--pb-success: #198754;
	--pb-shadow: 0 8px 24px rgba(23, 35, 61, 0.08);
}

* {
	box-sizing: border-box;
}

[v-cloak] {
	display: none;
}

body {
	margin: 0;
	font-family: Inter, sans-serif;
	color: var(--pb-text);
	background: var(--pb-bg);
}

.pb-app {
	display: flex;
	flex-direction: column;
	height: 100vh;
	min-height: 0;
}

.pb-topbar {
	height: 60px;
	padding: 0 16px;
	display: flex;
	align-items: center;
	justify-content: space-between;
	background: var(--pb-panel);
	border-bottom: 1px solid var(--pb-border);
}

.pb-brand {
	display: flex;
	align-items: center;
	gap: 10px;
	font-weight: 600;
}

.pb-brand-badge {
	width: 30px;
	height: 30px;
	border-radius: 8px;
	background: linear-gradient(135deg, #5b6cff, #39a2ff);
	color: #fff;
	display: flex;
	align-items: center;
	justify-content: center;
	font-size: 13px;
	font-weight: 700;
}

.pb-top-actions {
	display: flex;
	align-items: center;
	gap: 8px;
}

.pb-btn {
	border: 1px solid var(--pb-border);
	background: #fff;
	color: var(--pb-text);
	padding: 7px 12px;
	border-radius: 8px;
	font-size: 13px;
	font-weight: 500;
}

.pb-btn.primary {
	background: var(--pb-primary);
	border-color: var(--pb-primary);
	color: #fff;
}

.pb-btn:disabled {
	opacity: 0.75;
	cursor: not-allowed;
}

.pb-btn.primary.is-loading {
	display: inline-flex;
	align-items: center;
	justify-content: center;
	min-width: 108px;
}

.pb-btn.icon {
	width: 36px;
	height: 36px;
	padding: 0;
	display: inline-flex;
	align-items: center;
	justify-content: center;
}

.pb-main {
	display: grid;
	grid-template-columns: 320px 1fr;
	gap: 0;
	flex: 1;
	min-height: 0;
	min-width: 0;
	overflow: hidden;
}

.pb-panel {
	background: var(--pb-panel);
	min-height: 0;
	min-width: 0;
	overflow: auto;
	overscroll-behavior: contain;
}

.pb-panel.left {
	border-right: 1px solid var(--pb-border);
	padding: 12px;
	background: linear-gradient(180deg, #fbfcff 0%, #f7f9fd 100%);
}

.pb-props {
	min-height: 0;
	padding-bottom: 14px;
}

.pb-panel-title {
	font-size: 13px;
	font-weight: 700;
	text-transform: uppercase;
	letter-spacing: 0.4px;
	color: var(--pb-subtle);
	margin: 4px 0 12px;
}

.pb-section {
	margin-bottom: 20px;
}

.pb-tool-grid {
	display: grid;
	grid-template-columns: 1fr 1fr;
	gap: 8px;
}

.pb-tool-item {
	background: #f9fbff;
	border: 1px solid var(--pb-border);
	border-radius: 10px;
	padding: 10px;
	font-size: 12px;
	display: flex;
	gap: 8px;
	align-items: center;
	cursor: grab;
}

.pb-tool-item i {
	color: var(--pb-primary);
}

.pb-tabs-settings {
	display: flex;
	flex-direction: column;
	gap: 12px;
}

.pb-accordion-settings {
	display: flex;
	flex-direction: column;
	gap: 12px;
}

.pb-accordion-items-list {
	display: flex;
	flex-direction: column;
	gap: 8px;
}

.pb-accordion-item-row {
	display: grid;
	grid-template-columns: 32px minmax(0, 1fr) 38px 38px;
	border: 1px solid var(--pb-border);
	border-radius: 9px;
	overflow: hidden;
	background: #fff;
}

.pb-accordion-item-row.active {
	border-color: #aebdf7;
	box-shadow: 0 0 0 2px rgba(91, 108, 255, 0.11);
}

.pb-accordion-item-drag,
.pb-accordion-item-main,
.pb-accordion-item-action {
	min-height: 42px;
	border: 0;
	background: transparent;
	display: inline-flex;
	align-items: center;
	justify-content: center;
}

.pb-accordion-item-drag {
	cursor: grab;
	color: #7b879b;
}

.pb-accordion-item-main {
	justify-content: flex-start;
	padding: 8px 10px;
	font-size: 13px;
	color: var(--pb-text);
}

.pb-accordion-item-action {
	border-left: 1px solid var(--pb-border);
	color: #526178;
}

.pb-accordion-item-action:disabled {
	opacity: .45;
	cursor: not-allowed;
}

.pb-accordion-item-fields {
	margin-top: 12px;
	padding: 14px 12px;
	border: 1px solid #dbe3f2;
	border-radius: 10px;
	background: #fbfcff;
}

.pb-accordion-device-switcher {
	margin: 14px 0 18px;
	display: grid;
	grid-template-columns: repeat(3, minmax(0, 1fr));
	gap: 6px;
}

.pb-accordion-device-switcher .pb-device-btn {
	min-width: 0;
	padding: 8px 5px;
	font-size: 10px;
}

.pb-icon-source-btn {
	width: 100%;
	margin-top: 8px;
	justify-content: center;
	gap: 8px;
}

.pb-state-tabs {
	display: grid;
	grid-template-columns: repeat(3, minmax(0, 1fr));
	margin: 4px 0 16px;
	border: 1px solid #d5dce8;
	border-radius: 8px;
	overflow: hidden;
}

.pb-state-tabs--two {
	grid-template-columns: repeat(2, minmax(0, 1fr));
}

.pb-state-tabs button {
	min-height: 34px;
	border: 0;
	border-right: 1px solid #d5dce8;
	background: #fff;
	font-size: 11px;
	color: #526178;
}

.pb-state-tabs button:last-child {
	border-right: 0;
}

.pb-state-tabs button.active {
	background: #eef1ff;
	color: var(--pb-primary);
	font-weight: 600;
}

.pb-accordion-dimension-control .pb-label-row,
.pb-accordion-box-control .pb-label-row {
	min-height: 28px;
	margin-bottom: 8px;
}

.pb-accordion-dimension-tools {
	display: inline-flex;
	align-items: center;
	gap: 7px;
	color: #667085;
	font-size: 11px;
}

.pb-accordion-dimension-control .pb-range-value-row {
	grid-template-columns: minmax(0, 1fr) 94px;
}

.pb-accordion-box-control .pb-four-sides-with-link {
	grid-template-columns: repeat(4, minmax(0, 1fr)) 28px;
	gap: 0;
	align-items: start;
}

.pb-accordion-box-control .pb-side-input .pb-input {
	height: 30px;
	min-height: 30px;
	padding: 3px;
	border-radius: 0;
	border-right-width: 0;
}

.pb-accordion-box-control .pb-side-input:first-child .pb-input {
	border-radius: 5px 0 0 5px;
}

.pb-accordion-box-control .pb-side-link-cell {
	display: flex;
	align-items: flex-start;
}

.pb-accordion-box-control .pb-link-btn {
	width: 28px;
	height: 30px;
	border-radius: 0 5px 5px 0;
}

.pb-accordion-box-control .pb-link-btn.active {
	background: #eef1ff;
	color: var(--pb-primary);
}

.pb-widget-advanced-controls .pb-advanced-dimension-control,
.pb-widget-advanced-controls .pb-advanced-edge-control {
	min-width: 0;
	margin-bottom: 14px;
}

.pb-widget-advanced-controls .pb-advanced-control-head {
	min-height: 28px;
	display: flex;
	align-items: center;
	justify-content: space-between;
	gap: 8px;
	margin-bottom: 8px;
	font-size: 11px;
	color: #344054;
}

.pb-widget-advanced-controls .pb-advanced-control-tools {
	display: inline-flex;
	align-items: center;
	gap: 7px;
	color: #667085;
}

.pb-widget-advanced-controls .pb-advanced-control-tools .pb-mini-unit {
	width: 56px;
	min-width: 56px;
}

.pb-widget-advanced-controls .pb-advanced-dimension-control .pb-range-value-row {
	grid-template-columns: minmax(0, 1fr) 84px;
	gap: 8px;
}

.pb-widget-advanced-controls .pb-advanced-edge-fields {
	display: grid;
	grid-template-columns: repeat(4, minmax(0, 1fr)) 28px;
	gap: 0;
	align-items: start;
}

.pb-widget-advanced-controls .pb-advanced-edge-fields label {
	min-width: 0;
	display: flex;
	flex-direction: column;
	align-items: center;
	gap: 4px;
}

.pb-widget-advanced-controls .pb-advanced-edge-fields .pb-input {
	min-width: 0;
	height: 30px;
	padding: 3px;
	border-radius: 0;
	border-right-width: 0;
	text-align: center;
	font-size: 11px;
}

.pb-widget-advanced-controls .pb-advanced-edge-fields label:first-child .pb-input {
	border-radius: 5px 0 0 5px;
}

.pb-widget-advanced-controls .pb-advanced-edge-fields label span {
	color: #7a8699;
	font-size: 9px;
}

.pb-widget-advanced-controls .pb-advanced-edge-fields .pb-link-btn {
	width: 28px;
	height: 30px;
	border-radius: 0 5px 5px 0;
}

.pb-widget-advanced-controls .pb-advanced-edge-fields .pb-link-btn.active {
	background: #eef1ff;
	color: var(--pb-primary);
}

.pb-subsection-title {
	margin: 2px 0 12px;
	font-size: 12px;
	font-weight: 700;
	color: #26344b;
}

.pb-inline-fields {
	display: grid;
	grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
	gap: 8px;
}

.pb-tabs-items-list {
	display: flex;
	flex-direction: column;
	gap: 8px;
}

.pb-tabs-item-row {
	display: grid;
	grid-template-columns: minmax(0, 1fr) auto auto;
	gap: 0;
	border: 1px solid var(--pb-border);
	border-radius: 10px;
	overflow: hidden;
	background: #ffffff;
}

.pb-tabs-item-row.active {
	border-color: #bdc9f0;
	box-shadow: 0 0 0 1px rgba(91, 108, 255, 0.12);
}

.pb-tabs-item-main,
.pb-tabs-item-action,
.pb-tabs-add-btn {
	appearance: none;
}

.pb-tabs-item-main {
	border: 0;
	background: transparent;
	padding: 12px 14px;
	text-align: left;
	font-size: 13px;
	font-weight: 500;
	color: var(--pb-text);
}

.pb-tabs-item-action {
	width: 40px;
	border: 0;
	border-left: 1px solid var(--pb-border);
	background: #ffffff;
	color: #5c6980;
	display: inline-flex;
	align-items: center;
	justify-content: center;
}

.pb-tabs-item-action:disabled {
	opacity: 0.45;
	cursor: not-allowed;
}

.pb-tabs-add-btn {
	margin-top: 12px;
	display: inline-flex;
	align-items: center;
	gap: 8px;
}

.pb-tabs-item-fields {
	padding: 12px;
	border: 1px solid var(--pb-border);
	border-radius: 10px;
	background: #fbfcff;
}

.pb-preview-tabs .pb-preview-inner {
	width: 100%;
}

.pb-preview-accordion .pb-preview-inner,
.pb-preview-accordion .el-widget-accordion {
	width: 100%;
}

.pb-preview-accordion .el-widget-accordion__item {
	box-sizing: border-box;
}

.pb-preview-accordion .el-widget-accordion__header {
	appearance: none;
	width: 100%;
	min-height: 58px;
	padding: 14px 16px;
	border: 0;
	background: transparent;
	display: flex;
	align-items: center;
	gap: 12px;
	color: #1f2937;
	text-align: left;
}

.pb-preview-accordion .el-widget-accordion__title {
	flex: 1 1 auto;
	margin: 0;
	font: inherit;
}

.pb-preview-accordion .el-widget-accordion__panel-inner {
	min-height: 1px;
}

.pb-dropzone-accordion {
	min-height: 168px;
	padding: 18px;
	border-top: 1px solid #e4e8ef;
}

.pb-accordion-empty-hint {
	gap: 10px;
}

.pb-dropzone-tab {
	margin-top: 0;
	min-height: 168px;
	padding: 18px;
}

.pb-tabs-empty-hint {
	gap: 10px;
}

.pb-panel.left .pb-tabs-settings.pb-widget-settings {
	padding-top: 2px;
	gap: 0;
}

.pb-panel.left .pb-tabs-settings .pb-collapsible {
	margin: 0 0 16px;
	padding: 0 0 16px;
	border: 0;
	border-bottom: 1px solid #e6ebf4;
	background: transparent;
}

.pb-panel.left .pb-tabs-settings .pb-collapsible:last-child {
	margin-bottom: 0;
	padding-bottom: 0;
	border-bottom: 0;
}

.pb-panel.left .pb-tabs-settings .pb-collapsible summary {
	padding: 0 0 12px;
	font-size: 14px;
	font-weight: 600;
	line-height: 1.3;
	color: #233047;
}

.pb-panel.left .pb-tabs-settings .pb-collapsible-body {
	padding: 2px 0 0;
}

.pb-panel.left .pb-tabs-settings .pb-form-group {
	margin-bottom: 18px;
}

.pb-panel.left .pb-tabs-settings .pb-form-group:last-child {
	margin-bottom: 0;
}

.pb-panel.left .pb-tabs-settings .pb-form-label {
	margin-bottom: 7px;
	font-size: 12px;
	font-weight: 500;
	line-height: 1.35;
	letter-spacing: 0.01em;
	color: #384557;
}

.pb-panel.left .pb-tabs-settings .pb-input,
.pb-panel.left .pb-tabs-settings .pb-select,
.pb-panel.left .pb-tabs-settings .pb-mini-unit {
	min-height: 32px;
	padding: 7px 10px;
	font-size: 12px;
	border-radius: 7px;
	border-color: #cfd6e3;
	background: #ffffff;
	color: #273245;
	box-shadow: none;
}

.pb-panel.left .pb-tabs-settings .pb-label-row {
	align-items: center;
	gap: 6px;
	margin-bottom: 7px;
}

.pb-panel.left .pb-tabs-settings .pb-label-row > .pb-form-label {
	margin-bottom: 0;
	color: #394862;
}

.pb-panel.left .pb-tabs-settings .pb-tabs-items-list {
	gap: 10px;
}

.pb-panel.left .pb-tabs-settings .pb-tabs-item-row {
	border-color: #d6deee;
	border-radius: 9px;
	box-shadow: 0 1px 2px rgba(31, 45, 71, 0.03);
}

.pb-panel.left .pb-tabs-settings .pb-tabs-item-row.active {
	border-color: #aebdf7;
	box-shadow: 0 0 0 2px rgba(91, 108, 255, 0.11);
}

.pb-panel.left .pb-tabs-settings .pb-tabs-item-main {
	min-height: 42px;
	padding: 10px 13px;
	font-size: 13px;
	font-weight: 400;
}

.pb-panel.left .pb-tabs-settings .pb-tabs-item-action {
	width: 40px;
	min-height: 42px;
	border-left-color: #d6deee;
	color: #526178;
}

.pb-panel.left .pb-tabs-settings .pb-tabs-add-btn {
	margin-top: 14px;
	min-height: 34px;
	border-radius: 8px;
	font-weight: 500;
}

.pb-panel.left .pb-tabs-settings .pb-tabs-item-fields {
	padding: 14px 12px;
	border-color: #dbe3f2;
	border-radius: 10px;
	background: #fbfcff;
}

.pb-panel.left .pb-tabs-settings .pb-tabs-item-fields + .pb-form-group {
	margin-top: 20px;
}

.pb-panel.left .pb-tabs-settings .pb-seg-group {
	display: inline-flex;
	align-items: center;
	flex-wrap: wrap;
	gap: 7px;
}

.pb-panel.left .pb-tabs-settings .pb-seg-group .pb-seg-btn {
	flex: 0 0 30px;
	width: 30px;
	min-width: 30px;
	margin: 0;
}

.pb-panel.left .pb-tabs-settings .pb-value-with-unit {
	grid-template-columns: minmax(0, 1fr) 56px;
	gap: 6px;
}

.pb-panel.left .pb-tabs-settings .pb-tabs-width-control .pb-range-value-row {
	grid-template-columns: minmax(0, 1fr) 128px;
	gap: 10px;
}

.pb-panel.left .pb-tabs-settings .pb-tabs-width-control .pb-value-with-unit {
	grid-template-columns: minmax(0, 1fr) 54px;
	gap: 6px;
}

.pb-panel.left .pb-tabs-settings .pb-form-note {
	margin-top: 7px;
	font-size: 11px;
	line-height: 1.55;
	color: #707c92;
	font-style: italic;
}

.pb-preview-tabs .el-widget-tabs.is-accordion-preview {
	gap: 0;
}

.pb-preview-tabs .el-widget-tabs.is-accordion-preview .el-widget-tabs__accordion {
	display: flex;
	flex-direction: column;
	width: 100%;
}

.pb-preview-tabs .el-widget-tabs.is-accordion-preview .el-widget-tabs__accordion-title {
	width: 100% !important;
	flex: 0 0 auto !important;
	justify-content: center;
}

.pb-preview-tabs .el-widget-tabs.is-accordion-preview .el-widget-tabs__pane--accordion {
	padding: 0;
}

.pb-canvas.is-tablet .el-widget-tabs.is-breakpoint-tablet.is-direction-row .el-widget-tabs__nav,
.pb-canvas.is-tablet .el-widget-tabs.is-breakpoint-tablet.is-direction-row-reverse .el-widget-tabs__nav,
.pb-canvas.is-mobile .el-widget-tabs.is-breakpoint-tablet.is-direction-row .el-widget-tabs__nav,
.pb-canvas.is-mobile .el-widget-tabs.is-breakpoint-tablet.is-direction-row-reverse .el-widget-tabs__nav,
.pb-canvas.is-mobile .el-widget-tabs.is-breakpoint-mobile.is-direction-row .el-widget-tabs__nav,
.pb-canvas.is-mobile .el-widget-tabs.is-breakpoint-mobile.is-direction-row-reverse .el-widget-tabs__nav {
	overflow-x: visible;
	flex-direction: column;
	flex-wrap: nowrap;
	gap: 0;
}

.pb-canvas.is-tablet .el-widget-tabs.is-breakpoint-tablet.is-direction-row .el-widget-tabs__tab,
.pb-canvas.is-tablet .el-widget-tabs.is-breakpoint-tablet.is-direction-row-reverse .el-widget-tabs__tab,
.pb-canvas.is-mobile .el-widget-tabs.is-breakpoint-tablet.is-direction-row .el-widget-tabs__tab,
.pb-canvas.is-mobile .el-widget-tabs.is-breakpoint-tablet.is-direction-row-reverse .el-widget-tabs__tab,
.pb-canvas.is-mobile .el-widget-tabs.is-breakpoint-mobile.is-direction-row .el-widget-tabs__tab,
.pb-canvas.is-mobile .el-widget-tabs.is-breakpoint-mobile.is-direction-row-reverse .el-widget-tabs__tab {
	width: 100% !important;
	flex: 0 0 auto !important;
}

.pb-canvas-wrap {
	min-height: 0;
	min-width: 0;
	overflow: auto;
	padding: 18px 20px 30px;
	background:
		radial-gradient(960px 280px at 50% 0, rgba(255, 255, 255, 0.94), rgba(255, 255, 255, 0) 72%),
		linear-gradient(180deg, #eef2f8 0%, #e8edf5 100%);
}

.pb-stage-window {
	max-width: 1368px;
	margin: 0 auto;
	border: none;
	border-radius: 0;
	background: transparent;
	box-shadow: none;
	overflow: visible;
}

.pb-stage-chrome {
	height: 52px;
	padding: 0 14px;
	display: grid;
	grid-template-columns: auto minmax(260px, 520px) auto;
	align-items: center;
	gap: 10px;
	background: #f7f8fb;
	border-bottom: 1px solid #d6dbe5;
}

.pb-stage-chrome-left {
	display: inline-flex;
	align-items: center;
	gap: 6px;
}

.pb-stage-dot {
	width: 10px;
	height: 10px;
	border-radius: 999px;
	display: inline-block;
	border: 1px solid rgba(0, 0, 0, 0.08);
}

.pb-stage-dot.is-red {
	background: #ff605c;
}

.pb-stage-dot.is-yellow {
	background: #ffbd44;
}

.pb-stage-dot.is-green {
	background: #00ca4e;
}

.pb-stage-address {
	height: 30px;
	border-radius: 999px;
	border: 1px solid #e0e4ec;
	background: #ffffff;
	color: #636f86;
	font-size: 12px;
	display: inline-flex;
	align-items: center;
	justify-content: center;
	gap: 8px;
	padding: 0 14px;
	overflow: hidden;
}

.pb-stage-address span {
	white-space: nowrap;
	overflow: hidden;
	text-overflow: ellipsis;
}

.pb-stage-chrome-right {
	justify-self: end;
	display: inline-flex;
	align-items: center;
	gap: 4px;
}

.pb-stage-icon-btn {
	width: 28px;
	height: 28px;
	border: 1px solid transparent;
	border-radius: 8px;
	background: transparent;
	color: #56637c;
	font-size: 12px;
	display: inline-flex;
	align-items: center;
	justify-content: center;
	cursor: pointer;
}

.pb-stage-icon-btn:hover {
	border-color: #d2d8e4;
	background: #fff;
}

.pb-stage-toolbar {
	display: flex;
	align-items: center;
	justify-content: center;
	gap: 10px;
	padding: 6px 0 14px;
	background: transparent;
}

.pb-stage-device-group {
	display: inline-flex;
	align-items: center;
	padding: 4px;
	gap: 2px;
	border-radius: 999px;
	background: rgba(255, 255, 255, 0.9);
	border: 1px solid rgba(216, 223, 236, 0.96);
	box-shadow:
		0 12px 28px rgba(18, 26, 44, 0.08),
		0 2px 6px rgba(18, 26, 44, 0.04);
	backdrop-filter: blur(12px);
}

.pb-stage-device-btn {
	width: 30px;
	height: 30px;
	border: none;
	border-radius: 999px;
	background: transparent;
	color: #5b6780;
	font-size: 13px;
	display: inline-flex;
	align-items: center;
	justify-content: center;
	cursor: pointer;
	transition: background-color 120ms ease, color 120ms ease, box-shadow 120ms ease;
}

.pb-stage-device-btn:hover {
	background: rgba(238, 242, 255, 0.9);
	color: #3f52d8;
}

.pb-stage-device-btn.active {
	background: #eef2ff;
