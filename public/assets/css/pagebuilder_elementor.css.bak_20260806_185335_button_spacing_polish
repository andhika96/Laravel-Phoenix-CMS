.el-cont-columns > .pb-grid-col {
	min-width: 0;
	min-height: 0;
	box-sizing: border-box;
}

/* Flex row / row-reverse: kolom dibagi rata horizontal */
.el-cont-columns[style*="flex-direction: row"] > .el-grid-col,
.el-cont-columns[style*="flex-direction: row"] > .pb-grid-col,
.el-cont-columns[style*="flex-direction:row"] > .el-grid-col,
.el-cont-columns[style*="flex-direction:row"] > .pb-grid-col,
.el-cont-columns[style*="flex-flow: row"] > .el-grid-col,
.el-cont-columns[style*="flex-flow: row"] > .pb-grid-col,
.el-cont-columns[style*="flex-flow:row"] > .el-grid-col,
.el-cont-columns[style*="flex-flow:row"] > .pb-grid-col,
.el-cont-columns[style*="flex-direction: row-reverse"] > .el-grid-col,
.el-cont-columns[style*="flex-direction: row-reverse"] > .pb-grid-col,
.el-cont-columns[style*="flex-direction:row-reverse"] > .el-grid-col,
.el-cont-columns[style*="flex-direction:row-reverse"] > .pb-grid-col,
.el-cont-columns[style*="flex-flow: row-reverse"] > .el-grid-col,
.el-cont-columns[style*="flex-flow: row-reverse"] > .pb-grid-col,
.el-cont-columns[style*="flex-flow:row-reverse"] > .el-grid-col,
.el-cont-columns[style*="flex-flow:row-reverse"] > .pb-grid-col {
	flex: 1 1 0;
}

/* Flex row editor shell: keep the column border aligned to the actual ratio
   and move horizontal breathing room into the inner dropzone instead. */
.el-cont-columns[style*="flex-direction: row"] > .pb-grid-col,
.el-cont-columns[style*="flex-direction:row"] > .pb-grid-col,
.el-cont-columns[style*="flex-flow: row"] > .pb-grid-col,
.el-cont-columns[style*="flex-flow:row"] > .pb-grid-col,
.el-cont-columns[style*="flex-direction: row-reverse"] > .pb-grid-col,
.el-cont-columns[style*="flex-direction:row-reverse"] > .pb-grid-col,
.el-cont-columns[style*="flex-flow: row-reverse"] > .pb-grid-col,
.el-cont-columns[style*="flex-flow:row-reverse"] > .pb-grid-col {
	padding-left: 0;
	padding-right: 0;
}

.el-cont-columns[style*="flex-direction: row"] > .pb-grid-col > .pb-dropzone-col,
.el-cont-columns[style*="flex-direction:row"] > .pb-grid-col > .pb-dropzone-col,
.el-cont-columns[style*="flex-flow: row"] > .pb-grid-col > .pb-dropzone-col,
.el-cont-columns[style*="flex-flow:row"] > .pb-grid-col > .pb-dropzone-col,
.el-cont-columns[style*="flex-direction: row-reverse"] > .pb-grid-col > .pb-dropzone-col,
.el-cont-columns[style*="flex-direction:row-reverse"] > .pb-grid-col > .pb-dropzone-col,
.el-cont-columns[style*="flex-flow: row-reverse"] > .pb-grid-col > .pb-dropzone-col,
