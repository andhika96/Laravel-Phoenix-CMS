.pb-layout-type-card:hover {
	border-color: var(--pb-accent, #6c63ff);
	background: var(--pb-card-hover-bg, #eef0ff);
	box-shadow: 0 2px 12px rgba(108,99,255,.15);
}

[data-bs-theme="dark"] .pb-layout-type-card {
	background: rgba(255,255,255,.06);
}

[data-bs-theme="dark"] .pb-layout-type-card:hover {
	background: rgba(108,99,255,.18);
}

.pb-layout-preview {
	width: 88px;
	height: 64px;
	border-radius: 8px;
	overflow: hidden;
	gap: 3px;
	padding: 6px;
	background: var(--pb-canvas-bg, #e8eaf0);
}

.pb-layout-preview-flex {
	display: flex;
	flex-direction: row;
	align-items: stretch;
}

.pb-layout-preview-grid {
	display: grid;
	grid-template-columns: 1fr 1fr;
	grid-template-rows: 1fr 1fr;
}

.pb-lp-block {
	background: var(--pb-accent, #6c63ff);
	border-radius: 4px;
	min-width: 0;
	min-height: 0;
	flex: 1;
	opacity: .7;
}

.pb-layout-preview-grid .pb-lp-block {
	opacity: .55;
}
.pb-layout-preview-grid .pb-lp-block:nth-child(odd) {
	opacity: .75;
}

.pb-layout-type-label {
	font-size: 13px;
	font-weight: 600;
	color: var(--pb-text, #2d3651);
}

[data-bs-theme="dark"] .pb-layout-type-label {
	color: #dde3f5;
}

/* Back button in step 2 */
.pb-modal-back {
	display: inline-flex;
	align-items: center;
	gap: 6px;
	margin-top: 16px;
	background: none;
	border: 1px solid var(--pb-border, #dde3f5);
	border-radius: 6px;
	padding: 5px 12px;
	font-size: 12px;
	color: var(--pb-text-muted, #8a95ac);
	cursor: pointer;
	transition: background 120ms, color 120ms;
}
.pb-modal-back:hover {
	background: var(--pb-hover-bg, #f0f2fa);
	color: var(--pb-text, #2d3651);
}

/* =============================================
   MODAL: Page custom CSS editor
   ============================================= */
.pb-css-editor-modal {
	position: fixed;
	inset: 0;
	z-index: 10010;
	display: flex;
	align-items: flex-start;
	justify-content: center;
	padding: 58px 24px 24px;
	background: rgba(15, 20, 40, 0.58);
}

.pb-css-editor-panel {
	width: min(920px, calc(100vw - 48px));
	height: min(680px, calc(100vh - 82px));
	background: #fff;
	border: 1px solid #dbe3f2;
	border-radius: 12px;
	box-shadow: 0 28px 80px rgba(15, 20, 50, 0.28);
	display: flex;
	flex-direction: column;
	overflow: hidden;
	transition: width 160ms ease, height 160ms ease, border-radius 160ms ease;
}

.pb-css-editor-panel.fullscreen {
	position: fixed;
	inset: 0;
	width: 100vw;
	height: 100vh;
	border-radius: 0;
	border: none;
}

.pb-css-editor-header {
	height: 48px;
	padding: 0 14px 0 16px;
	border-bottom: 1px solid #e5ebf5;
	background: #f8faff;
	display: flex;
	align-items: center;
	justify-content: space-between;
	flex: 0 0 auto;
}

.pb-css-editor-title {
	display: inline-flex;
	align-items: center;
	gap: 9px;
	font-size: 13px;
	font-weight: 700;
	color: #243047;
}

.pb-css-editor-title i {
	color: #6b4ce6;
}

.pb-css-editor-actions,
.pb-css-editor-footer-actions {
	display: inline-flex;
	align-items: center;
	gap: 8px;
}

.pb-css-editor-icon-btn {
	width: 30px;
	height: 30px;
	border: 1px solid #d8e0ef;
	border-radius: 8px;
	background: #fff;
	color: #4e5c78;
	display: inline-flex;
	align-items: center;
	justify-content: center;
	cursor: pointer;
	transition: background 120ms ease, border-color 120ms ease, color 120ms ease;
}

.pb-css-editor-icon-btn:hover {
	background: #eef2ff;
	border-color: #bfcaff;
	color: #3f4fb6;
}

.pb-css-editor-icon-btn.danger:hover {
	background: #fff1f2;
	border-color: #fecdd3;
	color: #b4233b;
}

.pb-css-editor-body {
	flex: 1 1 auto;
	min-height: 0;
	padding: 14px;
	display: flex;
	flex-direction: column;
	gap: 12px;
	background: #fff;
}

.pb-css-editor-hint {
	display: flex;
	gap: 8px;
	align-items: flex-start;
	padding: 9px 11px;
	border: 1px solid #dce4f3;
	border-radius: 8px;
	background: #f8faff;
	color: #64728b;
	font-size: 12px;
	line-height: 1.45;
}

.pb-css-editor-hint i {
	color: #6b4ce6;
	margin-top: 2px;
}

.pb-css-editor-hint code {
	padding: 1px 5px;
	border-radius: 4px;
	background: #eef2ff;
	color: #4f46e5;
	font-size: 11px;
}

.pb-css-editor-toolbar {
	display: flex;
	align-items: center;
	gap: 10px;
	flex-wrap: wrap;
}

.pb-css-editor-tool {
	display: inline-flex;
	align-items: center;
	gap: 7px;
	min-height: 34px;
	padding: 5px 6px 5px 9px;
	border: 1px solid #dce4f3;
	border-radius: 8px;
	background: #f8faff;
	color: #536179;
}

.pb-css-editor-tool.is-search {
	flex: 1 1 260px;
}

.pb-css-editor-tool label {
	font-size: 11px;
	font-weight: 700;
	text-transform: uppercase;
	letter-spacing: 0.04em;
	color: #6a7890;
	margin: 0;
}

.pb-css-editor-tool-input {
	width: 100%;
	min-width: 0;
	height: 24px;
	border: none;
	background: transparent;
	color: #243047;
	font-size: 12px;
	outline: none;
}

.pb-css-editor-tool-input.is-line {
	width: 74px;
}

.pb-css-editor-tool-btn {
	width: 25px;
	height: 25px;
	border: 1px solid #cfd8ea;
	border-radius: 7px;
	background: #fff;
	color: #4f5fc6;
	display: inline-flex;
	align-items: center;
	justify-content: center;
	cursor: pointer;
	transition: background 120ms ease, border-color 120ms ease, color 120ms ease;
}

.pb-css-editor-tool-btn:hover {
	background: #eef2ff;
	border-color: #bfcaff;
}

.pb-css-editor-code-shell {
	--pb-css-editor-line-height: 21.45px;
	flex: 1 1 auto;
	min-height: 260px;
	width: 100%;
	border: 1px solid #253047;
	border-radius: 8px;
	background: #101827;
	display: flex;
	overflow: hidden;
}

.pb-css-editor-code-shell:focus-within {
	border-color: #6d7fff;
	box-shadow: 0 0 0 3px rgba(109, 127, 255, 0.18);
}

.pb-css-editor-gutter {
	width: 54px;
	flex: 0 0 54px;
	padding: 15px 0;
	background: #0b1220;
	border-right: 1px solid #253047;
	color: #70819d;
	font-family: Consolas, Monaco, "Courier New", monospace;
	font-size: 12px;
	line-height: var(--pb-css-editor-line-height);
	overflow: hidden;
	user-select: none;
}

.pb-css-editor-line-number {
	width: 100%;
	height: var(--pb-css-editor-line-height);
	border: none;
	border-radius: 0;
	padding: 0 10px 0 4px;
	background: transparent;
	color: inherit;
	display: block;
	font: inherit;
	line-height: var(--pb-css-editor-line-height);
	text-align: right;
	cursor: pointer;
}

.pb-css-editor-line-number:hover {
	background: rgba(109, 127, 255, 0.12);
	color: #bac7e4;
}

.pb-css-editor-line-number.active {
	background: rgba(109, 127, 255, 0.28);
	color: #fff;
	box-shadow: inset 3px 0 0 #7c86ff;
}

.pb-css-editor-textarea {
	flex: 1 1 auto;
	min-height: 260px;
	width: 100%;
	border: none;
	border-radius: 0;
	background: transparent;
	color: #e5edf8;
	padding: 15px;
	font-family: Consolas, Monaco, "Courier New", monospace;
	font-size: 13px;
	line-height: var(--pb-css-editor-line-height);
	resize: none;
	outline: none;
	tab-size: 2;
}

.pb-css-editor-textarea:focus {
	box-shadow: none;
}

.pb-css-editor-textarea::placeholder {
	color: #7f8da8;
}

.pb-css-editor-footer {
	min-height: 52px;
	padding: 10px 14px;
	border-top: 1px solid #e5ebf5;
	background: #f8faff;
	display: flex;
	align-items: center;
	justify-content: space-between;
	gap: 12px;
	flex: 0 0 auto;
}

.pb-css-editor-count {
	display: inline-flex;
	align-items: center;
	gap: 7px;
	color: #64728b;
	font-size: 12px;
}

.pb-css-editor-btn {
	min-height: 32px;
	border-radius: 8px;
	padding: 0 13px;
	border: 1px solid transparent;
	display: inline-flex;
	align-items: center;
	justify-content: center;
	gap: 7px;
	font-size: 12px;
	font-weight: 700;
	cursor: pointer;
	transition: background 120ms ease, border-color 120ms ease, color 120ms ease;
}

.pb-css-editor-btn.primary {
	background: #5b6cff;
	border-color: #5b6cff;
	color: #fff;
}

.pb-css-editor-btn.primary:hover {
	background: #4354d8;
	border-color: #4354d8;
}

.pb-css-editor-btn.danger {
	background: #fff;
	border-color: #fecdd3;
	color: #b4233b;
}

.pb-css-editor-btn.danger:hover {
	background: #fff1f2;
}

@media (max-width: 640px) {
	.pb-css-editor-modal {
		padding: 16px;
	}

	.pb-css-editor-panel {
		width: calc(100vw - 32px);
		height: calc(100vh - 32px);
	}

	.pb-css-editor-footer {
		align-items: stretch;
		flex-direction: column;
	}

	.pb-css-editor-footer-actions {
		justify-content: flex-end;
	}
}

/* ═══════════════════════════════════════════════════════
   PROPERTIES PANEL — 3-TAB UI
   ═══════════════════════════════════════════════════════ */

/* ── Props header ─────────────────────────────────────── */
.pb-props-header {
	display: flex;
	align-items: center;
	gap: 8px;
	padding-bottom: 8px;
	border-bottom: 1px solid var(--pb-border);
	margin-bottom: 4px;
}

.pb-btn.icon-sm {
	width: 28px;
	height: 28px;
	padding: 0;
	display: inline-flex;
	align-items: center;
	justify-content: center;
	border-radius: 6px;
	font-size: 12px;
	flex-shrink: 0;
}

.pb-props-type-badge {
	display: flex;
	align-items: center;
	gap: 6px;
	font-size: 13px;
	font-weight: 600;
	color: var(--pb-text);
	overflow: hidden;
}

.pb-props-type-badge i {
	color: var(--pb-primary);
	font-size: 13px;
	flex-shrink: 0;
}

.pb-props-type-badge span {
	white-space: nowrap;
	overflow: hidden;
	text-overflow: ellipsis;
}

.pb-input-sm {
	font-size: 12px;
	padding: 5px 8px;
}

/* ── Tab Nav ──────────────────────────────────────────── */
.pb-tab-nav {
	display: grid;
	grid-template-columns: repeat(3, minmax(0, 1fr));
	gap: 4px;
	border: 1px solid var(--pb-border);
	border-radius: 10px;
	background: #f3f6fc;
	padding: 4px;
	margin: 10px 0 12px;
}

.pb-tab-btn {
	border: 1px solid transparent;
	background: none;
	border-radius: 8px;
	padding: 7px 6px;
	font-size: 12px;
	font-weight: 600;
	color: var(--pb-subtle);
	cursor: pointer;
	transition: color 120ms, border-color 120ms, background-color 120ms;
}

.pb-tab-btn:hover {
	color: var(--pb-text);
	background: #eef2fb;
}

.pb-tab-btn.active {
	color: var(--pb-primary);
	border-color: rgba(91, 108, 255, 0.25);
	background: #fff;
	box-shadow: 0 1px 2px rgba(28, 39, 66, 0.06);
}

/* ── Tab Content ──────────────────────────────────────── */
.pb-tab-content {
	margin-top: 0;
	display: grid;
	gap: 10px;
}

/* ── Prop Section (collapsible groups) ────────────────── */
.pb-prop-section {
	margin-bottom: 0;
	padding: 10px 10px 9px;
	border: 1px solid #e2e7f2;
	border-radius: 10px;
	background: #fff;
	box-shadow: 0 1px 0 rgba(19, 32, 56, 0.03);
}

.pb-prop-section:last-child {
	margin-bottom: 2px;
}

.pb-prop-section-title {
	font-size: 11px;
	font-weight: 700;
	text-transform: uppercase;
	letter-spacing: 0.45px;
	color: #5e6c88;
	margin-bottom: 9px;
}

/* ── Segmented button group ───────────────────────────── */
.pb-btn-group {
	display: flex;
	flex-wrap: wrap;
	gap: 4px;
}

.pb-seg-btn {
	flex: 1;
	min-width: 28px;
	height: 31px;
	padding: 0 6px;
	border: 1px solid var(--pb-border);
	background: #f7f9ff;
	border-radius: 6px;
	font-size: 11px;
	font-weight: 500;
	color: var(--pb-subtle);
	cursor: pointer;
	display: inline-flex;
	align-items: center;
	justify-content: center;
	transition: background 100ms, color 100ms, border-color 100ms;
	white-space: nowrap;
	line-height: 1;
}

.pb-seg-btn i {
	font-size: 12px;
	line-height: 1;
}

.pb-seg-btn:hover {
	background: #eef1fb;
	color: var(--pb-text);
}

.pb-seg-btn.active {
	background: var(--pb-primary);
	border-color: var(--pb-primary);
	color: #fff;
}

/* ── Color picker row ─────────────────────────────────── */
.pb-color-row {
	display: flex;
	align-items: center;
	gap: 8px;
}

.pb-color-swatch {
	width: 32px;
	height: 32px;
	padding: 2px;
	border: 1px solid var(--pb-border);
	border-radius: 6px;
	cursor: pointer;
	flex-shrink: 0;
	background: none;
}

.pb-color-row .pb-input {
	flex: 1;
}

.pb-color-row .clr-field {
	flex: 1;
	width: 100%;
}

.pb-color-row .clr-field .pb-input {
	width: 100%;
	padding-right: 44px;
}

.pb-color-row .clr-field button {
	top: 50%;
	transform: translateY(-50%);
	border-top-right-radius: 10px;
	border-bottom-right-radius: 10px;
}

/* ── Four-sides input (Padding / Margin) ──────────────── */
.pb-four-sides {
	display: grid;
	grid-template-columns: 1fr 1fr 1fr 1fr;
	gap: 7px;
}

.pb-side-input {
	display: flex;
	flex-direction: column;
	align-items: center;
	gap: 3px;
}

.pb-side-input .pb-input {
	width: 100%;
	text-align: center;
	padding: 6px 4px;
	font-size: 12px;
	min-height: 31px;
}

.pb-side-input span {
	font-size: 10px;
	color: var(--pb-subtle);
}

/* ── Column picker (1-6 buttons) ─────────────────────── */
.pb-col-picker {
	display: flex;
	gap: 4px;
}

.pb-col-pick-btn {
	flex: 1;
	height: 30px;
	border: 1px solid var(--pb-border);
	background: #f9fbff;
	border-radius: 6px;
	font-size: 12px;
	font-weight: 600;
	color: var(--pb-subtle);
	cursor: pointer;
	transition: background 100ms, color 100ms, border-color 100ms;
}

.pb-col-pick-btn:hover {
	background: #eef1fb;
	color: var(--pb-text);
}

.pb-col-pick-btn.active {
	background: var(--pb-primary);
	border-color: var(--pb-primary);
	color: #fff;
}

/* ── Hint text ────────────────────────────────────────── */
.pb-form-hint {
	font-size: 10px;
	color: var(--pb-subtle);
	font-weight: 400;
}

.pb-label-row {
	display: flex;
	align-items: center;
	justify-content: space-between;
	gap: 10px;
}

.pb-responsive-switch {
	display: inline-flex;
	align-items: center;
	gap: 6px;
	flex-wrap: wrap;
}

.pb-device-btn {
	border: 1px solid var(--pb-border);
	background: #f7f9ff;
	color: var(--pb-subtle);
	border-radius: 7px;
	padding: 5px 8px;
	font-size: 11px;
	font-weight: 600;
	display: inline-flex;
	align-items: center;
	gap: 6px;
	cursor: pointer;
}

.pb-device-btn.active {
	background: var(--pb-primary);
	border-color: var(--pb-primary);
	color: #fff;
}

.pb-link-btn {
	border: 1px solid var(--pb-border);
	background: #f7f9ff;
	color: var(--pb-subtle);
	border-radius: 6px;
	width: 28px;
	height: 28px;
	display: inline-flex;
	align-items: center;
	justify-content: center;
	cursor: pointer;
	flex-shrink: 0;
}

.pb-link-btn:hover {
	background: #eef1fb;
	color: var(--pb-text);
}

.pb-gap-row {
	display: grid;
	grid-template-columns: 1fr 1fr;
	gap: 8px;
}

.pb-gap-field {
	display: flex;
	flex-direction: column;
	gap: 4px;
}

.pb-gap-field span {
	font-size: 10px;
	color: var(--pb-subtle);
	text-align: center;
}

.pb-toggle-wrap {
	display: inline-flex;
	align-items: center;
}

.pb-toggle {
	position: fixed;
	top: 0;
	left: 0;
	width: 1px;
	height: 1px;
	margin: 0;
	opacity: 0;
	pointer-events: none;
}

.pb-toggle + label {
	position: relative;
	display: inline-flex;
	align-items: center;
	width: 36px;
	height: 20px;
	border-radius: 999px;
	background: #d8deec;
	cursor: pointer;
	transition: background 120ms ease;
}

.pb-toggle + label::after {
	content: '';
	position: absolute;
	left: 2px;
	width: 16px;
	height: 16px;
	border-radius: 50%;
	background: #fff;
	box-shadow: 0 1px 3px rgba(15, 23, 42, 0.22);
	transition: transform 120ms ease;
}

.pb-toggle:checked + label {
	background: var(--pb-primary);
}

.pb-toggle:checked + label::after {
	transform: translateX(16px);
}

.pb-range {
	width: 100%;
	accent-color: var(--pb-primary);
}

.pb-code-editor {
	font-family: Consolas, 'Courier New', monospace;
	font-size: 12px;
	min-height: 120px;
}

.pb-attr-row {
	display: grid;
	grid-template-columns: 1fr 1fr auto;
	gap: 8px;
	margin-top: 8px;
}

.pb-mini-btn {
	flex: 0;
	padding: 2px 8px;
	font-size: 11px;
}

/* =============================================
   ADVANCED: responsive visibility + motion
   ============================================= */
@media (min-width: 1025px) {
	.pb-hide-desktop {
		display: none !important;
	}
	.pb-scroll-off-desktop.pb-motion-scroll {
		will-change: auto;
		transform: none !important;
	}
	.pb-mouse-off-desktop.pb-motion-mouse {
		transition: none;
		transform: none !important;
		box-shadow: none !important;
	}
	.pb-sticky-off-desktop {
		position: relative !important;
		top: auto !important;
		bottom: auto !important;
	}
}

@media (min-width: 768px) and (max-width: 1024px) {
	.pb-hide-tablet {
		display: none !important;
	}
	.pb-scroll-off-tablet.pb-motion-scroll {
		will-change: auto;
		transform: none !important;
	}
	.pb-mouse-off-tablet.pb-motion-mouse {
		transition: none;
		transform: none !important;
		box-shadow: none !important;
	}
	.pb-sticky-off-tablet {
		position: relative !important;
		top: auto !important;
		bottom: auto !important;
	}
}

@media (max-width: 767px) {
	.pb-hide-mobile {
		display: none !important;
	}
	.pb-scroll-off-mobile.pb-motion-scroll {
		will-change: auto;
		transform: none !important;
	}
	.pb-mouse-off-mobile.pb-motion-mouse {
		transition: none;
		transform: none !important;
		box-shadow: none !important;
	}
	.pb-sticky-off-mobile {
		position: relative !important;
		top: auto !important;
		bottom: auto !important;
	}
}

.pb-motion-mouse {
	transition: transform 220ms ease, box-shadow 220ms ease;
}

.pb-motion-mouse:hover {
	transform: translateY(-2px);
	box-shadow: 0 10px 28px rgba(23, 35, 61, 0.16);
}

.pb-motion-scroll {
	will-change: transform, opacity;
}

.pb-entrance-anim {
	animation-duration: 0.7s;
	animation-fill-mode: both;
}

.pb-anim-fadeIn { animation-name: pbFadeIn; }
.pb-anim-fadeInUp { animation-name: pbFadeInUp; }
.pb-anim-fadeInDown { animation-name: pbFadeInDown; }
.pb-anim-fadeInLeft { animation-name: pbFadeInLeft; }
.pb-anim-fadeInRight { animation-name: pbFadeInRight; }
.pb-anim-zoomIn { animation-name: pbZoomIn; }
.pb-anim-slideInUp { animation-name: pbSlideInUp; }
.pb-anim-slideInDown { animation-name: pbSlideInDown; }
.pb-anim-slideInLeft { animation-name: pbSlideInLeft; }
.pb-anim-slideInRight { animation-name: pbSlideInRight; }
.pb-anim-bounceIn { animation-name: pbBounceIn; }

@keyframes pbFadeIn {
	from { opacity: 0; }
	to { opacity: 1; }
}

@keyframes pbFadeInUp {
	from { opacity: 0; transform: translate3d(0, 20px, 0); }
	to { opacity: 1; transform: translate3d(0, 0, 0); }
}

@keyframes pbFadeInDown {
	from { opacity: 0; transform: translate3d(0, -20px, 0); }
	to { opacity: 1; transform: translate3d(0, 0, 0); }
}

@keyframes pbFadeInLeft {
	from { opacity: 0; transform: translate3d(-20px, 0, 0); }
	to { opacity: 1; transform: translate3d(0, 0, 0); }
}

@keyframes pbFadeInRight {
	from { opacity: 0; transform: translate3d(20px, 0, 0); }
	to { opacity: 1; transform: translate3d(0, 0, 0); }
}

@keyframes pbZoomIn {
	from { opacity: 0; transform: scale3d(0.96, 0.96, 1); }
	to { opacity: 1; transform: scale3d(1, 1, 1); }
}

@keyframes pbSlideInUp {
	from { transform: translate3d(0, 28px, 0); visibility: visible; }
	to { transform: translate3d(0, 0, 0); }
}

@keyframes pbSlideInDown {
	from { transform: translate3d(0, -28px, 0); visibility: visible; }
	to { transform: translate3d(0, 0, 0); }
}

@keyframes pbSlideInLeft {
	from { transform: translate3d(-28px, 0, 0); visibility: visible; }
	to { transform: translate3d(0, 0, 0); }
}

@keyframes pbSlideInRight {
	from { transform: translate3d(28px, 0, 0); visibility: visible; }
	to { transform: translate3d(0, 0, 0); }
}

@keyframes pbBounceIn {
	from, 20%, 40%, 60%, 80%, to {
		animation-timing-function: cubic-bezier(0.215, 0.610, 0.355, 1.000);
	}
	0% {
		opacity: 0;
		transform: scale3d(.9, .9, .9);
	}
	20% { transform: scale3d(1.05, 1.05, 1.05); }
	40% { transform: scale3d(.98, .98, .98); }
	60% {
		opacity: 1;
		transform: scale3d(1.02, 1.02, 1.02);
	}
	80% { transform: scale3d(.995, .995, .995); }
	to {
		opacity: 1;
