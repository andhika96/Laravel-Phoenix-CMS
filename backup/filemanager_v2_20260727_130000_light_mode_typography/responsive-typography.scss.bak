@import "bootstrap/scss/vendor/rfs";

// Bootstrap RFS only fluid-scales values above its 1.25rem base threshold.
// Smaller operational text stays stable so labels and metadata remain readable.
.content-toolbar h1,
.drop-overlay h2 {
  @include font-size(1.375rem);
}

.empty-state h2 {
  @include font-size(1.25rem);
}

.brand small,
.content-toolbar p,
.primary-actions .btn,
.asset-copy strong,
.list-card .asset-copy strong,
.drawer-head strong,
.upload-title strong,
.drop-overlay p {
  @include font-size(.75rem);
}

.storage-copy small,
.storage-option small,
.nav-count,
.folder-list small,
.section-heading,
.breadcrumb-wrap small,
.search-field kbd,
.profile-button span,
.profile-button i,
.filter-actions .btn span,
.asset-extension,
.asset-copy span,
.drawer-head small,
.drawer-section label,
.tag-list span,
.tag-list button,
.upload-title small,
.upload-item-copy small {
  @include font-size(.625rem);
}

.search-field input,
.filter-tabs button,
.filter-actions .btn,
.filter-actions .form-select,
.selection-toolbar,
.selection-toolbar button,
.drawer-actions button,
.editable-field,
.info-grid strong,
.location-link,
.drawer-section textarea,
.empty-state p,
.empty-state .btn,
.upload-summary button,
.upload-item-copy strong,
.fm-toast {
  @include font-size(.6875rem);
}

.usage-row,
.usage-row strong {
  @include font-size(.625rem);
}

.upload-window-actions button,
.upload-item-status button {
  @include font-size(.75rem);
}

.upload-menu .dropdown-item {
  padding: .5625rem .75rem;
  @include font-size(.75rem);
}

.upload-menu .dropdown-item i {
  @include font-size(.875rem);
}
