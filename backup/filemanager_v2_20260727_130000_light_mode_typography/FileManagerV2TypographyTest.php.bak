<?php

namespace Tests\Feature\FileManagerV2;

use Tests\TestCase;

class FileManagerV2TypographyTest extends TestCase
{
    public function test_light_mode_uses_a_true_medium_font_weight_and_readable_operational_text(): void
    {
        $entrypoint = file_get_contents(resource_path('js/filemanager_v2/main.js'));
        $styles = file_get_contents(resource_path('js/filemanager_v2/styles.css'));
        $responsiveTypography = file_get_contents(resource_path('js/filemanager_v2/responsive-typography.scss'));

        $this->assertStringContainsString("@fontsource/nunito/500.css", $entrypoint);
        $this->assertStringContainsString('--bs-body-font-weight: 500;', $styles);
        $this->assertStringContainsString('--muted: #5f6b7d;', $styles);
        $this->assertStringContainsString('.content-toolbar p { margin: 4px 0 0; color: #6e7b90; font-size: 10px; }', $styles);
        $this->assertStringNotContainsString('@include font-size(.625rem);', $responsiveTypography);
    }
}
