import assert from 'node:assert/strict';
import test from 'node:test';
import fs from 'node:fs';

const root = new URL('../', import.meta.url);
const read = (path) => fs.readFileSync(new URL(path, root), 'utf8');

test('v2.4 exposes an authenticated static import endpoint and Canvas trigger', () => {
  const route = read('routes/pagebuilder_elementor_v24.php');
  const shell = read('resources/views/pagebuilder_elementor_v24/editor_shell.blade.php');
  const app = read('public/js/pagebuilder_elementor_v24/app.js');

  assert.match(route, /Route::post\('\/import\/static', 'importStatic'\)/);
  assert.match(shell, /staticImportUrl:/);
  assert.match(app, /async function importStaticFile\(event\)/);
  assert.match(app, /rootNodes\.value = norm\(result\.layout\)/);
  assert.match(app, /class="top-action"[^\n]*Import Static/);
  assert.match(app, /accept="\.html,\.htm,\.zip/);
  assert.match(app, /staticImportFramework/);
  assert.match(app, /staticImportMode/);
  assert.match(app, /data\.append\('mode', staticImportMode\.value\)/);
  assert.match(app, /value="compiled"/);
  assert.match(app, /Compiled Native/);
  assert.match(app, /PhoenixStaticImportCompiler/);
  assert.match(app, /replaceGeneratedStaticImportCss/);
  assert.match(app, /customCssHasGeneratedBlock/);
  assert.match(app, /Generated CSS/);
  assert.match(shell, /static-import-compiler\.js/);
  assert.match(shell, /static-import-css\.js/);
  assert.match(app, /staticImportCompileController/);
  assert.match(app, /cancelStaticImportCompile/);
  assert.match(app, /useExactStaticImportFallback/);
  assert.match(app, /pb-static-import-compile-modal/);
  assert.match(app, /function showStaticImportReport\(\)/);
  assert.match(app, /showStaticImportReportModal/);
  assert.match(app, /includeScripts/);
  assert.match(app, /requestCopyDetectedStaticScripts/);
  assert.match(app, /copyDetectedStaticScriptsToCustomJavaScript/);
  assert.match(app, /Copy detected scripts to Custom JavaScript/);
  assert.match(app, /function downloadStaticImportJson\(\)/);
});

test('v2.4 synchronizes imported framework dependencies without changing manual layouts', () => {
  const app = read('public/js/pagebuilder_elementor_v24/app.js');

  assert.match(app, /function staticImportMetadata\(nodes\)/);
  assert.match(app, /function syncStaticImportDependencies\(nodes\)/);
  assert.match(app, /corePlugins:\s*\{\s*preflight:\s*false\s*\}/);
  assert.match(app, /important:\s*'\.pb-import-root'/);
  assert.match(app, /metadata\.mode === 'compiled'/);
  assert.match(app, /syncStaticImportDependencies\(rootNodes\.value\)/);
  assert.match(app, /data-pb-static-import/);
  assert.match(app, /querySelectorAll\('\[data-pb-static-import\]'\)/);
});

test('Compiled Native adapts only the editor CSS preview and preserves saved frontend CSS', () => {
  const app = read('public/js/pagebuilder_elementor_v24/app.js');
  const frontend = read('resources/views/pagebuilder_elementor_v24/frontend_renderer.blade.php');

  assert.match(app, /const canvasCustomCss = computed/);
  assert.match(app, /metadata\?\.mode !== 'compiled'/);
  assert.match(app, /adaptCompiledCssForCanvas/);
  assert.match(app, /<component v-if="canvasCustomCss" :is="'style'">\{\{ canvasCustomCss \}\}<\/component>/);
  assert.match(app, /customCss:normalizedCustomCss\.value/);
  assert.doesNotMatch(frontend, /adaptCompiledCssForCanvas|canvasCustomCss/);
  assert.match(frontend, /\{!! \$pageData->custom_css !!\}/);
});

test('Compiled Native runs computed-style mapping before normalization without changing other import modes', () => {
  const app = read('public/js/pagebuilder_elementor_v24/app.js');
  const shell = read('resources/views/pagebuilder_elementor_v24/editor_shell.blade.php');
  const native = read('public/js/pagebuilder_elementor_v24/static-import-native.js');

  assert.match(shell, /static-import-native\.js/);
  assert.match(native, /function applyComputedSnapshot\(layout, snapshot\)/);
  assert.match(app, /PhoenixStaticImportNative/);
  assert.match(app, /applyComputedSnapshot/);
  assert.match(app, /scanComputedStyles/);
  assert.match(app, /rootNodes\.value = norm\(result\.layout\)/);
  assert.match(app, /mode === 'compiled'/);
  assert.doesNotMatch(app, /applyComputedSnapshot\(result\.layout, result\.snapshot\)/);
});

