test('static html preview is a hidden v2.4 source module', () => {
  const manifest = read('resources/pagebuilder_elementor_v24/modules/widgets/basic/static-html/module.json');
  const canvas = read('resources/pagebuilder_elementor_v24/modules/widgets/basic/static-html/Canvas.vue');
  const frontend = read('resources/pagebuilder_elementor_v24/modules/widgets/basic/static-html/frontend.blade.php');

  assert.match(manifest, /"type": "static_html"/);
  assert.match(manifest, /"toolbox": false/);
  assert.match(canvas, /sandbox="allow-scripts"/);
  assert.match(canvas, /pb-static-html-preview--canvas/);
  assert.match(frontend, /sandbox="allow-scripts"/);
