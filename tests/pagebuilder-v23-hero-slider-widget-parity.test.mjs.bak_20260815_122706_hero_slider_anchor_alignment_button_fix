const canvasDescriptor = parse(canvas, { filename: 'HeroSliderCanvas.vue' }).descriptor;
const canvasModule = await import(`data:text/javascript;base64,${Buffer.from(canvasDescriptor.script.content).toString('base64')}`);
const canvasMethods = canvasModule.default.methods;
const responsiveImageContext = {
    responsiveDevice: 'tablet',
    safeMedia(value) { return canvasMethods.safeMedia.call(this, value); },
    slideResponsiveValue(slide, base, fallback = '') { return canvasMethods.slideResponsiveValue.call(this, slide, base, fallback); },
};
assert.equal(
    canvasMethods.imageUrl.call(responsiveImageContext, { imageUrl: '', imageUrlTablet: '/hero-tablet.webp', imageUrlMobile: '/hero-mobile.webp' }),
    '/hero-tablet.webp',
    'Tablet canvas must render its responsive image even when the desktop Image URL is empty',
);
responsiveImageContext.responsiveDevice = 'mobile';
assert.equal(
    canvasMethods.imageUrl.call(responsiveImageContext, { imageUrl: '', imageUrlTablet: '/hero-tablet.webp', imageUrlMobile: '/hero-mobile.webp' }),
    '/hero-mobile.webp',
    'Mobile canvas must prefer its responsive image even when the desktop Image URL is empty',
);
const canvasNavigation = {
    activeIndex: 0,
    slides: Array.from({ length: 5 }, (_, index) => ({ id: `slide-${index}` })),
    settings: { loop: false, rewind: true, perMove: 2 },
    moveStep() { return canvasMethods.moveStep.call(this); },
    goTo(index) { return canvasMethods.goTo.call(this, index); },
};
canvasMethods.next.call(canvasNavigation);
assert.equal(canvasNavigation.activeIndex, 2, 'Canvas next must honor perMove');
canvasNavigation.activeIndex = 4;
canvasMethods.next.call(canvasNavigation);
assert.equal(canvasNavigation.activeIndex, 0, 'Canvas next must honor rewind at the end');
canvasNavigation.activeIndex = 0;
canvasMethods.previous.call(canvasNavigation);
assert.equal(canvasNavigation.activeIndex, 4, 'Canvas previous must honor rewind at the start');

