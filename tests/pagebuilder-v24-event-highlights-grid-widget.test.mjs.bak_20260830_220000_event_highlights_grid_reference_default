        subheading: 'THE CHAMPIONSHIP PATHWAY',
        textOrder: 'subheading-first',
        linkText: 'REGISTER INTEREST',
        linkUrl: 'https://example.com/register',
        linkTarget: '_blank',
        linkNofollow: true,
        showLink: true,
        showArrow: true,
        gridColumns: '5',
        gridColumnsTablet: '3',
        gridColumnsMobile: '1',
        columnGap: '20px',
        rowGap: '20px',
