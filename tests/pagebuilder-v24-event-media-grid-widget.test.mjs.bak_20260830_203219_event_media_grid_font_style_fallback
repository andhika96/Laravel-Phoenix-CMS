test('Event Media Grid defaults and normalizer enforce the 12-card responsive contract', () => {
    const definition = loadDefinition();
    const defaults = definition.defaults();

    assert.equal(defaults.cards.length, 6);
    assert.deepEqual(Array.from(defaults.cards, (card) => card.showImage), [true, true, true, true, true, true]);
    assert.deepEqual(Array.from(defaults.cards, (card) => card.showIcon), [true, true, true, true, true, true]);
    assert.deepEqual(Array.from(defaults.cards, (card) => card.iconClass), [
        'fal fa-users', 'fal fa-award', 'fal fa-money-bill', 'fal fa-plane', 'fal fa-car', 'fal fa-glass-cheers',
    ]);
    assert.deepEqual(Array.from(defaults.cards, (card) => card.title), [
        'Pairs Scramble', 'Qualification', 'IDR 300M', 'Dubai Package', 'Hole-in-One', 'Novelty Awards',
    ]);
    assert.equal(defaults.gridColumns, '3');
    assert.equal(defaults.gridColumnsTablet, '2');
    assert.equal(defaults.gridColumnsMobile, '1');
    assert.equal(defaults.gridContentWidthMode, 'max');
    assert.equal(defaults.gridContentMaxWidth, '1636px');
    assert.equal(defaults.cardHeightMode, 'custom');
    assert.equal(defaults.cardHeight, '472px');
    assert.equal(defaults.imagePresentation, undefined);
    assert.equal(defaults.imageHeight, '195px');
    assert.equal(defaults.imageHeightTablet, '180px');
    assert.equal(defaults.imageHeightMobile, '160px');
    assert.equal(defaults.iconTitleGap, '32px');
    assert.equal(defaults.footerText, 'Prize information is subject to final event terms and conditions.');
    assert.equal(defaults.footerPosition, 'bottom');
    assert.equal(defaults.footerAlign, 'left');
    assert.equal(JSON.stringify(definition.editor.iconTargets), JSON.stringify({ cardIcon: { prefix: 'icon', collection: 'cards' } }));

    const normalized = definition.normalize({ settings: {
        gridColumns: '99',
        gridColumnsMobile: '99',
        footerPosition: 'invalid',
        footerAlign: 'invalid',
        gridContentWidthMode: 'invalid',
        gridContentMaxWidth: '1200px',
        cards: Array.from({ length: 13 }, (_, index) => ({
            id: index < 2 ? 'duplicate' : `card-${index}`,
            mediaMode: 'invalid',
            imageUrl: 'javascript:alert(1)',
            imagePresentation: 'invalid',
            iconSvg: '<svg><script>alert(1)</script></svg>',
        })),
    } });

    assert.equal(normalized.settings.gridColumns, '3');
    assert.equal(normalized.settings.gridColumnsMobile, '');
    assert.equal(normalized.settings.footerPosition, 'bottom');
    assert.equal(normalized.settings.footerAlign, 'left');
    assert.equal(normalized.settings.gridContentWidthMode, 'max');
    assert.equal(normalized.settings.gridContentMaxWidth, '1200px');
    assert.equal(normalized.settings.cards.length, 12);
    assert.equal(new Set(normalized.settings.cards.map((card) => card.id)).size, 12);
    assert.equal(normalized.settings.cards[0].imageUrl, '');
    assert.equal(normalized.settings.cards[0].imagePresentation, 'element');
    assert.equal(normalized.settings.cards[0].iconSvg, '');
});

test('Event Media Grid Settings follows shared tabs, controls, repeater, and media contracts', () => {
    const { descriptor, errors } = parse(settingsSource, { filename: 'EventMediaGridSettings.vue' });
    assert.deepEqual(errors, []);
    assert.deepEqual(compile(descriptor.template.content, { mode: 'function' }).errors ?? [], []);

    for (const marker of [
        'pb-tab-nav', 'pb-tab-btn', 'pb-tab-btn-icon', 'Content', 'Style', 'Advanced',
        'pb-tab-content', 'pb-collapsible', 'pb-collapsible-body', 'pb-form-group',
        'pb-form-label', 'pb-input', 'pb-select', 'pb-textarea', 'pb-form-row',
        'Footer Note', 'footerText', 'footerPosition', 'footerAlign', 'Cards', 'Move Up',
        'Move Down', 'Duplicate', 'Remove', 'Add Card', 'Media Library', 'External URL',
        'Image element', 'Background image', 'Alt Text', 'Show Icon', 'openProIconLibrary',
        'chooseProIconSvg', 'editor.widgetAdvancedControls', 'editor.typographyControl',
        'pb-range-value-row', 'pb-four-sides pb-four-sides-with-link', 'coloris pb-coloris-input',
        'Content Width', 'gridContentWidthMode', 'gridContentMaxWidth', 'Icon–Title Gap',
        'Card Layout', 'Card Media', 'Card Title', 'Card Description', 'Card Box', 'aria-label',
    ]) {
        assert.match(settingsSource, new RegExp(marker.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')), `missing Settings marker: ${marker}`);
    }
    assert.doesNotMatch(settingsSource, /<template\s+v-if=/, 'Settings must not hide controls in inert native templates');
    assert.match(manifestSource, /pro-icon-targets/);
});

test('Event Media Grid Canvas renders default cards, footer order, media modes, and responsive layout', async () => {
    const component = loadSfc(canvasSource, 'EventMediaGridCanvas.vue');
    const defaults = loadDefinition().defaults();
    const desktop = await renderComponent(component, { item: { settings: defaults }, responsiveDevice: 'desktop' });

    assert.match(desktop, /el-widget-event-media-grid/);
    assert.match(desktop, /event-media-grid__cards/);
    assert.equal((desktop.match(/class="event-media-grid__card(?:\s|")/g) || []).length, 6);
    assert.equal((desktop.match(/event-media-grid__image-placeholder/g) || []).length, 6);
    assert.match(desktop, /fal fa-users/);
    assert.match(desktop, /Pairs Scramble/);
    assert.match(desktop, /Prize information is subject to final event terms and conditions\./);
    assert.ok(desktop.indexOf('event-media-grid__cards') < desktop.indexOf('event-media-grid__footer'), 'bottom footer follows cards in the DOM');
    assert.match(desktop, /grid-template-columns:repeat\(3/);
    assert.match(desktop, /max-width:1636px/);
    assert.match(desktop, /min-height:472px/);
    assert.match(desktop, /gap:32px/);

    const responsive = await renderComponent(component, { item: { settings: {
        ...defaults,
        gridColumnsTablet: '4',
        gridColumnsMobile: '1',
        footerPositionMobile: 'top',
        footerAlignMobile: 'center',
    } }, responsiveDevice: 'tablet' });
    assert.match(responsive, /grid-template-columns:repeat\(4/);
    assert.match(responsive, /data-responsive-device="tablet"/);

    const mobileFooterTop = await renderComponent(component, { item: { settings: {
        ...defaults,
        footerPositionMobile: 'top',
        footerAlignMobile: 'right',
    } }, responsiveDevice: 'mobile' });
    assert.ok(mobileFooterTop.indexOf('event-media-grid__footer') < mobileFooterTop.indexOf('event-media-grid__cards'), 'top footer follows the visual DOM order');
    assert.match(mobileFooterTop, /grid-template-columns:repeat\(1/);
});

test('Event Media Grid Canvas supports image element/background, icon toggle, Full Width, and safe content', async () => {
    const component = loadSfc(canvasSource, 'EventMediaGridCanvas.vue');
    const base = loadDefinition().defaults();
    const cards = [
        { ...base.cards[0], imageUrl: 'https://example.com/golf.webp', imageAlt: 'Golf ball', imagePresentation: 'element', showIcon: false, title: 'Safe <title>', description: '<script>alert(1)</script>' },
        { ...base.cards[1], imageUrl: 'https://example.com/qualify.webp', imageAlt: 'Qualification', imagePresentation: 'background', showImage: true },
    ];
    const html = await renderComponent(component, { item: { settings: { ...base, gridContentWidthMode: 'full', cards } }, responsiveDevice: 'desktop' });

    assert.match(html, /class="event-media-grid__image"[^>]*>/);
    assert.match(html, /class="event-media-grid__image-element"[^>]*src="https:\/\/example\.com\/golf\.webp"/);
    assert.match(html, /class="event-media-grid__image-background"[^>]*style="[^"]*background-image:url/);
    assert.doesNotMatch(html, /event-media-grid__card-icon[^>]*fal fa-users/);
    assert.match(html, /max-width:100%/);
    assert.match(html, /Safe &lt;title&gt;/);
    assert.match(html, /&lt;script&gt;alert\(1\)&lt;\/script&gt;/);

    const unsafe = await renderComponent(component, { item: { settings: { ...base, cards: [{ ...base.cards[0], imageUrl: 'javascript:alert(1)', iconSource: 'svg', iconSvg: '<svg><script>alert(1)</script></svg>' }] } }, responsiveDevice: 'desktop' });
    assert.doesNotMatch(unsafe, /javascript:/);
    assert.doesNotMatch(unsafe, /<script>/);
});

test('Event Media Grid Canvas and Blade share the semantic, safety, and advanced contracts', () => {
    for (const marker of [
        'data-event-media-grid', 'event-media-grid__footer', 'event-media-grid__cards',
        'event-media-grid__card', 'event-media-grid__image', 'event-media-grid__body',
        'event-media-grid__icon', 'event-media-grid__title', 'event-media-grid__description',
        'gridColumns', 'gridContentWidthMode', 'gridContentMaxWidth', 'columnGap', 'rowGap',
        'cardHeightMode', 'imagePresentation', 'imagePadding', 'imageMargin', 'iconTitleGap',
        'footerPosition', 'footerAlign', 'overflow-wrap:anywhere',
    ]) {
        assert.match(canvasSource, new RegExp(marker.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')), `Canvas missing ${marker}`);
        assert.match(frontendSource, new RegExp(marker.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')), `Blade missing ${marker}`);
    }
    assert.doesNotMatch(frontendSource, /pb-node-toolbar|pb-dropzone|selection outline/i);
    assert.match(frontendSource, /WidgetAdvancedStyleResolver/);
    assert.match(frontendSource, /safe.*(?:Url|Svg)/i);
});

