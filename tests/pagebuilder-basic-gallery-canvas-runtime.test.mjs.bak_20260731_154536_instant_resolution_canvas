test('content controls drive gallery order, captions, links, and lightbox state on canvas', () => {
	const context = canvasContext({
		images: [
			{ id: 'one', url: '/gallery/one.jpg', caption: 'First', attachmentUrl: '/attachments/one' },
			{ id: 'two', url: '/gallery/two.jpg', caption: 'Second', attachmentUrl: '/attachments/two' },
		],
		orderBy: 'random', captionType: 'caption', linkType: 'media', lightbox: 'yes',
	});

	assert.equal(context.captionFor(context.resolvedImages[0]) !== '', true);
	assert.equal(context.linkFor(context.resolvedImages[0]), context.resolvedImages[0].url);
	assert.equal(context.usesLightbox, true);
	context.item.settings.linkType = 'attachment';
	assert.equal(context.linkFor(context.resolvedImages[0]), context.resolvedImages[0].attachmentUrl);
	context.item.settings.captionType = 'none';
	assert.equal(context.captionFor(context.resolvedImages[0]), '');
});

test('Image Resolution replaces stale rendition URLs immediately and requests the selected rendition', async () => {
	const originalWindow = globalThis.window;
	const requests = [];
	let resolveRequest;
	globalThis.window = {
		PAGE_BUILDER_ELEMENTOR_CONTEXT: { imageRenditionUrl: '/pagebuilder-elementor/image-rendition' },
		axios: {
			get(url, config) {
				requests.push({ url, params: config.params });
				return new Promise((resolve) => { resolveRequest = resolve; });
			},
		},
	};

	try {
		const sourceUrl = 'https://laravel-13-phoenix.aruna/storage/ckfinder/userfiles/image.png';
		const context = canvasContext({
			images: [{ id: 'one', url: sourceUrl, alt: 'One' }],
			imageResolution: 'custom', customImageWidth: 320, customImageHeight: 180,
		});
		context.renditionImages = [{ id: 'one', url: '/assets/pagebuilder_elementor/renditions/stale-thumbnail.png', alt: 'One' }];

		const pending = context.resolveImageRenditions();
		assert.deepEqual(context.renditionImages, [{ id: 'one', url: sourceUrl, alt: 'One' }]);
		assert.deepEqual(requests, [{
			url: '/pagebuilder-elementor/image-rendition',
			params: { url: sourceUrl, size: 'custom', width: 320, height: 180 },
		}]);

		resolveRequest({ data: { url: '/assets/pagebuilder_elementor/renditions/current-custom.png' } });
		await pending;
		assert.equal(context.renditionImages[0].url, '/assets/pagebuilder_elementor/renditions/current-custom.png');
	} finally {
		globalThis.window = originalWindow;
	}
});

test('custom resolution validates both dimensions before it calls the rendition endpoint', async () => {
	const originalWindow = globalThis.window;
	let requestCount = 0;
	globalThis.window = {
		PAGE_BUILDER_ELEMENTOR_CONTEXT: { imageRenditionUrl: '/pagebuilder-elementor/image-rendition' },
		axios: { get() { requestCount += 1; return Promise.resolve({ data: { url: '/unexpected.png' } }); } },
	};

	try {
		const sourceUrl = '/storage/ckfinder/userfiles/image.png';
		const context = canvasContext({
			images: [{ id: 'one', url: sourceUrl, alt: 'One' }],
			imageResolution: 'custom', customImageWidth: 150, customImageHeight: 5500000,
		});
		context.renditionImages = [{ id: 'one', url: '/assets/pagebuilder_elementor/renditions/stale.png', alt: 'One' }];

		await context.resolveImageRenditions();

		assert.equal(requestCount, 0);
		assert.deepEqual(context.renditionImages, [{ id: 'one', url: sourceUrl, alt: 'One' }]);
	} finally {
		globalThis.window = originalWindow;
	}
});

test('custom resolution input is debounced and presents a field-level validation message', () => {
	const canvas = fs.readFileSync(canvasPath, 'utf8');
	const settings = fs.readFileSync(settingsPath, 'utf8');

	assert.match(canvas, /scheduleImageRenditions\(\)/);
	assert.match(canvas, /renditionTimer/);
	assert.match(settings, /v-model\.number="node\.settings\.customImageWidth"/);
	assert.match(settings, /v-model\.number="node\.settings\.customImageHeight"/);
	assert.match(settings, /customResolutionError/);
	assert.match(settings, /pb-form-error/);
});

