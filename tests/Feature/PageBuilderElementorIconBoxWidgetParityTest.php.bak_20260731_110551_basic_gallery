                    'linkTarget' => '_blank',
                    'linkNofollow' => true,
                    'linkCustomAttributes' => [['key' => 'data-track', 'value' => 'icon-box']],
                    'iconPosition' => 'left',
                    'iconPositionTablet' => 'top',
                    'alignment' => 'left',
                    'primaryColor' => '#1d4ed8',
