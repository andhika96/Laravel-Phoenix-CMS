    public function test_title_tag_drives_automatic_canvas_and_frontend_heading_size_until_typography_is_custom(): void
    {
        $app = file_get_contents(public_path('js/pagebuilder_elementor/app.js'));
        $settings = file_get_contents(public_path('js/pagebuilder_elementor/widgets/general/icon-box/Settings.vue'));
        $canvas = file_get_contents(public_path('js/pagebuilder_elementor/widgets/general/icon-box/Canvas.vue'));

        $iconBoxDefaults = substr(
            $app,
            strpos($app, 'function iconBoxWidgetDefaults()'),
            strpos($app, 'const iconBoxHoverAnimations') - strpos($app, 'function iconBoxWidgetDefaults()')
        );

        $this->assertStringContainsString("titleFontSizeMode: 'auto'", $iconBoxDefaults);
        $this->assertStringContainsString('font-size-mode-key="titleFontSizeMode"', $settings);
        $this->assertStringContainsString('TITLE_TAG_FONT_SIZES', $canvas);
        $this->assertStringContainsString('automaticTitleFontSize()', $canvas);
        $this->assertStringContainsString("this.settings.titleFontSizeMode === 'custom'", $canvas);

        foreach ([
            ['tag' => 'h1', 'mode' => 'auto', 'storedSize' => '29px', 'expectedSize' => '40px'],
            ['tag' => 'h6', 'mode' => 'auto', 'storedSize' => '29px', 'expectedSize' => '16px'],
            ['tag' => 'h6', 'mode' => 'custom', 'storedSize' => '37px', 'expectedSize' => '37px'],
        ] as $case) {
            $html = view('pagebuilder_elementor.partials.render_icon_box', [
                'node' => [
                    'id' => 'icon-box-title-'.$case['tag'].'-'.$case['mode'],
                    'type' => 'icon_box',
                    'settings' => [
                        'title' => 'Tag-aware title',
                        'titleTag' => $case['tag'],
                        'titleFontSizeMode' => $case['mode'],
                        'titleFontSize' => $case['storedSize'],
                    ],
                ],
            ])->render();

            $this->assertStringContainsString('<'.$case['tag'], $html);
            $this->assertStringContainsString('font-size:'.$case['expectedSize'], $html);
        }
    }

    public function test_canvas_and_frontend_render_safe_responsive_styled_icon_box(): void
