            $this->assertStringContainsString($marker, $canvas);
        }
        foreach (['WidgetAdvancedStyleResolver', 'DynamicTagResolver', 'pb-icon-box__icon', '@media (max-width:', 'safeLinkUrl'] as $marker) {
            $this->assertStringContainsString($marker, $partial);
        }

        $html = view('pagebuilder_elementor.partials.render_icon_box', [
            'node' => [
                'id' => 'icon-box-parity',
                'type' => 'icon_box',
                'settings' => [
