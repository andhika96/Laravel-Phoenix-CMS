    public function test_frontend_rejects_unsafe_url_tag_icon_and_attributes(): void
    {
        $html = view('pagebuilder_elementor.partials.render_icon_box', [
            'node' => [
                'id' => 'unsafe-icon-box',
                'type' => 'icon_box',
                'settings' => [
                    'iconClass' => 'fas fa-star onclick=alert(1)',
                    'title' => 'Safe title',
                    'titleTag' => 'script',
                    'linkUrl' => 'javascript:alert(1)',
                    'linkCustomAttributes' => [['key' => 'onclick', 'value' => 'alert(1)']],
                ],
            ],
        ])->render();

        $this->assertStringContainsString('<h3', $html);
        $this->assertStringContainsString('far fa-star', $html);
        $this->assertStringNotContainsString('javascript:', $html);
        $this->assertStringNotContainsString('onclick=', $html);
        $this->assertStringNotContainsString('<script', $html);
    }

    public function test_all_elementor_hover_animation_values_are_persisted_to_the_frontend_contract(): void
    {
        $animations = [
            'grow', 'shrink', 'pulse', 'pulse-grow', 'pulse-shrink', 'push', 'pop',
            'bounce-in', 'bounce-out', 'rotate', 'grow-rotate', 'float', 'sink', 'bob',
            'hang', 'skew', 'skew-forward', 'skew-backward', 'wobble-vertical',
            'wobble-horizontal', 'wobble-to-bottom-right', 'wobble-to-top-right',
            'wobble-top', 'wobble-bottom', 'wobble-skew', 'buzz', 'buzz-out',
        ];

        foreach ($animations as $animation) {
            $html = view('pagebuilder_elementor.partials.render_icon_box', [
                'node' => [
                    'id' => 'icon-box-'.$animation,
                    'type' => 'icon_box',
                    'settings' => ['hoverAnimation' => $animation],
                ],
            ])->render();

            $this->assertStringContainsString('pb-icon-box--hover-'.$animation, $html);
        }
    }

    public function test_default_stacked_and_framed_views_render_their_shape_and_color_contracts(): void
    {
        foreach (['default', 'stacked', 'framed'] as $view) {
            $html = view('pagebuilder_elementor.partials.render_icon_box', [
                'node' => [
                    'id' => 'icon-box-'.$view,
                    'type' => 'icon_box',
                    'settings' => [
                        'view' => $view,
                        'shape' => 'circle',
                        'primaryColor' => '#123456',
                        'secondaryColor' => '#fedcba',
                    ],
                ],
            ])->render();

            $this->assertStringContainsString('is-view-'.$view, $html);
            $this->assertStringContainsString('is-shape-circle', $html);
            $this->assertStringContainsString('#123456', $html);
            if ($view === 'stacked') {
                $this->assertStringContainsString('color:#fedcba', $html);
                $this->assertStringContainsString('background-color:#123456', $html);
            } elseif ($view === 'framed') {
                $this->assertStringContainsString('border-style:solid', $html);
                $this->assertStringContainsString('border-color:#123456', $html);
            } else {
                $this->assertStringContainsString('border-style:none', $html);
            }
        }
    }

