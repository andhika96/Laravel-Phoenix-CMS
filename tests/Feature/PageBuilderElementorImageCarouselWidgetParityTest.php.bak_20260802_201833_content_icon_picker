    public function test_content_style_and_additional_options_change_the_frontend_contract(): void
    {
        $images = [
            ['id' => 'one', 'url' => '/storage/gallery/one.jpg', 'alt' => 'One', 'description' => 'First project description'],
            ['id' => 'two', 'url' => '/storage/gallery/two.jpg', 'alt' => 'Two', 'description' => 'Second project description'],
            ['id' => 'three', 'url' => '/storage/gallery/three.jpg', 'alt' => 'Three', 'description' => 'Third project description'],
        ];
        $settings = [
            'carouselName' => 'Projects carousel',
            'images' => $images,
            'slidesToShow' => '2',
            'slidesToScroll' => '2',
            'imageStretch' => true,
            'navigation' => 'arrows',
            'previousArrowIcon' => 'fas fa-circle-left',
            'nextArrowIcon' => 'fas fa-circle-right',
            'linkType' => 'media',
            'lightbox' => 'no',
            'captionType' => 'description',
            'lazyload' => true,
            'autoplay' => false,
            'pauseOnHover' => false,
            'pauseOnInteraction' => false,
            'autoplaySpeed' => 1750,
            'infiniteLoop' => false,
            'animationSpeed' => 725,
            'direction' => 'right',
            'arrowPosition' => 'outside',
            'arrowSize' => '33px',
            'arrowColor' => '#112233',
            'paginationPosition' => 'inside',
            'dotSpacing' => '11px',
            'dotSize' => '13px',
            'dotColor' => '#445566',
            'dotActiveColor' => '#778899',
            'imageSpacingMode' => 'custom',
            'imageSpacing' => '14px',
            'captionColor' => '#123456',
            'captionTextTransform' => 'uppercase',
            'captionFontStyle' => 'italic',
            'captionTextDecoration' => 'underline',
            'captionTextShadow' => '1px 1px 2px #000000',
        ];

        $html = view('pagebuilder_elementor.partials.render_image_carousel', [
            'node' => ['id' => 'options-carousel', 'type' => 'image_carousel', 'settings' => $settings],
        ])->render();
        $compact = preg_replace('/\s+/', ' ', $html);

        foreach ([
            'aria-label="Projects carousel"',
            'is-arrows-outside',
            'is-pagination-inside',
            '--pb-carousel-arrow-size:33px',
            '--pb-carousel-arrow-color:#112233',
            '--pb-carousel-dot-size:13px',
            '--pb-carousel-dot-gap:11px',
            '--pb-carousel-dot-color:#445566',
            '--pb-carousel-dot-active:#778899',
            '--pb-carousel-image-gap:14px',
            '--pb-carousel-transition:725ms',
            'width:100%;height:auto;object-fit:contain',
            'loading="lazy"',
            'fas fa-circle-left',
            'fas fa-circle-right',
            'First project description',
            'text-transform:uppercase',
            'font-style:italic',
            'text-decoration:underline',
            'text-shadow:1px 1px 2px #000000',
        ] as $marker) {
            $this->assertStringContainsString($marker, $compact);
        }
        $this->assertStringNotContainsString('data-carousel-lightbox', $compact);
        $this->assertStringNotContainsString('pb-image-carousel__pagination', $compact);

        $this->assertMatchesRegularExpression('/data-carousel-config="([^"]+)"/', $html);
        preg_match('/data-carousel-config="([^"]+)"/', $html, $matches);
        $config = json_decode(html_entity_decode($matches[1], ENT_QUOTES), true, flags: JSON_THROW_ON_ERROR);
        $this->assertSame(2, $config['slidesToShow']);
        $this->assertSame(2, $config['slidesToScroll']);
        $this->assertFalse($config['autoplay']);
        $this->assertFalse($config['pauseOnHover']);
        $this->assertFalse($config['pauseOnInteraction']);
        $this->assertSame(1750, $config['autoplaySpeed']);
        $this->assertFalse($config['infiniteLoop']);
        $this->assertSame(725, $config['animationSpeed']);
        $this->assertSame('right', $config['direction']);

        $settings['imageStretch'] = false;
        $settings['navigation'] = 'none';
        $unstretched = view('pagebuilder_elementor.partials.render_image_carousel', [
            'node' => ['id' => 'unstretched-carousel', 'type' => 'image_carousel', 'settings' => $settings],
        ])->render();
        $this->assertStringContainsString('width:auto;height:auto;object-fit:contain', preg_replace('/\s+/', ' ', $unstretched));
    }
    public function test_frontend_renderer_outputs_safe_carousel_markup_and_rejects_unsafe_urls(): void
    {
        $html = view('pagebuilder_elementor.partials.render_image_carousel', [
            'node' => [
                'id' => 'carousel-parity',
                'type' => 'image_carousel',
                'settings' => [
                    'images' => [
                        ['id' => 'safe', 'url' => '/storage/gallery/one.jpg', 'alt' => 'Safe image', 'title' => 'First title', 'caption' => 'First caption'],
                        ['id' => 'safe-two', 'url' => '/storage/gallery/two.jpg', 'alt' => 'Second image', 'title' => 'Second title', 'caption' => 'Second caption'],
                        ['id' => 'unsafe', 'url' => 'javascript:alert(1)', 'alt' => 'Unsafe image'],
                    ],
                    'navigation' => 'arrows_dots',
