<?php

namespace Tests\Feature;

use Tests\TestCase;

class PageBuilderElementorTabsWidgetParityTest extends TestCase
{
    public function test_editor_exposes_general_category_and_tabs_controls(): void
    {
        $appJs = file_get_contents(public_path('js/pagebuilder_elementor/app.js'));

        $this->assertIsString($appJs);
        $this->assertStringContainsString("general: [", $appJs);
        $this->assertStringContainsString("{ type:'tabs',", $appJs);
        $this->assertStringContainsString("label:'Tabs'", $appJs);
        $this->assertStringContainsString("selectedType==='tabs'", $appJs);
        $this->assertStringContainsString('Tabs Items', $appJs);
        $this->assertStringContainsString('Add Tab', $appJs);
        $this->assertStringContainsString('Horizontal Scroll', $appJs);
        $this->assertStringContainsString('Breakpoint', $appJs);
    }

    public function test_tabs_preview_component_exists_and_renders_nested_tab_shell(): void
    {
        $tabsVuePath = public_path('js/pagebuilder_elementor/widgets/general/Tabs.vue');

        $this->assertFileExists($tabsVuePath);

        $tabsVue = file_get_contents($tabsVuePath);

        $this->assertIsString($tabsVue);
        $this->assertStringContainsString("name: 'GeneralTabs'", $tabsVue);
        $this->assertStringContainsString('el-widget-tabs', $tabsVue);
        $this->assertStringContainsString('activeTab()', $tabsVue);
        $this->assertStringContainsString('tabItems()', $tabsVue);
    }

    public function test_tabs_canvas_preview_marks_interactive_areas_to_avoid_parent_selection_clicks(): void
    {
        $appJs = file_get_contents(public_path('js/pagebuilder_elementor/app.js'));
        $tabsVue = file_get_contents(public_path('js/pagebuilder_elementor/widgets/general/Tabs.vue'));
        $builderCss = file_get_contents(public_path('assets/css/pagebuilder_elementor.css'));

        $this->assertIsString($appJs);
        $this->assertIsString($tabsVue);
        $this->assertIsString($builderCss);
        $this->assertStringContainsString('@click.stop="onNodeContentClick(node, $event)"', $appJs);
        $this->assertStringContainsString("function isInteractiveCanvasTarget(target)", $appJs);
        $this->assertStringContainsString('data-pb-interactive="true"', $tabsVue);
        $this->assertStringContainsString('@click.stop="activateTab(tab.id)"', $tabsVue);
        $this->assertStringContainsString('.pb-node.pb-node-tabs .pb-preview,', $builderCss);
        $this->assertStringContainsString('.pb-node.pb-node-tabs .pb-dropzone-tab,', $builderCss);
        $this->assertStringContainsString('pointer-events: auto;', $builderCss);
    }

    public function test_tabs_canvas_preview_defers_nested_layout_dropzones_to_child_grid_columns(): void
    {
        $appJs = file_get_contents(public_path('js/pagebuilder_elementor/app.js'));
        $builderCss = file_get_contents(public_path('assets/css/pagebuilder_elementor.css'));

        $this->assertIsString($appJs);
        $this->assertIsString($builderCss);
        $this->assertStringContainsString('data-pb-nested-dropzone="true"', $appJs);
        $this->assertStringContainsString(':move="onTabDropzoneMove"', $appJs);
        $this->assertStringContainsString('function isNestedCanvasDropTarget(target)', $appJs);
        $this->assertStringContainsString('[data-pb-nested-dropzone="true"]', $builderCss);
    }

    public function test_frontend_renderer_emits_tabs_markup_and_nested_children(): void
    {
        $html = view('pagebuilder_elementor.partials.render_node', [
            'node' => [
                'id' => 'tabs-node',
                'type' => 'tabs',
                'settings' => [
                    'direction' => 'row',
                    'justify' => 'flex-start',
                    'alignTitle' => 'center',
                    'horizontalScroll' => false,
                    'breakpoint' => 'mobile',
                    'activeTabId' => 'tab-1',
                    'cssClass' => 'custom-tabs-node',
                ],
                'tabItems' => [
                    [
                        'id' => 'tab-1',
                        'title' => 'Tab #1',
                        'iconClass' => '',
                        'activeIconClass' => '',
                        'cssId' => 'tab-one',
                        'children' => [
                            [
                                'id' => 'heading-inside-tab',
                                'type' => 'heading',
                                'settings' => [
                                    'text' => 'Heading inside tab',
                                    'tag' => 'h3',
                                    'align' => 'left',
                                    'color' => '#101828',
                                ],
                            ],
                        ],
                    ],
                    [
                        'id' => 'tab-2',
                        'title' => 'Tab #2',
                        'iconClass' => '',
                        'activeIconClass' => '',
                        'cssId' => 'tab-two',
                        'children' => [],
                    ],
                ],
            ],
        ])->render();

        $this->assertStringContainsString('el-widget-tabs', $html);
        $this->assertStringContainsString('custom-tabs-node', $html);
        $this->assertStringContainsString('el-widget-tabs__nav', $html);
        $this->assertStringContainsString('Tab #1', $html);
        $this->assertStringContainsString('Tab #2', $html);
        $this->assertStringContainsString('Heading inside tab', $html);
        $this->assertStringContainsString('data-tab-id="tab-1"', $html);
        $this->assertStringContainsString('data-tab-panel="tab-1"', $html);
    }
}
