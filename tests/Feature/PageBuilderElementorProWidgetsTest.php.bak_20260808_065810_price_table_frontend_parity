<?php

namespace Tests\Feature;

use Illuminate\Support\Facades\File;
use Tests\TestCase;

class PageBuilderElementorProWidgetsTest extends TestCase
{
    private const WIDGETS = [
        'form' => ['Form', 'form'],
        'slides' => ['Slides', 'slides'],
        'animated_headline' => ['Animated Headline', 'animated-headline'],
        'hotspot' => ['Hotspot', 'hotspot'],
        'price_list' => ['Price List', 'price-list'],
        'price_table' => ['Price Table', 'price-table'],
        'call_to_action' => ['Call to Action', 'call-to-action'],
        'countdown' => ['Countdown', 'countdown'],
        'carousel' => ['Carousel', 'carousel'],
        'flip_box' => ['Flip Box', 'flip-box'],
    ];

    public function test_ten_widgets_are_registered_in_a_dedicated_pro_category(): void
    {
        foreach (self::WIDGETS as $type => [$label, $directory]) {
            $module = config("pagebuilder_elementor_widgets.{$type}");

            $this->assertIsArray($module, "Missing {$type} module.");
            $this->assertSame($type, $module['type']);
            $this->assertSame($label, $module['label']);
            $this->assertSame('pro', $module['category']);
            $this->assertTrue($module['toolbox']);
            $this->assertStringContainsString("/pro/{$directory}/definition.js", $module['definition']);
            $this->assertFileExists(public_path($module['definition']));
            $this->assertFileExists(public_path($module['canvas']));
            $this->assertFileExists(public_path($module['settings']));
            $this->assertTrue(view()->exists($module['view']));
        }
    }

    public function test_toolbox_and_editor_shell_render_the_pro_category(): void
    {
        $app = File::get(public_path('js/pagebuilder_elementor/app.js'));

        $this->assertStringContainsString('toolbox.pro', $app);
        $this->assertStringContainsString('>Pro<', $app);
        foreach (array_keys(self::WIDGETS) as $type) {
            $this->assertStringContainsString("{$type}:", $app);
        }
    }

    public function test_pro_settings_map_elementor_content_style_and_shared_advanced_controls(): void
    {
        $settings = File::get(public_path('js/pagebuilder_elementor/widgets/pro/shared/Settings.vue'));

        foreach ([
            'Form Fields', 'Actions After Submit', 'Slider Options', 'Animated Text',
            'Tooltip', 'Separator', 'Currency Symbol', 'Hover Effects', 'Actions After Expire',
            'Slides on display', 'Flip Effect', 'Normal', 'Hover', 'Border Radius',
        ] as $label) {
            $this->assertStringContainsString($label, $settings);
        }

        $this->assertStringContainsString('editor.widgetAdvancedControls', $settings);
        $this->assertStringContainsString('editor.typographyControl', $settings);
        $this->assertStringContainsString('editor.linkControl', $settings);
        $this->assertStringNotContainsString('v-if="false"', $settings);
        $this->assertStringContainsString('prefix="formLabel"', $settings);
        $this->assertStringContainsString('prefix="slideTitle"', $settings);
        $this->assertStringContainsString('prefix="headline"', $settings);
        $this->assertStringContainsString('prefix="tooltip"', $settings);
        $this->assertStringContainsString('prefix="priceListTitle"', $settings);
        $this->assertStringContainsString('prefix="priceTablePrice"', $settings);
        $this->assertStringContainsString('prefix="ctaTitle"', $settings);
        $this->assertStringContainsString('prefix="countdownDigit"', $settings);
        $this->assertStringContainsString('prefix="carouselTitle"', $settings);
        $this->assertStringContainsString('prefix="flipFrontTitle"', $settings);
        $this->assertGreaterThanOrEqual(7, substr_count($settings, '<link-field'));
        $this->assertStringContainsString('pb-widget-settings--pro', $settings);
        $this->assertStringContainsString('responsive', $settings);
        $this->assertStringContainsString('unit', $settings);
        $this->assertStringNotContainsString('s.__', $settings);
        $this->assertStringContainsString('buttonStates', $settings);
    }

    public function test_pro_canvas_contains_widget_specific_accessible_interactions(): void
    {
        $canvas = File::get(public_path('js/pagebuilder_elementor/widgets/pro/shared/Canvas.vue'));

        foreach (['data-pro-form', 'data-pro-slides', 'data-pro-hotspot', 'data-pro-countdown', 'data-pro-carousel', 'data-pro-flip-box'] as $hook) {
            $this->assertStringContainsString($hook, $canvas);
        }

        $this->assertStringContainsString('aria-live', $canvas);
        $this->assertStringContainsString('@click.stop', $canvas);
        $this->assertStringContainsString('@keydown', $canvas);
        $this->assertStringContainsString('prefers-reduced-motion', $canvas);
        $this->assertStringContainsString("typographyStyle('ctaTitle'", $canvas);
        $this->assertStringContainsString("typographyStyle('carouselTitle'", $canvas);
        $this->assertStringContainsString("this.type==='slides'?['both','dots'].includes(this.s.navigation):this.s.pagination!=='none'", $canvas);
        $this->assertStringContainsString(':global(.pb-node .pb-pro-canvas [data-pb-interactive="true"])', $canvas);
        $this->assertStringContainsString('carouselMaxIndex(){return Math.max(0,this.itemCount-this.carouselVisible)}', $canvas);
        $this->assertStringContainsString('carouselPageCount(){return Math.max(1,Math.ceil(this.carouselMaxIndex/this.carouselStep)+1)}', $canvas);
        $this->assertStringContainsString("s.tooltipTrigger==='hover'&&(openHotspot=index)", $canvas);
        $this->assertStringContainsString("s.tooltipTrigger==='click'&&toggleHotspot(index)", $canvas);
    }

    public function test_frontend_renderer_outputs_each_pro_widget_and_sanitizes_unsafe_links(): void
    {
        foreach (array_keys(self::WIDGETS) as $type) {
            $html = view('pagebuilder_elementor.partials.render_pro_widget', [
                'node' => [
                    'id' => "{$type}-example",
                    'type' => $type,
                    'settings' => ['linkUrl' => 'javascript:alert(1)', 'buttonLink' => 'javascript:alert(1)'],
                ],
            ])->render();

            $this->assertStringContainsString("data-pro-widget=\"{$type}\"", $html);
            $this->assertStringNotContainsString('javascript:', $html);
        }
    }

    public function test_frontend_runtime_initializes_pro_interactions_once(): void
    {
        $runtime = File::get(public_path('js/pagebuilder_elementor/frontend-runtime.js'));

        foreach (['initProSlides', 'initProCarousel', 'initProCountdown', 'initProHotspot', 'initProFlipBox', 'initProForm'] as $function) {
            $this->assertStringContainsString("function {$function}", $runtime);
        }
        $this->assertStringContainsString('data-pb-pro-ready', $runtime);
        $this->assertStringContainsString('dot.hidden = carousel && dotIndex >= pageCount', $runtime);
        $this->assertStringContainsString('interact(pageIndex * step())', $runtime);
    }

    public function test_pro_links_preserve_safe_elementor_metadata_and_reject_unsafe_attributes(): void
    {
        $html = view('pagebuilder_elementor.partials.render_pro_widget', [
            'node' => [
                'id' => 'slides-links',
                'type' => 'slides',
                'settings' => [
                    'slides' => [[
                        'title' => 'Linked slide',
                        'buttonText' => 'Open details',
                        'linkUrl' => 'https://example.com/details',
                        'linkTarget' => '_blank',
                        'linkNofollow' => true,
                        'linkCustomAttributes' => [
                            ['key' => 'aria-label', 'value' => 'Open slide details'],
                            ['key' => 'onclick', 'value' => 'alert(1)'],
                        ],
                    ]],
                    'navigation' => 'none',
                ],
            ],
        ])->render();

        $this->assertStringContainsString('href="https://example.com/details"', $html);
        $this->assertStringContainsString('target="_blank"', $html);
        $this->assertStringContainsString('rel="noopener noreferrer nofollow"', $html);
        $this->assertStringContainsString('aria-label="Open slide details"', $html);
        $this->assertStringNotContainsString('onclick=', $html);
    }

    public function test_carousel_frontend_honors_navigation_pagination_and_item_links(): void
    {
        $html = view('pagebuilder_elementor.partials.render_pro_widget', [
            'node' => [
                'id' => 'carousel-controls',
                'type' => 'carousel',
                'settings' => [
                    'items' => [[
                        'title' => 'Linked card',
                        'description' => 'Description',
                        'linkUrl' => '/details',
                    ]],
                    'navigation' => 'none',
                    'pagination' => 'none',
                ],
            ],
        ])->render();

        $this->assertStringContainsString('href="/details"', $html);
        $this->assertStringNotContainsString('data-pro-prev', $html);
        $this->assertStringNotContainsString('data-pro-next', $html);
        $this->assertStringNotContainsString('data-pro-index', $html);
    }

    public function test_pro_typography_controls_affect_frontend_output(): void
    {
        $html = view('pagebuilder_elementor.partials.render_pro_widget', [
            'node' => [
                'id' => 'cta-typography',
                'type' => 'call_to_action',
                'settings' => [
                    'title' => 'Styled title',
                    'description' => 'Styled description',
                    'ctaTitleFontFamily' => 'Georgia',
                    'ctaTitleFontSize' => '28px',
                    'ctaTitleFontWeight' => '700',
                    'ctaTitleTextTransform' => 'uppercase',
                    'ctaDescriptionFontSize' => '15px',
                ],
            ],
        ])->render();

        $this->assertStringContainsString('font-family:Georgia', $html);
        $this->assertStringContainsString('font-size:28px', $html);
        $this->assertStringContainsString('font-weight:700', $html);
        $this->assertStringContainsString('text-transform:uppercase', $html);
        $this->assertStringContainsString('font-size:15px', $html);
    }

    public function test_price_list_style_controls_affect_frontend_output(): void
    {
        $html = view('pagebuilder_elementor.partials.render_pro_widget', [
            'node' => [
                'id' => 'priced-menu',
                'type' => 'price_list',
                'settings' => [
                    'items' => [[
                        'id' => 'coffee',
                        'title' => 'Coffee',
                        'price' => '$4',
                        'description' => 'Fresh',
                        'imageUrl' => '/coffee.jpg',
                    ]],
                    'rowGap' => '24px',
                    'verticalAlign' => 'middle',
                    'titleColor' => '#112233',
                    'priceColor' => '#223344',
                    'descriptionColor' => '#334455',
                    'separatorStyle' => 'dashed',
                    'separatorWeight' => '3px',
                    'separatorColor' => '#445566',
                    'separatorSpacing' => '12px',
                    'imageSize' => '72px',
                    'imageRadius' => '9px',
                    'imageSpacing' => '18px',
                ],
            ],
        ])->render();

        $this->assertStringContainsString('--row-gap:24px', $html);
        $this->assertStringContainsString('--item-align:center', $html);
        $this->assertStringContainsString('--item-gap:18px', $html);
        $this->assertStringContainsString('--separator-style:dashed', $html);
        $this->assertStringContainsString('--separator-width:3px', $html);
        $this->assertStringContainsString('--separator-color:#445566', $html);
        $this->assertStringContainsString('--separator-spacing:12px', $html);
        $this->assertStringContainsString('--image-size:72px', $html);
        $this->assertStringContainsString('--image-radius:9px', $html);
        $this->assertStringContainsString('color:#112233', $html);
        $this->assertStringContainsString('color:#223344', $html);
        $this->assertStringContainsString('color:#334455', $html);
    }
}
