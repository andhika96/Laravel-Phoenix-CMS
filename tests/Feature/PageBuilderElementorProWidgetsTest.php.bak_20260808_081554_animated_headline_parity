    public function test_ten_widgets_are_registered_in_a_dedicated_pro_category(): void
    {
        foreach (self::WIDGETS as $type => [$label, $directory]) {
            $module = config("pagebuilder_elementor_widgets.{$type}");

            $this->assertIsArray($module, "Missing {$type} module.");
            $this->assertSame($type, $module['type']);
            $this->assertSame($label, $module['label']);
            $this->assertSame('pro', $module['category']);
            $this->assertTrue($module['toolbox']);
            $this->assertStringContainsString("/pro/{$directory}/definition.js", $module['definition']);
            $this->assertFileExists(public_path($module['definition']));
            $this->assertFileExists(public_path($module['canvas']));
            $this->assertFileExists(public_path($module['settings']));
            $this->assertTrue(view()->exists($module['view']));
        }
    }

    public function test_toolbox_and_editor_shell_render_the_pro_category(): void
    {
        $app = File::get(public_path('js/pagebuilder_elementor/app.js'));

        $this->assertStringContainsString('toolbox.pro', $app);
        $this->assertStringContainsString('>Pro<', $app);
        foreach (array_keys(self::WIDGETS) as $type) {
            $this->assertStringContainsString("{$type}:", $app);
        }
    }

