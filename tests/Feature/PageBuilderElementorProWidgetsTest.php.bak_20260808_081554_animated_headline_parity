        }

        $fractionHtml = view('pagebuilder_elementor.partials.render_pro_widget', [
            'node' => ['id' => 'fraction-carousel', 'type' => 'carousel', 'settings' => [...$settings, 'pagination' => 'fraction']],
        ])->render();
        $this->assertStringContainsString('data-pro-current', $fractionHtml);
        $this->assertStringContainsString('data-pro-total', $fractionHtml);

        $runtime = File::get(public_path('js/pagebuilder_elementor/frontend-runtime.js'));
        $this->assertStringContainsString("root.querySelector(':scope [data-pro-progress]')", $runtime);
        $this->assertStringContainsString("root.querySelector(':scope [data-pro-current]')", $runtime);
        $this->assertStringContainsString('config.transitionSpeed', $runtime);
        $this->assertStringContainsString('config.equalHeight', $runtime);
    }

