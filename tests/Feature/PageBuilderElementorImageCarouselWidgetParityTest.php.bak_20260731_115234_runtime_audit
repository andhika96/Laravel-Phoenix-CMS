    public function test_frontend_renderer_outputs_safe_carousel_markup_and_rejects_unsafe_urls(): void
    {
        $html = view('pagebuilder_elementor.partials.render_image_carousel', [
            'node' => [
                'id' => 'carousel-parity',
                'type' => 'image_carousel',
                'settings' => [
                    'images' => [
                        ['id' => 'safe', 'url' => '/storage/gallery/one.jpg', 'alt' => 'Safe image', 'title' => 'First title', 'caption' => 'First caption'],
                        ['id' => 'safe-two', 'url' => '/storage/gallery/two.jpg', 'alt' => 'Second image', 'title' => 'Second title', 'caption' => 'Second caption'],
                        ['id' => 'unsafe', 'url' => 'javascript:alert(1)', 'alt' => 'Unsafe image'],
                    ],
                    'navigation' => 'arrows_dots',
                    'captionType' => 'caption',
                    'linkType' => 'custom',
                    'customLinkUrl' => 'https://example.com/gallery',
                    'slidesToShow' => '3',
                    'slidesToShowTablet' => '2',
                    'slidesToShowMobile' => '1',
                    'cssId' => 'featured-carousel',
                    'cssClass' => 'marketing-carousel',
                ],
            ],
        ])->render();

        $compact = preg_replace('/\s+/', ' ', $html);
        $this->assertStringContainsString('id="featured-carousel"', $compact);
        $this->assertStringContainsString('data-image-carousel', $compact);
        $this->assertStringContainsString('data-carousel-config=', $compact);
        $this->assertStringNotContainsString('&amp;quot;', $html);
        $this->assertStringContainsString('pb-image-carousel__track', $compact);
        $this->assertStringContainsString('pb-image-carousel__slide', $compact);
        $this->assertStringContainsString('pb-image-carousel__arrow--previous', $compact);
        $this->assertStringContainsString('pb-image-carousel__pagination', $compact);
        $this->assertStringContainsString('First caption', $compact);
        $this->assertStringContainsString('href="https://example.com/gallery"', $compact);
        $this->assertStringNotContainsString('javascript:', $compact);
        $this->assertSame(2, substr_count($compact, 'pb-image-carousel__slide'));
    }

    public function test_custom_image_resolution_is_bounded_and_generated_by_the_rendition_endpoint(): void
    {
        $testRoot = storage_path('framework/testing/image-carousel-rendition-'.bin2hex(random_bytes(5)));
        $sourceRoot = $testRoot.DIRECTORY_SEPARATOR.'media';
        $outputRoot = $testRoot.DIRECTORY_SEPARATOR.'renditions';

        File::ensureDirectoryExists($sourceRoot);
        $sourceImage = imagecreatetruecolor(640, 360);
        imagefill($sourceImage, 0, 0, imagecolorallocate($sourceImage, 45, 93, 156));
        imagepng($sourceImage, $sourceRoot.DIRECTORY_SEPARATOR.'source.png');
        imagedestroy($sourceImage);

        $this->app->instance(ImageRenditionResolver::class, new ImageRenditionResolver(
            sourceRoots: ['media' => $sourceRoot],
            outputRoot: $outputRoot,
            outputUrlPrefix: '/test-carousel-renditions',
        ));

        try {
            $response = $this->getJson(route('cms.core.pagebuilder_elementor.image_rendition', [
                'url' => '/media/source.png',
                'size' => 'custom',
                'width' => 320,
                'height' => 180,
            ]));

            $response
                ->assertOk()
                ->assertJsonPath('size', 'custom')
                ->assertJsonPath('width', 320)
                ->assertJsonPath('height', 180);

            $this->assertMatchesRegularExpression(
                '#^/test-carousel-renditions/[a-f0-9]{40}-custom-320x180\.png$#',
                (string) $response->json('url')
            );
        } finally {
            File::deleteDirectory($testRoot);
        }
    }
}
