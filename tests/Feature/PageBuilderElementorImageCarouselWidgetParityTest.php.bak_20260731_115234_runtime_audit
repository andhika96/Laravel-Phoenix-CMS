<?php

namespace Tests\Feature;

use App\Support\PageBuilderElementor\ImageRenditionResolver;
use Illuminate\Support\Facades\File;
use Tests\TestCase;

class PageBuilderElementorImageCarouselWidgetParityTest extends TestCase
{
    public function test_image_carousel_is_registered_as_a_general_complex_widget(): void
    {
        $module = config('pagebuilder_elementor_widgets.image_carousel');

        $this->assertIsArray($module);
        $this->assertSame('image_carousel', $module['type']);
        $this->assertSame('Image Carousel', $module['label']);
        $this->assertSame('general', $module['category']);
        $this->assertTrue($module['toolbox']);
        $this->assertFileExists(public_path($module['definition']));
        $this->assertFileExists(public_path($module['canvas']));
        $this->assertFileExists(public_path($module['settings']));
        $this->assertTrue(view()->exists($module['view']));
    }

    public function test_editor_state_and_gallery_picker_own_the_complete_carousel_contract(): void
    {
        $app = file_get_contents(public_path('js/pagebuilder_elementor/app.js'));
        $definition = file_get_contents(public_path('js/pagebuilder_elementor/widgets/general/image-carousel/definition.js'));

        foreach ([
            "type: 'image_carousel'",
            "category: 'general'",
            'PageBuilderElementorComplexWidgetRuntime?.image_carousel',
        ] as $marker) {
            $this->assertStringContainsString($marker, $definition);
        }

        foreach ([
            'function imageCarouselWidgetDefaults()',
            'function normalizeImageCarouselSettings(settings)',
            'function chooseMediaGallery(targetObj, propName)',
            'function removeMediaGalleryItem(targetObj, propName, itemId)',
            'function moveMediaGalleryItem(targetObj, propName, itemId, offset)',
            "image_carousel: {",
            "if (c.type === 'image_carousel')",
            "images: []",
            "imageResolution: 'thumbnail'",
            "slidesToShow: 'default'",
            "slidesToScroll: 'default'",
            "navigation: 'arrows_dots'",
            'autoplay: true',
            'pauseOnHover: true',
            'pauseOnInteraction: true',
            'autoplaySpeed: 5000',
            'infiniteLoop: true',
            'animationSpeed: 500',
            "direction: 'left'",
            '...widgetAdvancedDefaults()',
        ] as $marker) {
            $this->assertStringContainsString($marker, $app);
        }

        $this->assertStringContainsString('files:choose', $app);
        $this->assertStringContainsString('chooseFiles: true', $app);
        $this->assertStringContainsString('chooseMediaGallery,', $app);
        $this->assertStringContainsString('removeMediaGalleryItem,', $app);
        $this->assertStringContainsString('moveMediaGalleryItem,', $app);
    }

