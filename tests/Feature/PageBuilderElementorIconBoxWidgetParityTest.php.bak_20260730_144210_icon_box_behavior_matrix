<?php

namespace Tests\Feature;

use Tests\TestCase;

class PageBuilderElementorIconBoxWidgetParityTest extends TestCase
{
    public function test_icon_box_is_a_registered_general_complex_widget(): void
    {
        $module = config('pagebuilder_elementor_widgets.icon_box');

        $this->assertIsArray($module);
        $this->assertSame('icon_box', $module['type']);
        $this->assertSame('Icon Box', $module['label']);
        $this->assertSame('general', $module['category']);
        $this->assertTrue($module['toolbox']);
        $this->assertFileExists(public_path($module['definition']));
        $this->assertFileExists(public_path($module['canvas']));
        $this->assertFileExists(public_path($module['settings']));
        $this->assertTrue(view()->exists($module['view']));
    }

    public function test_definition_owns_complete_defaults_and_normalization(): void
    {
        $definition = file_get_contents(public_path('js/pagebuilder_elementor/widgets/general/icon-box/definition.js'));
        $app = file_get_contents(public_path('js/pagebuilder_elementor/app.js'));

        foreach ([
            "type: 'icon_box'",
            "category: 'general'",
            'defaults()',
            'normalize(node)',
            'PageBuilderElementorComplexWidgetRuntime?.icon_box',
        ] as $marker) {
            $this->assertStringContainsString($marker, $definition);
        }

        foreach ([
            'function iconBoxWidgetDefaults()',
            'function normalizeIconBoxSettings(settings)',
            'icon_box: {',
            "if (c.type === 'icon_box')",
            "this.node.type === 'icon_box'",
        ] as $marker) {
            $this->assertStringContainsString($marker, $app);
        }
    }

    public function test_settings_map_elementor_content_style_conditionals_and_advanced(): void
    {
        $settings = file_get_contents(public_path('js/pagebuilder_elementor/widgets/general/icon-box/Settings.vue'));

        foreach (['Content', 'Style', 'Advanced', 'Icon Box', 'View', 'Shape', 'Title', 'Description', 'Link', 'Title HTML Tag'] as $label) {
            $this->assertStringContainsString($label, $settings);
        }

        foreach (['Default', 'Stacked', 'Framed', 'Square', 'Rounded', 'Circle'] as $option) {
            $this->assertStringContainsString($option, $settings);
        }

        foreach (['Icon Position', 'Alignment', 'Icon Spacing', 'Content Spacing', 'Primary Color', 'Secondary Color', 'Size', 'Padding', 'Rotate', 'Border Width', 'Border Radius', 'Hover Animation', 'Text Stroke', 'Text Shadow'] as $control) {
            $this->assertStringContainsString($control, $settings);
        }

        $this->assertStringContainsString("node.settings.view !== 'default'", $settings);
        $this->assertStringContainsString("node.settings.view === 'framed'", $settings);
        $this->assertStringContainsString("editor.iconBoxIconState === 'hover'", $settings);
        $this->assertStringContainsString('editor.openIconLibrary(node)', $settings);
        $this->assertStringContainsString('editor.dynamicTagControl', $settings);
        $this->assertStringContainsString('editor.linkControl', $settings);
        $this->assertStringContainsString('editor.typographyControl', $settings);
        $this->assertStringContainsString('editor.widgetAdvancedControls', $settings);
    }

    public function test_canvas_and_frontend_render_safe_responsive_styled_icon_box(): void
    {
        $canvas = file_get_contents(public_path('js/pagebuilder_elementor/widgets/general/icon-box/Canvas.vue'));
        $partial = file_get_contents(resource_path('views/pagebuilder_elementor/partials/render_icon_box.blade.php'));

        foreach (['safeLinkUrl', 'safeTitleTag', 'responsiveValue', 'iconStyle', 'titleStyle', 'descriptionStyle', 'pb-icon-box__icon', 'pb-icon-box__content'] as $marker) {
            $this->assertStringContainsString($marker, $canvas);
        }
        foreach (['WidgetAdvancedStyleResolver', 'DynamicTagResolver', 'pb-icon-box__icon', '@media (max-width:', 'safeLinkUrl'] as $marker) {
            $this->assertStringContainsString($marker, $partial);
        }

        $html = view('pagebuilder_elementor.partials.render_icon_box', [
            'node' => [
                'id' => 'icon-box-parity',
                'type' => 'icon_box',
                'settings' => [
                    'iconClass' => 'fas fa-bolt',
                    'view' => 'framed',
                    'shape' => 'rounded',
                    'title' => 'Fast delivery',
                    'description' => 'Delivered safely.',
                    'titleTag' => 'h4',
                    'linkUrl' => 'https://example.com/service',
                    'linkTarget' => '_blank',
                    'linkNofollow' => true,
                    'linkCustomAttributes' => [['key' => 'data-track', 'value' => 'icon-box']],
                    'iconPosition' => 'left',
                    'iconPositionTablet' => 'top',
                    'alignment' => 'left',
                    'primaryColor' => '#1d4ed8',
                    'secondaryColor' => '#ffffff',
                    'iconSize' => '36px',
                    'iconPadding' => '18px',
                    'iconBorderWidth' => '2px',
                    'titleColor' => '#111827',
                    'descriptionColor' => '#475467',
                    'cssId' => 'service-icon-box',
                    'cssClass' => 'featured-service',
                    'attributes' => [['name' => 'data-widget', 'value' => 'icon-box']],
                ],
            ],
        ])->render();
        $compact = preg_replace('/\s+/', ' ', $html);

        $this->assertStringContainsString('id="service-icon-box"', $compact);
        $this->assertStringContainsString('featured-service', $compact);
        $this->assertStringContainsString('data-widget="icon-box"', $compact);
        $this->assertStringContainsString('fas fa-bolt', $compact);
        $this->assertStringContainsString('is-view-framed', $compact);
        $this->assertStringContainsString('is-shape-rounded', $compact);
        $this->assertStringContainsString('<h4', $compact);
        $this->assertStringContainsString('Fast delivery', $compact);
        $this->assertStringContainsString('Delivered safely.', $compact);
        $this->assertStringContainsString('href="https://example.com/service"', $compact);
        $this->assertStringContainsString('target="_blank"', $compact);
        $this->assertStringContainsString('nofollow', $compact);
        $this->assertStringContainsString('data-track="icon-box"', $compact);
        $this->assertStringContainsString('@media(max-width:1024px)', str_replace(' ', '', $html));
    }

    public function test_frontend_rejects_unsafe_url_tag_icon_and_attributes(): void
    {
        $html = view('pagebuilder_elementor.partials.render_icon_box', [
            'node' => [
                'id' => 'unsafe-icon-box',
                'type' => 'icon_box',
                'settings' => [
                    'iconClass' => 'fas fa-star onclick=alert(1)',
                    'title' => 'Safe title',
                    'titleTag' => 'script',
                    'linkUrl' => 'javascript:alert(1)',
                    'linkCustomAttributes' => [['key' => 'onclick', 'value' => 'alert(1)']],
                ],
            ],
        ])->render();

        $this->assertStringContainsString('<h3', $html);
        $this->assertStringContainsString('far fa-star', $html);
        $this->assertStringNotContainsString('javascript:', $html);
        $this->assertStringNotContainsString('onclick=', $html);
        $this->assertStringNotContainsString('<script', $html);
    }
}
