<?php

namespace Tests\Feature;

use Tests\TestCase;

class PageBuilderElementorBasicWidgetStyleParityTest extends TestCase
{
    public function test_missing_basic_style_tabs_follow_elementor_style_control_contract(): void
    {
        $widgets = [
			'button' => ['Style', 'Position', 'typographyControl', 'textShadowControl', 'Background Type', 'Box Shadow', 'Horizontal', 'Vertical', 'Position', 'Border Radius', 'Padding'],
			'text-editor' => ['Style', 'Alignment', 'typographyControl', 'textShadowControl', 'Paragraph Spacing', 'Link Color'],
            'icon' => ['Style', 'Alignment', 'Primary Color', 'Secondary Color', 'Size', 'Rotate'],
        ];

        foreach ($widgets as $folder => $markers) {
            $settings = file_get_contents(public_path('js/pagebuilder_elementor/widgets/basic/'.$folder.'/Settings.vue'));
            $this->assertIsString($settings);
            $this->assertStringContainsString('class="pb-tab-nav"', $settings);
            $this->assertStringContainsString('>Content</span>', $settings);
            $this->assertStringContainsString('>Style</span>', $settings);
            $this->assertStringContainsString('>Advanced</span>', $settings);

            foreach ($markers as $marker) {
                $this->assertStringContainsString($marker, $settings, "Missing {$marker} marker in {$folder} settings.");
            }

            $this->assertStringContainsString('activeResponsiveKey', $settings);
            $this->assertStringContainsString('setResponsiveSetting', $settings);
        }
    }

    public function test_basic_style_panels_follow_general_compact_control_density(): void
    {
        $css = file_get_contents(public_path('assets/css/pagebuilder_elementor.css'));
        $this->assertIsString($css);

        foreach ([
            '.pb-basic-button-style-settings, .pb-basic-text-style-settings, .pb-basic-icon-style-settings',
            '.pb-basic-button-style-settings .pb-basic-inline-editor',
			'.pb-basic-button-style-settings .pb-basic-shadow-fields',
			'.pb-basic-button-style-settings .pb-basic-shadow-actions',
			'.pb-basic-button-style-settings .pb-basic-reset-button',
            '.pb-basic-responsive-choice .pb-basic-segmented',
			'.pb-basic-button-style-settings :is(.pb-basic-edit-button, .pb-basic-reset-button)',
			'.pb-panel.left .pb-widget-settings--button .pb-basic-button-icon-source-grid',
			'.pb-panel.left .pb-widget-settings--button .pb-basic-button-icon-action',
            '.pb-basic-icon-style-settings .pb-range-value-row',
            '.pb-typography-trigger-actions',
            '.pb-typography-trigger',
            '.pb-text-effect-trigger',
        ] as $marker) {
            $this->assertStringContainsString($marker, $css, "Missing compact density marker {$marker}.");
        }

        $this->assertStringContainsString('grid-template-columns: minmax(0, 1fr) 68px;', $css);
		$this->assertStringContainsString(".pb-panel.left .pb-basic-button-style-settings .pb-basic-shadow-fields {\n\tdisplay: flex;", $css);
		$this->assertStringContainsString(".pb-panel.left .pb-basic-button-style-settings .pb-basic-inline-editor__summary {\n\tdisplay: flex;", $css);
		$this->assertStringContainsString('min-width: 30px;', $css);
        $this->assertStringContainsString('min-height: 34px;', $css);
        $this->assertStringContainsString('width: 48px;', $css);
        $this->assertStringContainsString('width: 30px;', $css);
        $this->assertStringContainsString('height: 28px;', $css);
        $this->assertStringContainsString('gap: 4px;', $css);
		$this->assertStringContainsString('height: 30px;', $css);
    }

	public function test_button_box_shadow_control_follows_elementor_popover_contract(): void
	{
		$settings = file_get_contents(public_path('js/pagebuilder_elementor/widgets/basic/button/Settings.vue'));
		$this->assertIsString($settings);
		$this->assertStringContainsString('class="pb-basic-shadow-actions"', $settings);
		$this->assertStringContainsString(":aria-label=\"open ? 'Close Box Shadow' : 'Edit Box Shadow'\"", $settings);
		$this->assertStringContainsString('aria-label="Back to default"', $settings);
		$this->assertStringContainsString('Horizontal', $settings);
		$this->assertStringContainsString('Vertical', $settings);
		$this->assertStringContainsString('Blur', $settings);
		$this->assertStringContainsString('Spread', $settings);
		$this->assertStringContainsString('Position', $settings);
		$this->assertStringContainsString('<option value="outline">Outline</option>', $settings);
		$this->assertStringContainsString('<option value="inset">Inset</option>', $settings);
		$this->assertStringNotContainsString('>Enable</label>', $settings);
	}

	public function test_button_icon_sources_and_frontend_output_follow_elementor_contract(): void
	{
		$settings = file_get_contents(public_path('js/pagebuilder_elementor/widgets/basic/button/Settings.vue'));
		$css = file_get_contents(public_path('assets/css/pagebuilder_elementor.css'));
		$this->assertIsString($settings);
		$this->assertIsString($css);
		foreach (['Remove icon', 'Upload SVG', 'Icon Library', 'Icon Position', 'Icon Spacing', 'aria-label="Remove icon"'] as $marker) {
			$this->assertStringContainsString($marker, $settings);
		}
		foreach (['.pb-panel.left .pb-widget-settings--button .pb-basic-button-icon-source-grid', '.pb-panel.left .pb-widget-settings--button .pb-basic-button-icon-selected', '.pb-panel.left .pb-widget-settings--button .pb-basic-button-icon-spacing-row'] as $marker) {
			$this->assertStringContainsString($marker, $css);
		}

		$html = view('pagebuilder_elementor.partials.render_node', ['node' => [
			'id' => 'button-icon-output',
			'type' => 'button',
			'settings' => [
				'text' => 'Continue',
				'iconSource' => 'library',
				'iconStyle' => 'solid',
				'iconName' => 'arrow-right',
				'iconClass' => 'fas fa-arrow-right',
				'buttonIconPosition' => 'row-reverse',
				'buttonIconSpacing' => '12px',
			],
		]])->render();

		$this->assertStringContainsString('el-widget-button__icon', $html);
		$this->assertStringContainsString('fas fa-arrow-right', $html);
		$this->assertStringContainsString('flex-direction:row-reverse', $html);
		$this->assertStringContainsString('gap:12px', $html);
	}

    public function test_basic_unit_controls_and_shared_action_spacing_follow_elementor_reference(): void
    {
        $icon = file_get_contents(public_path('js/pagebuilder_elementor/widgets/basic/icon/Settings.vue'));
        $divider = file_get_contents(public_path('js/pagebuilder_elementor/widgets/basic/divider/Settings.vue'));
        $canvas = file_get_contents(public_path('js/pagebuilder_elementor/widgets/basic/divider/Canvas.vue'));
        $blade = file_get_contents(resource_path('views/pagebuilder_elementor/widgets/basic/divider.blade.php'));

        foreach ([$icon, $divider, $canvas, $blade] as $source) $this->assertIsString($source);
        $this->assertStringContainsString(":units=\"['px','%','em','rem','vw']\"", $icon);
        $this->assertStringContainsString(":units=\"['deg','grad','rad','turn']\"", $icon);
		$this->assertStringContainsString("editor.openControlResponsiveMenu('divider-thickness')", $divider);
		$this->assertStringContainsString('aria-label="Thickness unit" @change="setThicknessUnit($event)"', $divider);
		$this->assertStringContainsString('class="pb-value-with-unit"><input class="pb-input pb-input-compact"', $divider);
        $this->assertStringContainsString("thicknessUnits: ['px', 'em', 'rem']", $divider);
        $this->assertStringContainsString('borderTop: thickness + thicknessUnit', $canvas);
		$this->assertStringContainsString('$thicknessUnit', $blade);
		$this->assertStringContainsString('$settings[\'thicknessTablet\']', $blade);
		$this->assertStringContainsString('$settings[\'thicknessMobile\']', $blade);
    }

