    public function test_icon_style_reaches_frontend_and_responsive_css(): void
    {
        $html = view('pagebuilder_elementor.partials.render_node', ['node' => [
            'id' => 'icon-style-output',
            'type' => 'icon',
            'settings' => [
                'iconClass' => 'fas fa-star',
                'view' => 'framed',
                'shape' => 'rounded',
                'primaryColor' => '#123456',
                'secondaryColor' => '#abcdef',
                'iconSize' => '48px',
                'iconSizeMobile' => '30px',
                'iconRotate' => '12deg',
            ],
        ]])->render();

        $this->assertStringContainsString('id="pb-basic-icon-icon-style-output"', $html);
        $this->assertStringContainsString('--pb-icon-primary:#123456', $html);
        $this->assertStringContainsString('--pb-icon-secondary:#abcdef', $html);
        $this->assertStringContainsString('font-size:48px', $html);
        $this->assertStringContainsString('transform:rotate(12deg)', $html);
        $this->assertStringContainsString('font-size:30px', $html);

        $gradHtml = view('pagebuilder_elementor.partials.render_node', ['node' => [
            'id' => 'icon-grad-output',
            'type' => 'icon',
            'settings' => ['iconRotate' => '100grad'],
        ]])->render();

        $this->assertStringContainsString('transform:rotate(100grad)', $gradHtml);
    }

    public function test_divider_thickness_reaches_frontend_at_each_responsive_breakpoint(): void
    {
        $html = view('pagebuilder_elementor.partials.render_node', ['node' => [
            'id' => 'divider-thickness-output',
            'type' => 'divider',
            'settings' => [
                'thickness' => '2px',
                'thicknessTablet' => '3em',
                'thicknessMobile' => '4rem',
                'style' => 'dashed',
                'color' => '#123456',
            ],
        ]])->render();

        $this->assertStringContainsString('border-top:2px dashed #123456', $html);
        $this->assertStringContainsString('@media (max-width: 1024px){#pb-node-divider-thickness-output > hr{border-top:3em dashed #123456}}', $html);
        $this->assertStringContainsString('@media (max-width: 767px){#pb-node-divider-thickness-output > hr{border-top:4rem dashed #123456}}', $html);
    }
}
