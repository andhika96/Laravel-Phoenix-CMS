<?php

namespace Tests\Feature;

use Tests\Concerns\InteractsWithPageBuilderElementorV24Modules;
use Tests\TestCase;

class PageBuilderElementorV24ProductColorSelectorWidgetTest extends TestCase
{
    use InteractsWithPageBuilderElementorV24Modules;
    public function test_product_color_selector_is_registered_as_a_pro_widget_with_its_definition(): void
    {
        $module = $this->pageBuilderV24Module('product_color_selector');

        $this->assertIsArray($module);
        $this->assertSame('product_color_selector', $module['type'] ?? null);
        $this->assertSame('Product Color Selector', $module['label'] ?? null);
        $this->assertSame('pro', $module['category'] ?? null);
        $this->assertSame('fas fa-palette', $module['icon'] ?? null);
        $this->assertFileExists($module['assets']['definition'] ?? 'missing');
        $this->assertFileExists($module['assets']['canvas'] ?? 'missing');
        $this->assertFileExists($module['assets']['settings'] ?? 'missing');
        $this->assertFileExists($module['assets']['view'] ?? 'missing');
    }

    public function test_product_color_selector_renders_responsive_media_and_safe_fallbacks(): void
    {
        $html = $this->pageBuilderV24ModuleViewByType('product_color_selector', [
            'node' => [
                'id' => 'pcs-render-test',
                'type' => 'product_color_selector',
                'settings' => [
                    'title' => 'Choose <script>alert(1)</script>',
                    'listPosition' => 'bottom',
                    'listPositionTablet' => 'right',
                    'items' => [
                        [
                            'id' => 'black',
                            'name' => 'Black',
                            'description' => 'Short description',
                            'swatchColor' => '#111827',
                            'imageUrl' => '/storage/black.webp',
                            'imageUrlTablet' => '/storage/black-tablet.webp',
                            'imageUrlMobile' => 'javascript:alert(1)',
                        ],
                    ],
                    'defaultItemId' => 'black',
                ],
            ],
        ])->render();

        $this->assertStringContainsString('data-product-color-selector', $html);
        $this->assertStringContainsString('data-product-color-panel', $html);
        $this->assertStringContainsString('/storage/black-tablet.webp', $html);
        $this->assertStringNotContainsString('javascript:alert(1)', $html);
        $this->assertStringContainsString('&lt;script&gt;alert(1)&lt;/script&gt;', $html);
    }

    public function test_product_color_selector_renders_selected_indicator_settings_in_frontend_markup(): void
    {
        $html = $this->pageBuilderV24ModuleViewByType('product_color_selector', [
            'node' => [
                'id' => 'pcs-indicator-test',
                'type' => 'product_color_selector',
                'settings' => [
                    'selectedCheckVisible' => true,
                    'selectedCheckPosition' => 'bottom-left',
                    'selectedCheckSize' => '24px',
                    'selectedCheckIconSize' => '12px',
                    'selectedCheckOffset' => '8px',
                    'selectedCheckRadius' => '2px 4px 6px 8px',
                    'selectedCheckColor' => '#111827',
                    'selectedCheckBackground' => '#ffffff',
                    'defaultItemId' => 'color-1',
                ],
            ],
        ])->render();

        $this->assertStringContainsString('--pb-pcs-selected-check-size:24px', $html);
        $this->assertStringContainsString('--pb-pcs-selected-check-icon-size:12px', $html);
        $this->assertStringContainsString('--pb-pcs-selected-check-offset:8px', $html);
        $this->assertStringContainsString('--pb-pcs-selected-check-radius:2px 4px 6px 8px', $html);
        $this->assertStringContainsString('bottom:var(--pb-pcs-selected-check-bottom)', $html);
        $this->assertStringContainsString('class="pb-product-color-selector__indicator is-selected"', $html);
        $this->assertSame(3, substr_count($html, '<span class="pb-product-color-selector__indicator'));
        $this->assertMatchesRegularExpression('/aria-hidden="true"\s+hidden/', $html);
    }

    public function test_product_color_selector_keeps_unselected_ring_opt_in_and_default_off(): void
    {
        $defaultHtml = $this->pageBuilderV24ModuleViewByType('product_color_selector', [
            'node' => ['id' => 'pcs-ring-default', 'type' => 'product_color_selector', 'settings' => []],
        ])->render();
        $enabledHtml = $this->pageBuilderV24ModuleViewByType('product_color_selector', [
            'node' => [
                'id' => 'pcs-ring-enabled',
                'type' => 'product_color_selector',
                'settings' => [
                    'unselectedRingVisible' => true,
                    'unselectedRingColor' => '#f9fafb',
                    'unselectedRingBorderWidth' => '3pt',
                    'unselectedRingBackground' => 'transparent',
                ],
            ],
        ])->render();

        $this->assertStringContainsString('data-product-color-unselected-ring="false"', $defaultHtml);
        $this->assertStringContainsString('data-product-color-unselected-ring="true"', $enabledHtml);
        $this->assertStringContainsString('--pb-pcs-unselected-ring-color:#f9fafb', $enabledHtml);
        $this->assertStringContainsString('--pb-pcs-unselected-ring-border-width:3pt', $enabledHtml);
        $this->assertStringContainsString('--pb-pcs-unselected-ring-background:transparent', $enabledHtml);
        $this->assertStringContainsString('is-unselected', $enabledHtml);
    }

    public function test_product_color_selector_separates_variant_list_spacing_from_item_gap(): void
    {
        $html = $this->pageBuilderV24ModuleViewByType('product_color_selector', [
            'node' => [
                'id' => 'pcs-list-spacing-test',
                'type' => 'product_color_selector',
                'settings' => [
                    'listGap' => '0px',
                    'variantListSpacing' => '24px',
                    'variantListSpacingTablet' => '12px',
                ],
            ],
        ])->render();

        $this->assertStringContainsString('--pb-pcs-variant-list-spacing:24px', $html);
        $this->assertStringContainsString('--pb-pcs-variant-list-spacing:12px', $html);
        $this->assertStringContainsString('gap:var(--pb-pcs-variant-list-spacing)', $html);
        $this->assertStringContainsString('gap:var(--pb-pcs-list-gap)', $html);
    }
}
