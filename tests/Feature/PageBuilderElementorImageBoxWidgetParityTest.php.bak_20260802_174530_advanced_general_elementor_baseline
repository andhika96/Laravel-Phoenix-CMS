    public function test_frontend_renderer_rejects_unsafe_image_and_link_urls(): void
    {
        $html = view('pagebuilder_elementor.partials.render_image_box', [
            'node' => [
                'id' => 'unsafe-image-box',
                'type' => 'image_box',
                'settings' => [
                    'imageUrl' => 'javascript:alert(1)',
                    'title' => 'Safe title',
                    'description' => 'Safe description',
                    'linkUrl' => 'javascript:alert(2)',
                    'titleTag' => 'script',
                ],
            ],
        ])->render();

        $this->assertStringNotContainsString('javascript:', $html);
        $this->assertStringNotContainsString('<script', $html);
        $this->assertStringContainsString('<h3 class="pb-image-box__title"', $html);
        $this->assertStringContainsString('pb-image-box__empty-media', $html);
    }
    public function test_style_colors_use_only_the_local_coloris_picker(): void
    {
        $settings = file_get_contents(public_path('js/pagebuilder_elementor/widgets/general/image-box/Settings.vue'));

        $this->assertIsString($settings);
        $this->assertStringNotContainsString('type="color"', $settings);
