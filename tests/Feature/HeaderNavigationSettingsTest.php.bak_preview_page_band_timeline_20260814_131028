	public function test_editorial_option_two_workspace_keeps_preview_and_inspector_as_sibling_columns(): void
	{
		$view = file_get_contents(resource_path('views/awesome_admin/header_navigation/awesome_admin_header_navigation.blade.php'));
		$document = new \DOMDocument();
		$previousLibxmlErrors = libxml_use_internal_errors(true);
		$document->loadHTML($view);
		libxml_clear_errors();
		libxml_use_internal_errors($previousLibxmlErrors);
		$xpath = new \DOMXPath($document);
		$workspaceStart = strpos($view, '<div class="mock-workspace-grid">');
		$controlStart = strpos($view, '<div class="mock-control-pane">', $workspaceStart);
		$previewStart = strpos($view, '<div class="mock-preview-pane">', $controlStart);

		$this->assertNotFalse($workspaceStart);
		$this->assertNotFalse($controlStart);
		$this->assertNotFalse($previewStart);
		$this->assertGreaterThan($workspaceStart, $controlStart);
		$this->assertGreaterThan($controlStart, $previewStart);

		$controlToPreview = substr($view, $controlStart, $previewStart - $controlStart);
		$this->assertSame(
			substr_count($controlToPreview, '<div'),
			substr_count($controlToPreview, '</div>'),
			'The control pane must be fully closed before the preview pane begins.'
		);

		$this->assertSame(1, $xpath->query('//div[contains(concat(" ", normalize-space(@class), " "), " mock-workspace-grid ")]/div[contains(concat(" ", normalize-space(@class), " "), " mock-control-pane ")]')->length);
		$this->assertSame(1, $xpath->query('//div[contains(concat(" ", normalize-space(@class), " "), " mock-workspace-grid ")]/div[contains(concat(" ", normalize-space(@class), " "), " mock-preview-pane ")]')->length);
		$this->assertSame(3, $xpath->query('//div[contains(concat(" ", normalize-space(@class), " "), " inspector-content ")]/section[contains(concat(" ", normalize-space(@class), " "), " inspector-tab-panel ")]')->length);
	}

