        );

        $this->assertSame(['bootstrap5'], $result['frameworks']);
        $this->assertSame('Bootstrap Home', $result['pageName']);
        $this->assertCount(1, $result['layout']);
        $this->assertSame('container', $result['layout'][0]['type']);
