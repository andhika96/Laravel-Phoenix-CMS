        );

        $this->assertSame('compiled', $result['mode']);
        $this->assertSame('container', $result['layout'][0]['type']);
        $this->assertArrayHasKey('compilePayload', $result);
        $this->assertArrayHasKey('exactFallback', $result);
        $this->assertSame('static_html', $result['exactFallback']['layout'][0]['type']);
        $this->assertStringContainsString('data-pb-import-node="', $result['compilePayload']['html']);
        $this->assertArrayHasKey('lg:text-[6.2rem]', $result['compilePayload']['classMap']);
        $this->assertNotEmpty($result['compilePayload']['markerMap']);
