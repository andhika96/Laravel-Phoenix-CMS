        $this->assertSame('import-node-', substr((string) ($result['compilePayload']['sections'][0]['marker'] ?? ''), 0, 12));
    }

    public function test_compiled_import_marks_carousel_and_form_sections_for_local_fallback(): void
    {
        $html = <<<'HTML'
<!doctype html><html><body>
<header id="header"><nav><a href="#home">Home</a></nav></header>
<main><section id="features"><div class="snap-track flex gap-4 overflow-x-auto"><article class="snap-card min-w-[78vw]">Feature</article></div></section>
<section id="contact"><form><input name="email"></form></section></main>
<footer id="footer">Footer</footer>
</body></html>
HTML;

        $result = app(StaticPageImportService::class)->convert(
            UploadedFile::fake()->createWithContent('fallback-sections.html', $html),
            'tailwind',
            null,
            'compiled',
        );

        $sections = collect($result['compilePayload']['sections'] ?? [])->keyBy('sourceId');
        $this->assertTrue((bool) $sections['features']['fallback']);
        $this->assertContains('horizontal-snap-layout', $sections['features']['fallbackReasons']);
        $this->assertTrue((bool) $sections['contact']['fallback']);
        $this->assertContains('contains-unsupported-form', $sections['contact']['fallbackReasons']);
        $this->assertFalse((bool) $sections['header']['fallback']);
        $this->assertFalse((bool) $sections['footer']['fallback']);
    }

    public function test_compiled_import_resolves_relative_assets_from_an_explicit_safe_base_url(): void
    {
        $result = app(StaticPageImportService::class)->convert(
            UploadedFile::fake()->createWithContent(
                'relative-assets.html',
                '<html><body><section><img src="competition-assets/poster.jpg" alt="Poster"><a href="register">Register</a></section></body></html>',
