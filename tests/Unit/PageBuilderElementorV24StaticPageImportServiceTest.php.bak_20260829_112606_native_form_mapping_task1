        $this->assertGreaterThan(0, $result['report']['compileEligibleNodes']);
        $this->assertArrayNotHasKey('cssClass', $result['layout'][0]['children'][0]['settings']);
        $this->assertStringNotContainsString('<script', strtolower($result['compilePayload']['html']));
        $this->assertStringNotContainsString('document.querySelector', json_encode($result['compilePayload']));
        $this->assertStringNotContainsString('tailwind', strtolower(json_encode($result['layout'])));
    }

