    public function test_grid_geometry_is_used_when_the_computed_track_list_is_unavailable(): void
    {
        $snapshot = $this->snapshot('desktop', [
            $this->node('measured-grid', 'section', null, ['left', 'right'], [
                'display' => 'grid',
                'gridTemplateColumns' => 'none',
            ]),
            $this->node('left', 'div', 'measured-grid', [], [], ['x' => 0, 'y' => 0, 'width' => 360, 'height' => 100]),
            $this->node('right', 'div', 'measured-grid', [], [], ['x' => 380, 'y' => 0, 'width' => 520, 'height' => 100]),
        ]);

        $layout = (new AutomaticCompiledNativeLayoutClassifier)->classify(
            new SectionIndex([$this->section('measured-grid')]),
            $snapshot,
        )['sections'][0]['layoutByViewport']['desktop'];

        $this->assertSame('grid', $layout['mode']);
