    public function test_nested_source_nodes_are_retained_for_later_mapping(): void
    {
        $snapshot = $this->snapshot('desktop', [
            $this->node('nested', 'section', null, ['wrapper'], ['display' => 'block']),
            $this->node('wrapper', 'div', 'nested', ['heading'], ['display' => 'block']),
            $this->node('heading', 'h2', 'wrapper'),
        ]);

        $section = $this->section('nested', ['nested', 'wrapper', 'heading']);
        $result = (new AutomaticCompiledNativeLayoutClassifier)->classify(new SectionIndex([$section]), $snapshot);

        $this->assertSame(['nested', 'wrapper', 'heading'], array_column($result['sections'][0]['nodes'], 'sourceId'));
        $this->assertSame('container', $result['sections'][0]['nodes'][1]['layoutRole']);
        $this->assertSame('wrapper', $result['sections'][0]['nodes'][2]['parentSourceId']);
    }

    public function test_responsive_classifier_preserves_three_to_two_to_one_column_transition(): void
    {
        $classifier = new AutomaticCompiledNativeResponsiveClassifier;
        $result = $classifier->classify([
            'desktop' => $this->snapshot('desktop', [$this->gridNode('responsive', 'repeat(3, 1fr)')]),
            'tablet' => $this->snapshot('tablet', [$this->gridNode('responsive', 'repeat(2, 1fr)')]),
            'mobile' => $this->snapshot('mobile', [$this->gridNode('responsive', '1fr')]),
        ]);

        $this->assertSame(3, $result['viewports']['desktop']['columns']);
        $this->assertSame(2, $result['viewports']['tablet']['columns']);
        $this->assertSame(1, $result['viewports']['mobile']['columns']);
        $this->assertSame(['desktop:3→tablet:2', 'tablet:2→mobile:1'], $result['transitions']);
    }

    private function section(string $id, array $nodeIds = []): array
    {
        return ['id' => $id, 'sourceId' => $id, 'kind' => 'section', 'nodeIds' => $nodeIds === [] ? [$id] : $nodeIds];
    }

    private function gridNode(string $id, string $tracks): array
    {
        return $this->node($id, 'section', null, ['child-1', 'child-2', 'child-3'], [
            'display' => 'grid',
            'gridTemplateColumns' => $tracks,
        ]);
    }

    /** @param array<int,array<string,mixed>> $nodes */
    private function snapshot(string $viewport, array $nodes): array
    {
        $nodes = array_map(static function (array $node) use ($viewport): array {
            $style = $node['computedStyle'] ?? [];
            $rect = $node['rectByViewport']['desktop'] ?? [
                'x' => 0.0,
                'y' => 0.0,
                'width' => 600.0,
                'height' => 100.0,
            ];

            return [
                ...$node,
                'computedStyleByViewport' => [$viewport => $style],
                'rectByViewport' => [$viewport => $rect],
                'scrollSizeByViewport' => [$viewport => [
                    'width' => (float) ($rect['width'] ?? 0),
                    'height' => (float) ($rect['height'] ?? 0),
                ]],
            ];
        }, $nodes);

        return [
            'version' => 1,
            'viewports' => [['name' => $viewport, 'width' => $viewport === 'mobile' ? 390 : ($viewport === 'tablet' ? 768 : 1180), 'height' => 900]],
            'nodes' => $nodes,
        ];
    }

    /** @param array<int,string> $children @param array<string,string> $style @param array<string,int|float> $rect */
    private function node(string $id, string $tag, ?string $parent, array $children = [], array $style = [], array $rect = []): array
    {
        $computedStyle = array_merge([
            'display' => 'block',
            'position' => 'static',
            'flexDirection' => 'row',
            'flexWrap' => 'nowrap',
            'gridTemplateColumns' => 'none',
            'gap' => '0px',
            'columnGap' => '0px',
        ], $style);
        $record = [
            'x' => (float) ($rect['x'] ?? 0),
            'y' => (float) ($rect['y'] ?? 0),
            'width' => (float) ($rect['width'] ?? 600),
            'height' => (float) ($rect['height'] ?? 100),
        ];

        return [
            'sourceId' => $id,
            'tag' => $tag,
            'id' => $id,
            'classList' => [],
            'parentSourceId' => $parent,
            'computedStyle' => $computedStyle,
            'computedStyleByViewport' => ['desktop' => $computedStyle],
            'rectByViewport' => ['desktop' => $record],
            'scrollSizeByViewport' => ['desktop' => ['width' => $record['width'], 'height' => $record['height']]],
            'children' => $children,
        ];
    }
}
