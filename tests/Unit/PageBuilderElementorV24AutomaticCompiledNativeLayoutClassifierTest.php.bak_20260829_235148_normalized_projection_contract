<?php

namespace Tests\Unit;

use App\Support\PageBuilderElementorV24\CompiledNative\AutomaticCompiledNativeLayoutClassifier;
use App\Support\PageBuilderElementorV24\CompiledNative\AutomaticCompiledNativeResponsiveClassifier;
use App\Support\PageBuilderElementorV24\CompiledNative\SectionIndex;
use Tests\TestCase;

class PageBuilderElementorV24AutomaticCompiledNativeLayoutClassifierTest extends TestCase
{
    public function test_grid_repeat_three_is_classified_as_three_columns_with_track_evidence(): void
    {
        $snapshot = $this->snapshot('desktop', [
            $this->node('cards', 'section', null, ['one', 'two', 'three'], [
                'display' => 'grid',
                'gridTemplateColumns' => 'repeat(3, minmax(0, 1fr))',
                'columnGap' => '20px',
            ]),
            $this->node('one', 'article', 'cards', [], [], ['x' => 0, 'y' => 0, 'width' => 300, 'height' => 120]),
            $this->node('two', 'article', 'cards', [], [], ['x' => 320, 'y' => 0, 'width' => 300, 'height' => 120]),
            $this->node('three', 'article', 'cards', [], [], ['x' => 640, 'y' => 0, 'width' => 300, 'height' => 120]),
        ]);

        $result = (new AutomaticCompiledNativeLayoutClassifier)->classify(
            new SectionIndex([$this->section('cards')]),
            $snapshot,
        );
        $layout = $result['sections'][0]['layoutByViewport']['desktop'];

        $this->assertSame('grid', $layout['mode']);
        $this->assertSame(3, $layout['columns']);
        $this->assertSame(['minmax(0, 1fr)', 'minmax(0, 1fr)', 'minmax(0, 1fr)'], $layout['tracks']);
        $this->assertSame('computedStyle.gridTemplateColumns', $layout['evidence']['rule']);
    }

    public function test_arbitrary_fraction_tracks_are_preserved_as_two_columns(): void
    {
        $snapshot = $this->snapshot('desktop', [
            $this->node('hero', 'section', null, ['copy', 'media'], [
                'display' => 'grid',
                'gridTemplateColumns' => '0.9fr 1.1fr',
            ]),
            $this->node('copy', 'div', 'hero'),
            $this->node('media', 'div', 'hero'),
        ]);

        $layout = (new AutomaticCompiledNativeLayoutClassifier)->classify(
            new SectionIndex([$this->section('hero')]),
            $snapshot,
        )['sections'][0]['layoutByViewport']['desktop'];

        $this->assertSame('grid', $layout['mode']);
        $this->assertSame(2, $layout['columns']);
        $this->assertSame(['0.9fr', '1.1fr'], $layout['tracks']);
    }

    public function test_vertical_block_flow_stays_a_one_column_stack_without_grid(): void
    {
        $snapshot = $this->snapshot('desktop', [
            $this->node('single', 'section', null, ['heading', 'copy'], ['display' => 'block']),
            $this->node('heading', 'h2', 'single', [], [], ['x' => 0, 'y' => 0, 'width' => 600, 'height' => 40]),
            $this->node('copy', 'p', 'single', [], [], ['x' => 0, 'y' => 56, 'width' => 600, 'height' => 80]),
        ]);

        $layout = (new AutomaticCompiledNativeLayoutClassifier)->classify(
            new SectionIndex([$this->section('single')]),
            $snapshot,
        )['sections'][0]['layoutByViewport']['desktop'];

        $this->assertSame('stack', $layout['mode']);
        $this->assertSame(1, $layout['columns']);
        $this->assertSame(['computedStyle.display'], $layout['evidence']['rules']);
    }

    public function test_flex_wrap_uses_geometry_to_report_the_maximum_items_per_line(): void
    {
        $snapshot = $this->snapshot('desktop', [
            $this->node('wrap', 'section', null, ['one', 'two', 'three', 'four'], [
                'display' => 'flex',
                'flexDirection' => 'row',
                'flexWrap' => 'wrap',
                'gap' => '16px',
            ], ['width' => 800, 'height' => 260]),
            $this->node('one', 'div', 'wrap', [], [], ['x' => 0, 'y' => 0, 'width' => 240, 'height' => 100]),
            $this->node('two', 'div', 'wrap', [], [], ['x' => 256, 'y' => 0, 'width' => 240, 'height' => 100]),
            $this->node('three', 'div', 'wrap', [], [], ['x' => 512, 'y' => 0, 'width' => 240, 'height' => 100]),
            $this->node('four', 'div', 'wrap', [], [], ['x' => 0, 'y' => 116, 'width' => 240, 'height' => 100]),
        ]);

        $result = (new AutomaticCompiledNativeLayoutClassifier)->classify(
            new SectionIndex([$this->section('wrap')]),
            $snapshot,
        );
        $layout = $result['sections'][0]['layoutByViewport']['desktop'];

        $this->assertSame('flex', $layout['mode']);
        $this->assertSame(3, $layout['columns']);
        $this->assertSame([['one', 'two', 'three'], ['four']], $layout['lines']);
        $this->assertContains('children.rectByViewport.desktop', $layout['evidence']['rules']);
    }

    public function test_absolute_overlap_is_unclassified_with_an_explicit_diagnostic(): void
    {
        $snapshot = $this->snapshot('desktop', [
            $this->node('overlay', 'section', null, ['background', 'badge'], ['display' => 'block']),
            $this->node('background', 'div', 'overlay', [], [], ['x' => 0, 'y' => 0, 'width' => 600, 'height' => 300]),
            $this->node('badge', 'div', 'overlay', [], ['position' => 'absolute'], ['x' => 480, 'y' => 20, 'width' => 100, 'height' => 40]),
        ]);

        $layout = (new AutomaticCompiledNativeLayoutClassifier)->classify(
            new SectionIndex([$this->section('overlay')]),
            $snapshot,
        )['sections'][0]['layoutByViewport']['desktop'];

        $this->assertSame('unclassified', $layout['mode']);
        $this->assertSame(1, $layout['columns']);
        $this->assertContains('absolute-or-transformed-child', array_column($layout['diagnostics'], 'code'));
    }

