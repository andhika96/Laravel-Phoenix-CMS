    public function test_it_emits_canonical_tailwind_grid_columns_and_responsive_counts(): void
    {
        $result = app(StaticPageImportService::class)->convert(
            UploadedFile::fake()->createWithContent(
                'home.html',
                '<section class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-[.9fr_1.1fr]"><h2>A</h2><h2>B</h2><h2>C</h2></section>',
            ),
        );

        $grid = $result['layout'][0]['children'][0];

        $this->assertSame('grid', $grid['settings']['displayType']);
        $this->assertSame(2, $grid['settings']['gridColumns']);
        $this->assertSame(2, $grid['settings']['gridColumnsTablet']);
        $this->assertSame(1, $grid['settings']['gridColumnsMobile']);
        $this->assertSame('.9fr 1.1fr', $grid['settings']['gridTemplateColumns']);
        $this->assertSame('2', $grid['settings']['gridRows']);
        $this->assertSame([], $grid['children'] ?? []);
        $this->assertCount(4, $grid['columns']);
        $this->assertSame('A', $grid['columns'][0]['children'][0]['settings']['text']);
        $this->assertSame('B', $grid['columns'][1]['children'][0]['settings']['text']);
        $this->assertSame('C', $grid['columns'][2]['children'][0]['settings']['text']);
        $this->assertSame([], $grid['columns'][3]['children']);
    }

