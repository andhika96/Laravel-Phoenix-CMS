    public function test_it_attaches_scoped_css_and_framework_dependencies_only_to_the_imported_root(): void
    {
        $html = <<<'HTML'
<!doctype html><html><head>
<script src="https://cdn.tailwindcss.com"></script>
<script>tailwind.config={theme:{extend:{colors:{ink:"#061426"}}}};</script>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;700&display=swap">
<style>:root { --ink: #061426; } .hero { color: var(--ink); }</style>
</head><body><main class="hero"><h1>Imported</h1></main></body></html>
HTML;

        $result = app(StaticPageImportService::class)->convert(
            UploadedFile::fake()->createWithContent('home.html', $html),
        );

        $metadata = $result['layout'][0]['settings']['staticImport'];
        $this->assertSame(['tailwind'], $metadata['frameworks']);
        $this->assertSame(
            ['https://fonts.googleapis.com/css2?family=Montserrat:wght@400;700&display=swap'],
            $metadata['stylesheets'],
        );
        $this->assertSame('#061426', $metadata['tailwindConfig']['theme']['extend']['colors']['ink']);
        $this->assertStringContainsString('.pb-import-root{--ink:#061426}', $result['customCss']);
        $this->assertStringContainsString('.pb-import-root .hero{color:var(--ink)}', $result['customCss']);
        $this->assertSame(1, $result['report']['processedStyles']);
        $this->assertSame(1, $result['report']['importedStylesheets']);
    }

