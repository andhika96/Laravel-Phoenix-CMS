    public function test_exact_mode_keeps_the_source_dom_inside_a_static_html_widget(): void
    {
        $html = <<<'HTML'
<!doctype html><html><head><title>Exact Landing</title>
<script>alert('must not run')</script>
<script src="https://cdn.tailwindcss.com"></script>
<style>#hero { color: #fff; }</style>
</head><body id="source-body" class="js source-page" lang="en"><main id="hero" class="grid grid-cols-2"><h1>Exact <span>DOM</span></h1><img src="https://example.com/hero.jpg" alt="Hero"></main></body></html>
HTML;

        $result = app(StaticPageImportService::class)->convert(
            UploadedFile::fake()->createWithContent('exact.html', $html),
            'auto',
            null,
            'exact',
        );

        $node = $result['layout'][0];
        $this->assertSame('static_html', $node['type']);
        $this->assertSame('Exact Landing', $result['pageName']);
        $this->assertStringContainsString('<main id="hero" class="grid grid-cols-2">', $node['settings']['srcdoc']);
        $this->assertStringContainsString('<body id="source-body" class="js source-page pb-import-root" lang="en">', $node['settings']['srcdoc']);
        $this->assertStringContainsString('https://cdn.tailwindcss.com', $node['settings']['srcdoc']);
        $this->assertStringContainsString('.pb-import-root :is(#hero,[data-css-id="hero"])', $node['settings']['srcdoc']);
        $this->assertStringContainsString('https://example.com/hero.jpg', $node['settings']['srcdoc']);
        $this->assertStringNotContainsString("alert('must not run')", $node['settings']['srcdoc']);
        $this->assertStringNotContainsString('<script>alert', $node['settings']['srcdoc']);
        $this->assertSame(2, $result['report']['droppedScripts']);
    }

