    public function test_unknown_meaningful_subtrees_are_guided_and_not_mapped_to_empty_text(): void
    {
        $regions = $this->analyze(<<<'HTML'
<!doctype html><html><body>
<section data-pb-import-node="import-node-1"><custom-widget data-pb-import-node="import-node-2">Important content</custom-widget></section>
</body></html>
HTML);

        $unknown = $regions[0]['blocks'][0];
        $this->assertSame('unknown', $unknown['role']);
        $this->assertNull($unknown['recommendedWidget']);
        $this->assertSame([], $unknown['allowedWidgets']);
        $this->assertContains('unmapped-structure', $unknown['warnings']);
        $this->assertSame('guided_native', $regions[0]['recommendedStrategy']);
        $this->assertContains('unmapped-structure', $regions[0]['warnings']);
    }

    public function test_important_hidden_visibility_declarations_are_excluded(): void
    {
        $regions = $this->analyze(<<<'HTML'
<!doctype html><html><body>
<section data-pb-import-node="import-node-1">
    <div style="display:none!important" data-pb-import-node="import-node-2">Display hidden</div>
    <div style="visibility: hidden !important" data-pb-import-node="import-node-3">Visibility hidden</div>
    <p data-pb-import-node="import-node-4">Visible</p>
</section>
HTML);

        $this->assertSame(['block-import-node-4'], array_column($regions[0]['blocks'], 'id'));
        $this->assertSame(2, $regions[0]['stats']['elements']);
        $this->assertSame(1, $regions[0]['stats']['blocks']);
    }

    /** @return array<int, array<string, mixed>> */
    private function analyze(string $html): array
    {
        $dom = new DOMDocument('1.0', 'UTF-8');
        $previous = libxml_use_internal_errors(true);
        $dom->loadHTML('<?xml encoding="UTF-8">'.$html, LIBXML_NONET | LIBXML_HTML_NODEFDTD | LIBXML_COMPACT);
        libxml_clear_errors();
        libxml_use_internal_errors($previous);

        return (new StaticPageRegionAnalyzer())->analyze($dom);
    }

    /** @param array<int, array<string, mixed>> $blocks @return array<int, array<string, mixed>> */
    private function flatten(array $blocks): array
    {
        $flat = [];
        foreach ($blocks as $block) {
            $flat[] = $block;
            $flat = array_merge($flat, $this->flatten(is_array($block['children'] ?? null) ? $block['children'] : []));
        }
        return $flat;
    }
}
