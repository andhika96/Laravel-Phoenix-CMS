    public function test_it_builds_a_hero_block_tree_with_native_recommendations_and_parent_links(): void
    {
        $regions = $this->analyze(<<<'HTML'
<!doctype html><html><body>
<section id="hero" data-pb-import-node="import-node-1">
    <div data-pb-import-node="import-node-2">
        <h1 data-pb-import-node="import-node-3">CEO Masters</h1>
        <p data-pb-import-node="import-node-4">Lead with clarity.</p>
        <div data-pb-import-node="import-node-5">
            <a href="/start" role="button" data-pb-import-node="import-node-6">Start</a>
        </div>
        <img src="hero.jpg" alt="Hero" data-pb-import-node="import-node-7">
    </div>
</section>
HTML);

        $this->assertSame('container', $regions[0]['recommendedWidget']);
        $root = $regions[0]['blocks'][0];
        $this->assertSame('layout', $root['role']);
        $this->assertSame('container', $root['recommendedWidget']);
        $this->assertSame(null, $root['parentId']);
        $this->assertSame(['block-import-node-3', 'block-import-node-4', 'block-import-node-5', 'block-import-node-7'], array_column($root['children'], 'id'));
        $this->assertSame('block-import-node-2', $root['children'][0]['parentId']);
        $this->assertSame(['heading', 'text', 'layout', 'image'], array_column($root['children'], 'role'));
        $this->assertSame(['heading', 'text_editor', 'container', 'image'], array_column($root['children'], 'recommendedWidget'));
        $this->assertSame(['heading', 'text_editor'], $root['children'][0]['allowedWidgets']);
        $this->assertSame('button', $root['children'][2]['children'][0]['recommendedWidget']);
    }

    public function test_it_recommends_native_widgets_for_supported_elements_and_card_collections(): void
    {
        $regions = $this->analyze(<<<'HTML'
<!doctype html><html><body>
<section data-pb-import-node="import-node-1">
    <form data-pb-import-node="import-node-2"><input name="email" data-pb-import-node="import-node-3"></form>
    <video src="movie.mp4" data-pb-import-node="import-node-4"></video>
    <hr data-pb-import-node="import-node-5">
    <div data-pb-import-node="import-node-6">
        <article data-pb-import-node="import-node-7">One</article>
        <article data-pb-import-node="import-node-8">Two</article>
    </div>
</section>
HTML);

        $blocks = $this->flatten($regions[0]['blocks']);
        $byMarker = [];
        foreach ($blocks as $block) $byMarker[$block['marker']] = $block;

        $this->assertSame(['form', 'form'], [$byMarker['import-node-2']['role'], $byMarker['import-node-2']['recommendedWidget']]);
        $this->assertSame([], $byMarker['import-node-2']['children']);
        $this->assertSame(['video', 'video'], [$byMarker['import-node-4']['role'], $byMarker['import-node-4']['recommendedWidget']]);
        $this->assertSame(['divider', 'divider'], [$byMarker['import-node-5']['role'], $byMarker['import-node-5']['recommendedWidget']]);
        $this->assertSame(['card_collection', 'carousel'], [$byMarker['import-node-6']['role'], $byMarker['import-node-6']['recommendedWidget']]);
        $this->assertSame('guided_native', $regions[0]['recommendedStrategy']);
    }

