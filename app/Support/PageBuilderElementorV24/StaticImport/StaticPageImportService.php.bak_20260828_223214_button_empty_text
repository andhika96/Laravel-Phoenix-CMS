<?php

namespace App\Support\PageBuilderElementorV24\StaticImport;

use DOMDocument;
use DOMElement;
use DOMNode;
use Illuminate\Http\UploadedFile;
use InvalidArgumentException;
use ZipArchive;

final class StaticPageImportService
{
    private int $sequence = 0;

    /** @return array<string, mixed> */
    public function convert(UploadedFile $source, string $framework = 'auto', ?string $entry = null): array
    {
        $extension = strtolower((string) ($source->getClientOriginalExtension() ?: pathinfo($source->getClientOriginalName(), PATHINFO_EXTENSION)));
        if ($extension === 'zip') {
            return $this->convertZip($source, $framework, $entry);
        }
        if (! in_array($extension, ['html', 'htm'], true)) {
            throw new InvalidArgumentException('Only HTML or ZIP files are supported.');
        }
        if (($source->getSize() ?: 0) > 2 * 1024 * 1024) {
            throw new InvalidArgumentException('HTML source exceeds the conservative 2 MB limit.');
        }

        $html = file_get_contents($source->getRealPath());
        if ($html === false || trim($html) === '') {
            throw new InvalidArgumentException('The HTML file is empty or unreadable.');
        }

        return $this->convertHtml($html, $framework, pathinfo($source->getClientOriginalName(), PATHINFO_FILENAME));
    }

    /** @return array<string, mixed> */
    private function convertZip(UploadedFile $source, string $framework, ?string $requestedEntry): array
    {
        if (($source->getSize() ?: 0) > 20 * 1024 * 1024) {
            throw new InvalidArgumentException('ZIP source exceeds the 20 MB compressed limit.');
        }

        $zip = new ZipArchive();
        if ($zip->open($source->getRealPath()) !== true) {
            throw new InvalidArgumentException('The ZIP source could not be opened.');
        }

        $htmlEntries = [];
        $assetCount = 0;
        $expandedBytes = 0;
        try {
            if ($zip->numFiles > 500) throw new InvalidArgumentException('ZIP contains more than 500 files.');
            for ($index = 0; $index < $zip->numFiles; $index++) {
                $stat = $zip->statIndex($index);
                $name = str_replace('\\', '/', (string) ($stat['name'] ?? ''));
                if ($name === '' || str_ends_with($name, '/')) continue;
                if (str_starts_with($name, '/') || preg_match('/^[A-Za-z]:/', $name) || preg_match('~(^|/)\.\.(?:/|$)~', $name)) {
                    throw new InvalidArgumentException('ZIP contains an unsafe path.');
                }
                if (substr_count(trim($name, '/'), '/') > 8) throw new InvalidArgumentException('ZIP path depth exceeds the limit.');
                $expandedBytes += max(0, (int) ($stat['size'] ?? 0));
                if ($expandedBytes > 100 * 1024 * 1024) throw new InvalidArgumentException('ZIP expanded content exceeds the 100 MB limit.');
                $extension = strtolower(pathinfo($name, PATHINFO_EXTENSION));
                if (in_array($extension, ['html', 'htm'], true)) $htmlEntries[] = $name;
                if (in_array($extension, ['png', 'jpg', 'jpeg', 'gif', 'webp', 'svg', 'woff', 'woff2', 'ttf', 'otf'], true)) $assetCount++;
            }

            $entry = $this->selectZipEntry($htmlEntries, $requestedEntry);
            $html = $zip->getFromName($entry);
            if ($html === false || trim($html) === '') throw new InvalidArgumentException('The selected ZIP HTML entry is empty.');
        } finally {
            $zip->close();
        }

        // ponytail: ZIP assets stay as reported paths in this vertical slice; promote through FileManagerV2 batches when asset persistence is scheduled.
        $result = $this->convertHtml($html, $framework, pathinfo($entry, PATHINFO_FILENAME), [
            'entry' => $entry,
            'missingAssets' => $assetCount,
        ]);
        if ($assetCount > 0) {
            $result['report']['warnings'][] = 'ZIP assets were detected but are not uploaded to File Manager in this slice.';
            $result['status'] = 'partial';
        }
        return $result;
    }

    /** @param array<int, string> $entries */
    private function selectZipEntry(array $entries, ?string $requestedEntry): string
    {
        $normalized = array_values(array_unique($entries));
        if ($requestedEntry !== null && trim($requestedEntry) !== '') {
            $requested = str_replace('\\', '/', trim($requestedEntry));
            foreach ($normalized as $entry) if (strcasecmp($entry, $requested) === 0) return $entry;
            throw new InvalidArgumentException('Requested ZIP HTML entry was not found.');
        }
        foreach (['home.html', 'index.html'] as $preferred) {
            foreach ($normalized as $entry) if (strcasecmp(basename($entry), $preferred) === 0) return $entry;
        }
        if (count($normalized) === 1) return $normalized[0];
        throw new InvalidArgumentException('ZIP must contain home.html, index.html, or one unambiguous HTML entry.');
    }

    /** @return array<string, mixed> */
    private function convertHtml(string $html, string $framework, string $fallbackName, array $reportOverrides = []): array
    {
        $this->sequence = 0;
        $dom = new DOMDocument('1.0', 'UTF-8');
        $previous = libxml_use_internal_errors(true);
        $loaded = $dom->loadHTML('<?xml encoding="UTF-8"?>'.$html, LIBXML_NONET | LIBXML_HTML_NODEFDTD | LIBXML_COMPACT);
        libxml_clear_errors();
        libxml_use_internal_errors($previous);

        if (! $loaded) {
            throw new InvalidArgumentException('The HTML document could not be parsed.');
        }

        $styleImport = app(StaticPageCssProcessor::class)->process($dom, $html);

        $report = array_merge([
            'frameworks' => $this->detectFrameworks($dom, $html, $framework),
            'entry' => $fallbackName.'.html',
            'mappedNodes' => 0,
            'placeholderNodes' => 0,
            'preservedIds' => 0,
            'preservedClasses' => 0,
            'rejectedSourceAttributes' => 0,
            'importedAssets' => 0,
            'missingAssets' => 0,
            'droppedScripts' => 0,
            'droppedStyles' => $styleImport['dropped'],
            'processedStyles' => $dom->getElementsByTagName('style')->length,
            'importedStylesheets' => count($styleImport['stylesheets']),
            'warnings' => $styleImport['warnings'],
        ], $reportOverrides);

        foreach (['script', 'link', 'style'] as $tag) {
            $elements = iterator_to_array($dom->getElementsByTagName($tag));
            foreach ($elements as $element) {
                if ($tag === 'script') $report['droppedScripts']++;
                $element->parentNode?->removeChild($element);
            }
        }
        if ($report['droppedScripts'] > 0) {
            $report['warnings'][] = 'Scripts and inline behavior were removed from the imported page.';
        }

        $title = '';
        $titles = $dom->getElementsByTagName('title');
        if ($titles->length > 0) $title = trim((string) $titles->item(0)?->textContent);
        $body = $dom->getElementsByTagName('body')->item(0);
        $children = [];
        if ($body instanceof DOMElement) {
            foreach (iterator_to_array($body->childNodes) as $child) {
                $mapped = $this->mapNode($child, $report);
                if ($mapped !== null) $children[] = $mapped;
            }
        }

        if ($children === []) {
            $report['warnings'][] = 'No supported visible body content was found.';
        }

        return [
            'status' => $report['warnings'] === [] ? 'success' : 'partial',
            'frameworks' => $report['frameworks'],
            'pageName' => $title !== '' ? $title : ($fallbackName !== '' ? $fallbackName : 'Imported Page'),
            'layout' => [$this->node('container', [
                'displayType' => 'flex',
                'direction' => 'column',
                'contentWidth' => 'full',
                'cssClass' => 'pb-import-root',
                'staticImport' => [
                    'frameworks' => array_values(array_intersect($report['frameworks'], ['tailwind', 'bootstrap5'])),
                    'stylesheets' => $styleImport['stylesheets'],
                    'tailwindConfig' => $styleImport['tailwindConfig'],
                ],
            ], $children)],
            'customCss' => $styleImport['css'],
            'assetBatchId' => null,
            'report' => $report,
        ];
    }

    /** @param array<string, mixed> $report */
    private function mapNode(DOMNode $source, array &$report): ?array
    {
        if ($source->nodeType === XML_TEXT_NODE) {
            return trim((string) $source->textContent) === '' ? null : $this->textNode((string) $source->textContent, $report);
        }
        if (! $source instanceof DOMElement) return null;

        $tag = strtolower($source->tagName);
        if (in_array($tag, ['script', 'style', 'link', 'meta', 'noscript', 'iframe', 'object', 'embed'], true)) return null;
        if ($tag === 'form') {
            $report['placeholderNodes']++;
            $report['warnings'][] = 'Form markup was kept as a static placeholder; submit behavior was not imported.';
            return $this->textNode('Imported form (static preview only).', $report, true, $source);
        }

        if (preg_match('/^h([1-6])$/', $tag, $match)) {
            $report['mappedNodes']++;
            return $this->node('heading', array_merge([
                'text' => $this->textContentWithBreaks($source),
                'tag' => 'h'.$match[1],
                'sourceLineBreaks' => stripos($this->innerHtml($source), '<br') !== false,
            ], $this->sourceSettings($source, $report)));
        }

        if ($tag === 'img') {
            $report['mappedNodes']++;
            $src = $this->safeUrl($source->getAttribute('src'));
            if ($src === '') {
                $report['missingAssets']++;
                $report['warnings'][] = 'An image source was unsafe or empty and was omitted.';
            }
            return $this->node('image', array_merge([
                'src' => $src,
                'alt' => trim($source->getAttribute('alt')),
                'imageSource' => 'url',
            ], $this->sourceSettings($source, $report)));
        }

        if ($tag === 'hr') {
            $report['mappedNodes']++;
            return $this->node('divider', $this->sourceSettings($source, $report));
        }

        if ($this->isButtonElement($source)) {
            $report['mappedNodes']++;
            $settings = [
                'text' => trim((string) $source->textContent) ?: 'Button',
                'url' => $tag === 'a' ? ($this->safeUrl($source->getAttribute('href')) ?: '#') : '#',
                'className' => $this->sourceButtonClassName($source),
                'sourceClassStyles' => true,
            ];
            $icon = $this->descendantIconSettings($source);
            if ($icon !== []) $settings = array_merge($settings, $icon);
            return $this->node('button', array_merge($settings, $this->sourceSettings($source, $report)));
        }

        if ($tag === 'i' && ($icon = $this->iconSettings($source)) !== []) {
            $report['mappedNodes']++;
            return $this->node('icon', array_merge($icon, $this->sourceSettings($source, $report)));
        }

        if (in_array($tag, ['p', 'span', 'strong', 'em', 'b', 'i', 'a', 'ul', 'ol', 'li', 'blockquote'], true)) {
            return $this->textNode($this->innerHtml($source), $report, false, $source);
        }

        $childNodes = [];
        foreach (iterator_to_array($source->childNodes) as $child) {
            $mapped = $this->mapNode($child, $report);
            if ($mapped !== null) $childNodes[] = $mapped;
        }
        if ($childNodes === []) {
            return trim((string) $source->textContent) === '' ? null : $this->textNode($this->innerHtml($source), $report);
        }

        $settings = array_merge($this->layoutSettings($source, $report), $this->sourceSettings($source, $report));
        $type = $this->hasClass($source, 'container-fluid') ? 'container_fluid' : 'container';
        $report['mappedNodes']++;
        if (($settings['displayType'] ?? 'flex') === 'grid') {
            $node = $this->node($type, $settings, []);
            $node['settings']['gridRows'] = (string) max(1, (int) ceil(max(1, count($childNodes)) / max(1, (int) ($settings['gridColumns'] ?? 1))));
            $node['settings']['gridRowsTablet'] = (string) max(1, (int) ceil(max(1, count($childNodes)) / max(1, (int) ($settings['gridColumnsTablet'] ?? $settings['gridColumns'] ?? 1))));
            $node['settings']['gridRowsMobile'] = (string) max(1, (int) ceil(max(1, count($childNodes)) / max(1, (int) ($settings['gridColumnsMobile'] ?? $settings['gridColumns'] ?? 1))));
            $node['columns'] = $this->canonicalGridColumns($node['id'], $childNodes, $node['settings'], $report);
            return $node;
        }
        return $this->node($type, $settings, $childNodes);
    }

    /** @param array<string, mixed> $report */
    private function textNode(string $html, array &$report, bool $placeholder = false, ?DOMElement $source = null): array
    {
        $report['mappedNodes']++;
        $settings = ['html' => $this->sanitizeHtml($html), 'align' => 'left'];
        if ($source instanceof DOMElement) $settings = array_merge($settings, $this->sourceSettings($source, $report));
        return $this->node('text_editor', $settings, null, $placeholder ? 'Imported Placeholder' : null);
    }

    /** @param array<string, mixed> $report */
    private function layoutSettings(DOMElement $element, array &$report): array
    {
        $classes = $this->classes($element);
        $settings = [
            'displayType' => in_array('grid', $classes, true) ? 'grid' : 'flex',
            'direction' => 'column',
            'contentWidth' => 'full',
        ];
        $directions = [];
        $directionPriorities = [];
        $gridColumns = [];
        $gridColumnPriorities = [];
        $gridTemplates = [];
        $gridTemplatePriorities = [];
        $gridGaps = ['row' => [], 'column' => []];
        $gridGapPriorities = ['row' => [], 'column' => []];
        $flexGaps = ['row' => [], 'column' => []];
        $flexGapPriorities = ['row' => [], 'column' => []];
        $paddingValues = [];
        $paddingPriorities = [];
        $columnWidths = [];
        $columnWidthPriorities = [];
        $visibility = [];
        $visibilityPriorities = [];

        foreach (['top', 'right', 'bottom', 'left'] as $side) {
            $paddingValues[$side] = [];
            $paddingPriorities[$side] = [];
        }

        foreach ($classes as $class) {
            [$bucket, $utility, $priority, $prefix] = $this->responsiveClass($class);

            if ($utility === 'grid') {
                if ($prefix !== null) {
                    $report['warnings'][] = 'Responsive display variants were reduced to the supported Canvas layout controls.';
                }
                $settings['displayType'] = 'grid';
                continue;
            }
            if ($utility === 'hidden') {
                $targets = $prefix === null ? ['mobile', 'tablet', 'desktop'] : [$bucket];
                foreach ($targets as $target) {
                    $this->assignResponsiveValue($visibility, $visibilityPriorities, $target, $prefix === null ? 0 : $priority, true);
                }
                continue;
            }
            if ($utility === 'flex' || $utility === 'inline-flex') {
                $settings['displayType'] = 'flex';
                if ($directions === [] && $prefix === null) $settings['direction'] = 'row';
                if ($prefix === null) {
                    foreach (['mobile', 'tablet', 'desktop'] as $target) {
                        $this->assignResponsiveValue($visibility, $visibilityPriorities, $target, 0, false);
                    }
                } else {
                    $this->assignResponsiveValue($directions, $directionPriorities, $bucket, $priority, 'row');
                    $this->assignResponsiveValue($visibility, $visibilityPriorities, $bucket, $priority, false);
                }
                continue;
            }
            if (preg_match('/^flex-(row|row-reverse|col|col-reverse)$/', $utility, $match)) {
                $direction = str_starts_with($match[1], 'col') ? 'column' : 'row';
                if (str_ends_with($match[1], 'reverse')) $direction .= '-reverse';
                $this->assignResponsiveValue($directions, $directionPriorities, $bucket, $priority, $direction);
                continue;
            }
            if ($utility === 'row') {
                $settings['displayType'] = 'flex';
                $settings['direction'] = 'row';
                $settings['flexWrap'] = 'wrap';
                continue;
            }
            if (preg_match('/^grid-cols-([1-9]|1[0-2])$/', $utility, $match)) {
                $settings['displayType'] = 'grid';
                $this->assignResponsiveValue($gridColumns, $gridColumnPriorities, $bucket, $priority, (int) $match[1]);
                $this->assignResponsiveValue($gridTemplates, $gridTemplatePriorities, $bucket, $priority, '');
                continue;
            }
            if (preg_match('/^grid-cols-\[([^\]]+)\]$/', $utility, $match)) {
                $settings['displayType'] = 'grid';
                $template = $this->safeGridTemplate($match[1]);
                if ($template === null) {
                    $report['warnings'][] = 'An arbitrary Tailwind grid template was rejected as unsafe.';
                    continue;
                }
                $this->assignResponsiveValue($gridColumns, $gridColumnPriorities, $bucket, $priority, $this->gridTrackCount($template));
                $this->assignResponsiveValue($gridTemplates, $gridTemplatePriorities, $bucket, $priority, $template);
                if ($bucket !== 'desktop') {
                    $report['warnings'][] = 'Responsive arbitrary Tailwind grid tracks were reduced to a numeric column count.';
                }
                continue;
            }
            if (preg_match('/^gap(?:-([xy]))?-([0-9]+)$/', $utility, $match)) {
                $axis = $match[1] ?? null;
                $value = $this->tailwindSpacing($match[2]);
                $targets = $axis === 'x' ? ['column'] : ($axis === 'y' ? ['row'] : ['row', 'column']);
                foreach ($targets as $target) {
                    $this->assignResponsiveValue($gridGaps[$target], $gridGapPriorities[$target], $bucket, $priority, $value);
                    $this->assignResponsiveValue($flexGaps[$target], $flexGapPriorities[$target], $bucket, $priority, $value);
                }
                continue;
            }
            if (preg_match('/^(p|px|py|pt|pr|pb|pl)-([0-9]+)$/', $utility, $match)) {
                $value = $this->spacing($match[2]);
                $sides = match ($match[1]) {
                    'p' => ['top', 'right', 'bottom', 'left'],
                    'px' => ['right', 'left'],
                    'py' => ['top', 'bottom'],
                    'pt' => ['top'],
                    'pr' => ['right'],
                    'pb' => ['bottom'],
                    'pl' => ['left'],
                };
                foreach ($sides as $side) {
                    $this->assignResponsiveValue($paddingValues[$side], $paddingPriorities[$side], $bucket, $priority, $value);
                }
                continue;
            }
            if (preg_match('/^col(?:-(sm|md|lg|xl|xxl))?(?:-([1-9]|1[0-2]))?$/', $utility, $match)) {
                $breakpoint = $match[1] ?? null;
                $width = $this->percentFromColumns($match[2] ?: '12');
                if ($breakpoint === null) {
                    foreach (['mobile', 'tablet', 'desktop'] as $widthBucket) {
                        $this->assignResponsiveValue($columnWidths, $columnWidthPriorities, $widthBucket, 0, $width);
                    }
                } elseif (in_array($breakpoint, ['sm', 'md'], true)) {
                    $breakpointPriority = $breakpoint === 'md' ? 2 : 1;
                    $this->assignResponsiveValue($columnWidths, $columnWidthPriorities, 'mobile', $breakpointPriority, '100%');
                    $this->assignResponsiveValue($columnWidths, $columnWidthPriorities, 'tablet', $breakpointPriority, $width);
                    $this->assignResponsiveValue($columnWidths, $columnWidthPriorities, 'desktop', $breakpointPriority, $width);
                } else {
                    $breakpointPriority = ['lg' => 3, 'xl' => 4, 'xxl' => 5][$breakpoint];
                    $this->assignResponsiveValue($columnWidths, $columnWidthPriorities, 'mobile', $breakpointPriority, '100%');
                    $this->assignResponsiveValue($columnWidths, $columnWidthPriorities, 'tablet', $breakpointPriority, '100%');
                    $this->assignResponsiveValue($columnWidths, $columnWidthPriorities, 'desktop', $breakpointPriority, $width);
                }
            }
        }

        if ($directions !== []) {
            $resolvedDirections = $this->resolveResponsiveValues($directions, $settings['direction']);
            $settings['direction'] = $resolvedDirections['desktop'];
            $settings['directionTablet'] = $resolvedDirections['tablet'];
            $settings['directionMobile'] = $resolvedDirections['mobile'];
        }

        if ($settings['displayType'] === 'grid') {
            $resolvedColumns = $this->resolveResponsiveValues($gridColumns, 1);
            $settings['gridColumns'] = $resolvedColumns['desktop'];
            $settings['gridColumnsTablet'] = $resolvedColumns['tablet'];
            $settings['gridColumnsMobile'] = $resolvedColumns['mobile'];
            if ($gridTemplates !== []) {
                $resolvedTemplates = $this->resolveResponsiveValues($gridTemplates, '');
                if ($resolvedTemplates['desktop'] !== '') $settings['gridTemplateColumns'] = $resolvedTemplates['desktop'];
            }
            $this->applyResponsiveGapSettings($settings, $gridGaps, 'grid');
        } else {
            $this->applyResponsiveGapSettings($settings, $flexGaps, 'flex');
        }

        if ($columnWidths !== []) {
            $resolvedWidths = $this->resolveResponsiveValues($columnWidths, '100%');
            $settings['containerWidth'] = $resolvedWidths['desktop'];
            $settings['containerWidthTablet'] = $resolvedWidths['tablet'];
            $settings['containerWidthMobile'] = $resolvedWidths['mobile'];
        }

        foreach (['top', 'right', 'bottom', 'left'] as $side) {
            if ($paddingValues[$side] === []) continue;
            $resolvedPadding = $this->resolveResponsiveValues($paddingValues[$side], '0');
            $settings['padding'.ucfirst($side)] = $resolvedPadding['desktop'];
            $settings['padding'.ucfirst($side).'Tablet'] = $resolvedPadding['tablet'];
            $settings['padding'.ucfirst($side).'Mobile'] = $resolvedPadding['mobile'];
        }

        if ($visibility !== []) {
            $resolvedVisibility = $this->resolveResponsiveValues($visibility, false);
            $settings['hideDesktop'] = (bool) $resolvedVisibility['desktop'];
            $settings['hideTablet'] = (bool) $resolvedVisibility['tablet'];
            $settings['hideMobile'] = (bool) $resolvedVisibility['mobile'];
        }

        return $settings;
    }

    /** @return array<int, string> */
    private function detectFrameworks(DOMDocument $dom, string $html, string $requested): array
    {
        $source = strtolower($html);
        $tokens = [];
        foreach (iterator_to_array($dom->getElementsByTagName('*')) as $element) {
            if (! $element instanceof DOMElement) continue;
            foreach ($this->classes($element) as $class) $tokens[] = $class;
        }

        $bootstrap = str_contains($source, 'bootstrap@5')
            || str_contains($source, 'bootstrap.min.css');
        $tailwind = str_contains($source, 'cdn.tailwindcss.com')
            || str_contains($source, '@tailwind');

        foreach ($tokens as $class) {
            [, $utility] = $this->responsiveClass($class);
            if ($utility === 'row'
                || $utility === 'container-fluid'
                || preg_match('/^row-cols-[1-6]$/', $utility)
                || preg_match('/^col(?:-(?:sm|md|lg|xl|xxl))?(?:-([1-9]|1[0-2]))?$/', $utility)
            ) {
                $bootstrap = true;
            }
            if ($utility === 'flex'
                || $utility === 'grid'
                || preg_match('/^(?:inline-)?flex-(?:row|col)(?:-reverse)?$/', $utility)
                || preg_match('/^grid-cols-(?:[1-9]|1[0-2]|\[[^\]]+\])$/', $utility)
                || preg_match('/^(?:gap|gap-[xy]|p|px|py|pt|pr|pb|pl)-[0-9]+$/', $utility)
                || preg_match('/^max-w-[A-Za-z0-9[\]._-]+$/', $utility)
            ) {
                $tailwind = true;
            }
        }

        if ($requested === 'bootstrap5') $bootstrap = true;
        if ($requested === 'tailwind') $tailwind = true;
        $frameworks = [];
        if ($bootstrap) $frameworks[] = 'bootstrap5';
        if ($tailwind) $frameworks[] = 'tailwind';
        return $frameworks ?: ['unknown'];
    }

    /** @return array{0: string, 1: string, 2: int, 3: string|null} */
    private function responsiveClass(string $class): array
    {
        $class = trim($class);
        if (preg_match('/^(sm|md|lg|xl|2xl):(.*)$/', $class, $match)) {
            $prefix = $match[1];
            $bucket = in_array($prefix, ['sm', 'md'], true) ? 'tablet' : 'desktop';
            $priority = ['sm' => 1, 'md' => 2, 'lg' => 3, 'xl' => 4, '2xl' => 5][$prefix];
            return [$bucket, $match[2], $priority, $prefix];
        }
        return ['mobile', $class, 0, null];
    }

    /** @param array<string, mixed> $values */
    /** @param array<string, int> $priorities */
    private function assignResponsiveValue(array &$values, array &$priorities, string $bucket, int $priority, mixed $value): void
    {
        if (! array_key_exists($bucket, $priorities) || $priority >= $priorities[$bucket]) {
            $values[$bucket] = $value;
            $priorities[$bucket] = $priority;
        }
    }

    /** @param array<string, mixed> $values */
    /** @return array{desktop: mixed, tablet: mixed, mobile: mixed} */
    private function resolveResponsiveValues(array $values, mixed $default): array
    {
        $mobile = array_key_exists('mobile', $values) ? $values['mobile'] : $default;
        $tablet = array_key_exists('tablet', $values) ? $values['tablet'] : $mobile;
        $desktop = array_key_exists('desktop', $values) ? $values['desktop'] : $tablet;
        return ['desktop' => $desktop, 'tablet' => $tablet, 'mobile' => $mobile];
    }

    /** @param array<string, mixed> $settings */
    /** @param array<string, array<string, mixed>> $values */
    private function applyResponsiveGapSettings(array &$settings, array $values, string $layout): void
    {
        foreach (['row', 'column'] as $axis) {
            if ($values[$axis] === []) continue;
            $resolved = $this->resolveResponsiveValues($values[$axis], '0');
            if ($layout === 'grid') {
                $base = $axis === 'row' ? 'gridRowGap' : 'gridColumnGap';
            } else {
                $base = $axis === 'row' ? 'flexRowGap' : 'flexColumnGap';
            }
            $settings[$base] = $resolved['desktop'];
            $settings[$base.'Tablet'] = $resolved['tablet'];
            $settings[$base.'Mobile'] = $resolved['mobile'];
        }
    }

    /** @param array<int, array<string, mixed>> $children */
    /** @param array<string, mixed> $settings */
    /** @param array<string, mixed> $report */
    /** @return array<int, array<string, mixed>> */
    private function canonicalGridColumns(string $nodeId, array $children, array $settings, array &$report): array
    {
        $columnCount = max(1, min(12, (int) ($settings['gridColumns'] ?? 1)));
        $rowCount = max(1, min(12, (int) ($settings['gridRows'] ?? 1)));
        $slotCount = $columnCount * $rowCount;
        if (count($children) > $slotCount) {
            $report['warnings'][] = 'Grid content exceeded the 12-row Canvas limit; overflow was grouped in the final cell.';
        }

        $columns = [];
        for ($index = 0; $index < $slotCount; $index++) {
            $columns[] = [
                'id' => $nodeId.'-cell-'.($index + 1),
                'styleOverrides' => [],
                'children' => [],
            ];
        }
        foreach ($children as $index => $child) {
            $slot = min($index, $slotCount - 1);
            $columns[$slot]['children'][] = $child;
        }
        return $columns;
    }

    private function safeGridTemplate(string $value): ?string
    {
        $template = trim(str_replace('_', ' ', $value));
        if ($template === '' || strlen($template) > 256) return null;
        if (preg_match('/[;{}"\']|(?:url|var|env|attr|expression|javascript|--)/i', $template)) return null;
        if (! preg_match('/^[A-Za-z0-9\s.,%()+*\/-]+$/', $template)) return null;

        $depth = 0;
        for ($index = 0, $length = strlen($template); $index < $length; $index++) {
            if ($template[$index] === '(') $depth++;
            if ($template[$index] === ')') $depth--;
            if ($depth < 0) return null;
        }
        if ($depth !== 0) return null;
        if (preg_match_all('/([A-Za-z][A-Za-z0-9-]*)\s*\(/', $template, $matches)) {
            foreach ($matches[1] as $function) {
                if (! in_array(strtolower($function), ['repeat', 'minmax', 'fit-content', 'min', 'max', 'clamp'], true)) return null;
            }
        }
        return preg_replace('/\s+/', ' ', $template) ?: null;
    }

    private function gridTrackCount(string $template): int
    {
        $parts = [];
        $token = '';
        $depth = 0;
        for ($index = 0, $length = strlen($template); $index < $length; $index++) {
            $character = $template[$index];
            if ($character === '(') $depth++;
            if ($character === ')') $depth--;
            if (ctype_space($character) && $depth === 0) {
                if ($token !== '') {
                    $parts[] = $token;
                    $token = '';
                }
                continue;
            }
            $token .= $character;
        }
        if ($token !== '') $parts[] = $token;

        $count = 0;
        foreach ($parts as $part) {
            if (preg_match('/^repeat\(\s*([1-9]|1[0-2])\s*,/i', $part, $match)) {
                $count += (int) $match[1];
            } else {
                $count++;
            }
        }
        return max(1, min(12, $count));
    }

    private function spacing(string $value): string
    {
        return [
            '0' => '0', '1' => '.25rem', '2' => '.5rem', '3' => '.75rem', '4' => '1rem',
            '5' => '1.25rem', '6' => '1.5rem', '8' => '2rem', '10' => '2.5rem', '12' => '3rem',
            '16' => '4rem', '20' => '5rem', '24' => '6rem',
        ][$value] ?? '0';
    }

    private function tailwindSpacing(string $value): string
    {
        return $this->spacing($value);
    }

    private function percentFromColumns(string $columns): string
    {
        return (string) (round((max(1, min(12, (int) $columns)) / 12) * 100, 4)).'%';
    }

    /** @return array<int, string> */
    private function classes(DOMElement $element): array
    {
        return array_values(array_filter(preg_split('/\s+/', trim($element->getAttribute('class'))) ?: []));
    }

    /** @param array<string, mixed> $report */
    /** @return array<string, string> */
    private function sourceSettings(DOMElement $element, array &$report): array
    {
        $settings = [];
        $sourceId = trim($element->getAttribute('id'));
        if ($sourceId !== '') {
            $safeId = $this->safeSourceId($sourceId);
            if ($safeId !== '') {
                $settings['cssId'] = $safeId;
                $report['preservedIds']++;
            } else {
                $report['rejectedSourceAttributes']++;
                $report['warnings'][] = 'An unsafe source id was omitted from the imported node.';
            }
        }

        $rawClasses = $this->classes($element);
        $sourceClasses = $this->safeSourceClasses($element->getAttribute('class'));
        $rejectedClasses = max(0, count($rawClasses) - count($sourceClasses));
        if ($rejectedClasses > 0) {
            $report['rejectedSourceAttributes'] += $rejectedClasses;
            $report['warnings'][] = 'An unsafe source class was omitted from the imported node.';
        }
        if ($sourceClasses !== []) {
            $settings['cssClass'] = implode(' ', $sourceClasses);
            $report['preservedClasses'] += count($sourceClasses);
        }
        return $settings;
    }

    private function safeSourceId(string $value): string
    {
        $value = trim($value);
        return preg_match('/^[A-Za-z][A-Za-z0-9_-]*$/', $value) ? $value : '';
    }

    /** @return array<int, string> */
    private function safeSourceClasses(string $value): array
    {
        $tokens = array_values(array_filter(preg_split('/\s+/', trim($value)) ?: []));
        $tokens = array_filter($tokens, fn (string $token): bool => ! preg_match('/[\x00-\x20\x7F"\'<>;{}]/', $token));
        return array_values(array_unique($tokens));
    }

    private function hasClass(DOMElement $element, string $class): bool
    {
        return in_array($class, $this->classes($element), true);
    }

    private function isButtonElement(DOMElement $element): bool
    {
        $tag = strtolower($element->tagName);
        if ($tag === 'button') return true;
        if ($tag !== 'a') return false;
        if (strtolower(trim($element->getAttribute('role'))) === 'button') return true;
        foreach ($this->safeSourceClasses($element->getAttribute('class')) as $class) {
            if ($class === 'btn' || preg_match('/-button$/i', $class)) return true;
        }
        return false;
    }

    private function sourceButtonClassName(DOMElement $element): string
    {
        $classes = $this->safeSourceClasses($element->getAttribute('class'));
        foreach ($classes as $class) {
            if (preg_match('/-button$/i', $class)) return $class;
        }
        $bootstrap = array_values(array_filter($classes, fn (string $class): bool => $class === 'btn' || str_starts_with($class, 'btn-')));
        return $bootstrap !== [] ? implode(' ', $bootstrap) : 'btn btn-primary';
    }

    /** @return array<string, string> */
    private function descendantIconSettings(DOMElement $element): array
    {
        foreach ($element->getElementsByTagName('i') as $icon) {
            if ($icon instanceof DOMElement && ($settings = $this->iconSettings($icon)) !== []) return $settings;
        }
        return [];
    }

    /** @return array<string, string> */
    private function iconSettings(DOMElement $element): array
    {
        $mappedClass = $this->mappedIconClass($element);
        if ($mappedClass === '') return [];
        [$prefix, $name] = explode(' ', $mappedClass, 2);
        return [
            'iconSource' => 'library',
            'iconStyle' => $prefix === 'far' ? 'regular' : ($prefix === 'fab' ? 'brands' : 'solid'),
            'iconName' => preg_replace('/^fa-/', '', $name) ?: 'star',
            'iconClass' => $mappedClass,
        ];
    }

    private function mappedIconClass(DOMElement $element): string
    {
        $map = [
            'airplane' => 'fas fa-plane', 'airplane-tilt' => 'fas fa-plane',
            'arrow-down-right' => 'fas fa-arrow-down', 'arrow-up-right' => 'fas fa-arrow-right',
            'buildings' => 'fas fa-building', 'calendar-blank' => 'far fa-calendar',
            'car' => 'fas fa-car', 'confetti' => 'fas fa-glass-cheers', 'crown' => 'fas fa-crown',
            'currency-circle-dollar' => 'fas fa-dollar-sign', 'diamond' => 'fas fa-gem',
            'flag-banner' => 'fas fa-flag', 'golf' => 'fas fa-golf-ball', 'handshake' => 'fas fa-handshake',
            'lightning' => 'fas fa-bolt', 'list' => 'fas fa-bars', 'map-pin' => 'fas fa-map-marker-alt',
            'medal' => 'fas fa-medal', 'seal-check' => 'fas fa-check-circle', 'shield-check' => 'fas fa-shield-alt',
            'star' => 'fas fa-star', 'trophy' => 'fas fa-trophy', 'users-three' => 'fas fa-users',
            'whatsapp-logo' => 'fab fa-whatsapp', 'wine' => 'fas fa-wine-glass', 'x' => 'fas fa-times',
        ];
        foreach ($this->classes($element) as $class) {
            if (preg_match('/^ph-(.+)$/', $class, $match) && isset($map[$match[1]])) return $map[$match[1]];
        }
        return '';
    }

    private function safeUrl(string $value): string
    {
        $value = trim($value);
        return $value !== '' && ! str_starts_with($value, '//') && preg_match('/^(?:https?:|\/|#|data:image\/(?:png|gif|jpe?g|webp);base64,)/i', $value)
            ? $value
            : '';
    }

    private function innerHtml(DOMElement $element): string
    {
        $html = '';
        foreach (iterator_to_array($element->childNodes) as $child) $html .= $element->ownerDocument?->saveHTML($child) ?: '';
        return $html !== '' ? $html : trim((string) $element->textContent);
    }

    private function textContentWithBreaks(DOMNode $node): string
    {
        if ($node instanceof DOMElement && strtolower($node->tagName) === 'br') return "\n";
        if ($node->nodeType === XML_TEXT_NODE) return (string) $node->textContent;
        $text = '';
        foreach (iterator_to_array($node->childNodes ?? []) as $child) $text .= $this->textContentWithBreaks($child);
        return trim($text);
    }

    private function sanitizeHtml(string $html): string
    {
        $dom = new DOMDocument('1.0', 'UTF-8');
        $previous = libxml_use_internal_errors(true);
        $dom->loadHTML('<?xml encoding="UTF-8"?><!doctype html><html><body><div id="pb-import-text">'.$html.'</div></body></html>', LIBXML_NONET | LIBXML_HTML_NODEFDTD | LIBXML_COMPACT);
        libxml_clear_errors();
        libxml_use_internal_errors($previous);
        $root = $dom->getElementById('pb-import-text');
        if (! $root) return strip_tags($html);
        $allowed = ['P', 'BR', 'SPAN', 'STRONG', 'EM', 'B', 'I', 'A', 'UL', 'OL', 'LI', 'H1', 'H2', 'H3', 'H4', 'H5', 'H6', 'BLOCKQUOTE'];
        $walk = function (DOMNode $parent) use (&$walk, $allowed): void {
            foreach (iterator_to_array($parent->childNodes) as $child) {
                if (! $child instanceof DOMElement) continue;
                $tag = strtoupper($child->tagName);
                if (! in_array($tag, $allowed, true)) {
                    while ($child->firstChild) $parent->insertBefore($child->firstChild, $child);
                    $parent->removeChild($child);
                    continue;
                }
                foreach (iterator_to_array($child->attributes) as $attribute) {
                    $name = strtolower($attribute->name);
                    $value = (string) $attribute->value;
                    if ($name === 'id') {
                        $safeId = $this->safeSourceId($value);
                        if ($safeId !== '') $child->setAttribute('id', $safeId);
                        else $child->removeAttribute($attribute->name);
                        continue;
                    }
                    if ($name === 'class') {
                        $safeClasses = $this->safeSourceClasses($value);
                        if ($safeClasses !== []) $child->setAttribute('class', implode(' ', $safeClasses));
                        else $child->removeAttribute($attribute->name);
                        continue;
                    }
                    $allowedAttribute = $tag === 'A' && in_array($name, ['href', 'title', 'target', 'rel'], true);
                    if (! $allowedAttribute || ($name === 'href' && ! preg_match('/^(?:https?:|mailto:|tel:|\/|#)/i', $value))) {
                        $child->removeAttribute($attribute->name);
                    }
                }
                $walk($child);
            }
        };
        $walk($root);
        $output = '';
        foreach (iterator_to_array($root->childNodes) as $child) $output .= $dom->saveHTML($child) ?: '';
        return $output;
    }

    /** @param array<string, mixed> $settings */
    private function node(string $type, array $settings, ?array $children = null, ?string $label = null): array
    {
        $node = [
            'id' => 'import-node-'.$this->sequence++,
            'type' => $type,
            'label' => $label ?: ucwords(str_replace('_', ' ', $type)),
            'labelSuffix' => '',
            'settings' => $settings,
        ];
        if ($children !== null) $node['children'] = $children;
        return $node;
    }
}
