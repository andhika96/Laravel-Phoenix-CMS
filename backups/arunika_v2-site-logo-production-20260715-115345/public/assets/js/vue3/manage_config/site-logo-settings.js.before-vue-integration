(function ()
{
	'use strict';

	const root = document.getElementById('siteLogoSettings');

	if ( ! root)
	{
		return;
	}

	const ALLOWED_LOGO_UNITS = ['%', 'px', 'em', 'rem', 'pt'];
	const ALLOWED_LOGO_TYPES = ['image/png', 'image/jpeg', 'image/webp'];
	const DEFAULT_LOGO_WIDTH_PX = 34;
	const MAX_LOGO_FILE_SIZE = 5 * 1024 * 1024;

	const elements =
	{
		dropZone: document.getElementById('siteLogoDropZone'),
		input: document.getElementById('siteLogoInput'),
		removeInput: document.getElementById('removeSiteLogoInput'),
		chooseButton: document.getElementById('chooseSiteLogo'),
		removeButton: document.getElementById('removeSiteLogo'),
		uploadPreview: document.getElementById('siteLogoUploadPreview'),
		fileMeta: document.getElementById('siteLogoFileMeta'),
		fileName: document.getElementById('siteLogoFileName'),
		fileDetails: document.getElementById('siteLogoFileDetails'),
		resizeCard: document.getElementById('siteLogoResizeCard'),
		widthValue: document.getElementById('siteLogoWidthValue'),
		widthUnit: document.getElementById('siteLogoWidthUnit'),
		widthReadout: document.getElementById('siteLogoWidthReadout'),
		preview: document.getElementById('siteLogoSidebarPreview'),
		previewBrand: document.getElementById('siteLogoSidebarBrand'),
		previewImage: document.getElementById('siteLogoSidebarImage'),
		previewInitial: document.getElementById('siteLogoSidebarInitial'),
		previewName: document.getElementById('siteLogoSidebarName'),
		previewToggle: document.getElementById('toggleSiteLogoPreview'),
		siteName: document.querySelector('input[name="site_name"]'),
		liveBrand: document.querySelector('#sidebar > .ph-sidebar-logo-container'),
	};

	elements.liveImage = elements.liveBrand ? elements.liveBrand.querySelector('.ph-app-logo-icon img') : null;
	elements.liveName = elements.liveBrand ? elements.liveBrand.querySelector('.ph-app-logo-text') : null;
	elements.liveInitial = elements.liveBrand ? elements.liveBrand.querySelector('.ph-app-logo-initial') : null;

	let logoState =
	{
		hasLogo: root.dataset.hasLogo === '1',
		src: root.dataset.logoUrl || '',
		name: root.dataset.logoName || '',
		details: root.dataset.hasLogo === '1' ? 'Saved logo' : '',
		objectUrl: '',
	};

	function logoWidthMaxForUnit(unit)
	{
		return unit === '%' ? 100 : 500;
	}

	function normalizedSiteName()
	{
		return elements.siteName && elements.siteName.value.trim()
			? elements.siteName.value.trim()
			: 'LaraPhoenix CMS';
	}

	function resolveLogoWidth()
	{
		const unit = ALLOWED_LOGO_UNITS.includes(elements.widthUnit.value) ? elements.widthUnit.value : '%';
		const maxValue = logoWidthMaxForUnit(unit);
		const parsedValue = Number.parseFloat(elements.widthValue.value);
		const value = Number.isFinite(parsedValue) ? Math.min(maxValue, Math.max(1, parsedValue)) : 100;
		const cssValue = unit === '%'
			? `${Number((DEFAULT_LOGO_WIDTH_PX * (value / 100)).toFixed(2))}px`
			: `${value}${unit}`;

		return { value, unit, cssValue };
	}

	function setImageSource(image, src)
	{
		if ( ! image)
		{
			return;
		}

		if (src)
		{
			image.src = src;
		}
		else
		{
			image.removeAttribute('src');
		}
	}

	function renderLogoSettings()
	{
		const siteName = normalizedSiteName();
		const width = resolveLogoWidth();

		elements.dropZone.classList.toggle('has-logo', logoState.hasLogo);
		elements.previewBrand.classList.toggle('has-logo', logoState.hasLogo);
		elements.fileMeta.classList.toggle('is-visible', logoState.hasLogo);
		elements.resizeCard.classList.toggle('is-disabled', ! logoState.hasLogo);
		elements.resizeCard.setAttribute('aria-disabled', String(! logoState.hasLogo));
		elements.removeButton.disabled = ! logoState.hasLogo;
		elements.widthValue.disabled = ! logoState.hasLogo;
		elements.widthUnit.disabled = ! logoState.hasLogo;
		elements.previewName.textContent = siteName;
		elements.previewInitial.textContent = siteName.charAt(0).toUpperCase();
		elements.previewImage.style.width = width.cssValue;
		elements.widthReadout.textContent = `${width.value}${width.unit}`;
		elements.fileName.textContent = logoState.name;
		elements.fileDetails.textContent = logoState.details;

		setImageSource(elements.uploadPreview, logoState.src);
		setImageSource(elements.previewImage, logoState.src);

		if (elements.liveBrand)
		{
			elements.liveBrand.classList.toggle('has-logo', logoState.hasLogo);
			elements.liveBrand.style.setProperty('--ph-site-logo-width', width.cssValue);
			setImageSource(elements.liveImage, logoState.src);
		}

		if (elements.liveName)
		{
			elements.liveName.textContent = siteName;
		}

		if (elements.liveInitial)
		{
			elements.liveInitial.textContent = siteName.charAt(0).toUpperCase();
		}
	}

	function resetObjectUrl()
	{
		if (logoState.objectUrl)
		{
			URL.revokeObjectURL(logoState.objectUrl);
			logoState.objectUrl = '';
		}
	}

	function validateLogo(file)
	{
		if ( ! ALLOWED_LOGO_TYPES.includes(file.type))
		{
			return 'Choose a PNG, JPG, or WebP image.';
		}

		if (file.size > MAX_LOGO_FILE_SIZE)
		{
			return 'The logo file may not be greater than 5 MB.';
		}

		return '';
	}

	function selectLogo(file)
	{
		const validationMessage = validateLogo(file);

		if (validationMessage)
		{
			elements.input.setCustomValidity(validationMessage);
			elements.input.reportValidity();
			return;
		}

		elements.input.setCustomValidity('');
		resetObjectUrl();
		logoState.objectUrl = URL.createObjectURL(file);
		logoState.hasLogo = true;
		logoState.src = logoState.objectUrl;
		logoState.name = file.name;
		logoState.details = `${Math.max(1, Math.round(file.size / 1024))} KB · Ready to upload`;
		elements.removeInput.value = '0';
		renderLogoSettings();
	}

	function assignDroppedFile(file)
	{
		const transfer = new DataTransfer();
		transfer.items.add(file);
		elements.input.files = transfer.files;
		selectLogo(file);
	}

	function removeLogo()
	{
		resetObjectUrl();
		logoState.hasLogo = false;
		logoState.src = '';
		logoState.name = '';
		logoState.details = '';
		elements.input.value = '';
		elements.removeInput.value = '1';
		renderLogoSettings();
	}

	function normalizeWidthControl()
	{
		const maxValue = logoWidthMaxForUnit(elements.widthUnit.value);
		const parsedValue = Number.parseFloat(elements.widthValue.value);

		elements.widthValue.max = String(maxValue);
		elements.widthValue.step = ['em', 'rem'].includes(elements.widthUnit.value) ? '0.1' : '1';

		if (Number.isFinite(parsedValue))
		{
			elements.widthValue.value = String(Math.min(maxValue, Math.max(1, parsedValue)));
		}

		renderLogoSettings();
	}

	elements.chooseButton.addEventListener('click', function ()
	{
		elements.input.click();
	});

	elements.input.addEventListener('change', function ()
	{
		if (elements.input.files && elements.input.files[0])
		{
			selectLogo(elements.input.files[0]);
		}
	});

	elements.removeButton.addEventListener('click', removeLogo);
	elements.widthValue.addEventListener('input', normalizeWidthControl);
	elements.widthUnit.addEventListener('change', normalizeWidthControl);

	if (elements.siteName)
	{
		elements.siteName.addEventListener('input', renderLogoSettings);
	}

	elements.previewToggle.addEventListener('click', function ()
	{
		const collapsed = elements.preview.classList.toggle('is-collapsed');
		elements.previewToggle.textContent = collapsed ? 'Expand' : 'Collapse';
	});

	['dragenter', 'dragover'].forEach(function (eventName)
	{
		elements.dropZone.addEventListener(eventName, function (event)
		{
			event.preventDefault();
			elements.dropZone.classList.add('is-dragging');
		});
	});

	['dragleave', 'drop'].forEach(function (eventName)
	{
		elements.dropZone.addEventListener(eventName, function (event)
		{
			event.preventDefault();
			elements.dropZone.classList.remove('is-dragging');
		});
	});

	elements.dropZone.addEventListener('drop', function (event)
	{
		if (event.dataTransfer.files && event.dataTransfer.files[0])
		{
			assignDroppedFile(event.dataTransfer.files[0]);
		}
	});

	elements.dropZone.addEventListener('keydown', function (event)
	{
		if ((event.key === 'Enter' || event.key === ' ') && event.target === elements.dropZone)
		{
			event.preventDefault();
			elements.input.click();
		}
	});

	normalizeWidthControl();
})();
