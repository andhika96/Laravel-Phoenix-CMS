			'margin-right:'.$cssLength($responsive($keys['margin'].'Right', $suffix, '0px'), '0px'),
			'margin-bottom:'.$cssLength($responsive($keys['margin'].'Bottom', $suffix, '0px'), '0px'),
			'margin-left:'.$cssLength($responsive($keys['margin'].'Left', $suffix, '0px'), '0px'),
			'border-style:'.($mode === 'none' ? 'none' : $borderType),
			'border-color:'.($mode === 'none' ? 'transparent' : $borderColor),
