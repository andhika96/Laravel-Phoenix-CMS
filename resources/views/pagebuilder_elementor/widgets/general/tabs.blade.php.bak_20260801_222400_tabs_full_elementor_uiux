			'--pb-tabs-title-font-weight:' . $fontWeight('tabsTitleFontWeight', $suffix, '500'),
			'--pb-tabs-title-line-height:' . $lineHeight('tabsTitleLineHeight', $suffix, '1.3em'),
			'--pb-tabs-title-letter-spacing:' . $cssLength($responsive('tabsTitleLetterSpacing', $suffix, '0px'), '0px'),
			'--pb-tabs-title-word-spacing:' . $cssLength($responsive('tabsTitleWordSpacing', $suffix, '0px'), '0px'),
			'--pb-tabs-title-text-transform:' . $enum($responsive('tabsTitleTextTransform', $suffix, 'none'), ['none','uppercase','lowercase','capitalize'], 'none'),
			'--pb-tabs-title-font-style:' . $enum($responsive('tabsTitleFontStyle', $suffix, 'normal'), ['normal','italic','oblique'], 'normal'),
			'--pb-tabs-title-text-decoration:' . $enum($responsive('tabsTitleTextDecoration', $suffix, 'none'), ['none','underline','overline','line-through'], 'none'),
			'--pb-tabs-icon-size:' . $cssLength($responsive('tabsIconSize', $suffix, '14px'), '14px'),
			'--pb-tabs-icon-spacing:' . $cssLength($responsive('tabsIconSpacing', $suffix, '10px'), '10px'),
			'--pb-tabs-content-background:' . $cssColor($responsive('tabsContentBackgroundColor', $suffix, 'transparent'), 'transparent'),
			'--pb-tabs-content-text-color:' . $cssColor($responsive('tabsContentTextColor', $suffix, 'inherit'), 'inherit'),
			'--pb-tabs-content-border-style:' . $enum($responsive('tabsContentBorderType', $suffix, 'none'), ['none','solid','double','dotted','dashed','groove'], 'none'),
			'--pb-tabs-content-border-width:' . $boxValue('tabsContentBorderWidth', $suffix, '0px'),
			'--pb-tabs-content-border-color:' . $cssColor($responsive('tabsContentBorderColor', $suffix, 'transparent'), 'transparent'),
			'--pb-tabs-content-border-radius:' . $boxValue('tabsContentBorderRadius', $suffix, '0px'),
			'--pb-tabs-content-padding:' . $boxValue('tabsContentPadding', $suffix, '0px'),
			'--pb-tabs-content-font-family:' . $fontFamily('tabsContentFontFamily', $suffix, 'inherit'),
			'--pb-tabs-content-font-size:' . $cssLength($responsive('tabsContentFontSize', $suffix, '16px'), '16px'),
			'--pb-tabs-content-font-weight:' . $fontWeight('tabsContentFontWeight', $suffix, 'inherit'),
			'--pb-tabs-content-line-height:' . $lineHeight('tabsContentLineHeight', $suffix, '1.5em'),
			'--pb-tabs-content-letter-spacing:' . $cssLength($responsive('tabsContentLetterSpacing', $suffix, '0px'), '0px'),
			'--pb-tabs-content-word-spacing:' . $cssLength($responsive('tabsContentWordSpacing', $suffix, '0px'), '0px'),
			'--pb-tabs-content-text-transform:' . $enum($responsive('tabsContentTextTransform', $suffix, 'none'), ['none','uppercase','lowercase','capitalize'], 'none'),
			'--pb-tabs-content-font-style:' . $enum($responsive('tabsContentFontStyle', $suffix, 'normal'), ['normal','italic','oblique'], 'normal'),
			'--pb-tabs-content-text-decoration:' . $enum($responsive('tabsContentTextDecoration', $suffix, 'none'), ['none','underline','overline','line-through'], 'none'),
		];
		foreach (['Normal' => 'normal', 'Hover' => 'hover', 'Active' => 'active'] as $state => $slug) {
			$active = $slug === 'active';
			$variables[] = '--pb-tabs-' . $slug . '-text-color:' . $cssColor($responsive('tabs' . $state . 'TextColor', $suffix, $active ? '#ffffff' : '#4f5f78'), $active ? '#ffffff' : '#4f5f78');
			$variables[] = '--pb-tabs-' . $slug . '-background:' . $cssColor($responsive('tabs' . $state . 'BackgroundColor', $suffix, $active ? '#4f5ec9' : '#f3f5fa'), $active ? '#4f5ec9' : '#f3f5fa');
			$variables[] = '--pb-tabs-' . $slug . '-border-style:' . $enum($responsive('tabs' . $state . 'BorderType', $suffix, 'solid'), ['none','solid','double','dotted','dashed','groove'], 'solid');
			$variables[] = '--pb-tabs-' . $slug . '-border-width:' . $boxValue('tabs' . $state . 'BorderWidth', $suffix, '1px');
			$variables[] = '--pb-tabs-' . $slug . '-border-color:' . $cssColor($responsive('tabs' . $state . 'BorderColor', $suffix, $active ? '#4f5ec9' : '#dde3ef'), $active ? '#4f5ec9' : '#dde3ef');
