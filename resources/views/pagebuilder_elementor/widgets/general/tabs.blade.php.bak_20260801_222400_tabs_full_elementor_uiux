	$width = is_numeric($settings['tabWidth'] ?? null) && (float) $settings['tabWidth'] > 0 ? ((float) $settings['tabWidth'] + 0) . $widthUnit : '';
	$cssLength = function (mixed $value, string $fallback = '0px'): string {
		$raw = trim((string) $value);
		if ($raw === '') return $fallback;
		$tokens = preg_split('/\s+/', $raw) ?: [];
		if (count($tokens) < 1 || count($tokens) > 4) return $fallback;
		$normalized = [];
		foreach ($tokens as $token) {
			if (preg_match('/^-?\d+(?:\.\d+)?$/', $token)) $normalized[] = $token . 'px';
			elseif (preg_match('/^-?\d+(?:\.\d+)?(?:px|pt|%|em|rem|vw|vh)$/i', $token)) $normalized[] = $token;
			else return $fallback;
		}
		return implode(' ', $normalized);
	};
	$cssColor = function (mixed $value, string $fallback = 'inherit'): string {
		$raw = trim((string) $value);
		return $raw !== '' && preg_match('/^[#a-z0-9(),.%\s-]+$/i', $raw) ? $raw : $fallback;
	};
	$responsive = function (string $base, string $suffix = '', mixed $fallback = '') use ($settings): mixed {
		$keys = $suffix === 'Mobile' ? [$base.'Mobile', $base.'Tablet', $base] : ($suffix === 'Tablet' ? [$base.'Tablet', $base] : [$base]);
		foreach ($keys as $key) {
			$value = $settings[$key] ?? null;
			if ($value !== '' && $value !== null) return $value;
		}
		return $fallback;
	};
	$hasResponsive = function (string $base, string $suffix = '') use ($settings): bool {
		$keys = $suffix === 'Mobile' ? [$base.'Mobile', $base.'Tablet', $base] : ($suffix === 'Tablet' ? [$base.'Tablet', $base] : [$base]);
		foreach ($keys as $key) {
			$value = $settings[$key] ?? null;
			if ($value !== '' && $value !== null) return true;
		}
		return false;
	};
	$boxValue = function (string $base, string $suffix = '', string $fallback = '0px') use ($cssLength, $responsive, $hasResponsive): string {
		$sides = ['Top', 'Right', 'Bottom', 'Left'];
		if (!array_filter($sides, fn ($side) => $hasResponsive($base . $side, $suffix))) {
			return $cssLength($responsive($base, $suffix, $fallback), $fallback);
		}
		return implode(' ', array_map(fn ($side) => $cssLength($responsive($base . $side, $suffix, $fallback), $fallback), $sides));
	};
	$enum = function (mixed $value, array $allowed, string $fallback): string {
		$raw = strtolower(trim((string) $value));
		return in_array($raw, $allowed, true) ? $raw : $fallback;
	};
	$fontFamily = function (string $base, string $suffix = '', string $fallback = 'inherit') use ($responsive): string {
		$raw = trim((string) $responsive($base, $suffix, $fallback));
		return $raw === 'inherit' || preg_match('/^[A-Za-z0-9 _\'"-]+(?:\s*,\s*[A-Za-z0-9 _\'"-]+)*$/', $raw) ? $raw : $fallback;
	};
	$fontWeight = function (string $base, string $suffix = '', string $fallback = 'inherit') use ($responsive): string {
		$raw = trim((string) $responsive($base, $suffix, $fallback));
		return $raw === 'inherit' || preg_match('/^(?:[1-9]00|normal|bold|lighter|bolder)$/', $raw) ? $raw : $fallback;
	};
	$lineHeight = function (string $base, string $suffix = '', string $fallback = '1.4em') use ($responsive): string {
		$raw = trim((string) $responsive($base, $suffix, $fallback));
		return preg_match('/^(?:normal|\d+(?:\.\d+)?(?:px|%|em|rem)?)$/i', $raw) ? $raw : $fallback;
	};
	$rootVariables = function (string $suffix = '') use ($settings, $cssLength, $cssColor, $responsive, $boxValue, $enum, $fontFamily, $fontWeight, $lineHeight): string {
		$variables = [
			'--pb-tabs-title-font-family:' . $fontFamily('tabsTitleFontFamily', $suffix, 'inherit'),
