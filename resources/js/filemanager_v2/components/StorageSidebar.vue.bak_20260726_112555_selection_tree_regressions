<script setup>
import { computed, ref } from 'vue';

const props = defineProps({
  activeStorage: String,
  mobileOpen: Boolean,
  profile: Object,
  profiles: Object,
  activeNav: String,
  navItems: Array,
  folders: Array,
  activeFolder: String,
});

const emit = defineEmits(['change-storage', 'change-nav', 'change-folder', 'create-folder', 'open-settings', 'close-mobile']);
const usagePercent = computed(() => Math.round((props.profile.used / props.profile.total) * 100));
const collapsedFolders = ref(new Set());

function parentPath(path) {
  const parts = path.split('/').filter(Boolean);
  parts.pop();
  return parts.join('/');
}

function hasChildren(path) {
  return props.folders.some((folder) => folder.path.startsWith(`${path}/`));
}

function isFolderVisible(folder) {
  let parent = parentPath(folder.path);
  while (parent) {
    if (collapsedFolders.value.has(parent)) return false;
    parent = parentPath(parent);
  }

  return true;
}

const visibleFolders = computed(() => props.folders.filter(isFolderVisible));

function isCollapsed(path) {
  return collapsedFolders.value.has(path);
}

function toggleFolder(path) {
  const next = new Set(collapsedFolders.value);
  next.has(path) ? next.delete(path) : next.add(path);
  collapsedFolders.value = next;
}
</script>

<template>
  <aside id="mobile-file-navigation" class="fm-sidebar" :class="{ 'is-mobile-open': mobileOpen }">
    <div class="brand">
      <div class="brand-mark"><i class="bi bi-stack"></i></div>
      <div class="brand-copy">
        <strong>Arunika Files</strong>
        <small>Asset manager</small>
      </div>
      <button class="mobile-sidebar-close" type="button" aria-label="Close navigation" @click="emit('close-mobile')"><i class="bi bi-x-lg"></i></button>
    </div>

    <div class="storage-switcher dropdown">
      <button class="storage-current" data-bs-toggle="dropdown" aria-expanded="false">
        <span class="storage-icon"><i class="bi" :class="profile.icon"></i></span>
        <span class="storage-copy">
          <small>Active storage</small>
          <strong>{{ profile.shortName }}</strong>
        </span>
        <span class="status-dot"></span>
        <i class="bi bi-chevron-down ms-auto"></i>
      </button>
      <div class="dropdown-menu storage-menu shadow-sm">
        <button
          v-for="item in profiles"
          :key="item.id"
          class="dropdown-item storage-option"
          :class="{ active: item.id === activeStorage }"
          @click="emit('change-storage', item.id); emit('close-mobile')"
        >
          <i class="bi" :class="item.icon"></i>
          <span>
            <strong>{{ item.name }}</strong>
            <small>{{ item.root }}</small>
          </span>
          <i v-if="item.id === activeStorage" class="bi bi-check2 ms-auto"></i>
        </button>
      </div>
    </div>

    <nav class="sidebar-nav" aria-label="File manager navigation">
      <button
        v-for="item in navItems"
        :key="item.id"
        :class="{ active: activeNav === item.id && !activeFolder }"
        @click="emit('change-nav', item.id); emit('close-mobile')"
      >
        <i class="bi" :class="item.icon"></i>
        <span>{{ item.label }}</span>
      </button>
    </nav>

    <div class="folder-section">
      <div class="section-heading">
        <span>Folders</span>
        <button type="button" title="Create folder" aria-label="Create folder" @click="emit('create-folder')"><i class="bi bi-plus-lg"></i></button>
      </div>
      <TransitionGroup name="folder-tree" tag="div" class="folder-list">
        <div
          v-for="folder in visibleFolders"
          :key="folder.id"
          :style="{ '--folder-depth': folder.depth }"
          class="folder-tree-row"
        >
          <button
            v-if="hasChildren(folder.path)"
            class="folder-tree-toggle"
            type="button"
            :aria-label="isCollapsed(folder.path) ? `Show ${folder.name}` : `Hide ${folder.name}`"
            :aria-expanded="!isCollapsed(folder.path)"
            @click.stop="toggleFolder(folder.path)"
          >
            <i class="bi" :class="isCollapsed(folder.path) ? 'bi-chevron-right' : 'bi-chevron-down'"></i>
          </button>
          <span v-else class="folder-tree-toggle-placeholder" aria-hidden="true"></span>
          <button
            class="folder-tree-item"
            :class="{ active: activeFolder === folder.id }"
            @click="emit('change-folder', folder.id); emit('close-mobile')"
          >
            <i class="bi" :class="folder.icon"></i>
            <span class="folder-tree-branch" v-if="folder.depth" aria-hidden="true"></span>
            <span>{{ folder.name }}</span>
            <small>{{ folder.count }}</small>
          </button>
        </div>
      </TransitionGroup>
    </div>

    <div class="sidebar-footer">
      <div class="usage-row">
        <span>Storage used</span>
        <strong>{{ profile.used }} {{ profile.unit }} / {{ profile.total }} {{ profile.unit }}</strong>
      </div>
      <div class="progress storage-progress" role="progressbar" :aria-valuenow="usagePercent">
        <div class="progress-bar" :style="{ width: usagePercent + '%' }"></div>
      </div>
      <button class="settings-link" @click="emit('open-settings')">
        <i class="bi bi-gear"></i> Storage & upload settings
      </button>
    </div>
  </aside>
</template>
