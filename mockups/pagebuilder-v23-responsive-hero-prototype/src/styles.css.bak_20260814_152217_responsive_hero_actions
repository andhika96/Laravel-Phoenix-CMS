:root {
  font-family: Inter, Arial, sans-serif;
  color: #243047;
  background: #eef1f7;
  font-synthesis: none;
  --primary: #5b6cff;
  --primary-soft: #eef0ff;
  --border: #dfe5f0;
  --subtle: #6f7b91;
}

* { box-sizing: border-box; }

body {
  margin: 0;
  min-width: 320px;
  min-height: 100vh;
  -webkit-font-smoothing: antialiased;
}

button, input { font: inherit; }
button { cursor: pointer; }
button:focus-visible, input:focus-visible { outline: 3px solid rgba(91, 108, 255, .28); outline-offset: 1px; }

.builder-shell { height: 100vh; min-height: 720px; display: flex; flex-direction: column; overflow: hidden; }

.topbar {
  height: 60px;
  flex: 0 0 60px;
  display: grid;
  grid-template-columns: minmax(420px, 1fr) auto minmax(310px, 1fr);
  align-items: center;
  gap: 18px;
  padding: 0 16px;
  background: #fff;
  border-bottom: 1px solid var(--border);
  z-index: 10;
}

.topbar-left, .topbar-actions, .device-switcher, .brand-copy, .crumb, .canvas-meta, .canvas-breadcrumb, .canvas-tools, .panel-heading, .section-title, .active-target, .media-row, .decision-bar > div { display: flex; align-items: center; }
.topbar-left { min-width: 0; gap: 10px; }
.brand-mark { width: 31px; height: 31px; border-radius: 8px; display: grid; place-items: center; color: #fff; background: linear-gradient(135deg, #5b6cff, #39a2ff); }
.brand-copy { align-items: flex-start; flex-direction: column; line-height: 1.05; padding-right: 16px; border-right: 1px solid var(--border); }
.brand-copy strong { font-size: 13px; }
.brand-copy span { margin-top: 4px; color: var(--subtle); font-size: 9px; text-transform: uppercase; letter-spacing: .55px; }
.crumb { min-width: 0; gap: 8px; color: var(--subtle); font-size: 12px; }
.crumb strong { max-width: 250px; color: #354158; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.crumb i { font-size: 10px; }

.device-switcher { gap: 4px; padding: 4px; border: 1px solid var(--border); border-radius: 9px; background: #f7f8fc; }
.device-switcher button { min-width: 38px; height: 32px; border: 0; border-radius: 6px; color: #768197; background: transparent; }
.device-switcher button span { display: none; }
.device-switcher button.active { color: var(--primary); background: #fff; box-shadow: 0 1px 5px rgba(28, 42, 78, .13); }

.topbar-actions { justify-content: flex-end; gap: 8px; }
.icon-button, .secondary-button, .primary-button { height: 34px; border-radius: 7px; border: 1px solid var(--border); background: #fff; color: #354158; font-size: 12px; font-weight: 600; }
.icon-button { width: 34px; }
.secondary-button, .primary-button { padding: 0 12px; }
.secondary-button i, .primary-button i { margin-right: 6px; }
.primary-button { color: #fff; border-color: var(--primary); background: var(--primary); }
.icon-button:disabled, .secondary-button:disabled, .primary-button:disabled { cursor: not-allowed; opacity: .62; }

.workspace { min-height: 0; flex: 1; display: grid; grid-template-columns: 320px minmax(0, 1fr); }
.inspector { min-height: 0; display: flex; flex-direction: column; background: #fff; border-right: 1px solid var(--border); box-shadow: 5px 0 20px rgba(35, 48, 71, .04); z-index: 3; }
.panel-heading { min-height: 66px; gap: 10px; padding: 12px 13px; border-bottom: 1px solid var(--border); }
.panel-heading > div { min-width: 0; display: flex; flex: 1; flex-direction: column; }
.panel-heading strong { font-size: 13px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.panel-heading span { margin-top: 4px; color: var(--subtle); font-size: 10px; }
.back-button { width: 30px; height: 30px; border: 0; border-radius: 7px; color: #66748c; background: #f3f5fa; }
.panel-heading .prototype-badge { flex: 0 0 auto; margin: 0; padding: 4px 6px; border-radius: 5px; color: #6959c6; background: #f1efff; font-size: 8px; font-weight: 700; letter-spacing: .4px; text-transform: uppercase; }

.tabs { display: grid; grid-template-columns: repeat(3, 1fr); border-bottom: 1px solid var(--border); }
.tabs button { height: 43px; border: 0; border-bottom: 2px solid transparent; color: #7a869a; background: #fff; font-size: 10px; font-weight: 700; letter-spacing: .45px; text-transform: uppercase; }
.tabs button.active { color: var(--primary); border-bottom-color: var(--primary); }
.panel-scroll { min-height: 0; overflow-y: auto; overscroll-behavior: contain; }

.panel-section { padding: 17px 16px; border-top: 1px solid #edf0f5; }
.panel-section.first { border-top: 0; }
.section-title { justify-content: space-between; margin-bottom: 14px; color: #364258; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: .45px; }
.section-title > i { color: #9aa3b3; font-size: 11px; }
.mode-toggle { display: grid; grid-template-columns: 1fr 1fr; gap: 6px; padding: 4px; border: 1px solid var(--border); border-radius: 9px; background: #f7f8fb; }
.mode-toggle button { min-height: 38px; border: 0; border-radius: 6px; color: #68758b; background: transparent; font-size: 11px; font-weight: 650; }
.mode-toggle button i { margin-right: 6px; }
.mode-toggle button.active { color: #4c5ed5; background: #fff; box-shadow: 0 1px 4px rgba(38, 50, 78, .12); }
.helper-copy, .empty-tab-copy { margin: 9px 1px 0; color: #7a8699; font-size: 10px; line-height: 1.55; }

.field { display: block; margin-bottom: 12px; }
.field > span, .control-label { display: block; margin-bottom: 6px; color: #657188; font-size: 10px; font-weight: 600; }
.field input, .number-control { width: 100%; height: 36px; border: 1px solid #d8dfea; border-radius: 7px; color: #354158; background: #fff; font-size: 11px; }
.field input { padding: 0 10px; }
.field input:focus { border-color: var(--primary); }
.number-control { display: grid; grid-template-columns: 1fr 34px; overflow: hidden; }
.number-control input { height: 34px; min-width: 0; border: 0; border-radius: 0; }
.number-control span { display: grid; place-items: center; color: #7a8699; border-left: 1px solid #e4e8f0; background: #f7f8fb; }
.control-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 9px; }

.device-chip { gap: 5px; margin: 0; padding: 4px 7px; border-radius: 6px; color: #5b6cff; background: var(--primary-soft); font-size: 9px; }
.target-tabs { display: grid; grid-template-columns: repeat(3, 1fr); gap: 5px; margin-bottom: 12px; }
.target-tabs button { height: 31px; border: 1px solid #dce2ed; border-radius: 6px; color: #6e7a90; background: #fff; font-size: 9px; }
.target-tabs button.active { color: #4d5fd8; border-color: #afb8f8; background: #f1f2ff; }
.active-target { justify-content: space-between; margin-bottom: 13px; padding: 8px 9px; border-radius: 7px; background: #f7f8fb; font-size: 10px; }
.active-target span { color: #7f8a9e; }
.active-target strong { color: #4e5fd7; }

.anchor-grid { width: 108px; display: grid; grid-template-columns: repeat(3, 36px); margin: 0 auto 15px; overflow: hidden; border: 1px solid #d9dfeb; border-radius: 7px; }
.anchor-grid button { position: relative; width: 36px; height: 32px; border: 0; border-right: 1px solid #e5e9f1; border-bottom: 1px solid #e5e9f1; background: #fbfcfe; }
.anchor-grid button:nth-child(3n) { border-right: 0; }
.anchor-grid button:nth-last-child(-n+3) { border-bottom: 0; }
.anchor-grid button span { width: 5px; height: 5px; display: block; margin: auto; border-radius: 50%; background: #a8b1c1; }
.anchor-grid button.active { background: var(--primary-soft); }
.anchor-grid button.active span { width: 8px; height: 8px; background: var(--primary); box-shadow: 0 0 0 3px rgba(91, 108, 255, .15); }

.alignment-control { display: grid; grid-template-columns: repeat(3, 1fr); overflow: hidden; border: 1px solid #d8dfea; border-radius: 7px; }
.alignment-control button { height: 34px; border: 0; border-right: 1px solid #e2e6ef; color: #7a8598; background: #fff; }
.alignment-control button:last-child { border-right: 0; }
.alignment-control button.active { color: var(--primary); background: var(--primary-soft); }
.reset-button { width: 100%; height: 34px; border: 1px solid #d8dfea; border-radius: 7px; color: #657188; background: #fff; font-size: 10px; }
.reset-button i { margin-right: 6px; }

.media-row { gap: 9px; margin-top: 8px; padding: 7px; border: 1px solid #e2e7ef; border-radius: 8px; }
.media-row img { width: 47px; height: 34px; border-radius: 5px; object-fit: cover; }
.media-row > div { min-width: 0; display: flex; flex: 1; flex-direction: column; }
.media-row strong { color: #4a566c; font-size: 10px; }
.media-row span { margin-top: 3px; color: #8b95a7; font-size: 9px; }
.media-row > i { color: #27a56f; }
.style-swatch-row { display: grid; grid-template-columns: 1fr 25px auto; align-items: center; gap: 8px; margin-top: 12px; color: #67738a; font-size: 10px; }
.swatch { width: 25px; height: 25px; border: 1px solid #d7dce6; border-radius: 5px; }
.swatch.dark { background: #292d32; }
.swatch.button { background: #30343a; }

.canvas-region { min-width: 0; min-height: 0; display: grid; grid-template-rows: 46px minmax(0, 1fr) 64px; background: #edf0f6; }
.canvas-toolbar { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; padding: 0 16px; border-bottom: 1px solid #dce2ec; background: #f8f9fc; }
.canvas-meta { gap: 5px; color: #7d889c; font-size: 10px; }
.canvas-meta em { margin-left: 5px; padding: 3px 6px; border-radius: 4px; color: #25835f; background: #e6f7ef; font-size: 8px; font-style: normal; text-transform: uppercase; letter-spacing: .4px; }
.canvas-breadcrumb { gap: 7px; color: #7d889b; font-size: 10px; }
.canvas-breadcrumb strong { color: #4e5fd7; }
.canvas-breadcrumb i { font-size: 9px; }
.canvas-tools { justify-content: flex-end; gap: 6px; }
.canvas-tools button { width: 29px; height: 29px; border: 1px solid #dce2ec; border-radius: 6px; color: #6e7a8f; background: #fff; }
.canvas-tools span { color: #758197; font-size: 9px; }

.stage { min-width: 0; min-height: 0; display: grid; place-items: center; padding: 28px; overflow: auto; background-image: linear-gradient(rgba(126, 139, 164, .08) 1px, transparent 1px), linear-gradient(90deg, rgba(126, 139, 164, .08) 1px, transparent 1px); background-size: 22px 22px; }
.webpage-frame { width: min(1120px, 100%); background: #fff; box-shadow: 0 12px 34px rgba(36, 48, 71, .14); transition: width .2s ease, height .2s ease; }
.webpage-frame.desktop { aspect-ratio: 1440 / 500; }
.webpage-frame.tablet { width: min(720px, 100%); aspect-ratio: 4 / 3; }
.webpage-frame.mobile { width: min(390px, 100%); height: min(680px, 100%); min-height: 540px; }

.hero-canvas { position: relative; width: 100%; height: 100%; overflow: hidden; background: #e8eaeb; }
.hero-canvas picture, .hero-canvas picture img { width: 100%; height: 100%; display: block; }
.hero-canvas picture img { object-fit: cover; object-position: center; }
.hero-canvas.tablet picture img { object-position: 56% center; }
.hero-canvas.mobile picture img { object-position: center top; }
.content-group, .independent-element { position: absolute; z-index: 2; color: #292d32; }
.content-group { display: flex; flex-direction: column; align-items: var(--content-align); gap: clamp(8px, 1vw, 20px); }
.content-group h1, .independent-element h1 { margin: 0; font-size: clamp(25px, 2.65vw, 46px); line-height: .96; letter-spacing: .01em; }
.content-group p, .independent-element p { margin: 0; font-size: clamp(13px, 1.35vw, 24px); line-height: 1.3; }
.hero-button { display: inline-flex; align-items: center; justify-content: center; gap: 7px; min-height: 38px; padding: 0 17px; border: 0; border-radius: 999px; color: #fff; background: #30343a; font-size: clamp(10px, 1vw, 15px); }
.hero-button i { font-size: 1.25em; }
.independent-element .hero-button { width: max-content; }
.independent-element[style*="text-align: center"] .hero-button { margin-inline: auto; }
.independent-element[style*="text-align: right"] .hero-button { margin-left: auto; }
.selection-outline { outline: 2px solid #5b6cff; outline-offset: 5px; }
.selection-label { position: absolute; left: -7px; bottom: calc(100% + 7px); padding: 3px 6px; border-radius: 4px 4px 0 0; color: #fff; background: #5b6cff; font-size: 8px; font-weight: 700; white-space: nowrap; text-transform: uppercase; letter-spacing: .35px; }
.independent-element { cursor: pointer; }

.decision-bar { display: flex; align-items: center; justify-content: space-between; gap: 20px; padding: 0 22px; border-top: 1px solid #dce2ec; background: #fff; }
.decision-bar > div { gap: 8px; }
.decision-bar > div > i { width: 30px; height: 30px; display: grid; place-items: center; border-radius: 7px; color: var(--primary); background: var(--primary-soft); }
.decision-bar span { color: #8a94a6; font-size: 9px; text-transform: uppercase; letter-spacing: .35px; }
.decision-bar strong { color: #3d495f; font-size: 11px; }
.decision-bar p { margin: 0; color: #778298; font-size: 10px; }

@media (max-width: 1100px) {
  .topbar { grid-template-columns: minmax(260px, 1fr) auto auto; }
  .crumb { display: none; }
  .workspace { grid-template-columns: 300px minmax(0, 1fr); }
  .stage { place-items: start center; padding: 20px; }
  .canvas-breadcrumb { display: none; }
}

@media (max-width: 760px) {
  .builder-shell { min-height: 900px; overflow: auto; }
  .topbar { position: sticky; top: 0; grid-template-columns: 1fr auto; }
  .device-switcher { justify-self: end; }
  .topbar-actions { display: none; }
  .workspace { grid-template-columns: 1fr; grid-template-rows: 520px minmax(540px, 1fr); }
  .inspector { border-right: 0; border-bottom: 1px solid var(--border); }
  .canvas-region { grid-template-rows: 46px minmax(0, 1fr) 76px; }
  .canvas-toolbar { grid-template-columns: 1fr auto; }
  .canvas-meta em { display: none; }
  .stage { min-height: 520px; }
  .decision-bar { align-items: flex-start; flex-direction: column; justify-content: center; gap: 5px; }
}

@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after { scroll-behavior: auto !important; transition: none !important; }
}
