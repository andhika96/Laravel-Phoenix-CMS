<div class="ph-notice" v-cloak>
	<div class="toast-container position-fixed top-0 end-0 p-3">
		<div class="toast ph-notice-toast" :class="responseStatusToast" role="alert" aria-live="assertive" aria-atomic="true" data-bs-delay="5000">
			<div class="toast-header">
				<strong class="me-auto">{{ t('Notice') }}</strong>
				<button type="button" class="btn-close" data-bs-dismiss="toast" aria-label="{{ t('Close') }}"></button>
			</div>
			<div class="toast-body">
				<ul v-if="isArrayMessageAfterSubmit" class="mb-0 ps-3"><li v-for="(item,index) in responseMessageAfterSubmit" :key="index">@{{ Array.isArray(item) ? item.join(' ') : item }}</li></ul>
				<span v-else>@{{ responseMessageAfterSubmit }}</span>
			</div>
		</div>
	</div>
</div>
