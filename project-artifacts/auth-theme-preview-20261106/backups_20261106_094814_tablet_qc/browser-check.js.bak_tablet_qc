async (page) => {
  const failures = [];
  const pageErrors = [];
  const submittedRequests = [];
  const scenes = [];
  const screenshots = [];
  page.on('pageerror',error => pageErrors.push(error.message));
  page.on('request',request => { if (request.method() !== 'GET') submittedRequests.push({method:request.method(),url:request.url()}); });
  await page.setViewportSize({width:1024,height:1100});
  await page.goto('http://127.0.0.1:8767/');
  const frame = page.frames().find(item => item.parentFrame() === page.mainFrame());
  await frame.locator('#phoenix-auth-preview').waitFor();
  await frame.evaluate(() => document.fonts.ready);
  const root = frame.locator('#phoenix-auth-preview');
  const variants = ['Verdant Split','Paper Centered'];
  const pageNames = ['login','signup','forgot','reset'];
  const stamp = new Date().toISOString().replace(/[:.]/g,'-');
  const base = 'D:/Laragon/www/laravel-13-phoenix/project-artifacts/auth-theme-preview-20261106/';
  async function chooseVariant(name) {
    if (await frame.locator('.viz-carousel > section:not([hidden])').getAttribute('data-variant') !== name) await frame.getByRole('button',{name:'Tema berikutnya',exact:true}).click();
  }
  async function choosePage(name) { await root.locator('.px-pages [data-page="'+name+'"]').click(); }
  async function checkGeometry(label) {
    const result = await frame.evaluate(() => {
      const root = document.getElementById('phoenix-auth-preview');
      const active = root.querySelector('.viz-carousel > section:not([hidden])');
      const win = active.querySelector('.px-window');
      const bounds = win.getBoundingClientRect();
      const bad = [];
      active.querySelectorAll('.px-main input,.px-main button,.px-main h1,.px-main label,.px-main footer').forEach(el => {
        const r = el.getBoundingClientRect();
        if (r.width && (r.left < bounds.left - 1 || r.right > bounds.right + 1 || r.bottom > bounds.bottom + 1)) bad.push(el.tagName+':'+(el.getAttribute('aria-label') || el.textContent.trim() || el.name));
      });
      const seen = new Set();
      const duplicates = Array.from(root.querySelectorAll('[id]')).filter(el => seen.has(el.id) || !seen.add(el.id)).map(el => el.id);
      return {width:innerWidth,scrollWidth:document.documentElement.scrollWidth,windowWidth:bounds.width,bad,duplicates,stageHeight:active.getBoundingClientRect().height,heading:active.querySelector('h1').textContent};
    });
    scenes.push({label,...result});
    if (result.scrollWidth > result.width + 1 || result.bad.length || result.duplicates.length) failures.push({label,...result});
    if (await root.locator('.px-pages [aria-pressed="true"]').count() !== 1) failures.push({label,error:'Page selection is ambiguous'});
  }
  for (const scheme of ['light','dark']) {
    await page.emulateMedia({colorScheme:scheme,reducedMotion:'reduce'});
    for (const width of [320,375,390,768,820,1024,1440]) {
      await page.setViewportSize({width,height:1150});
      for (const variant of variants) {
        await chooseVariant(variant);
        for (const screen of pageNames) { await choosePage(screen); await checkGeometry(scheme+'/'+width+'/'+variant+'/'+screen); }
        if (scheme === 'light' && [390,768,1024].includes(width)) {
          await choosePage('login');
          const file = base+'qc-'+stamp+'-'+variant.toLowerCase().replace(/ /g,'-')+'-'+width+'.png';
          await page.screenshot({path:file,fullPage:true,scale:'css'});
          screenshots.push(file);
        }
      }
    }
  }
  await page.emulateMedia({colorScheme:'light'});
  await page.setViewportSize({width:1024,height:1150});
  await chooseVariant('Verdant Split');
  for (const device of ['desktop','tablet','mobile']) {
    await root.locator('.px-devices [data-device="'+device+'"]').click();
    await checkGeometry('device-control/'+device);
    const size = await root.locator('[data-variant="Verdant Split"] .px-window').boundingBox();
    if (device === 'tablet' && size.width > 768.5) failures.push({error:'Tablet control is too wide',size});
    if (device === 'mobile' && size.width > 390.5) failures.push({error:'Mobile control is too wide',size});
  }
  await root.locator('.px-devices [data-device="desktop"]').click();
  await choosePage('login');
  const active = root.locator('[data-variant="Verdant Split"]');
  await active.getByLabel('Email address',{exact:true}).fill('preview@example.test');
  await active.getByLabel('Password',{exact:true}).fill('PreviewOnly123!');
  await active.getByRole('button',{name:'Show password',exact:true}).click();
  if (await active.locator('[name="password"]').getAttribute('type') !== 'text') failures.push({error:'Password reveal failed'});
  await active.getByRole('button',{name:'Hide password',exact:true}).click();
  if (await active.locator('[name="password"]').getAttribute('type') !== 'password') failures.push({error:'Password hide failed'});
  await active.getByRole('button',{name:'Sign in',exact:true}).click();
  if (!(await active.getByRole('status').textContent()).includes('has not been accessed')) failures.push({error:'Login preview feedback failed'});
  await choosePage('signup');
  await active.getByLabel('Full name',{exact:true}).fill('Preview User');
  await active.getByLabel('Username',{exact:true}).fill('preview-user');
  await active.getByLabel('Email address',{exact:true}).fill('preview@example.test');
  await active.getByLabel('Password',{exact:true}).fill('PreviewOnly123!');
  await active.getByRole('button',{name:'Create account',exact:true}).click();
  if (!(await active.getByRole('status').textContent()).includes('No account')) failures.push({error:'Signup preview feedback failed'});
  await choosePage('forgot');
  await active.getByLabel('Email address',{exact:true}).fill('preview@example.test');
  await active.getByRole('button',{name:'Send reset link',exact:true}).click();
  if (!(await active.locator('h1').textContent()).includes('Check your inbox')) failures.push({error:'Forgot confirmation failed'});
  if (!(await active.locator('.px-message').textContent()).includes('No email')) failures.push({error:'Forgot preview disclosure missing'});
  await choosePage('reset');
  await active.getByLabel('New password',{exact:true}).fill('PreviewOnly123!');
  await active.getByLabel('Confirm new password',{exact:true}).fill('Mismatch123!');
  await active.getByRole('button',{name:'Update password',exact:true}).click();
  if (!(await active.getByRole('alert').textContent()).includes('don’t match')) failures.push({error:'Password mismatch feedback failed'});
  await active.getByLabel('Confirm new password',{exact:true}).fill('PreviewOnly123!');
  await active.getByRole('button',{name:'Update password',exact:true}).click();
  if (!(await active.locator('h1').textContent()).includes('You’re all set')) failures.push({error:'Reset confirmation failed'});
  await choosePage('login');
  const finalFile = base+'qc-'+stamp+'-desktop-final.png';
  await page.screenshot({path:finalFile,fullPage:true,scale:'css'});
  screenshots.push(finalFile);
  if (pageErrors.length) failures.push({error:'Browser errors',pageErrors});
  if (submittedRequests.length) failures.push({error:'Unexpected submission request',submittedRequests});
  console.log(JSON.stringify({status:failures.length?'FAIL':'PASS',geometryScenes:scenes.length,viewportWidths:[320,375,390,768,820,1024,1440],schemes:['light','dark'],variants,interactions:['screen navigation','variant carousel','desktop/tablet/mobile controls','show/hide password','login feedback','signup feedback','forgot confirmation','reset mismatch','reset confirmation'],browserErrors:pageErrors,submissionRequests:submittedRequests,failures,screenshots,scenes},null,2));
  if (failures.length) throw new Error(failures.length+' preview checks failed');
}
