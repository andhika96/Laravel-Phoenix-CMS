  #phoenix-auth-preview .px-form-zone h1 { font-size: 29px; }
}
@media (prefers-reduced-motion: reduce) { #phoenix-auth-preview * { transition: none !important; } }
</style>
<div id="phoenix-auth-preview" data-device="desktop" lang="en">
  <div class="px-toolbar" aria-label="Kontrol preview desain">
    <div class="px-pages" role="group" aria-label="Halaman autentikasi">
      <button type="button" data-page="login" aria-pressed="true">Login</button>
      <button type="button" data-page="signup" aria-pressed="false">Signup</button>
      <button type="button" data-page="forgot" aria-pressed="false">Forgot password</button>
      <button type="button" data-page="reset" aria-pressed="false">Reset password</button>
    </div>
    <div class="px-devices" role="group" aria-label="Ukuran layar preview">
      <button type="button" data-device="desktop" aria-pressed="true"><i data-lucide="monitor" aria-hidden="true"></i>Desktop</button>
      <button type="button" data-device="mobile" aria-pressed="false"><i data-lucide="smartphone" aria-hidden="true"></i>Mobile</button>
    </div>
  </div>
  <div class="viz-carousel" aria-label="Pilihan tema autentikasi Phoenix" data-previous-label="Tema sebelumnya" data-next-label="Tema berikutnya">
    <section class="px-stage" data-variant="Verdant Split" aria-label="Verdant Split">
      <div class="px-window" aria-label="Tema Verdant Split">
        <div class="px-split">
          <aside class="px-art" aria-label="Phoenix, a space for your next idea">
            <div class="px-brand"><span class="px-brand-mark"><i data-lucide="flame" aria-hidden="true"></i></span>Phoenix</div>
            <p class="px-art-kicker">A SPACE FOR YOUR NEXT IDEA</p>
            <h2>A little clarity.<br>A lot of <em>possibility.</em></h2>
            <p class="px-art-copy">Bring your ideas together.<br>Make something that matters.</p>
            <div class="px-sculpture" aria-hidden="true"><div class="px-orbit"></div><div class="px-stem"></div><div class="px-leaf px-leaf-e"></div><div class="px-leaf px-leaf-f"></div><div class="px-leaf px-leaf-c"></div><div class="px-leaf px-leaf-d"></div><div class="px-leaf px-leaf-a"></div><div class="px-leaf px-leaf-b"></div></div>
            <div class="px-art-bottom"><span>Thoughtfully simple. Naturally yours.</span><i data-lucide="move-up-right" aria-hidden="true"></i></div>
          </aside>
          <main class="px-main">
            <div class="px-main-top"><span class="px-mini-brand"><i data-lucide="flame" aria-hidden="true"></i>Phoenix CMS</span><span class="px-demo-label">Design preview</span></div>
            <div class="px-form-zone" aria-live="polite">
              <p class="px-heading-eyebrow">YOUR WORKSPACE AWAITS</p>
              <h1>Welcome back.</h1>
              <p class="px-subtitle">A fresh perspective starts here.<br>Sign in to your Phoenix workspace.</p>
              <form class="px-form">
                <div class="px-field"><label for="px-initial-email">Email address</label><input class="px-input" id="px-initial-email" name="email" type="email" placeholder="you@company.com" autocomplete="email" required></div>
                <div class="px-field"><label for="px-initial-password">Password</label><div class="px-input-wrap"><input class="px-input" id="px-initial-password" name="password" type="password" data-secret placeholder="Enter your password" autocomplete="current-password" required><button class="px-eye" type="button" aria-label="Show password" aria-pressed="false"><i data-lucide="eye" aria-hidden="true"></i></button></div></div>
                <div class="px-options"><label class="px-checkbox"><input type="checkbox" name="remember">Remember me</label><button class="px-link" data-go="forgot" type="button">Forgot password?</button></div>
                <button class="px-submit" type="submit">Sign in<i data-lucide="arrow-right" aria-hidden="true"></i></button>
              </form>
              <p class="px-signpost">New around here? <button class="px-link" type="button" data-go="signup">Create an account</button></p>
            </div>
            <footer class="px-main-bottom"><span>© 2026 Phoenix</span><span>A simpler way to create.</span></footer>
          </main>
        </div>
      </div>
    </section>
    <section class="px-stage" data-variant="Paper Centered" aria-label="Paper Centered" hidden></section>
  </div>
</div>
<script>
(() => {
  const root = document.getElementById('phoenix-auth-preview');
  const original = root.querySelector('.px-window');
  const centered = original.cloneNode(true);
  centered.classList.add('px-centered');
  centered.setAttribute('aria-label','Tema Paper Centered');
  root.querySelector('[data-variant="Paper Centered"]').appendChild(centered);
  const windows = [original,centered];
  const restored = window.openai?.widgetState?.modelContent || {};
  const pages = ['login','signup','forgot','reset'];
  const state = { page: pages.includes(restored.page) ? restored.page : 'login', device: restored.device === 'mobile' ? 'mobile' : 'desktop' };
  const themes = [{ accent:'#187653',radius:9 },{ accent:'#394f43',radius:7 }];
  function save() { window.openai?.setWidgetState?.({modelContent:{page:state.page,device:state.device},privateContent:null})?.catch(() => {}); }
  function icons() { if (globalThis.lucide) lucide.createIcons({attrs:{width:16,height:16}}); }
  function field(prefix,key,label,type,placeholder,autocomplete) {
    const secret = type === 'password';
    return '<div class="px-field"><label for="'+prefix+'-'+key+'">'+label+'</label><div class="px-input-wrap"><input class="px-input" id="'+prefix+'-'+key+'" name="'+key+'" type="'+type+'" placeholder="'+placeholder+'" autocomplete="'+autocomplete+'" '+(secret?'data-secret ':'')+'required>'+(secret?'<button class="px-eye" type="button" aria-label="Show '+label.toLowerCase()+'" aria-pressed="false"><i data-lucide="eye" aria-hidden="true"></i></button>':'')+'</div></div>';
  }
  const content = {
    login:{eyebrow:'YOUR WORKSPACE AWAITS',title:'Welcome back.',copy:'A fresh perspective starts here.<br>Sign in to your Phoenix workspace.',button:'Sign in'},
    signup:{eyebrow:'MAKE SOMETHING YOURS',title:'Create your account.',copy:'A new chapter starts with you.<br>Let’s set up your Phoenix workspace.',button:'Create account'},
    forgot:{eyebrow:'LET’S GET YOU BACK IN',title:'Forgot your password?',copy:'It happens. Enter your email address and we’ll send you a link to reset your password.',button:'Send reset link'},
    reset:{eyebrow:'A FRESH START',title:'Set a new password.',copy:'Choose a strong password to keep your Phoenix workspace protected.',button:'Update password'}
  };
  function render() {
    root.dataset.device = state.device;
    root.querySelectorAll('.px-pages button').forEach(b => b.setAttribute('aria-pressed',String(b.dataset.page === state.page)));
    root.querySelectorAll('.px-devices button').forEach(b => b.setAttribute('aria-pressed',String(b.dataset.device === state.device)));
    windows.forEach((win,index) => {
      const c = content[state.page];
      const prefix = 'px-'+index+'-'+state.page;
      let fields = '';
      if (state.page === 'signup') fields += field(prefix,'fullname','Full name','text','Your full name','name')+field(prefix,'username','Username','text','Choose a username','username');
      if (state.page !== 'reset') fields += field(prefix,'email','Email address','email','you@company.com','email');
      if (state.page !== 'forgot') fields += field(prefix,'password',state.page === 'reset'?'New password':'Password','password',state.page === 'login'?'Enter your password':'Create a strong password',state.page === 'login'?'current-password':'new-password');
      if (state.page === 'reset') fields += field(prefix,'confirmation','Confirm new password','password','Re-enter your new password','new-password');
      if (state.page === 'login') fields += '<div class="px-options"><label class="px-checkbox"><input type="checkbox" name="remember">Remember me</label><button class="px-link" data-go="forgot" type="button">Forgot password?</button></div>';
      let tail = state.page === 'login'?'<p class="px-signpost">New around here? <button class="px-link" type="button" data-go="signup">Create an account</button></p>':state.page === 'signup'?'<p class="px-signpost">Already have an account? <button class="px-link" type="button" data-go="login">Sign in</button></p>':'<p class="px-signpost"><button class="px-link px-back" type="button" data-go="login"><i data-lucide="arrow-left" aria-hidden="true"></i>Back to sign in</button></p>';
      win.querySelector('.px-form-zone').innerHTML = '<p class="px-heading-eyebrow">'+c.eyebrow+'</p><h1>'+c.title+'</h1><p class="px-subtitle">'+c.copy+'</p><form class="px-form">'+fields+'<p class="px-error" role="alert" hidden></p><button class="px-submit" type="submit">'+c.button+'<i data-lucide="arrow-right" aria-hidden="true"></i></button></form>'+tail;
    });
    icons();
  }
  function applyTheme(win,theme) {
    win.style.setProperty('--px-accent',theme.accent);
    win.style.setProperty('--px-radius',theme.radius+'px');
    const rgb = theme.accent.match(/[a-f\d]{2}/gi);
    const luminance = rgb.map(v=>parseInt(v,16)/255).map(v=>v<=.04045?v/12.92:Math.pow((v+.055)/1.055,2.4)).reduce((sum,v,i)=>sum+v*[.2126,.7152,.0722][i],0);
    win.style.setProperty('--px-accent-text',luminance>.179?'#000000':'#ffffff');
  }
  root.addEventListener('click',event => {
    const button = event.target.closest('button');
    if (!button || !root.contains(button)) return;
    if (button.dataset.page || button.dataset.go) { state.page = button.dataset.page || button.dataset.go; render(); save(); }
    else if (button.dataset.device) { state.device = button.dataset.device; render(); save(); }
    else if (button.classList.contains('px-eye')) {
      const input = button.parentElement.querySelector('input');
      input.type = input.type === 'password' ? 'text' : 'password';
      button.setAttribute('aria-pressed',String(input.type === 'text'));
      button.setAttribute('aria-label',(input.type === 'text'?'Hide ':'Show ')+(input.name === 'confirmation'?'confirmation password':'password'));
      button.innerHTML = '<i data-lucide="'+(input.type === 'text'?'eye-off':'eye')+'" aria-hidden="true"></i>';
      icons();
    }
  });
  root.addEventListener('submit',event => {
    event.preventDefault();
    const form = event.target;
    if (!form.matches('.px-form')) return;
    const data = new FormData(form);
    const error = form.querySelector('.px-error');
    if (state.page === 'reset' && data.get('password') !== data.get('confirmation')) { error.textContent = 'Your passwords don’t match. Please try again.'; error.hidden = false; form.querySelector('[name="confirmation"]').focus(); return; }
    const zone = form.closest('.px-form-zone');
    if (state.page === 'forgot' || state.page === 'reset') {
      const forgot = state.page === 'forgot';
      zone.innerHTML = '<div class="px-success-icon"><i data-lucide="'+(forgot?'mail-check':'shield-check')+'" aria-hidden="true"></i></div><p class="px-heading-eyebrow">'+(forgot?'RESET LINK CONFIRMATION':'READY FOR A FRESH START')+'</p><h1>'+(forgot?'Check your inbox.':'You’re all set.')+'</h1><p class="px-subtitle">'+(forgot?'If an account matches that address, a password reset link will be on its way.':'Your new password is ready. Sign in and pick up where you left off.')+'</p><p class="px-message">Design preview only. '+(forgot?'No email has been sent.':'Your password has not been changed.')+'</p><p class="px-signpost"><button class="px-link px-back" type="button" data-go="login"><i data-lucide="arrow-left" aria-hidden="true"></i>Back to sign in</button></p>';
      icons();
    } else {
      error.hidden = true;
      let message = zone.querySelector('.px-message');
      if (!message) { message = document.createElement('p'); message.className = 'px-message'; message.setAttribute('role','status'); form.appendChild(message); }
      message.textContent = state.page === 'login' ? 'Design preview only. Your account has not been accessed.' : 'Design preview only. No account has been created.';
    }
  });
  windows.forEach((win,index) => {
    applyTheme(win,themes[index]);
    if (globalThis.Tweak) {
      const tweak = new Tweak({container:win,onChange:()=>applyTheme(win,themes[index])});
      tweak.addColorPicker(themes[index],'accent',{label:'Primary color',reference:'--px-accent'});
      tweak.addSlider(themes[index],'radius',{label:'Input corner radius',min:0,max:20,step:1,unit:'px',reference:'--px-radius'});
    }
  });
  window.addEventListener('openai:set_globals',event => {
    const next = event.detail?.globals?.widgetState?.modelContent;
    if (!next) return;
    state.page = pages.includes(next.page)?next.page:state.page;
    state.device = next.device === 'mobile'?'mobile':'desktop';
    render();
  });
  render();
})();
</script>
