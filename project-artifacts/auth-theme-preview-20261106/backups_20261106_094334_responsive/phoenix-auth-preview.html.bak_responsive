#phoenix-auth-preview .px-link { padding: 0; background: transparent; border: 0; color: var(--px-accent); font-size: inherit; font-weight: 550; text-decoration: none; }
#phoenix-auth-preview .px-link:hover { text-decoration: underline; text-underline-offset: 3px; }
#phoenix-auth-preview .px-submit { display: flex; align-items: center; justify-content: center; gap: 10px; width: 100%; min-height: 46px; padding: 12px; border: 0; border-radius: var(--px-radius); background: var(--px-accent); color: var(--px-accent-text); font-size: 12px; font-weight: 650; transition: background .15s,transform .15s; }
#phoenix-auth-preview .px-submit:hover { background: color-mix(in srgb,var(--px-accent),#000 12%); }
#phoenix-auth-preview .px-submit:active { transform: translateY(1px); }
#phoenix-auth-preview .px-submit svg { width: 15px; height: 15px; }
#phoenix-auth-preview .px-signpost { font-size: 12px; text-align: center; margin: 23px 0 0; color: var(--px-muted); }
#phoenix-auth-preview .px-help { font-size: 11px; color: var(--px-muted); margin: 0; }
#phoenix-auth-preview .px-back { display: inline-flex; align-items: center; gap: 7px; margin: 25px auto 0; font-size: 12px; }
#phoenix-auth-preview .px-back svg { width: 14px; height: 14px; }
#phoenix-auth-preview .px-main-bottom { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 10px; color: var(--px-muted); font-size: 10px; }
#phoenix-auth-preview .px-error { color: light-dark(#ad352d,#ffada2); font-size: 12px; margin: 0; }
#phoenix-auth-preview .px-message { padding: 13px 15px; background: color-mix(in srgb,var(--px-accent) 8%,var(--px-surface)); color: var(--px-ink); border-radius: var(--px-radius); font-size: 12px; line-height: 1.7; margin: 0; }
#phoenix-auth-preview .px-success-icon { width: 48px; height: 48px; border-radius: 14px; background: color-mix(in srgb,var(--px-accent) 12%,var(--px-surface)); color: var(--px-accent); display: flex; align-items: center; justify-content: center; margin-bottom: 21px; }
#phoenix-auth-preview .px-success-icon svg { width: 23px; height: 23px; }
#phoenix-auth-preview .px-centered { background: var(--px-bg); padding: 30px; }
#phoenix-auth-preview .px-centered .px-split { display: block; position: relative; min-height: 700px; }
#phoenix-auth-preview .px-centered .px-art { display: none; }
#phoenix-auth-preview .px-centered .px-main { width: min(100%,430px); min-height: 685px; padding: 23px 33px 21px; margin: 7px auto 0; background: var(--px-surface); border: 1px solid var(--px-line); border-radius: 14px; box-shadow: 0 12px 35px #163c2510; }
#phoenix-auth-preview .px-centered .px-form-zone { padding: 29px 0; }
#phoenix-auth-preview .px-centered .px-main-top { margin-bottom: 4px; }
#phoenix-auth-preview .px-centered .px-heading-eyebrow { color: var(--px-muted); }
#phoenix-auth-preview[data-device="mobile"] .px-window { max-width: 390px; }
#phoenix-auth-preview[data-device="mobile"] .px-split { display: flex; min-height: 760px; }
