#phoenix-auth-preview .px-orbit::before { content: ''; position: absolute; inset: 23px; border: 1px solid #638371; border-radius: inherit; }
#phoenix-auth-preview .px-leaf { position: absolute; width: 111px; height: 176px; left: 50%; top: 50%; border-radius: 100% 0 100% 0; transform-origin: 0% 100%; background: linear-gradient(118deg,#b4d6a3 0%,#729d79 44%,#365e47 100%); box-shadow: inset 1px 0 #e2e9b950, 15px 12px 28px #071e1b36; }
#phoenix-auth-preview .px-leaf-a { transform: translate(-2px,-89%) rotate(-32deg); }
#phoenix-auth-preview .px-leaf-b { transform: translate(-2px,-89%) rotate(28deg); background: linear-gradient(122deg,#d4e3b6,#8baf80 48%,#365e47); }
#phoenix-auth-preview .px-leaf-c { transform: translate(-2px,-89%) rotate(-91deg) scale(.84); background: linear-gradient(122deg,#6f9b79,#48775b 48%,#1d4c39); }
#phoenix-auth-preview .px-leaf-d { transform: translate(-2px,-89%) rotate(85deg) scale(.84); background: linear-gradient(122deg,#bad4a5,#72997a 48%,#365e47); }
#phoenix-auth-preview .px-leaf-e { transform: translate(-2px,-89%) rotate(-148deg) scale(.66); background: linear-gradient(122deg,#5b8e6b,#245c40); }
#phoenix-auth-preview .px-leaf-f { transform: translate(-2px,-89%) rotate(144deg) scale(.66); background: linear-gradient(122deg,#8db08a,#396b4b); }
#phoenix-auth-preview .px-stem { position: absolute; left: 49.5%; top: 53%; width: 2px; height: 116px; transform: rotate(-4deg); transform-origin: top; background: #a9c598; }
#phoenix-auth-preview .px-art-bottom { margin-top: auto; display: flex; align-items: center; justify-content: space-between; padding-top: 20px; border-top: 1px solid #476b55; font-size: 11px; letter-spacing: .2px; color: #c4d1c2; }
#phoenix-auth-preview .px-art-bottom svg { width: 17px; height: 17px; }
