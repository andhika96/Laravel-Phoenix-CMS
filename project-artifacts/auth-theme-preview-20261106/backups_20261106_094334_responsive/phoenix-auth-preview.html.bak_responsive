#phoenix-auth-preview .px-eye { position: absolute; right: 3px; top: 3px; width: 40px; height: 40px; border: 0; background: transparent; border-radius: 5px; display: flex; align-items: center; justify-content: center; color: var(--px-muted); }
#phoenix-auth-preview .px-eye svg { width: 17px; height: 17px; stroke-width: 1.6; }
#phoenix-auth-preview .px-options { display: flex; align-items: center; justify-content: space-between; gap: 10px; font-size: 11px; }
#phoenix-auth-preview .px-checkbox { display: inline-flex; align-items: center; gap: 7px; font-size: 11px; color: var(--px-muted); }
