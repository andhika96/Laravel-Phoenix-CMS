#phoenix-auth-preview .px-form-zone h1 { margin: 0; font: 650 30px/1.25 'Manrope',sans-serif; letter-spacing: -1.15px; color: var(--px-ink); }
#phoenix-auth-preview .px-subtitle { margin: 10px 0 28px; color: var(--px-muted); font-size: 13px; line-height: 1.65; }
#phoenix-auth-preview .px-form { display: grid; gap: 18px; }
#phoenix-auth-preview .px-field { min-width: 0; display: grid; gap: 7px; }
#phoenix-auth-preview .px-field label { font-size: 12px; font-weight: 550; color: var(--px-ink); }
#phoenix-auth-preview .px-input-wrap { position: relative; }
