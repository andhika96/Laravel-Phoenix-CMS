#phoenix-auth-preview[data-device="mobile"] .px-main { width: 100%; padding: 26px; }
#phoenix-auth-preview[data-device="mobile"] .px-centered { padding: 15px; }
#phoenix-auth-preview[data-device="mobile"] .px-centered .px-main { padding: 23px; min-height: 730px; margin: 0; }
#phoenix-auth-preview[data-device="mobile"] .px-input { font-size: 16px; }
#phoenix-auth-preview[data-device="mobile"] .px-form-zone { padding: 32px 0; }
@media (max-width: 680px) {
  #phoenix-auth-preview .px-toolbar { padding-right: 0; gap: 8px; }
  #phoenix-auth-preview .px-toolbar button { padding: 9px 10px; min-height: 42px; }
  #phoenix-auth-preview .px-split { display: flex; min-height: 760px; }
  #phoenix-auth-preview .px-art { display: none; }
  #phoenix-auth-preview .px-main { width: 100%; padding: 26px; }
  #phoenix-auth-preview .px-centered { padding: 14px; }
