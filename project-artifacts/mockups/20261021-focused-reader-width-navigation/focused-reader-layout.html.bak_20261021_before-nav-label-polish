 <script>
 (()=>{
   const root=document.getElementById('fr-layout-preview');
   const first=root.querySelector('.fl-page');
   const second=first.cloneNode(true);
   second.classList.add('fl-editorial');second.setAttribute('aria-label','Editorial Flow — pengaturan desain');
   root.querySelector('[data-variant="Editorial Flow"] .fl-stage').append(second);
   const defaults={device:'desktop',hover:false,cardWidth:880,editorialWidth:960,radius:10};
   const state={...defaults,...(window.openai?.widgetState?.modelContent?.focusedReaderLayout||{})};
   const save=()=>window.openai?.setWidgetState?.({modelContent:{focusedReaderLayout:state},privateContent:null})?.catch(()=>{});
   const render=()=>{
     const widths={desktop:1200,tablet:834,mobile:390};
     for(const page of [first,second]){page.style.maxWidth=(widths[state.device]||1200)+'px';page.classList.toggle('show-hover',!!state.hover);page.style.setProperty('--fl-radius',state.radius+'px')}
     first.style.setProperty('--fl-reading',state.cardWidth+'px');second.style.setProperty('--fl-reading',state.editorialWidth+'px');
     root.querySelectorAll('[data-device]').forEach(b=>b.setAttribute('aria-pressed',String(b.dataset.device===state.device)));
     root.querySelector('[data-hover]').setAttribute('aria-pressed',String(!!state.hover));
   };
   root.querySelectorAll('[data-device]').forEach(b=>b.addEventListener('click',()=>{state.device=b.dataset.device;render();save()}));
   root.querySelector('[data-hover]').addEventListener('click',()=>{state.hover=!state.hover;render();save()});
   root.querySelectorAll('.fl-navlink').forEach(a=>a.addEventListener('click',e=>{e.preventDefault();a.closest('.fl-after').querySelector('.fl-selected').textContent='Dipilih: '+a.querySelector('strong').textContent}));
   window.addEventListener('openai:set_globals',e=>{const incoming=e.detail?.globals?.widgetState?.modelContent?.focusedReaderLayout;if(incoming){Object.assign(state,defaults,incoming);render()}});
   render();
   if(globalThis.Tweak){
     const cards=new Tweak({container:first,onChange:()=>{render();save()}});
     cards.addSlider(state,'cardWidth',{label:'Lebar kolom baca',min:760,max:1040,step:20,unit:'px'});
     cards.addSlider(state,'radius',{label:'Radius kartu navigasi',min:0,max:18,step:2,unit:'px'});
     const editorial=new Tweak({container:second,onChange:()=>{render();save()}});
     editorial.addSlider(state,'editorialWidth',{label:'Lebar kolom baca',min:800,max:1040,step:20,unit:'px'});
   }
 })();
 </script>
