<div id="fr-layout-preview">
 <style>
 #fr-layout-preview{--fl-bg:light-dark(#fff,#171d22);--fl-ink:light-dark(#172833,#edf3f5);--fl-muted:light-dark(#65757e,#afbec6);--fl-line:light-dark(#dfe7e7,#354349);--fl-green:light-dark(#087e61,#60d5b0);--fl-soft:light-dark(#edf8f3,#20372e);font-family:Arial,Helvetica,sans-serif;color:var(--fl-ink)}
