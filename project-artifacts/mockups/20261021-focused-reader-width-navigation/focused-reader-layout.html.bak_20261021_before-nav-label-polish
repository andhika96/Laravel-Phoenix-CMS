 #fr-layout-preview blockquote{border-left:3px solid var(--fl-green);padding:2px 0 2px 20px;margin:24px 0;font-size:15px;line-height:1.7;color:var(--fl-ink)}
 #fr-layout-preview .fl-after{max-width:var(--fl-reading,880px);margin:32px auto 0;border-top:1px solid var(--fl-line);padding-top:22px}
 #fr-layout-preview .fl-nav-heading{margin:0 0 14px;font-size:12px;font-weight:600;color:var(--fl-muted)}
 #fr-layout-preview .fl-nav{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px}
 #fr-layout-preview .fl-navlink{display:flex;flex-direction:column;gap:14px;min-width:0;min-height:178px;border:1px solid var(--fl-line);border-radius:var(--fl-radius,10px);padding:18px;text-decoration:none;background:var(--fl-bg);color:var(--fl-ink);transition:background-color .18s ease,border-color .18s ease;color:var(--fl-ink)}
 #fr-layout-preview .fl-direction{display:flex;align-items:center;justify-content:space-between;gap:10px;font-size:11px;letter-spacing:.07em;font-weight:600;color:var(--fl-muted)}
 #fr-layout-preview .fl-direction .fl-arrow{display:grid;place-items:center;width:30px;height:30px;flex-shrink:0;border:1px solid var(--fl-line);border-radius:50%;transition:transform .18s ease,background-color .18s ease,color .18s ease}
 #fr-layout-preview .fl-navbody{display:flex;gap:14px;align-items:center;min-width:0}
 #fr-layout-preview .fl-thumb{width:76px;height:72px;object-fit:cover;border-radius:6px;flex-shrink:0}
 #fr-layout-preview .fl-thumb-right{object-position:85% center}
 #fr-layout-preview .fl-navcopy{min-width:0}
 #fr-layout-preview .fl-navcopy small{display:block;color:var(--fl-muted);font-size:11px;margin-bottom:6px}
 #fr-layout-preview .fl-navcopy strong{font-size:15px;font-weight:600;line-height:1.45;display:block;text-wrap:pretty;overflow-wrap:anywhere}
 #fr-layout-preview .fl-navlink:hover,#fr-layout-preview .fl-navlink:focus-visible,#fr-layout-preview .show-hover .fl-next{background:var(--fl-soft);border-color:var(--fl-green)}
 #fr-layout-preview .fl-navlink:hover .fl-navcopy strong,#fr-layout-preview .fl-navlink:focus-visible .fl-navcopy strong,#fr-layout-preview .show-hover .fl-next .fl-navcopy strong{color:var(--fl-green)}
 #fr-layout-preview .fl-navlink:hover .fl-arrow,#fr-layout-preview .fl-navlink:focus-visible .fl-arrow,#fr-layout-preview .show-hover .fl-next .fl-arrow{background:var(--fl-green);border-color:var(--fl-green);color:light-dark(#fff,#11291f)}
 #fr-layout-preview .fl-next:hover .fl-arrow,#fr-layout-preview .fl-next:focus-visible .fl-arrow,#fr-layout-preview .show-hover .fl-next .fl-arrow{transform:translateX(3px)}
 #fr-layout-preview .fl-prev:hover .fl-arrow,#fr-layout-preview .fl-prev:focus-visible .fl-arrow{transform:translateX(-3px)}
 #fr-layout-preview .fl-navlink:focus-visible{outline:2px solid var(--fl-green);outline-offset:4px}
 #fr-layout-preview .fl-selected{font-size:12px;color:var(--fl-green);margin:14px 0 0;min-height:18px}
 #fr-layout-preview .fl-editorial .fl-header{max-width:var(--fl-reading,960px);text-align:left}
 #fr-layout-preview .fl-editorial .fl-header h1{max-width:740px}
 #fr-layout-preview .fl-editorial .fl-meta{justify-content:flex-start}
 #fr-layout-preview .fl-editorial .fl-cover{max-width:var(--fl-reading,960px)}
 #fr-layout-preview .fl-editorial .fl-nav{gap:0;border-top:1px solid var(--fl-line);border-bottom:1px solid var(--fl-line)}
 #fr-layout-preview .fl-editorial .fl-navlink{border:0;border-radius:0;padding:22px;min-height:164px}
 #fr-layout-preview .fl-editorial .fl-prev{border-right:1px solid var(--fl-line)}
 #fr-layout-preview .fl-editorial .fl-navcopy strong{font-size:17px}
 #fr-layout-preview .fl-editorial .fl-thumb{display:none}
 #fr-layout-preview [hidden]{display:none!important}
 @container(max-width:850px){#fr-layout-preview .fl-main{padding:24px}#fr-layout-preview .fl-site{padding:18px 24px}#fr-layout-preview .fl-navlink{padding:16px}#fr-layout-preview .fl-thumb{width:62px;height:64px}}
 @container(max-width:560px){#fr-layout-preview .fl-main{padding:18px 20px 28px}#fr-layout-preview .fl-site{padding:16px 20px}#fr-layout-preview .fl-site-links{display:none}#fr-layout-preview .fl-header{text-align:left}#fr-layout-preview h1{font-size:24px}#fr-layout-preview h2{font-size:21px}#fr-layout-preview .fl-meta{justify-content:flex-start;gap:6px 12px}#fr-layout-preview .fl-meta b{flex-basis:100%}#fr-layout-preview .fl-cover{margin-top:22px}#fr-layout-preview .fl-cover img{aspect-ratio:16/9}#fr-layout-preview .fl-nav{grid-template-columns:minmax(0,1fr);gap:12px}#fr-layout-preview .fl-navlink{min-height:156px;padding:16px}#fr-layout-preview .fl-thumb{width:66px;height:64px}#fr-layout-preview .fl-navcopy strong{font-size:14px}#fr-layout-preview .fl-editorial .fl-nav{gap:0}#fr-layout-preview .fl-editorial .fl-prev{border-right:0;border-bottom:1px solid var(--fl-line)}#fr-layout-preview .fl-editorial .fl-navcopy strong{font-size:15px}}
 @media(max-width:500px){#fr-layout-preview .fl-toolbar{padding-right:0}#fr-layout-preview .fl-buttons{width:100%}#fr-layout-preview .fl-buttons button{flex:1}#fr-layout-preview .fl-stage{padding:8px 0}}
 @media(prefers-reduced-motion:reduce){#fr-layout-preview .fl-navlink,#fr-layout-preview .fl-arrow{transition:none!important;transform:none!important}}
 </style>
