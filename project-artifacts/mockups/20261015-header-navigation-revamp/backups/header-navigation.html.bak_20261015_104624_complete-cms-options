</div>
<script>
(()=>{
const root=document.getElementById('phoenix-nav-studio');
const $=id=>root.querySelector('#pn-'+id);
const defaults={width:'full',align:'left',background:'#ffffff',text:'#292b31',accent:'#c92d38',shadow:false,behavior:'sticky',transparent:false,scrolledbg:'#ffffff',enabled:true,sizes:{desktop:{height:70,padding:20,radius:0},tablet:{height:66,padding:16,radius:0},mobile:{height:62,padding:12,radius:0}}};
let state=structuredClone(defaults),saved=structuredClone(defaults),device='desktop',scroll='top';
const names={desktop:'Desktop',tablet:'Tablet',mobile:'Mobile'};
const sizeKeys=['height','padding','radius'];const keys=['width','align','background','text','accent','shadow','behavior','transparent','scrolledbg','enabled'];
function controls(){for(const key of [...keys,...sizeKeys]){const el=$(key),value=sizeKeys.includes(key)?state.sizes[device][key]:state[key];if(el.type==='checkbox')el.checked=value;else el.value=value;}}
function render(){const s=state.sizes[device],head=$('header'),site=$('site'),after=scroll==='scrolled';site.style.width={desktop:'100%',tablet:'440px',mobile:'300px'}[device];site.classList.toggle('compact',device!=='desktop');site.style.setProperty('--pn-accent',state.accent);head.hidden=!state.enabled||(after&&state.behavior!=='sticky');head.style.minHeight=s.height+'px';head.style.padding='12px '+s.padding+'px';head.style.borderRadius=s.radius+'px';head.style.margin=state.width==='full'?'0':state.width==='floating'?'12px':'0 12px';head.style.background=after?state.scrolledbg:state.transparent?'#f3f0e9':state.background;head.style.color=state.text;head.style.boxShadow=state.shadow?'0 5px 14px #0000001a':'none';head.style.flexDirection=state.align==='right'?'row-reverse':'row';head.style.justifyContent=state.align==='center'?'center':'space-between';root.querySelector('.pn-logo').style.width=state.align==='center'?'100%':'';root.querySelector('.pn-logo').style.justifyContent=state.align==='center'?'center':'';$('heightout').textContent=s.height+' px';for(const key of ['background','text','accent','scrolledbg'])$(key+'out').textContent=state[key].toUpperCase();$('devicebadge').textContent=names[device];$('deviceinfo').textContent=names[device]+' · preview adaptif';$('scrollhint').textContent=after?'Simulasi posisi setelah scroll':'Posisi awal halaman';const dirty=JSON.stringify(state)!==JSON.stringify(saved);$('save').disabled=!dirty;$('discard').disabled=!dirty;$('status').textContent=dirty?'Perubahan belum disimpan':'Draft contoh · tidak ada perubahan tertunda';$('status').classList.toggle('pn-status',dirty);}
for(const key of [...keys,...sizeKeys])$(key).addEventListener('input',()=>{const el=$(key);if(sizeKeys.includes(key)){if(!el.checkValidity()||el.value==='')return;state.sizes[device][key]=Number(el.value);}else state[key]=el.type==='checkbox'?el.checked:el.value;render();});
function select(group,button){root.querySelectorAll(group).forEach(b=>b.setAttribute('aria-pressed',String(b===button)));}
root.querySelectorAll('[data-device]').forEach(b=>b.addEventListener('click',()=>{device=b.dataset.device;select('[data-device]',b);controls();render();}));
root.querySelectorAll('[data-scroll]').forEach(b=>b.addEventListener('click',()=>{scroll=b.dataset.scroll;select('[data-scroll]',b);render();}));
root.querySelectorAll('[data-tab]').forEach(b=>b.addEventListener('click',()=>{select('[data-tab]',b);root.querySelectorAll('[data-panel]').forEach(p=>p.hidden=p.dataset.panel!==b.dataset.tab);}));
root.querySelectorAll('.pn-links button').forEach(b=>b.addEventListener('click',()=>{root.querySelectorAll('.pn-links button').forEach(link=>link.removeAttribute('aria-current'));b.setAttribute('aria-current','page');}));
$('menu').addEventListener('click',()=>{const open=$('site').classList.toggle('menu-open');$('menu').setAttribute('aria-expanded',String(open));});
// shortcut: draft hanya hidup dalam sesi prototipe; gunakan endpoint CMS ketika implementasi disetujui.
$('save').addEventListener('click',()=>{saved=structuredClone(state);render();$('status').textContent='Draft tersimpan di sesi prototipe ini';});
$('discard').addEventListener('click',()=>{state=structuredClone(saved);controls();render();});
controls();render();
if(globalThis.Tweak){const design={accent:'#c92d38'};const tweak=new Tweak({container:root,onChange:()=>root.style.setProperty('--pn-accent',design.accent)});tweak.addColorPicker(design,'accent',{label:'Aksen editor',reference:'--pn-accent'});}
})();
</script>
