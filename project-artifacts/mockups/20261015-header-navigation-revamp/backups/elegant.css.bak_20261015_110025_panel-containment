#headerNavigationEditor{--pn-bg:light-dark(#f7f8fa,#191c22);--pn-surface:light-dark(#ffffff,#242830);--pn-accent:#c72c3a;--pn-soft:light-dark(#faedef,#422a31);--cms-text:14px;font-family:'Noto Sans',sans-serif;font-size:var(--cms-text);line-height:1.55;border-radius:12px;max-width:1440px;margin-inline:auto}
#headerNavigationEditor :is(button,input,select,textarea){font-family:inherit}
#headerNavigationEditor .pn-top{padding:14px 28px;background:var(--pn-bg);border:0;font-size:13px;gap:10px}#headerNavigationEditor .pn-mark{width:25px;height:25px;font-size:13px;border-radius:7px}#headerNavigationEditor .pn-crumb{font-size:12px}#headerNavigationEditor .pn-titlebar{padding:16px 28px 25px;background:var(--pn-bg)}#headerNavigationEditor h1{font-size:25px;letter-spacing:-.7px;font-weight:600;line-height:1.3}#headerNavigationEditor .pn-titlebar p{font-size:14px;margin-top:8px}#headerNavigationEditor .pn-active{font-size:13px}#headerNavigationEditor .pn-button{font-size:13px;padding:9px 14px;border-radius:6px}
#headerNavigationEditor .pn-workspace{display:flex;flex-direction:column;border:0;padding:0 28px 28px;gap:25px}
#headerNavigationEditor .pn-preview{width:100%;padding:0;background:var(--pn-surface);border:1px solid var(--pn-line);border-radius:9px;overflow:hidden}#headerNavigationEditor .pn-previewbar{margin:0;padding:12px 16px;border-bottom:1px solid var(--pn-line);gap:14px}#headerNavigationEditor .pn-caption{font-size:13px;letter-spacing:0;text-transform:none;font-weight:600;margin-right:auto}#headerNavigationEditor .pn-previewbar .pn-segment{border:0;background:var(--pn-bg);padding:3px}#headerNavigationEditor .pn-segment button{font-size:12px;padding:7px 11px}#headerNavigationEditor .condition-control{display:flex;gap:8px;align-items:center;font-size:12px;color:var(--pn-muted)}#headerNavigationEditor .condition-control select{border:1px solid var(--pn-line);border-radius:5px;background:var(--pn-surface);color:var(--pn-ink);padding:6px 8px;font-size:12px}
#headerNavigationEditor .pn-browser,#headerNavigationEditor .pn-scrollbox,#headerNavigationEditor #previewFeedback{display:none}#headerNavigationEditor #previewFrame{border:0;border-radius:0;background:#edf0f3;max-height:340px}#headerNavigationEditor .pn-under{margin:0;padding:10px 16px;background:var(--pn-surface);font-size:12px;border-top:1px solid var(--pn-line)}#headerNavigationEditor #resetPreview{font-size:12px}#headerNavigationEditor .device-stage{background:#edf0f3;font-family:'Noto Sans',sans-serif}#headerNavigationEditor .hero-copy{padding:70px 110px;min-height:580px;background:#edf0f3}#headerNavigationEditor .hero-copy>span{font-size:13px;letter-spacing:2px;color:#697784}#headerNavigationEditor .hero-copy h2{font-family:inherit;font-size:54px;font-weight:600;line-height:1.15;letter-spacing:-2px;color:#243440;margin:25px 0}#headerNavigationEditor .hero-copy p{font-size:17px;max-width:540px;color:#62717e}#headerNavigationEditor .header-logo{font-weight:600}#headerNavigationEditor .header-menu a{font-weight:600;font-size:14px}
#headerNavigationEditor .pn-inspector{width:100%;min-height:0;border:1px solid var(--pn-line);border-radius:9px;display:grid;grid-template-columns:1fr auto;background:var(--pn-surface)}#headerNavigationEditor .pn-inspectorhead{padding:18px 22px}#headerNavigationEditor .pn-inspectorhead strong{font-size:15px;font-weight:600}#headerNavigationEditor .pn-badge{display:none}#headerNavigationEditor .pn-tabs{align-items:stretch;padding:0 18px;border:0;gap:20px}#headerNavigationEditor .pn-tabs button{font-size:14px;padding:16px 4px}#headerNavigationEditor .inspector-content{grid-column:1/-1;border-top:1px solid var(--pn-line);padding:24px}#headerNavigationEditor .inspector-tab-panel{padding:0}#headerNavigationEditor .header-settings-accordion{display:grid;grid-template-columns:170px minmax(0,1fr);column-gap:30px;row-gap:6px;align-items:start}#headerNavigationEditor .header-setting-group{display:contents}#headerNavigationEditor .header-setting-summary{grid-column:1;grid-row:var(--section-row);padding:11px 13px;margin:0;border-radius:6px;font-size:14px;font-weight:400;align-self:start}#headerNavigationEditor .header-setting-summary::after{content:none}#headerNavigationEditor details[open]>.header-setting-summary{background:var(--pn-bg);color:var(--pn-ink);font-weight:600}#headerNavigationEditor details[open]>.header-setting-summary::after{content:none}#headerNavigationEditor .header-setting-panel{grid-column:2;grid-row:1/span 8;padding:2px 0 8px;max-width:820px;min-width:0}#headerNavigationEditor details:not([open])>.header-setting-panel{display:none}
#headerNavigationEditor .form-label,#headerNavigationEditor .form-check,#headerNavigationEditor .form-control,#headerNavigationEditor .form-select,#headerNavigationEditor .segmented button{font-size:var(--cms-text)}#headerNavigationEditor .form-label{font-weight:600;margin-bottom:9px}#headerNavigationEditor .form-control,#headerNavigationEditor .form-select{min-height:40px;padding:8px 10px}#headerNavigationEditor .segmented{max-width:420px;background:var(--pn-bg);border:0;padding:4px;gap:4px}#headerNavigationEditor .segmented button{padding:8px}#headerNavigationEditor .segmented button.is-active{background:var(--pn-surface);box-shadow:0 1px 4px #0000000d;color:var(--pn-ink)}#headerNavigationEditor .mb-3{margin-bottom:23px}#headerNavigationEditor .row{gap:24px 22px}#headerNavigationEditor .col-12{grid-column:1/-1}#headerNavigationEditor .box-side-label{font-size:12px;margin-top:7px}#headerNavigationEditor .box-side-stepper input{font-size:14px;padding:9px 0}#headerNavigationEditor .box-stepper-btn{height:25px}#headerNavigationEditor .box-control-row{gap:8px}#headerNavigationEditor .box-control-header{grid-template-columns:minmax(0,1fr) 36px 74px;gap:8px}#headerNavigationEditor .box-control{max-width:560px}#headerNavigationEditor .unit-control{max-width:420px}#headerNavigationEditor .coloris-field{font-family:inherit;font-size:13px}#headerNavigationEditor .link-color-state-list{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px}#headerNavigationEditor .link-color-control{grid-template-columns:minmax(0,1fr) 32px}#headerNavigationEditor .link-color-field{grid-column:1}#headerNavigationEditor .link-color-control .box-link-toggle{grid-column:2;grid-row:1/span 2;align-self:center}#headerNavigationEditor .link-color-state-name,#headerNavigationEditor .link-color-state-title{font-size:14px;font-weight:600}#headerNavigationEditor .link-color-field .visually-hidden{font-size:12px}#headerNavigationEditor .color-picker-row{grid-template-columns:30px minmax(0,1fr);gap:8px}#headerNavigationEditor .shadow-control{max-width:600px}#headerNavigationEditor .pn-footer{font-size:12px;padding:12px 28px;background:var(--pn-bg)}
#headerNavigationEditor .header-settings-accordion{grid-template-rows:44px 44px 44px minmax(0,1fr);min-height:180px}#headerNavigationEditor .header-setting-panel{grid-row:1/span 4}#headerNavigationEditor .header-setting-panel:has([data-control="logoPosition"]){display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:24px}#headerNavigationEditor .header-setting-panel:has([data-control="logoPosition"])>.mb-3{margin:0}#headerNavigationEditor .header-setting-panel:has([data-control="logoPosition"])>.form-check{align-self:end;margin-bottom:12px}
@media(min-width:1200px) and (max-height:1000px){#headerNavigationEditor{--cms-text:13px}}
@container(max-width:700px){#headerNavigationEditor .pn-workspace{padding:0 14px 18px;gap:18px}#headerNavigationEditor .pn-titlebar{padding:14px 16px 20px}#headerNavigationEditor .pn-top{padding:12px 16px}#headerNavigationEditor .pn-inspector{display:block}#headerNavigationEditor .pn-tabs{justify-content:flex-start;border-top:1px solid var(--pn-line)}#headerNavigationEditor .pn-inspectorhead{padding:16px}#headerNavigationEditor .inspector-content{padding:16px}#headerNavigationEditor .header-settings-accordion{grid-template-columns:1fr;gap:8px}#headerNavigationEditor .header-setting-summary{grid-column:1;grid-row:auto;background:var(--pn-bg)}#headerNavigationEditor .header-setting-panel{grid-column:1;grid-row:auto;padding:14px 0 22px}#headerNavigationEditor .link-color-state-list{grid-template-columns:1fr}#headerNavigationEditor .pn-previewbar{gap:10px}#headerNavigationEditor .condition-control{margin-left:auto}#headerNavigationEditor .pn-previewbar .pn-segment{margin-left:auto}#headerNavigationEditor .pn-caption{width:100%}#headerNavigationEditor h1{font-size:23px}}
#headerNavigationEditor details:not([open])>.header-setting-panel{display:none}
@container(max-width:700px){#headerNavigationEditor .header-settings-accordion{grid-template-rows:none}#headerNavigationEditor .header-setting-panel{grid-row:auto}#headerNavigationEditor .header-setting-panel:has([data-control="logoPosition"]){display:block}#headerNavigationEditor .header-setting-panel:has([data-control="logoPosition"])>.mb-3{margin-bottom:24px}#headerNavigationEditor details:not([open])>.header-setting-panel{display:none}}
