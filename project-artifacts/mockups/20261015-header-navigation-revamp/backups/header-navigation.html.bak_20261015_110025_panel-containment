		#headerNavigationEditor .site-header {
			top: 0;
			left: 0;
			right: 0;
			z-index: 5;
			color: var(--header-text);
			background: var(--header-bg);
			box-shadow: 0 1px 0 rgba(16, 24, 40, .06);
			transition: background .32s ease, box-shadow .32s ease, border-radius .32s ease, backdrop-filter .32s ease;
		}

		#headerNavigationEditor .site-header.is-fixed {
			position: sticky;
		}

		#headerNavigationEditor .site-header.is-stay {
			position: relative;
		}

		#headerNavigationEditor .site-header.is-transparent:not(.is-scrolled) {
			background: transparent !important;
			box-shadow: none;
		}

		#headerNavigationEditor .site-header.is-transparent:not(.is-scrolled) .header-container,
		#headerNavigationEditor .site-header.is-transparent:not(.is-scrolled) .header-inner {
			background: transparent !important;
			box-shadow: none;
		}

		#headerNavigationEditor .site-header.is-scrolled {
			background: var(--scrolled-bg);
			box-shadow: 0 12px 35px rgba(16, 24, 40, .13);
			backdrop-filter: blur(12px);
		}

		#headerNavigationEditor .site-header.is-scrolled-transparent {
			box-shadow: none;
			backdrop-filter: none;
		}

		#headerNavigationEditor .header-inner {
			min-height: var(--header-height);
			padding: var(--header-padding);
			display: grid;
			align-items: center;
			gap: clamp(28px, 2.2vw, 36px);
			border-radius: var(--header-radius);
			transition: background .32s ease, box-shadow .32s ease, border-radius .32s ease, padding .2s ease, min-height .2s ease;
		}

		#headerNavigationEditor .site-header.inner-bg {
			background: transparent;
			box-shadow: none;
			backdrop-filter: none;
		}

		#headerNavigationEditor .site-header.inner-bg .header-container {
			background: var(--header-bg);
			box-shadow: 0 14px 34px rgba(16, 24, 40, .1);
			border-radius: var(--header-radius);
			transition: background .32s ease, box-shadow .32s ease, border-radius .32s ease;
		}

		#headerNavigationEditor .site-header.inner-bg .header-inner {
			background: transparent;
			box-shadow: none;
		}

		#headerNavigationEditor .site-header.inner-bg.is-scrolled {
			background: transparent;
		}

		#headerNavigationEditor .site-header.inner-bg.is-scrolled .header-container {
			background: var(--scrolled-bg);
		}

		#headerNavigationEditor .site-header.inner-bg.is-scrolled-transparent .header-container,
		#headerNavigationEditor .site-header.inner-bg.is-scrolled-transparent .header-inner {
			box-shadow: none;
		}

		#headerNavigationEditor .site-header.full-bg .header-container,
		#headerNavigationEditor .site-header.full-bg .header-inner {
			background: transparent;
			box-shadow: none;
		}

		#headerNavigationEditor .header-container {
			width: min(calc(100% - 32px - var(--header-container-margin-left) - var(--header-container-margin-right)), 1180px);
			margin: var(--header-container-margin-top) auto var(--header-container-margin-bottom);
			transform: translateX(calc((var(--header-container-margin-left) - var(--header-container-margin-right)) / 2));
		}

		#headerNavigationEditor .header-container.is-fluid {
			width: calc(100% - 28px - var(--header-container-margin-left) - var(--header-container-margin-right));
			max-width: none;
		}

		#headerNavigationEditor .header-logo {
			display: inline-flex;
			align-items: center;
			gap: 11px;
			color: var(--header-text);
			font-weight: 900;
			font-size: 18px;
			white-space: nowrap;
			text-decoration: none;
		}

		#headerNavigationEditor .logo-mark {
			width: 36px;
			height: 36px;
			border-radius: 10px;
			background: linear-gradient(135deg, #e01d24, #121826);
			display: inline-flex;
			align-items: center;
			justify-content: center;
			color: white;
			font-weight: 900;
			font-size: 14px;
			box-shadow: 0 8px 18px rgba(224, 29, 36, .24);
		}

		#headerNavigationEditor .header-menu {
			display: flex;
			align-items: center;
			gap: 6px;
			margin: 0;
			padding: 0;
			list-style: none;
			min-width: 0;
		}

		#headerNavigationEditor .header-menu a {
			box-sizing: border-box;
			display: inline-flex;
			align-items: center;
			justify-content: center;
			gap: 6px;
			min-height: 38px;
			padding: 8px 11px;
			border: 1px solid transparent;
			border-radius: var(--nav-radius);
			color: var(--link-color);
			text-decoration: none;
			font-weight: 800;
