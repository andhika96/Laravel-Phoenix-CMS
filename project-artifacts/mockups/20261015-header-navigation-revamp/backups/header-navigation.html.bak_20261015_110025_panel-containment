			white-space: nowrap;
		}

		#headerNavigationEditor .header-menu .menu-label {
			min-width: 0;
		}

		#headerNavigationEditor .header-menu .menu-dropdown-indicator {
			display: inline-flex;
			align-items: center;
			justify-content: center;
			width: 12px;
			height: 12px;
			font-size: 12px;
			line-height: 1;
			opacity: .8;
			transition: transform .2s ease, opacity .2s ease;
		}

		#headerNavigationEditor .header-menu .menu-dropdown-indicator img {
			display: block;
			width: 12px;
			height: 12px;
			object-fit: contain;
		}

		#headerNavigationEditor .header-menu a.has-dropdown:hover .menu-dropdown-indicator,
		#headerNavigationEditor .header-menu a.has-dropdown:focus .menu-dropdown-indicator {
			opacity: 1;
			transform: translateY(1px);
		}

		#headerNavigationEditor .header-menu a:hover {
			color: var(--link-hover-text);
			background: var(--link-hover);
			border-color: var(--link-hover-border);
		}

		#headerNavigationEditor .header-menu a:focus {
			color: var(--link-focus-text);
			background: var(--link-focus);
			border-color: var(--link-focus-border);
			outline: 0;
		}

		#headerNavigationEditor .header-menu a.is-active {
			color: var(--link-active-text);
			background: var(--link-active);
			border-color: var(--link-active-border);
			box-shadow: var(--link-active-shadow);
		}

		#headerNavigationEditor .site-header.is-transparent:not(.is-scrolled) .header-logo,
		#headerNavigationEditor .site-header.is-transparent:not(.is-scrolled) .hamburger {
			color: var(--transparent-header-text);
		}

		#headerNavigationEditor .site-header.is-transparent:not(.is-scrolled) .header-menu a {
			color: var(--transparent-link-color);
		}

		#headerNavigationEditor .site-header.is-transparent:not(.is-scrolled) .header-menu a:hover {
			color: var(--transparent-hover-text);
			background: var(--transparent-hover-bg);
			border-color: var(--transparent-hover-border);
		}

		#headerNavigationEditor .site-header.is-transparent:not(.is-scrolled) .header-menu a:focus {
			color: var(--transparent-focus-text);
			background: var(--transparent-focus-bg);
			border-color: var(--transparent-focus-border);
		}

		#headerNavigationEditor .site-header.is-transparent:not(.is-scrolled) .header-menu a.is-active {
			color: var(--transparent-active-text);
			background: var(--transparent-active-bg);
			border-color: var(--transparent-active-border);
		}

		#headerNavigationEditor .header-actions {
			display: flex;
			align-items: center;
			justify-content: flex-end;
			gap: 8px;
		}

		#headerNavigationEditor .header-actions .btn-demo {
			border: 0;
			background: var(--link-active);
			color: #fff;
			font-weight: 800;
			border-radius: var(--nav-radius);
			padding: 10px 16px;
			font-size: 13px;
			white-space: nowrap;
			box-shadow: 0 9px 20px color-mix(in srgb, var(--link-active) 23%, transparent);
		}

		#headerNavigationEditor .hamburger {
			display: none;
			width: 40px;
			height: 40px;
			border-radius: 10px;
			border: 1px solid rgba(16, 24, 40, .12);
			background: rgba(255, 255, 255, .78);
			color: var(--header-text);
		}

		#headerNavigationEditor .layout-left {
			grid-template-columns: auto minmax(0, 1fr) auto;
		}

		#headerNavigationEditor .layout-left .header-menu {
			justify-content: flex-start;
		}

		#headerNavigationEditor .layout-center {
			grid-template-columns: 1fr auto 1fr;
		}

		#headerNavigationEditor .layout-center .header-logo {
			justify-self: center;
		}

		#headerNavigationEditor .layout-center .menu-left {
			justify-content: flex-end;
		}

		#headerNavigationEditor .layout-center .menu-right {
