async page => {
  const output='D:/Laragon/www/laravel-13-phoenix/project-artifacts/implementations/20261012_template-options-ui-revamp/';
  const checks=[],errors=[];
  const check=(name,value)=>{if(!value)throw Error(name);checks.push(name);};
  page.on('pageerror',error=>errors.push(error.message));
  const visibleNotice=()=>page.waitForFunction(()=>document.querySelector('#article-template-notice').classList.contains('show')&&parseFloat(getComputedStyle(document.querySelector('#article-template-notice')).opacity)>.95);
  const closeNotice=async()=>{await page.locator('#article-template-notice [data-bs-dismiss=toast]').click();await page.waitForFunction(()=>!document.querySelector('#article-template-notice').classList.contains('showing')&&!document.querySelector('#article-template-notice').classList.contains('show'));};
  await page.setViewportSize({width:1600,height:1000});
  await page.goto('http://127.0.0.1:8781/');await page.waitForFunction(()=>window.prototypeVm&&!window.prototypeVm.modalPreviewLoading);
  await page.locator('.article-template-header-field').nth(1).locator('input').fill('Runtime draft title');
  await page.waitForFunction(()=>window.prototypeVm.optionsModal.dirty&&!window.prototypeVm.modalPreviewLoading);
  const savedBefore=await page.evaluate(()=>JSON.stringify(window.prototypeVm.saved));
  await page.getByRole('button',{name:'Cancel',exact:true}).click();await visibleNotice();
  check('Cancel on a dirty draft shows a CMS warning',await page.locator('#article-template-notice.ph-callout-warning').count()===1);
  check('Dirty draft remains open for Keep editing or Discard',await page.locator('.article-template-options-dismiss').isVisible());
  await page.locator('#article-template-notice').screenshot({path:output+'warning-closeup.png'});await closeNotice();
  await page.getByRole('button',{name:'Keep editing',exact:true}).click();
  await page.getByRole('button',{name:'Apply changes',exact:true}).click();await visibleNotice();
  check('Apply reports draft success and asks for Save Template',/draft.*Save Template/.test(await page.locator('#article-template-notice').innerText()));
  check('Apply does not change persisted saved state',await page.evaluate(()=>JSON.stringify(window.prototypeVm.saved))===savedBefore);
  await page.locator('#article-template-notice').screenshot({path:output+'success-draft-closeup.png'});await closeNotice();
  await page.waitForFunction(()=>!window.prototypeVm.optionsModal.value);
  await page.locator('#article-template-options-trigger').click();await page.waitForFunction(()=>!window.prototypeVm.modalPreviewLoading);
  check('Applied title survives reopening the options draft',await page.locator('.article-template-header-field').nth(1).locator('input').inputValue()==='Runtime draft title');
  await page.evaluate(()=>window.prototypeVm.onModalPreviewError());await visibleNotice();
  check('Preview failure shows the CMS danger notice',await page.locator('#article-template-notice.ph-callout-danger').count()===1);
  check('Preview failure retains Retry and a CMS inline callout',await page.locator('.article-template-options-preview__error.ph-callout-danger').isVisible());
  await page.locator('#article-template-notice').screenshot({path:output+'failed-preview-closeup.png'});await closeNotice();
  await page.evaluate(()=>{window.axios={post:()=>new Promise(resolve=>{window.__resolveSave=resolve;})};window.__savingPromise=window.prototypeVm.save();});
  check('Save stays locked while awaiting the server',await page.evaluate(()=>window.prototypeVm.saving));
  await page.evaluate(async()=>{window.__resolveSave({data:{message:'Templates saved',data:{archive_template:window.prototypeVm.draft.archive_template}}});await window.__savingPromise;});await visibleNotice();
  check('Server success shows CMS success notice',await page.locator('#article-template-notice.ph-callout-success').count()===1);
  check('Save success releases the lock',await page.evaluate(()=>!window.prototypeVm.saving));await closeNotice();
  const savedAfter=await page.evaluate(()=>JSON.stringify(window.prototypeVm.saved));
  await page.evaluate(async()=>{window.axios={post:async()=>{throw {response:{data:{errors:{title:['Title is required']}}}};}};await window.prototypeVm.save();});await visibleNotice();
  check('Server validation failure shows its message in CMS danger notice',/Title is required/.test(await page.locator('#article-template-notice.ph-callout-danger').innerText()));
  check('Failed save preserves prior saved state and releases the lock',await page.evaluate(()=>JSON.stringify(window.prototypeVm.saved)===window.__expectedSaved&&!window.prototypeVm.saving).catch(()=>false) || await page.evaluate(expected=>JSON.stringify(window.prototypeVm.saved)===expected&&!window.prototypeVm.saving,savedAfter));
  await closeNotice();
  await page.locator('#prototype-template').selectOption('archive:editorial-journal');await page.waitForFunction(()=>!window.prototypeVm.modalPreviewLoading);
  await page.evaluate(()=>{window.prototypeVm.setOptionsSection('editorial-journal');window.prototypeVm.optionsModal.value.editorial_journal.card.background.type='image';});
  check('Image field renders Choose Image without a Vue translation error',await page.getByRole('button',{name:'Choose Image',exact:true}).isVisible());
  await page.evaluate(()=>window.prototypeVm.optionsModal.value.editorial_journal.card.background.image='/assets/images/alpine-lake.png');
  check('An image selection renders Change Image',await page.getByRole('button',{name:'Change Image',exact:true}).isVisible());
  await page.evaluate(()=>window.prototypeVm.clearEditorialJournalBackground());
  check('Removing the image restores Choose Image',await page.getByRole('button',{name:'Choose Image',exact:true}).isVisible());
  check('Notice flows have no Vue runtime errors',errors.length===0);
  await page.evaluate(results=>window.__noticeFlowResults=results,{passed:checks.length,checks,errors,saveResponses:'Mocked in the browser; real controller persistence is covered by the SQLite feature tests.'});
}
