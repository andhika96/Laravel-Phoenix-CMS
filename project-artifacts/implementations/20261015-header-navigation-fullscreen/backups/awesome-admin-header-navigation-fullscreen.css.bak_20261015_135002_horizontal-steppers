#headerNavigationEditor.header-settings-drilldown .box-control-header{display:grid;grid-template-columns:minmax(0,1fr) 34px 64px 30px;grid-template-rows:auto auto;column-gap:8px;row-gap:10px;margin:0 0 14px;padding:0;height:auto}
#headerNavigationEditor.header-settings-drilldown .box-control-header>.form-label{grid-column:1/-1;grid-row:1;white-space:normal;font-size:12px;line-height:1.5;margin:0}
#headerNavigationEditor.header-settings-drilldown .box-control-header>.responsive-mode-control{grid-column:2;grid-row:2;width:34px;min-width:0;margin:0}
#headerNavigationEditor.header-settings-drilldown .box-control-header>.box-unit-select{grid-column:3;grid-row:2;width:64px;min-width:0;margin:0;height:32px;padding:4px 22px 4px 8px;font-size:12px}
#headerNavigationEditor.header-settings-drilldown .box-control-header>.box-link-toggle{grid-column:4;grid-row:2;width:30px;height:32px;min-height:32px;padding:0;border:1px solid var(--bs-border-color);border-radius:6px}
#headerNavigationEditor.header-settings-drilldown .responsive-mode-trigger{width:34px;height:32px;min-height:32px;padding:0;border-radius:6px}
#headerNavigationEditor.header-settings-drilldown .box-control-row{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));grid-template-rows:auto auto;gap:14px 10px;margin:0;height:auto}
#headerNavigationEditor.header-settings-drilldown .box-side{display:flex;flex-direction:column;gap:6px;margin:0;padding:0;min-height:60px}
#headerNavigationEditor.header-settings-drilldown .box-side-label{font-size:11px;font-weight:400;line-height:16px;padding:0;margin:0;white-space:normal}
#headerNavigationEditor.header-settings-drilldown .box-side-stepper{height:40px;min-height:40px;grid-template-rows:20px 20px;gap:0;border:1px solid var(--bs-border-color);border-radius:6px!important}
#headerNavigationEditor.header-settings-drilldown .box-side-stepper input{height:40px;min-height:40px;padding:8px 10px;border:0;border-radius:0;font-size:13px;line-height:20px}
#headerNavigationEditor.header-settings-drilldown .box-side-stepper .box-stepper-btn{height:20px;min-height:0;line-height:1;padding:0}
#headerNavigationEditor.header-settings-drilldown .box-stepper-btn i,#headerNavigationEditor.header-settings-drilldown .stepper-btn i{font-size:10px;line-height:1}
#headerNavigationEditor.header-settings-drilldown .header-setting-panel>.row.gy-lg-4{--bs-gutter-y:22px;row-gap:0}
#headerNavigationEditor.header-settings-drilldown .shadow-control-header{display:flex;align-items:center;justify-content:space-between;gap:8px;padding:0 0 14px}
#headerNavigationEditor.header-settings-drilldown .shadow-control-meta{display:grid;grid-template-columns:minmax(0,1fr);gap:14px;margin-top:16px}
#headerNavigationEditor.header-settings-drilldown .shadow-control{padding:0;border:0;background:transparent;box-shadow:none}
#headerNavigationEditor.header-settings-drilldown .shadow-control-row{grid-template-columns:repeat(2,minmax(0,1fr))}
@media(pointer:coarse){#headerNavigationEditor.header-settings-drilldown .box-side-stepper{height:52px;min-height:52px;grid-template-rows:26px 26px}#headerNavigationEditor.header-settings-drilldown .box-side-stepper input{height:52px;min-height:52px}#headerNavigationEditor.header-settings-drilldown .box-side-stepper .box-stepper-btn{height:26px}#headerNavigationEditor.header-settings-drilldown .box-side{min-height:74px}}
