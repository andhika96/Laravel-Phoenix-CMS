/* Full-page editor shell; existing settings and renderer styles remain intact. */
body.header-editor-open { overflow: hidden !important; }
#headerNavigationEditor.header-navigation-fullscreen {
    position: fixed; inset: 0; z-index: 1040; width: 100%; height: 100dvh;
    margin: 0; background: var(--bs-body-bg, #fff); color: var(--bs-body-color, #182230);
    font-family: var(--ph-font-family, inherit); font-size: var(--ph-adaptive-font-size, 14px);
    --inspector-ui-font-size: var(--ph-adaptive-font-size, 14px);
    --inspector-meta-font-size: 12px;
}
#headerNavigationEditor.header-navigation-fullscreen > main {
    height: 100%; min-height: 0; display: flex; flex-direction: column; padding: 0;
}
#headerNavigationEditor.header-navigation-fullscreen .header-editor-topbar {
    flex: 0 0 auto; padding: 12px 20px !important; margin: 0 !important;
    border: 0; border-bottom: 1px solid var(--bs-border-color, #e3e7ed);
    border-radius: 0 !important; box-shadow: none; background: var(--bs-body-bg, #fff);
}
#headerNavigationEditor.header-navigation-fullscreen .mock-topbar {
    display: flex; align-items: center; justify-content: space-between; min-height: 40px; gap: 22px;
}
#headerNavigationEditor .header-editor-back {
    display: inline-flex; align-items: center; gap: 9px; white-space: nowrap;
    color: inherit; text-decoration: none; padding: 8px 0; font-weight: 600;
}
#headerNavigationEditor.header-navigation-fullscreen .mock-topbar-copy { flex: 1; min-width: 0; }
#headerNavigationEditor.header-navigation-fullscreen .mock-title { font: 600 18px/1.4 var(--ph-font-family, sans-serif); margin: 0; }
#headerNavigationEditor.header-navigation-fullscreen .editor-eyebrow,
#headerNavigationEditor.header-navigation-fullscreen .mock-subtitle { display: none; }
#headerNavigationEditor.header-navigation-fullscreen .mock-topbar-actions { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; }
#headerNavigationEditor.header-navigation-fullscreen .mock-workspace-grid {
    display: grid; grid-template-columns: 300px minmax(0, 1fr); grid-template-rows: minmax(0, 1fr);
    flex: 1; min-height: 0; height: auto; width: 100%; gap: 0; padding: 0; margin: 0;
}
#headerNavigationEditor.header-navigation-fullscreen .mock-control-pane {
    grid-column: 1; grid-row: 1; order: 0; width: 100%; min-width: 0; height: 100%; min-height: 0;
    border-right: 1px solid var(--bs-border-color, #e3e7ed);
}
#headerNavigationEditor.header-navigation-fullscreen .inspector-shell {
    height: 100%; min-height: 0; max-height: none; padding: 0 !important;
    border: 0; border-radius: 0 !important; box-shadow: none; overflow: hidden;
}
#headerNavigationEditor.header-navigation-fullscreen .inspector-layout {
    display: flex; flex-direction: column; height: 100%; min-height: 0;
}
#headerNavigationEditor.header-navigation-fullscreen .inspector-tabs { flex: 0 0 auto; width: 100%; }
#headerNavigationEditor.header-navigation-fullscreen .inspector-content {
    flex: 1; min-height: 0; overflow-y: auto; overflow-x: hidden; overscroll-behavior: contain;
}
#headerNavigationEditor.header-navigation-fullscreen .inspector-selection-summary { display: none; }
#headerNavigationEditor.header-navigation-fullscreen .inspector-tab-panel { padding: 16px; }
#headerNavigationEditor.header-navigation-fullscreen .mock-preview-pane {
    grid-column: 2; grid-row: 1; order: 1; padding: 0; min-width: 0; min-height: 0; height: 100%;
}
#headerNavigationEditor.header-navigation-fullscreen .preview-card {
    display: flex; flex-direction: column; height: 100%; min-height: 0; max-height: none;
    border: 0; border-radius: 0 !important; box-shadow: none; overflow: hidden;
}
#headerNavigationEditor.header-navigation-fullscreen .preview-toolbar {
    flex: 0 0 auto; padding: 10px 16px; display: flex; flex-wrap: wrap; align-items: center; gap: 12px;
    background: var(--bs-body-bg, #fff); border-bottom: 1px solid var(--bs-border-color, #e3e7ed);
}
#headerNavigationEditor.header-navigation-fullscreen .preview-toolbar-hint { display: none; }
#headerNavigationEditor.header-navigation-fullscreen .preview-toolbar-copy { display: flex; flex-direction: row; align-items: center; flex-wrap: wrap; gap: 12px; }
#headerNavigationEditor.header-navigation-fullscreen .preview-toolbar-actions { display: flex; gap: 10px; flex-wrap: wrap; }
#headerNavigationEditor.header-navigation-fullscreen .preview-scale-status { font-size: 12px; margin-top: 0; }
#headerNavigationEditor.header-navigation-fullscreen .preview-frame {
    flex: 1; height: auto; min-height: 0; max-height: none; margin: 0; border: 0;
    border-radius: 0; overflow: hidden; background: var(--bs-tertiary-bg, #f2f4f7);
}
#headerNavigationEditor.header-navigation-fullscreen .preview-viewport { transform-origin: top left; }
#headerNavigationEditor.header-navigation-fullscreen .device-stage {
    height: 100%; overflow-y: auto; overflow-x: hidden; overscroll-behavior: contain;
}
#headerNavigationEditor.header-navigation-fullscreen .preview-timeline { display: none; }
/* CMS themes force anchor colors with !important; preview links use their own settings. */
#headerNavigationEditor #siteHeader .header-logo { color: var(--header-text) !important; }
#headerNavigationEditor #siteHeader .header-menu a { color: var(--link-color) !important; }
#headerNavigationEditor #siteHeader .header-menu a:hover { color: var(--link-hover-text) !important; }
#headerNavigationEditor #siteHeader .header-menu a:focus { color: var(--link-focus-text) !important; }
#headerNavigationEditor #siteHeader .header-menu a.is-active { color: var(--link-active-text) !important; }
#headerNavigationEditor #siteHeader.is-transparent:not(.is-scrolled) .header-logo { color: var(--transparent-header-text) !important; }
#headerNavigationEditor #siteHeader.is-transparent:not(.is-scrolled) .header-menu a { color: var(--transparent-link-color) !important; }
#headerNavigationEditor #siteHeader.is-transparent:not(.is-scrolled) .header-menu a:hover { color: var(--transparent-hover-text) !important; }
#headerNavigationEditor #siteHeader.is-transparent:not(.is-scrolled) .header-menu a:focus { color: var(--transparent-focus-text) !important; }
#headerNavigationEditor #siteHeader.is-transparent:not(.is-scrolled) .header-menu a.is-active { color: var(--transparent-active-text) !important; }
#headerNavigationEditor.header-navigation-fullscreen .hero-copy {
    background: #edf1f4 !important; color: #263746; padding: 84px 72px; min-height: 440px;
}
#headerNavigationEditor.header-navigation-fullscreen .hero-copy h2 {
    color: #263746; font-family: inherit; font-size: 44px; font-weight: 600; line-height: 1.2;
    max-width: 650px; letter-spacing: -1px; text-shadow: none;
}
#headerNavigationEditor.header-navigation-fullscreen .hero-copy p { color: #586b7b; font-size: 17px; line-height: 1.7; max-width: 560px; }
#headerNavigationEditor.header-navigation-fullscreen .page-band { background: #fff; padding: 40px 72px; }
#headerNavigationEditor.header-navigation-fullscreen .page-tile { box-shadow: none; border: 0; border-radius: 0; }
#headerNavigationEditor.header-navigation-fullscreen .box-control-row { gap: 5px; }
#headerNavigationEditor.header-navigation-fullscreen .box-control-header { column-gap: 6px; }
#headerNavigationEditor.header-navigation-fullscreen .inspector-inline-setting { display: grid; grid-template-columns: minmax(0, 1fr); gap: 8px; }
#headerNavigationEditor.header-navigation-fullscreen .unit-control { display: grid; grid-template-columns: minmax(0, 1fr) 72px; width: 100%; gap: 8px; }
#headerNavigationEditor.header-navigation-fullscreen .number-stepper { display: grid; grid-template-columns: 30px minmax(0, 1fr) 30px; width: 100%; min-width: 0; }
#headerNavigationEditor.header-navigation-fullscreen .number-stepper input { min-width: 0; width: 100%; }
#headerNavigationEditor.header-navigation-fullscreen .link-color-state-row { display: block; margin-bottom: 12px; }
#headerNavigationEditor.header-navigation-fullscreen .link-color-state-name { display: block; margin-bottom: 6px; }
#headerNavigationEditor.header-navigation-fullscreen .link-color-control { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr) 30px; gap: 5px; }
#headerNavigationEditor.header-navigation-fullscreen .hero-copy { text-shadow: none; }
#headerNavigationEditor.header-navigation-fullscreen .device-stage.mobile-mode .hero-copy { padding: 48px 24px; }
#headerNavigationEditor.header-navigation-fullscreen .device-stage.mobile-mode .hero-copy h2 { font-size: 34px; }
#headerNavigationEditor.header-navigation-fullscreen .device-stage.mobile-mode .page-band { padding: 24px; }
#headerNavigationEditor .header-preview-condition { display: flex; align-items: center; gap: 7px; margin: 0; font-size: 12px; }
#headerNavigationEditor .header-preview-condition select { width: auto; max-width: 160px; }
#headerNavigationEditor .header-editor-dialog-actions { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: 10px; margin-top: 24px; }
#headerEditorExitDialog {
    color: var(--bs-body-color, #182230); background: var(--bs-body-bg, #fff);
    width: min(460px, calc(100vw - 32px)); padding: 26px; border: 1px solid var(--bs-border-color, #e3e7ed);
    border-radius: 12px; box-shadow: 0 20px 60px #0003;
}
#headerEditorExitDialog::backdrop { background: #10182866; }
#headerEditorExitDialog h2 { font-size: 20px; font-weight: 600; margin: 0 0 12px; }
#headerEditorExitDialog p { margin: 0; }
@media (max-width: 1100px) {
    #headerNavigationEditor.header-navigation-fullscreen .mock-workspace-grid { grid-template-columns: 300px minmax(0, 1fr); }
    #headerNavigationEditor.header-navigation-fullscreen .mock-topbar { gap: 14px; flex-wrap: wrap; }
    #headerNavigationEditor.header-navigation-fullscreen .mock-topbar-actions { margin-left: auto; }
}
@media (max-width: 700px) {
    #headerNavigationEditor.header-navigation-fullscreen .header-editor-topbar { padding: 10px 12px !important; }
    #headerNavigationEditor.header-navigation-fullscreen .mock-title { font-size: 15px; }
    #headerNavigationEditor.header-navigation-fullscreen .mock-topbar { flex-direction: row; align-items: center; text-align: left; }
    #headerNavigationEditor.header-navigation-fullscreen .mock-topbar-copy { text-align: left; }
    #headerNavigationEditor.header-navigation-fullscreen .mock-topbar-actions { width: 100%; justify-content: flex-end; gap: 8px; }
    #headerNavigationEditor.header-navigation-fullscreen .save-header-navigation { width: auto; min-width: 0; }
    #headerNavigationEditor.header-navigation-fullscreen .mock-active-control { margin-right: auto; }
    #headerNavigationEditor.header-navigation-fullscreen .mock-status { display: none; }
    #headerNavigationEditor.header-navigation-fullscreen .mock-workspace-grid { display: flex; flex-direction: column; overflow-y: auto; }
    #headerNavigationEditor.header-navigation-fullscreen .mock-preview-pane { order: 0; flex: 0 0 380px; height: 380px; }
    #headerNavigationEditor.header-navigation-fullscreen .mock-control-pane { order: 1; flex: 0 0 520px; height: 520px; border-right: 0; border-top: 1px solid var(--bs-border-color, #e3e7ed); }
}
@media (prefers-reduced-motion: reduce) {
    #headerNavigationEditor.header-navigation-fullscreen .site-header,
    #headerNavigationEditor.header-navigation-fullscreen .header-inner { transition: none !important; }
}
