/* Theme anchor rules must not override the configured website preview. */
#headerNavigationEditor #siteHeader .header-logo { color: var(--header-text) !important; }
#headerNavigationEditor #siteHeader .header-menu a { color: var(--link-color) !important; }
#headerNavigationEditor #siteHeader .header-menu a:hover { color: var(--link-hover-text) !important; }
#headerNavigationEditor #siteHeader .header-menu a:focus { color: var(--link-focus-text) !important; }
#headerNavigationEditor #siteHeader .header-menu a.is-active { color: var(--link-active-text) !important; }
#headerNavigationEditor #siteHeader.is-transparent:not(.is-scrolled) .header-logo { color: var(--transparent-header-text) !important; }
#headerNavigationEditor #siteHeader.is-transparent:not(.is-scrolled) .header-menu a { color: var(--transparent-link-color) !important; }
#headerNavigationEditor #siteHeader.is-transparent:not(.is-scrolled) .header-menu a:hover { color: var(--transparent-hover-text) !important; }
#headerNavigationEditor #siteHeader.is-transparent:not(.is-scrolled) .header-menu a:focus { color: var(--transparent-focus-text) !important; }
#headerNavigationEditor #siteHeader.is-transparent:not(.is-scrolled) .header-menu a.is-active { color: var(--transparent-active-text) !important; }
#headerNavigationEditor :is(button, a, select, input, summary):focus-visible { outline: 2px solid var(--editor-accent); outline-offset: 2px; }
/* Numeric fields use surface changes instead of focus rings, including keyboard focus. */
#headerNavigationEditor.header-navigation-fullscreen :is(.number-stepper, .box-side-stepper, .unit-control):focus-within,
#headerNavigationEditor.header-navigation-fullscreen :is(.number-stepper, .box-side-stepper) :is(input, button):focus { outline: none; box-shadow: none; }
#headerNavigationEditor.header-navigation-fullscreen :is(.number-stepper, .box-side-stepper) input:focus { border-color: transparent; background: color-mix(in srgb, var(--editor-field), black 4%); }
#headerNavigationEditor.header-navigation-fullscreen :is(.stepper-btn, .box-stepper-btn):is(:hover, :focus-visible) { background: color-mix(in srgb, var(--editor-field), black 8%); color: var(--editor-muted); }
#headerNavigationEditor.header-navigation-fullscreen :is(.stepper-btn, .box-stepper-btn):active { background: color-mix(in srgb, var(--editor-field), black 14%); color: var(--editor-muted); }
/* Override legacy inspector accents while preserving the website preview's own colors. */
#headerNavigationEditor.header-navigation-fullscreen .save-header-navigation { background: var(--editor-accent) !important; border-color: var(--editor-accent) !important; }
#headerNavigationEditor.header-navigation-fullscreen .save-header-navigation:is(:hover, :focus-visible, :active) { background: var(--editor-accent-hover) !important; border-color: var(--editor-accent-hover) !important; }
#headerNavigationEditor.header-navigation-fullscreen .inspector-content .box-link-toggle.is-active { background: var(--editor-accent); border-color: var(--editor-accent); color: #fff; }
#headerNavigationEditor.header-navigation-fullscreen .inspector-content .segmented button:is(:hover, :focus-visible) { background: var(--editor-accent-soft); outline: none; }
#headerNavigationEditor.header-navigation-fullscreen .inspector-content :is(.box-link-toggle, .responsive-mode-trigger):focus-visible { outline: none; box-shadow: none; background: var(--editor-accent-soft); color: var(--editor-accent); }
#headerNavigationEditor.header-navigation-fullscreen :is(.inspector-tab, .preview-device-button):is(:hover, :focus-visible),
#headerNavigationEditor.header-navigation-fullscreen .inspector-content :is(.responsive-mode-option:hover, .responsive-mode-option:focus, .responsive-mode-option.is-active) { color: var(--editor-accent); background: var(--editor-accent-soft); }
#headerNavigationEditor.header-navigation-fullscreen .responsive-mode-trigger.is-active,
#headerNavigationEditor.header-navigation-fullscreen .responsive-mode-option.is-active { border-color: var(--editor-accent); color: var(--editor-accent); }
#headerNavigationEditor.header-navigation-fullscreen .responsive-mode-trigger::after { background: var(--editor-accent); }
#headerNavigationEditor.header-navigation-fullscreen .responsive-mode-option { border: 0; border-radius: 3px; box-shadow: none; }
#headerNavigationEditor.header-navigation-fullscreen .inspector-content :is(.form-control, .form-select, .coloris-control input):focus { border-color: var(--editor-accent); outline: none; box-shadow: none; }
#headerNavigationEditor.header-navigation-fullscreen .inspector-content :is(.number-stepper, .box-side-stepper) input:focus { border-color: transparent; box-shadow: none; }
#headerNavigationEditor.header-navigation-fullscreen #resetPreview:is(:hover, :focus-visible) { border-color: var(--editor-accent); color: var(--editor-accent-hover); background: var(--editor-accent-soft); }
#headerEditorExitDialog { width: min(440px, calc(100vw - 32px)); padding: 24px; border: 1px solid #e1e5eb; border-radius: 8px; background: #fff; color: #182230; box-shadow: 0 20px 60px #0003; }
