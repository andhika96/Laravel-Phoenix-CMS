/* Fullscreen inspector. Header preview values remain owned by the renderer. */
body.header-editor-open { overflow: hidden !important; }
#headerNavigationEditor.header-navigation-fullscreen {
    position: fixed; inset: 0; z-index: 1040; width: 100%; height: 100dvh; margin: 0;
    --inspector-ui-font-size: 12px; --inspector-meta-font-size: 11px;
    --editor-border: #e8ebef; --editor-muted: #667085; --editor-field: #f5f6f8;
    --editor-control-radius: 5px; --editor-value-width: 144px;
    --editor-accent: var(--ph-primary, var(--bs-primary));
    --editor-accent-hover: var(--ph-primary-hover-bg, color-mix(in srgb, var(--editor-accent), black 12%));
    --editor-accent-soft: color-mix(in srgb, var(--editor-accent) 10%, white);
    --mock-primary: var(--editor-accent); --mock-primary-dark: var(--editor-accent-hover);
    background: #fff; color: #182230; font-family: var(--ph-font-family, sans-serif); font-size: 13px;
}
#headerNavigationEditor.header-navigation-fullscreen > main { display: flex; flex-direction: column; height: 100%; min-height: 0; padding: 0; }
#headerNavigationEditor.header-navigation-fullscreen [hidden] { display: none !important; }
#headerNavigationEditor.header-navigation-fullscreen .header-editor-topbar {
    flex: 0 0 auto; margin: 0 !important; padding: 10px 20px !important; border: 0; border-bottom: 1px solid var(--editor-border);
    border-radius: 0 !important; box-shadow: none; background: #fff;
}
#headerNavigationEditor.header-navigation-fullscreen .mock-topbar { display: flex; align-items: center; gap: 20px; min-height: 32px; }
#headerNavigationEditor.header-navigation-fullscreen .mock-topbar-copy { order: 0; flex: 0 1 auto; min-width: 0; }
#headerNavigationEditor.header-navigation-fullscreen .mock-title { margin: 0; font: 600 16px/1.4 var(--ph-font-family, sans-serif); letter-spacing: -.2px; }
#headerNavigationEditor.header-navigation-fullscreen .header-editor-back {
    order: 1; display: inline-flex; gap: 8px; align-items: center; padding-left: 20px; border-left: 1px solid var(--editor-border);
    color: var(--editor-muted) !important; text-decoration: none; font-size: 12px; white-space: nowrap;
}
#headerNavigationEditor.header-navigation-fullscreen .mock-topbar-actions { order: 2; display: flex; align-items: center; flex-wrap: nowrap; gap: 12px; margin-left: auto; }
