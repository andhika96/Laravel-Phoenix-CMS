  };
  const defaults = {
    clean:{primary:'#EAC2A2',pageBackground:'#FCF5ED',formSurface:'#FCF5ED',textColor:'#343029',logoSize:32,radius:20,side:'right',imageSize:100,decoration:true,decorationColor:'#F4D5B8',labelStyle:'Outline label',socialStyle:'Icons only',mobileVisual:'Compact above form',mobileHeight:160,tabletVisual:'Two columns when space allows'},
    ocean:{primary:'#144E5B',pageBackground:'#183D46',formSurface:'#FFFFFF',textColor:'#202B32',logoSize:32,radius:6,sameImage:true,backgroundPosition:'Center',panelImagePosition:'Center',side:'left',panelHeading:'Your next adventure awaits!',panelDescription:'A space for your next chapter.',panelTextColor:'#FFFFFF',cardWidth:'Normal',proportion:'50 : 50',overlay:'#12323D99',mobileVisual:'Hide photo panel',tabletVisual:'Two columns when space allows'},
    midnight:{primary:'#44B284',pageBackground:'#0D1511',formSurface:'#101813',textColor:'#F2F6F3',logoSize:30,radius:8,supportingPanel:true,side:'right',panelHeading:'Stories from our community',panelColor:'#44B284',glow:true,glowIntensity:45,decoration:true,infoCard:true,infoTitle:'Make room for your next idea',infoText:'Add a short message for your community.',mobileVisual:'Hide supporting panel',tabletVisual:'Stack panel below form',testimonials:[{quote:'',author:'',role:''}]},
    verdant:{primary:'#187653',pageBackground:'#F3F5F0',formSurface:'#FEFEFD',textColor:'#1C3025',logoSize:32,radius:9,side:'left',panelHeading:'A little clarity. A lot of possibility.',panelDescription:'Bring your ideas together.',decoration:true,mobileVisual:'Hide illustration',tabletVisual:'Two columns when space allows'}
  };
  const restored = window.openai?.widgetState?.modelContent || {};
  const state = {page:Object.hasOwn(pages,restored.page)?restored.page:'login',device:['desktop','tablet','mobile'].includes(restored.device)?restored.device:'desktop',open:['visual'],dirty:false,records:{}};
  for (const page of Object.keys(pages)) state.records[page] = {theme:page === state.page && Object.hasOwn(names,restored.theme)?restored.theme:'clean',themes:{}};
  function current() {
    const row = state.records[state.page];
    if (!row.themes[row.theme]) row.themes[row.theme] = {...structuredClone(defaults[row.theme]),...pageDefaults[state.page]};
    return row.themes[row.theme];
  }
  function escape(value) { return String(value ?? '').replace(/[&<>"']/g,ch=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[ch])); }
  function icons() { if (globalThis.lucide) lucide.createIcons({attrs:{width:16,height:16}}); }
  function saveState() { window.openai?.setWidgetState?.({modelContent:{page:state.page,theme:state.records[state.page].theme,device:state.device},privateContent:null})?.catch(()=>{}); }
  function field(key,label,kind='text',help='',options=[],when='') {
    const data = current(), value = data[key] ?? '', id = 'ap-field-'+key;
    let control = '';
    if (kind === 'select') control = '<select class="ap-control" id="'+id+'" data-key="'+key+'">'+options.map(option=>'<option'+(option===value?' selected':'')+'>'+escape(option)+'</option>').join('')+'</select>';
    else if (kind === 'color') control = '<div class="ap-control-pair"><input class="ap-color" type="color" data-color-for="'+key+'" aria-label="'+escape(label)+' picker" value="'+escape(value.slice(0,7))+'"><input class="ap-control" id="'+id+'" data-key="'+key+'" data-color-text="true" value="'+escape(value)+'" maxlength="9" spellcheck="false" aria-label="'+escape(label)+' HEX"></div>';
    else if (kind === 'toggle') control = '<label class="ap-toggle"><input id="'+id+'" type="checkbox" data-key="'+key+'"'+(value?' checked':'')+'><span>Enabled</span></label>';
    else if (kind === 'file' || kind === 'files') control = '<input class="ap-control" id="'+id+'" type="file" accept="image/png,image/jpeg,image/webp"'+(kind==='files'?' multiple':'')+' aria-label="'+escape(label)+'">';
    else if (kind === 'textarea') control = '<textarea class="ap-control" id="'+id+'" data-key="'+key+'" rows="2">'+escape(value)+'</textarea>';
    else if (kind === 'range') {
      const settings = key==='glowIntensity'?[0,100,'%']:key==='mobileHeight'?[80,240,'px']:key==='imageSize'?[70,120,'%']:key==='logoSize'?[20,64,'px']:[0,24,'px'];
      control = '<div class="ap-range-row"><input type="range" id="'+id+'" data-key="'+key+'" min="'+settings[0]+'" max="'+settings[1]+'" value="'+value+'"><output for="'+id+'">'+value+settings[2]+'</output></div>';
    } else control = '<input class="ap-control" id="'+id+'" data-key="'+key+'" value="'+escape(value)+'" type="text">';
    return '<div class="ap-field-row"'+(when?' data-when="'+when+'"':'')+'><label class="ap-field-label" for="'+id+'">'+escape(label)+(help?'<span class="ap-field-help">'+escape(help)+'</span>':'')+'</label><div>'+control+'</div></div>';
  }
  function group(key,title,description,icon,body) {
    return '<details class="ap-group" data-group="'+key+'"'+(state.open.includes(key)?' open':'')+'><summary><span class="ap-group-title"><i data-lucide="'+icon+'" aria-hidden="true"></i><span><strong>'+title+'</strong><small>'+description+'</small></span></span><i class="ap-chevron" data-lucide="chevron-down" aria-hidden="true"></i></summary><div class="ap-group-body">'+body+'</div></details>';
  }
  function renderTestimonials() {
    const data = current();
    return (data.testimonials.length?data.testimonials.map((item,index)=>'<div class="ap-testimonial"><div class="ap-testimonial-head"><span>Testimonial '+(index+1)+'</span><button type="button" class="ap-text-button ap-remove" data-remove="'+index+'" aria-label="Remove testimonial '+(index+1)+'">Remove</button></div><div class="ap-field-row"><label class="ap-field-label" for="ap-quote-'+index+'">Quote</label><textarea class="ap-control" id="ap-quote-'+index+'" data-item="'+index+'" data-prop="quote" placeholder="Add your testimonial text">'+escape(item.quote)+'</textarea></div><div class="ap-name-pair"><div class="ap-field-row"><label class="ap-field-label" for="ap-author-'+index+'">Name</label><input class="ap-control" id="ap-author-'+index+'" data-item="'+index+'" data-prop="author" value="'+escape(item.author)+'" placeholder="Name"></div><div class="ap-field-row"><label class="ap-field-label" for="ap-role-'+index+'">Role / organization</label><input class="ap-control" id="ap-role-'+index+'" data-item="'+index+'" data-prop="role" value="'+escape(item.role)+'" placeholder="Role or organization"></div></div></div>').join(''):'<p class="ap-empty">No testimonials added yet.</p>')+'<button type="button" class="ap-text-button" data-add-testimonial>Add testimonial</button>';
  }
  function render() {
    const theme = state.records[state.page].theme, data = current();
    root.dataset.device = state.device;
    root.querySelectorAll('.ap-device').forEach(button=>button.setAttribute('aria-pressed',String(button.dataset.device===state.device)));
    root.querySelectorAll('.ap-pages button').forEach(button=>button.setAttribute('aria-selected',String(button.dataset.page===state.page)));
    root.querySelector('#ap-settings').setAttribute('aria-labelledby','ap-tab-'+state.page);
    root.querySelectorAll('.ap-theme').forEach(button=>button.setAttribute('aria-checked',String(button.dataset.theme===theme)));
    root.querySelector('#ap-active-context').textContent = pages[state.page]+' / '+names[theme];
    let html = group('general','Colors & branding','Logo, colors and control shape','palette',
      field('primary','Primary Color','color','Existing setting. Used for buttons, links and accents.')+
      field('pageBackground','Page background','color')+field('formSurface','Form surface','color')+field('textColor','Text color','color')+
      field('logoImage','Logo image','file','Optional theme-specific logo.')+field('logoSize','Logo size','range')+field('radius','Input & button corners','range'));
    html += group('content','Page content','Heading, description and button text','type',
      field('pageHeading','Heading')+field('pageDescription','Description','textarea')+field('buttonText','Button text'));
    if (theme==='clean') html += group('visual','Illustration settings','Character, placement and decorative shape','image',
      field('illustration','Illustration image','file','Use a transparent PNG or WebP.')+field('side','Desktop position','select','',['left','right'])+
      field('imageSize','Illustration size','range')+field('decoration','Decorative shape','toggle','Show the arch behind your illustration.')+
      field('decorationColor','Shape color','color','','','decoration=true')+
      field('labelStyle','Input label style','select','',['Outline label','Above input'])+
      (state.page==='login'?field('socialStyle','Social button style','select','Only applies to login providers already supported by the application.',['Icons only','Icons with labels']):''));
    if (theme==='ocean') html += group('visual','Photo panel','Background, image focus and panel content','image',
      field('backgroundImage','Background Image','file','Uses the existing page background setting.')+
      field('overlay','Color Nuances','color','Uses the existing overlay color, including transparency.')+
      field('sameImage','Use page background for panel','toggle')+field('panelImage','Panel image','file','Shown when the panel uses a different image.',[],'sameImage=false')+
      field('backgroundPosition','Background image focus','select','',['Center','Top','Bottom','Left','Right'])+
      field('panelImagePosition','Panel image focus','select','',['Center','Top','Bottom','Left','Right'])+
      field('side','Panel position','select','',['left','right'])+field('panelHeading','Panel heading')+
      field('panelDescription','Panel description','textarea')+field('panelTextColor','Panel text color','color')+
      field('cardWidth','Card width','select','',['Compact','Normal','Wide'])+field('proportion','Photo / form proportion','select','',['40 : 60','50 : 50']));
    if (theme==='midnight') {
      html += group('visual','Panel appearance','Supporting panel, glow and decoration','layout-panel-left',
        field('supportingPanel','Supporting panel','toggle')+field('side','Panel position','select','',['left','right'],'supportingPanel=true')+
        field('panelHeading','Panel heading','text','',[],'supportingPanel=true')+field('panelColor','Panel color','color','',[],'supportingPanel=true')+
        field('glow','Background glow','toggle')+field('glowIntensity','Glow intensity','range','',[],'glow=true')+
        field('decoration','Panel decoration','toggle','',[],'supportingPanel=true'));
      if (data.supportingPanel) {
        html += group('testimonials','Testimonials','Quotes, names and organization details','quote',renderTestimonials());
        html += group('information','Information card','Optional message and avatar images','contact-round',
          field('infoCard','Show information card','toggle')+field('infoTitle','Card heading','text','',[],'infoCard=true')+
          field('infoText','Card description','textarea','',[],'infoCard=true')+field('avatars','Avatar images','files','Optional images for the information card.',[],'infoCard=true'));
      }
    }
    if (theme==='verdant') html += group('visual','Illustration panel','Placement, message and decoration','leaf',
      field('side','Panel position','select','',['left','right'])+field('panelHeading','Panel heading')+
      field('panelDescription','Panel description','textarea')+field('decoration','Botanical illustration','toggle'));
    const mobileOptions = theme==='clean'?['Compact above form','Hide illustration']:theme==='ocean'?['Hide photo panel','Short banner above form']:theme==='midnight'?['Hide supporting panel','Below form']:['Hide illustration','Compact above form'];
    html += group('responsive','Tablet & mobile','How visual content adapts to smaller screens','smartphone',
      field('tabletVisual','Tablet layout','select','Form fields remain readable at every layout.',['Two columns when space allows','Stack panel below form'])+
      field('mobileVisual','Mobile visual','select','',[...mobileOptions])+
      (theme==='clean'?field('mobileHeight','Mobile illustration height','range','',[],'mobileVisual=Compact above form'):''));
    groupHost.innerHTML = html;
    applyConditions(); icons();
  }
  function applyConditions() {
    const data = current();
    groupHost.querySelectorAll('[data-when]').forEach(row=> {
      const split = row.dataset.when.indexOf('='), key = row.dataset.when.slice(0,split), value = row.dataset.when.slice(split+1);
      row.hidden = String(data[key]) !== value;
    });
  }
  function dirty() { state.dirty = true; root.querySelector('.ap-status').hidden = true; }
  root.addEventListener('click',event=> {
    const button = event.target.closest('button');
    if (!button || !root.contains(button)) return;
    if (button.dataset.device) { state.device = button.dataset.device; root.dataset.device = state.device; root.querySelectorAll('.ap-device').forEach(item=>item.setAttribute('aria-pressed',String(item===button))); saveState(); }
    else if (button.dataset.page) { state.open = Array.from(groupHost.querySelectorAll('details[open]')).map(item=>item.dataset.group); state.page = button.dataset.page; render(); saveState(); }
    else if (button.dataset.theme) { state.open = Array.from(groupHost.querySelectorAll('details[open]')).map(item=>item.dataset.group); state.records[state.page].theme = button.dataset.theme; dirty(); render(); saveState(); }
    else if (button.hasAttribute('data-add-testimonial')) { current().testimonials.push({quote:'',author:'',role:''}); state.open = Array.from(groupHost.querySelectorAll('details[open]')).map(item=>item.dataset.group); dirty(); render(); root.querySelector('#ap-quote-'+(current().testimonials.length-1)).focus(); }
    else if (button.hasAttribute('data-remove')) { const index = Number(button.dataset.remove); current().testimonials.splice(index,1); state.open = Array.from(groupHost.querySelectorAll('details[open]')).map(item=>item.dataset.group); dirty(); render(); (root.querySelector('#ap-quote-'+Math.min(index,current().testimonials.length-1)) || root.querySelector('[data-add-testimonial]')).focus(); }
    else if (button.classList.contains('ap-save')) {
      const invalid = Array.from(groupHost.querySelectorAll('[data-color-text]')).find(input=>!/^#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?$/.test(input.value));
      if (invalid) { invalid.closest('details').open = true; invalid.setCustomValidity('Enter a HEX color such as #1FA675.'); invalid.reportValidity(); return; }
      state.dirty = false; const status = root.querySelector('.ap-status'); status.textContent = 'Preview reviewed for '+pages[state.page]+' / '+names[state.records[state.page].theme]+'. No application settings were changed.'; status.hidden = false; saveState();
    }
  });
  function updateInput(event) {
    const input = event.target, data = current();
    if (input.dataset.colorFor) {
      const key = input.dataset.colorFor; data[key] = input.value+(String(data[key]).length===9?String(data[key]).slice(7):'');
      groupHost.querySelector('[data-key="'+key+'"]').value = data[key]; dirty(); return;
    }
    if (input.dataset.item !== undefined) { data.testimonials[Number(input.dataset.item)][input.dataset.prop] = input.value; dirty(); return; }
    if (!input.dataset.key) return;
    const key = input.dataset.key;
    data[key] = input.type==='checkbox'?input.checked:input.type==='range'?Number(input.value):input.value;
    if (input.dataset.colorText) {
      input.setCustomValidity('');
      if (/^#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?$/.test(input.value)) groupHost.querySelector('[data-color-for="'+key+'"]').value = input.value.slice(0,7);
    }
    if (input.type==='range') { const output = input.parentElement.querySelector('output'); output.textContent = input.value+(key==='imageSize'||key==='glowIntensity'?'%':'px'); }
    dirty(); applyConditions();
    if (key==='supportingPanel' && event.type==='change') { state.open = Array.from(groupHost.querySelectorAll('details[open]')).map(item=>item.dataset.group); render(); root.querySelector('#ap-field-supportingPanel').focus(); }
  }
  root.addEventListener('input',updateInput);
  root.addEventListener('change',updateInput);
  root.querySelector('.ap-pages').addEventListener('keydown',event=> {
    if (!['ArrowLeft','ArrowRight','Home','End'].includes(event.key)) return;
    event.preventDefault(); const tabs = Array.from(root.querySelectorAll('.ap-pages button')); let index = tabs.indexOf(event.target);
    index = event.key==='Home'?0:event.key==='End'?tabs.length-1:(index+(event.key==='ArrowRight'?1:-1)+tabs.length)%tabs.length;
    tabs[index].click(); tabs[index].focus();
  });
  root.querySelector('.ap-theme-grid').addEventListener('keydown',event=> {
    if (!['ArrowLeft','ArrowRight','ArrowUp','ArrowDown'].includes(event.key)) return;
    event.preventDefault(); const buttons = Array.from(root.querySelectorAll('.ap-theme')); const step = event.key==='ArrowLeft'||event.key==='ArrowUp'?-1:1; const index = (buttons.indexOf(event.target)+step+buttons.length)%buttons.length;
    buttons[index].click(); buttons[index].focus();
  });
  window.addEventListener('openai:set_globals',event=> {
    const next = event.detail?.globals?.widgetState?.modelContent;
    if (!next) return;
    if (Object.hasOwn(pages,next.page)) state.page = next.page;
    if (Object.hasOwn(names,next.theme)) state.records[state.page].theme = next.theme;
    if (['desktop','tablet','mobile'].includes(next.device)) state.device = next.device;
    render();
  });
  render();
  if (globalThis.Tweak) {
    const layout = {rowSpace:18};
    const tweak = new Tweak({container:root.querySelector('.ap-window'),onChange:()=>root.style.setProperty('--ap-row-space',layout.rowSpace+'px')});
    tweak.addSlider(layout,'rowSpace',{label:'Field spacing',min:12,max:26,step:2,unit:'px',reference:'--ap-row-space'});
  }
})();
</script>
