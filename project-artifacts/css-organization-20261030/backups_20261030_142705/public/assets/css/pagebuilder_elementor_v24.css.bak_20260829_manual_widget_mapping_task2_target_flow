:root {
	--pb-bg: #f4f6fb;
	--pb-panel: #ffffff;
	--pb-border: #dfe5f0;
	--pb-text: #243047;
	--pb-subtle: #6f7b91;
	--pb-primary: #5b6cff;
	--pb-danger: #dc3545;
	--pb-success: #198754;
	--pb-shadow: 0 8px 24px rgba(23, 35, 61, 0.08);
}

* {
	box-sizing: border-box;
}

[v-cloak] {
	display: none;
}

body {
	margin: 0;
	font-family: Inter, sans-serif;
	color: var(--pb-text);
	background: var(--pb-bg);
}

.pb-app {
	display: flex;
	flex-direction: column;
	height: 100vh;
	min-height: 0;
}

.pb-topbar {
	height: 60px;
	padding: 0 16px;
	display: flex;
	align-items: center;
	justify-content: space-between;
	background: var(--pb-panel);
	border-bottom: 1px solid var(--pb-border);
}

.pb-brand {
	display: flex;
	align-items: center;
	gap: 10px;
	font-weight: 600;
}

.pb-brand-badge {
	width: 30px;
	height: 30px;
	border-radius: 8px;
	background: linear-gradient(135deg, #5b6cff, #39a2ff);
	color: #fff;
	display: flex;
	align-items: center;
	justify-content: center;
	font-size: 13px;
	font-weight: 700;
}

.pb-top-actions {
	display: flex;
	align-items: center;
	gap: 8px;
}

.pb-btn {
	border: 1px solid var(--pb-border);
	background: #fff;
	color: var(--pb-text);
	padding: 7px 12px;
	border-radius: 8px;
	font-size: 13px;
	font-weight: 500;
}

.pb-btn.primary {
	background: var(--pb-primary);
	border-color: var(--pb-primary);
	color: #fff;
}

.pb-btn:disabled {
	opacity: 0.75;
	cursor: not-allowed;
}

.pb-btn.primary.is-loading {
	display: inline-flex;
	align-items: center;
	justify-content: center;
	min-width: 108px;
}

.pb-btn.icon {
	width: 36px;
	height: 36px;
	padding: 0;
	display: inline-flex;
	align-items: center;
	justify-content: center;
}

.pb-main {
	display: grid;
	grid-template-columns: 320px 1fr;
	gap: 0;
	flex: 1;
	min-height: 0;
	min-width: 0;
	overflow: hidden;
}

.pb-panel {
	background: var(--pb-panel);
	min-height: 0;
	min-width: 0;
	overflow: auto;
	overscroll-behavior: contain;
}

.pb-panel.left {
	border-right: 1px solid var(--pb-border);
	padding: 12px;
	background: linear-gradient(180deg, #fbfcff 0%, #f7f9fd 100%);
}

.pb-props {
	min-height: 0;
	padding-bottom: 14px;
}

.pb-panel-title {
	font-size: 13px;
	font-weight: 700;
	text-transform: uppercase;
	letter-spacing: 0.4px;
	color: var(--pb-subtle);
	margin: 4px 0 12px;
}

.pb-section {
	margin-bottom: 20px;
}

.pb-tool-grid {
	display: grid;
	grid-template-columns: 1fr 1fr;
	gap: 8px;
}

.pb-tool-item {
	background: #f9fbff;
	border: 1px solid var(--pb-border);
	border-radius: 10px;
	padding: 10px;
	font-size: 12px;
	display: flex;
	gap: 8px;
	align-items: center;
	cursor: grab;
}

.pb-tool-item i {
	color: var(--pb-primary);
}

.pb-icon-source-btn {
	width: 100%;
	margin-top: 8px;
	justify-content: center;
	gap: 8px;
}

.pb-state-tabs {
	display: grid;
	grid-template-columns: repeat(3, minmax(0, 1fr));
	margin: 4px 0 16px;
	border: 1px solid #d5dce8;
	border-radius: 8px;
	overflow: hidden;
}

.pb-state-tabs--two {
	grid-template-columns: repeat(2, minmax(0, 1fr));
}

.pb-state-tabs button {
	min-height: 34px;
	border: 0;
	border-right: 1px solid #d5dce8;
	background: #fff;
	font-size: 11px;
	color: #526178;
}

.pb-state-tabs button:last-child {
	border-right: 0;
}

.pb-state-tabs button.active {
	background: #eef1ff;
	color: var(--pb-primary);
	font-weight: 600;
}

.pb-widget-advanced-controls .pb-advanced-dimension-control,
.pb-widget-advanced-controls .pb-advanced-edge-control {
	min-width: 0;
	margin-bottom: 14px;
}

.pb-widget-advanced-controls .pb-advanced-control-head {
	min-height: 28px;
	display: flex;
	align-items: center;
	justify-content: space-between;
	gap: 8px;
	margin-bottom: 8px;
	font-size: 11px;
	color: #344054;
}

.pb-widget-advanced-controls .pb-advanced-control-tools {
	display: inline-flex;
	align-items: center;
	gap: 7px;
	color: #667085;
}

.pb-widget-advanced-controls .pb-advanced-control-tools .pb-mini-unit {
	width: 56px;
	min-width: 56px;
}

.pb-widget-advanced-controls .pb-advanced-dimension-control .pb-range-value-row {
	grid-template-columns: minmax(0, 1fr) 84px;
	gap: 8px;
}

.pb-widget-advanced-controls .pb-advanced-edge-fields {
	display: grid;
	grid-template-columns: repeat(4, minmax(0, 1fr)) 28px;
	gap: 0;
	align-items: start;
}

.pb-widget-advanced-controls .pb-advanced-edge-fields label {
	min-width: 0;
	display: flex;
	flex-direction: column;
	align-items: center;
	gap: 4px;
}

.pb-widget-advanced-controls .pb-advanced-edge-fields .pb-input {
	min-width: 0;
	height: 30px;
	padding: 3px;
	border-radius: 0;
	border-right-width: 0;
	text-align: center;
	font-size: 11px;
}

.pb-widget-advanced-controls .pb-advanced-edge-fields label:first-child .pb-input {
	border-radius: 5px 0 0 5px;
}

.pb-widget-advanced-controls .pb-advanced-edge-fields label span {
	color: #7a8699;
	font-size: 9px;
}

.pb-widget-advanced-controls .pb-advanced-edge-fields .pb-link-btn {
	width: 28px;
	height: 30px;
	border-radius: 0 5px 5px 0;
}

.pb-widget-advanced-controls .pb-advanced-edge-fields .pb-link-btn.active {
	background: #eef1ff;
	color: var(--pb-primary);
}

.pb-subsection-title {
	margin: 2px 0 12px;
	font-size: 12px;
	font-weight: 700;
	color: #26344b;
}

.pb-inline-fields {
	display: grid;
	grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
	gap: 8px;
}

.pb-canvas-wrap {
	min-height: 0;
	min-width: 0;
	overflow: auto;
	padding: 18px 20px 30px;
	background:
		radial-gradient(960px 280px at 50% 0, rgba(255, 255, 255, 0.94), rgba(255, 255, 255, 0) 72%),
		linear-gradient(180deg, #eef2f8 0%, #e8edf5 100%);
}

.pb-stage-window {
	max-width: 1368px;
	margin: 0 auto;
	border: none;
	border-radius: 0;
	background: transparent;
	box-shadow: none;
	overflow: visible;
}

.pb-stage-chrome {
	height: 52px;
	padding: 0 14px;
	display: grid;
	grid-template-columns: auto minmax(260px, 520px) auto;
	align-items: center;
	gap: 10px;
	background: #f7f8fb;
	border-bottom: 1px solid #d6dbe5;
}

.pb-stage-chrome-left {
	display: inline-flex;
	align-items: center;
	gap: 6px;
}

.pb-stage-dot {
	width: 10px;
	height: 10px;
	border-radius: 999px;
	display: inline-block;
	border: 1px solid rgba(0, 0, 0, 0.08);
}

.pb-stage-dot.is-red {
	background: #ff605c;
}

.pb-stage-dot.is-yellow {
	background: #ffbd44;
}

.pb-stage-dot.is-green {
	background: #00ca4e;
}

.pb-stage-address {
	height: 30px;
	border-radius: 999px;
	border: 1px solid #e0e4ec;
	background: #ffffff;
	color: #636f86;
	font-size: 12px;
	display: inline-flex;
	align-items: center;
	justify-content: center;
	gap: 8px;
	padding: 0 14px;
	overflow: hidden;
}

.pb-stage-address span {
	white-space: nowrap;
	overflow: hidden;
	text-overflow: ellipsis;
}

.pb-stage-chrome-right {
	justify-self: end;
	display: inline-flex;
	align-items: center;
	gap: 4px;
}

.pb-stage-icon-btn {
	width: 28px;
	height: 28px;
	border: 1px solid transparent;
	border-radius: 8px;
	background: transparent;
	color: #56637c;
	font-size: 12px;
	display: inline-flex;
	align-items: center;
	justify-content: center;
	cursor: pointer;
}

.pb-stage-icon-btn:hover {
	border-color: #d2d8e4;
	background: #fff;
}

.pb-stage-toolbar {
	display: flex;
	align-items: center;
	justify-content: center;
	gap: 10px;
	padding: 6px 0 14px;
	background: transparent;
}

.pb-stage-device-group {
	display: inline-flex;
	align-items: center;
	padding: 4px;
	gap: 2px;
	border-radius: 999px;
	background: rgba(255, 255, 255, 0.9);
	border: 1px solid rgba(216, 223, 236, 0.96);
	box-shadow:
		0 12px 28px rgba(18, 26, 44, 0.08),
		0 2px 6px rgba(18, 26, 44, 0.04);
	backdrop-filter: blur(12px);
}

.pb-stage-device-btn {
	width: 30px;
	height: 30px;
	border: none;
	border-radius: 999px;
	background: transparent;
	color: #5b6780;
	font-size: 13px;
	display: inline-flex;
	align-items: center;
	justify-content: center;
	cursor: pointer;
	transition: background-color 120ms ease, color 120ms ease, box-shadow 120ms ease;
}

.pb-stage-device-btn:hover {
	background: rgba(238, 242, 255, 0.9);
	color: #3f52d8;
}

.pb-stage-device-btn.active {
	background: #eef2ff;
	color: #4052d8;
	box-shadow: inset 0 0 0 1px rgba(93, 110, 255, 0.16);
}

.pb-stage-width-pill {
	appearance: none;
	height: 38px;
	padding: 0 14px;
	border-radius: 999px;
	border: 1px solid rgba(216, 223, 236, 0.96);
	background: rgba(255, 255, 255, 0.9);
	color: #55617a;
	font-size: 12px;
	font-weight: 600;
	display: inline-flex;
	align-items: center;
	justify-content: center;
	gap: 8px;
	box-shadow:
		0 12px 28px rgba(18, 26, 44, 0.08),
		0 2px 6px rgba(18, 26, 44, 0.04);
	backdrop-filter: blur(12px);
	cursor: default;
	transition: border-color 120ms ease, box-shadow 120ms ease, background-color 120ms ease, color 120ms ease;
}

.pb-stage-width-control {
	position: relative;
}

.pb-stage-width-pill.is-interactive {
	cursor: pointer;
}

.pb-stage-width-pill.is-interactive:hover,
.pb-stage-width-pill.is-menu-open {
	border-color: rgba(182, 195, 228, 0.98);
	background: rgba(255, 255, 255, 0.96);
	box-shadow:
		0 14px 30px rgba(18, 26, 44, 0.1),
		0 2px 6px rgba(18, 26, 44, 0.04);
}

.pb-stage-width-pill i:last-child {
	transition: transform 120ms ease;
}

.pb-stage-width-pill.is-menu-open i:last-child {
	transform: rotate(180deg);
}

.pb-stage-width-menu {
	position: absolute;
	top: calc(100% + 10px);
	left: 50%;
	transform: translateX(-50%);
	min-width: 132px;
	padding: 8px;
	border-radius: 16px;
	border: 1px solid rgba(216, 223, 236, 0.96);
	background: rgba(255, 255, 255, 0.98);
	box-shadow:
		0 18px 36px rgba(18, 26, 44, 0.12),
		0 4px 12px rgba(18, 26, 44, 0.05);
	backdrop-filter: blur(14px);
	z-index: 30;
}

.pb-stage-width-option {
	width: 100%;
	appearance: none;
	border: none;
	background: transparent;
	border-radius: 12px;
	padding: 10px 12px;
	display: flex;
	align-items: center;
	justify-content: space-between;
	gap: 10px;
	color: #56637c;
	font-size: 12px;
	font-weight: 600;
	cursor: pointer;
	transition: background-color 120ms ease, color 120ms ease;
}

.pb-stage-width-option:hover {
	background: rgba(238, 242, 255, 0.88);
	color: #3f52d8;
}

.pb-stage-width-option.active {
	background: #eef2ff;
	color: #4052d8;
}

.pb-stage-width-option i {
	font-size: 11px;
}

.pb-canvas {
	min-height: calc(100vh - 250px);
	max-width: 1140px;
	margin: 10px auto 0;
	background: #fff;
	border: 1px solid #e6e9f0;
	border-radius: 8px;
	padding: 14px;
	box-shadow:
		0 14px 34px rgba(18, 26, 44, 0.08),
		0 2px 5px rgba(18, 26, 44, 0.05);
}

.pb-canvas.is-tablet {
	max-width: 720px;
}

.pb-canvas.is-mobile {
	max-width: 540px;
}

.pb-empty-root {
	position: absolute;
	inset: 12px;
	border: 1px dashed #cad3e4;
	border-radius: 12px;
	padding: 42px 26px;
	text-align: center;
	color: #75829a;
	font-size: 13px;
	background: #fbfcff;
	display: flex;
	flex-direction: column;
	align-items: center;
	justify-content: center;
	pointer-events: none;
	z-index: 0;
}

.pb-empty-root i,
.pb-root-followup-hint i {
	width: 36px;
	height: 36px;
	display: inline-flex;
	align-items: center;
	justify-content: center;
	border-radius: 999px;
	background: #f0f4ff;
	color: #5b6cff;
	font-size: 14px;
}

.pb-root-followup-hint {
	margin-top: 10px;
	border: 1px dashed #d7deed;
	border-radius: 12px;
	padding: 30px 24px;
	text-align: center;
	color: #7f8ba2;
	font-size: 13px;
	background: #fbfcff;
	display: flex;
	flex-direction: column;
	align-items: center;
	justify-content: center;
	gap: 12px;
}

.pb-root-followup-text {
	line-height: 1.5;
}

.pb-node {
	position: relative;
	border: 1px solid transparent;
	border-radius: 8px;
	margin-bottom: 8px;
	background: transparent;
	overflow: visible;
	transition: border-color 120ms ease, box-shadow 120ms ease, background-color 120ms ease;
}

.pb-node::after {
	content: none;
	position: absolute;
	top: -10px;
	left: 10px;
	padding: 2px 8px;
	border-radius: 999px;
	border: 1px solid #e3a6ff;
	background: #fff;
	color: #6f4aa0;
	font-size: 10px;
	font-weight: 700;
	letter-spacing: 0.2px;
	opacity: 0;
	transform: translateY(-2px);
	transition: opacity 120ms ease, transform 120ms ease;
	pointer-events: none;
	z-index: 8;
	display: none;
}

.pb-node:hover {
	border-color: #d8dff0;
	box-shadow: 0 0 0 1px rgba(113, 132, 183, 0.2);
	background: rgba(250, 252, 255, 0.72);
}

.pb-node:hover::after {
	opacity: 1;
	transform: translateY(0);
}

.pb-node.active {
	border-color: #b3c2ec;
	box-shadow: 0 0 0 1px rgba(86, 120, 212, 0.32);
}

.pb-node-toolbar {
	position: absolute;
	inset: 0;
	z-index: 10;
	pointer-events: none;
	opacity: 0;
	transition: opacity 120ms ease;
}

.pb-node.is-toolbar-visible > .pb-node-toolbar,
.pb-node.is-drag-over > .pb-node-toolbar {
	opacity: 1;
}

.pb-node.is-toolbar-visible > .pb-node-toolbar .pb-node-label,
.pb-node.is-toolbar-visible > .pb-node-toolbar .pb-node-actions,
.pb-node.is-drag-over > .pb-node-toolbar .pb-node-label,
.pb-node.is-drag-over > .pb-node-toolbar .pb-node-actions {
	pointer-events: auto;
}

.pb-node-label {
	position: absolute;
	top: -12px;
	left: 12px;
	padding: 6px 12px;
	border: 1px solid #e3a6ff;
	border-radius: 14px 14px 14px 4px;
	background: #fff;
	box-shadow: 0 10px 24px rgba(57, 42, 102, 0.12);
	font-size: 11px;
	font-weight: 600;
	display: inline-flex;
	align-items: center;
	gap: 7px;
	color: #6f4aa0;
	pointer-events: none;
	cursor: pointer;
	white-space: nowrap;
}

.pb-node-actions {
	position: absolute;
	top: -12px;
	right: 12px;
	transform: none;
	display: inline-flex;
	flex-direction: row;
	align-items: center;
	justify-content: center;
	gap: 2px;
	padding: 4px 5px;
	border: 1px solid #e3a6ff;
	border-radius: 16px 16px 5px 16px;
	background: #fff;
	box-shadow: 0 10px 24px rgba(57, 42, 102, 0.12);
	pointer-events: none;
	cursor: pointer;
}

.pb-node-btn {
	width: 28px;
	height: 28px;
	border: none;
	background: transparent;
	border-radius: 999px;
	font-size: 13px;
	color: #3a2f57;
	display: inline-flex;
	align-items: center;
	justify-content: center;
	cursor: pointer;
	transition: background 100ms ease;
}

.pb-node-btn:hover {
	background: rgba(227, 166, 255, 0.25);
}

.pb-node-btn.remove {
	color: #8b2340;
}

.pb-node-btn.remove:hover {
	background: rgba(220, 53, 69, 0.1);
}

.pb-node-content {
	padding: 0;
	cursor: grab;
	user-select: none;
	-webkit-user-select: none;
	-webkit-user-drag: none;
	touch-action: none;
}

.pb-is-dragging .pb-node-content {
	cursor: grabbing;
}

.pb-node.active > .pb-node-content {
	padding: 0;
}

.pb-dropzone {
	min-height: 32px;
	border: 1px dashed transparent;
	border-radius: 8px;
	padding: 2px;
	background: transparent;
	display: flex;
	flex-direction: column;
	flex: 1 1 auto;
	transition: border-color 120ms ease, background-color 120ms ease, box-shadow 120ms ease;
}

.pb-dropzone-stack {
	position: relative;
	display: flex;
	flex: 1 1 auto;
	min-height: 100%;
}

.pb-dropzone-empty {
	font-size: 12px;
	color: #8a95ac;
	text-align: center;
	padding: 0;
	display: flex;
	flex-direction: column;
	align-items: center;
	gap: 8px;
}

.pb-dropzone-empty-text {
	font-size: 12px;
	color: #8a95ac;
}

/* Grid column kosong: overlay penuh agar placeholder Sortable tetap tepat di dalam cell. */

.pb-dropzone-col.is-sequential-locked {
	border-color: #e2e8f7;
	background: #f6f8fd;
}

.pb-dropzone-col.is-sequential-locked .pb-dropzone-empty-text {
	color: #9aa4bc;
}

.pb-dropzone-lock-text {
	font-size: 11px;
	font-weight: 600;
	color: #8663c5;
}

.pb-dropzone-overlay {
	/* deprecated - dipertahankan untuk backward compat tapi tidak dipakai lagi di container */
	display: flex;
	flex-direction: column;
	align-items: center;
	justify-content: center;
	gap: 8px;
	border-radius: 8px;
	pointer-events: none;
}

.pb-dropzone-overlay .pb-inline-add {
	pointer-events: auto;
}

.pb-dropzone-root {
	min-height: calc(100vh - 260px);
	border: 1px solid transparent;
	border-radius: 8px;
	padding: 0;
	background: transparent;
	position: relative;
}

.pb-dropzone:empty,
.pb-dropzone > .sortable-ghost:only-child {
	min-height: 0;
}

.pb-dropzone.is-drop-hover {
	border-color: #86a0ea;
	background: #f7faff;
	box-shadow: inset 0 0 0 1px rgba(134, 160, 234, 0.2);
}

.pb-dropzone-col {
	gap: 8px;
	padding: 0;
	border-radius: 0;
	position: relative;
}

.pb-dropzone-col > .pb-node {
	margin-bottom: 0;
	position: relative;
	z-index: 1;
}

.pb-dropzone-col > .sortable-ghost,
.pb-dropzone-col > .sortable-chosen {
	position: relative;
	z-index: 1;
}

.pb-dropzone-col > .pb-node::after {
	left: 76px;
}

.pb-inline-add {
	border: 1px dashed #d7c8f4;
	background: #fff;
	color: #7a57b2;
	border-radius: 999px;
	height: 26px;
	padding: 0 10px;
	display: inline-flex;
	align-items: center;
	gap: 6px;
	font-size: 11px;
	font-weight: 600;
	line-height: 1;
}

.pb-inline-add i {
	font-size: 10px;
}

.pb-inline-add.mini {
	height: 22px;
	padding: 0 8px;
	font-size: 10px;
}

.pb-node.active .pb-dropzone {
	border-color: #cfdbf5;
	background: #fff;
}

/* Grid Outline toggle (Container > Items > Grid Outline) */

.pb-node.is-drop-hover-node > .pb-node-content {
	border-color: #e4b4fb;
	background: #fff;
}

.pb-is-dragging .pb-node {
	transition: transform 120ms ease, box-shadow 120ms ease;
}

.pb-is-dragging .pb-dropzone {
	border-color: #d7c0f6;
	background: rgba(255, 251, 255, 0.72);
}

.pb-is-dragging .pb-dropzone-root {
	border: 1px dashed #c9b3ee;
	background: #fdf9ff;
}

.pb-is-dragging .pb-dropzone-empty {
	pointer-events: none;
}

.pb-is-dragging .pb-dropzone-overlay .pb-inline-add {
	pointer-events: none;
}

.pb-is-dragging .sortable-ghost {
	opacity: 0.35 !important;
	background: #efeaff !important;
	border: 1px dashed #8f7bff !important;
}

.pb-is-dragging .sortable-chosen {
	box-shadow: 0 12px 30px rgba(54, 36, 127, 0.16);
