/* ═══════════════════════════════════════════════════════
   PROPERTIES PANEL — 3-TAB UI
   ═══════════════════════════════════════════════════════ */

/* ── Props header ─────────────────────────────────────── */
.pb-props-header {
	display: flex;
	align-items: center;
	gap: 8px;
	padding-bottom: 8px;
	border-bottom: 1px solid var(--pb-border);
	margin-bottom: 4px;
}

.pb-btn.icon-sm {
	width: 28px;
	height: 28px;
	padding: 0;
	display: inline-flex;
	align-items: center;
	justify-content: center;
	border-radius: 6px;
	font-size: 12px;
	flex-shrink: 0;
}

.pb-props-type-badge {
	display: flex;
	align-items: center;
	gap: 6px;
	font-size: 13px;
	font-weight: 600;
	color: var(--pb-text);
	overflow: hidden;
}

.pb-props-type-badge i {
	color: var(--pb-primary);
	font-size: 13px;
	flex-shrink: 0;
}

.pb-props-type-badge span {
	white-space: nowrap;
	overflow: hidden;
	text-overflow: ellipsis;
}

.pb-input-sm {
	font-size: 12px;
	padding: 5px 8px;
}

/* ── Tab Nav ──────────────────────────────────────────── */
.pb-tab-nav {
	display: grid;
	grid-template-columns: repeat(3, minmax(0, 1fr));
	gap: 4px;
	border: 1px solid var(--pb-border);
	border-radius: 10px;
	background: #f3f6fc;
	padding: 4px;
	margin: 10px 0 12px;
}

.pb-tab-btn {
	border: 1px solid transparent;
	background: none;
	border-radius: 8px;
	padding: 7px 6px;
	font-size: 12px;
	font-weight: 600;
	color: var(--pb-subtle);
	cursor: pointer;
	transition: color 120ms, border-color 120ms, background-color 120ms;
}

.pb-tab-btn:hover {
	color: var(--pb-text);
	background: #eef2fb;
}

.pb-tab-btn.active {
	color: var(--pb-primary);
	border-color: rgba(91, 108, 255, 0.25);
	background: #fff;
	box-shadow: 0 1px 2px rgba(28, 39, 66, 0.06);
}

/* ── Tab Content ──────────────────────────────────────── */
.pb-tab-content {
	margin-top: 0;
	display: grid;
	gap: 10px;
}

/* ── Prop Section (collapsible groups) ────────────────── */
.pb-prop-section {
	margin-bottom: 0;
	padding: 10px 10px 9px;
	border: 1px solid #e2e7f2;
	border-radius: 10px;
	background: #fff;
	box-shadow: 0 1px 0 rgba(19, 32, 56, 0.03);
}

.pb-prop-section:last-child {
	margin-bottom: 2px;
}

.pb-prop-section-title {
	font-size: 11px;
	font-weight: 700;
	text-transform: uppercase;
	letter-spacing: 0.45px;
	color: #5e6c88;
	margin-bottom: 9px;
}

/* ── Segmented button group ───────────────────────────── */
.pb-btn-group {
	display: flex;
	flex-wrap: wrap;
	gap: 4px;
}

.pb-seg-btn {
	flex: 1;
	min-width: 28px;
	height: 31px;
	padding: 0 6px;
	border: 1px solid var(--pb-border);
	background: #f7f9ff;
	border-radius: 6px;
	font-size: 11px;
	font-weight: 500;
	color: var(--pb-subtle);
	cursor: pointer;
	display: inline-flex;
	align-items: center;
	justify-content: center;
	transition: background 100ms, color 100ms, border-color 100ms;
	white-space: nowrap;
	line-height: 1;
}

.pb-seg-btn i {
	font-size: 12px;
	line-height: 1;
}

.pb-seg-btn:hover {
	background: #eef1fb;
	color: var(--pb-text);
}

.pb-seg-btn.active {
	background: var(--pb-primary);
	border-color: var(--pb-primary);
	color: #fff;
}

/* ── Color picker row ─────────────────────────────────── */
.pb-color-row {
	display: flex;
	align-items: center;
	gap: 8px;
}

.pb-color-swatch {
	width: 32px;
	height: 32px;
	padding: 2px;
	border: 1px solid var(--pb-border);
	border-radius: 6px;
	cursor: pointer;
	flex-shrink: 0;
	background: none;
}

.pb-color-row .pb-input {
	flex: 1;
}

.pb-color-row .clr-field {
	flex: 1;
	width: 100%;
}

.pb-color-row .clr-field .pb-input {
	width: 100%;
	padding-right: 44px;
}

.pb-color-row .clr-field button {
	top: 50%;
	transform: translateY(-50%);
	border-top-right-radius: 10px;
	border-bottom-right-radius: 10px;
}

/* ── Four-sides input (Padding / Margin) ──────────────── */
.pb-four-sides {
	display: grid;
	grid-template-columns: 1fr 1fr 1fr 1fr;
	gap: 7px;
}

.pb-side-input {
	display: flex;
	flex-direction: column;
	align-items: center;
	gap: 3px;
}

.pb-side-input .pb-input {
	width: 100%;
	text-align: center;
	padding: 6px 4px;
	font-size: 12px;
	min-height: 31px;
}

.pb-side-input span {
	font-size: 10px;
	color: var(--pb-subtle);
}

/* ── Column picker (1-6 buttons) ─────────────────────── */
.pb-col-picker {
	display: flex;
	gap: 4px;
}

.pb-col-pick-btn {
	flex: 1;
	height: 30px;
	border: 1px solid var(--pb-border);
	background: #f9fbff;
	border-radius: 6px;
	font-size: 12px;
	font-weight: 600;
	color: var(--pb-subtle);
	cursor: pointer;
	transition: background 100ms, color 100ms, border-color 100ms;
}

.pb-col-pick-btn:hover {
	background: #eef1fb;
	color: var(--pb-text);
}

.pb-col-pick-btn.active {
	background: var(--pb-primary);
	border-color: var(--pb-primary);
	color: #fff;
}

/* ── Hint text ────────────────────────────────────────── */
.pb-form-hint {
	font-size: 10px;
	color: var(--pb-subtle);
	font-weight: 400;
}

.pb-label-row {
	display: flex;
	align-items: center;
	justify-content: space-between;
	gap: 10px;
}

.pb-responsive-switch {
	display: inline-flex;
	align-items: center;
	gap: 6px;
	flex-wrap: wrap;
}

.pb-device-btn {
	border: 1px solid var(--pb-border);
	background: #f7f9ff;
	color: var(--pb-subtle);
	border-radius: 7px;
	padding: 5px 8px;
	font-size: 11px;
	font-weight: 600;
	display: inline-flex;
	align-items: center;
	gap: 6px;
	cursor: pointer;
}

.pb-device-btn.active {
	background: var(--pb-primary);
	border-color: var(--pb-primary);
	color: #fff;
}

.pb-link-btn {
	border: 1px solid var(--pb-border);
	background: #f7f9ff;
	color: var(--pb-subtle);
	border-radius: 6px;
	width: 28px;
	height: 28px;
	display: inline-flex;
	align-items: center;
	justify-content: center;
	cursor: pointer;
	flex-shrink: 0;
}

.pb-link-btn:hover {
	background: #eef1fb;
	color: var(--pb-text);
}

.pb-gap-row {
	display: grid;
	grid-template-columns: 1fr 1fr;
	gap: 8px;
}

.pb-gap-field {
	display: flex;
	flex-direction: column;
	gap: 4px;
}

.pb-gap-field span {
	font-size: 10px;
	color: var(--pb-subtle);
	text-align: center;
}

.pb-toggle-wrap {
	display: inline-flex;
	align-items: center;
}

.pb-toggle {
	position: fixed;
	top: 0;
	left: 0;
	width: 1px;
	height: 1px;
	margin: 0;
	opacity: 0;
	pointer-events: none;
}

.pb-toggle + label {
	position: relative;
	display: inline-flex;
	align-items: center;
	width: 36px;
	height: 20px;
	border-radius: 999px;
	background: #d8deec;
	cursor: pointer;
	transition: background 120ms ease;
}

.pb-toggle + label::after {
	content: '';
	position: absolute;
	left: 2px;
	width: 16px;
	height: 16px;
	border-radius: 50%;
	background: #fff;
	box-shadow: 0 1px 3px rgba(15, 23, 42, 0.22);
	transition: transform 120ms ease;
}

.pb-toggle:checked + label {
	background: var(--pb-primary);
}

.pb-toggle:checked + label::after {
	transform: translateX(16px);
}

.pb-range {
	width: 100%;
	accent-color: var(--pb-primary);
}

.pb-code-editor {
	font-family: Consolas, 'Courier New', monospace;
	font-size: 12px;
	min-height: 120px;
}

.pb-attr-row {
	display: grid;
	grid-template-columns: 1fr 1fr auto;
	gap: 8px;
	margin-top: 8px;
}

.pb-mini-btn {
	flex: 0;
	padding: 2px 8px;
	font-size: 11px;
}

/* =============================================
   ADVANCED: responsive visibility + motion
   ============================================= */
@media (min-width: 1025px) {
	.pb-hide-desktop {
		display: none !important;
	}
	.pb-scroll-off-desktop.pb-motion-scroll {
		will-change: auto;
		transform: none !important;
	}
	.pb-mouse-off-desktop.pb-motion-mouse {
		transition: none;
		transform: none !important;
		box-shadow: none !important;
	}
	.pb-sticky-off-desktop {
		position: relative !important;
		top: auto !important;
		bottom: auto !important;
	}
}

@media (min-width: 768px) and (max-width: 1024px) {
	.pb-hide-tablet {
		display: none !important;
	}
	.pb-scroll-off-tablet.pb-motion-scroll {
		will-change: auto;
		transform: none !important;
	}
	.pb-mouse-off-tablet.pb-motion-mouse {
		transition: none;
		transform: none !important;
		box-shadow: none !important;
	}
	.pb-sticky-off-tablet {
		position: relative !important;
		top: auto !important;
		bottom: auto !important;
	}
}

@media (max-width: 767px) {
	.pb-hide-mobile {
		display: none !important;
	}
	.pb-scroll-off-mobile.pb-motion-scroll {
		will-change: auto;
		transform: none !important;
	}
	.pb-mouse-off-mobile.pb-motion-mouse {
		transition: none;
		transform: none !important;
		box-shadow: none !important;
	}
	.pb-sticky-off-mobile {
		position: relative !important;
		top: auto !important;
		bottom: auto !important;
	}
}

.pb-motion-mouse {
	transition: transform 220ms ease, box-shadow 220ms ease;
}

.pb-motion-mouse:hover {
	transform: translateY(-2px);
	box-shadow: 0 10px 28px rgba(23, 35, 61, 0.16);
}

.pb-motion-scroll {
	will-change: transform, opacity;
}

.pb-entrance-anim {
	animation-duration: 0.7s;
	animation-fill-mode: both;
}

.pb-anim-fadeIn { animation-name: pbFadeIn; }
.pb-anim-fadeInUp { animation-name: pbFadeInUp; }
.pb-anim-fadeInDown { animation-name: pbFadeInDown; }
.pb-anim-fadeInLeft { animation-name: pbFadeInLeft; }
.pb-anim-fadeInRight { animation-name: pbFadeInRight; }
.pb-anim-zoomIn { animation-name: pbZoomIn; }
.pb-anim-slideInUp { animation-name: pbSlideInUp; }
.pb-anim-slideInDown { animation-name: pbSlideInDown; }
.pb-anim-slideInLeft { animation-name: pbSlideInLeft; }
.pb-anim-slideInRight { animation-name: pbSlideInRight; }
.pb-anim-bounceIn { animation-name: pbBounceIn; }

@keyframes pbFadeIn {
	from { opacity: 0; }
	to { opacity: 1; }
}

@keyframes pbFadeInUp {
	from { opacity: 0; transform: translate3d(0, 20px, 0); }
	to { opacity: 1; transform: translate3d(0, 0, 0); }
}

@keyframes pbFadeInDown {
	from { opacity: 0; transform: translate3d(0, -20px, 0); }
	to { opacity: 1; transform: translate3d(0, 0, 0); }
}

