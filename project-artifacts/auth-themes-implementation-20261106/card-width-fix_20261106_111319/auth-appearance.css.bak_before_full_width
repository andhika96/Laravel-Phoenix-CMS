.ph-auth-appearance [v-cloak] { display:none; }
.ph-auth-appearance .ph-auth-field-help { color:var(--bs-secondary-color,#66736b); font-size:.85em; line-height:1.6; }
.ph-auth-appearance .ph-auth-page-tabs { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); }
.ph-auth-appearance .ph-auth-page-tabs .nav-link { min-height:44px; padding:.75rem .5rem; }
.ph-auth-appearance .ph-auth-theme-grid { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:1rem; max-width:1120px; }
.ph-auth-appearance .ph-auth-theme-choice { position:relative; min-width:0; width:100%; height:130px; padding:.25rem; border:2px solid var(--bs-border-color); border-radius:10px; background:var(--bs-body-bg); color:var(--bs-body-color); overflow:hidden; }
.ph-auth-appearance .ph-auth-theme-choice:hover { border-color:var(--ph-theme-primary,var(--bs-primary)); }
.ph-auth-appearance .ph-auth-theme-choice.selected { border-color:var(--ph-theme-primary,var(--bs-primary)); }
.ph-auth-appearance .ph-auth-theme-thumbnail { display:block; width:100%; height:100%; object-fit:cover; object-position:center; border-radius:7px; background:#e5e7eb; }
.ph-auth-appearance .ph-auth-theme-selected { position:absolute; left:.75rem; bottom:.85rem; display:grid; place-items:center; width:31px; height:31px; border:2px solid #fff; border-radius:50%; background:#1fa675; color:#fff; font-size:17px; }
.ph-auth-appearance .ph-auth-option-groups { --bs-accordion-bg:transparent; --bs-accordion-active-bg:transparent; --bs-accordion-btn-focus-box-shadow:none; }
.ph-auth-appearance .accordion-header { margin:0; font-size:inherit; line-height:1.45; }
.ph-auth-appearance .accordion-button { padding:.85rem 0; color:inherit; font-size:inherit; line-height:1.45; }
.ph-auth-appearance .accordion-button:not(.collapsed) { color:var(--ph-theme-primary,var(--bs-primary)); box-shadow:none; }
.ph-auth-appearance .accordion-button strong { font-size:1em; font-weight:600; }
.ph-auth-appearance .ph-auth-setting-row { display:grid; grid-template-columns:minmax(0,.65fr) minmax(0,1.85fr); gap:1.5rem; padding:.75rem 0; align-items:start; }
.ph-auth-appearance .ph-auth-setting-row>.form-label { padding-top:.5rem; }
.ph-auth-appearance .ph-auth-setting-control { min-width:0; }
.ph-auth-appearance .ph-auth-setting-toggle,.ph-auth-appearance .ph-auth-range-control { min-height:40px; }
.ph-auth-appearance .ph-auth-setting-toggle { display:flex; align-items:center; gap:.6rem; }
.ph-auth-appearance .ph-auth-setting-toggle .form-check-input { margin-top:0; }
.ph-auth-appearance .ph-auth-range-control .form-range { margin:0; }
.ph-auth-appearance .clr-field { width:100%; max-width:240px; }
.ph-auth-appearance .ph-auth-setting-control>.form-select { max-width:650px; }
.ph-auth-appearance .ph-auth-image-field { max-width:720px; }
.ph-auth-appearance .clr-field button { border-top-right-radius:var(--bs-border-radius); border-bottom-right-radius:var(--bs-border-radius); }
.ph-auth-appearance .ph-auth-upload-progress { height:6px; background:var(--bs-secondary-bg); }
.ph-auth-appearance .ph-auth-upload-progress .progress-bar { background:var(--ph-theme-primary,var(--bs-primary)); }
.ph-auth-appearance .ph-auth-image-empty { display:flex; flex-direction:column; justify-content:center; align-items:center; gap:.3rem; min-height:135px; border-radius:7px; background:#e5e7eb; color:#59616b; font-size:.9em; }
.ph-auth-appearance .ph-auth-image-thumb { display:block; width:100%; height:155px; object-fit:contain; border-radius:7px; background:#e5e7eb; }
.ph-auth-appearance .ph-auth-image-name { min-width:0; flex:1 1 130px; }
.ph-auth-appearance .ph-auth-image-action { display:grid; place-items:center; width:42px; height:42px; padding:0; }
.ph-auth-appearance .ph-auth-full-image { display:block; width:100%; max-height:70vh; object-fit:contain; background:#e5e7eb; }
.ph-auth-appearance .ph-auth-testimonial-editor { padding:1rem 0; border-bottom:1px solid var(--bs-border-color); margin-bottom:1rem; }
.ph-auth-appearance :is(button,input,select,textarea):focus-visible { outline:2px solid var(--ph-theme-primary,var(--bs-primary)); outline-offset:3px; }
@media(max-width:991.98px) {
	.ph-auth-appearance .ph-auth-theme-grid { grid-template-columns:repeat(2,minmax(0,1fr)); }
}
@media(max-width:575.98px) {
	.ph-auth-appearance .ph-auth-page-tabs { grid-template-columns:repeat(2,minmax(0,1fr)); }
	.ph-auth-appearance .ph-auth-theme-grid { gap:.7rem; }
	.ph-auth-appearance .ph-auth-theme-choice { height:105px; }
	.ph-auth-appearance .ph-auth-setting-row { grid-template-columns:1fr; gap:.6rem; padding:1rem 0; }
	.ph-auth-appearance .ph-auth-setting-row>.form-label { padding-top:0; }
	.ph-auth-appearance :is(.form-control,.form-select) { font-size:16px!important; }
	.ph-auth-appearance .ph-auth-image-action { width:44px; height:44px; }
	.ph-auth-appearance .btn-submit-data { width:100%; min-height:44px; }
}
