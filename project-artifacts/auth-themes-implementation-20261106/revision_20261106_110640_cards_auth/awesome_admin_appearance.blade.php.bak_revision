															</div>
															<label :for="fieldId('quote-'+index)" class="form-label small">{{ t('Quote') }}</label>
															<textarea :id="fieldId('quote-'+index)" class="form-control font-size-inherit mb-3" rows="3" maxlength="1000" v-model="item.quote"></textarea>
