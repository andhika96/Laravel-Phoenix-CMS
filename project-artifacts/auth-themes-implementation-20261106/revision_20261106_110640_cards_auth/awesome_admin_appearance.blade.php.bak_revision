																<div class="col-sm-6"><label class="form-label small" :for="fieldId('role-'+index)">{{ t('Role / organization') }}</label><input :id="fieldId('role-'+index)" class="form-control font-size-inherit" maxlength="160" v-model="item.role"></div>
