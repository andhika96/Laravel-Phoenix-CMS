                index.append('- [' + item['title'].replace('[','(').replace(']',')') + '](' + Path(item['e']).name + ') — ' + item['action'] + '; ' + str(item['final_count']) + ' laporan akhir.')
        index.append('')
    index += ['## File dibuat dan verifikasi', '', '- Script: ' + str(BASE/'export_memories.py'), '- Manifest: ' + str(BASE/'manifest.json'), '- Verifikasi: ' + str(BASE/'verification.json'), '', '## Masalah belum selesai dan langkah lanjutan', '',
        '- Akses ke seluruh chat ChatGPT web belum tersedia dalam inventaris ini; ekspor akun diperlukan untuk cakupan cloud yang tidak ditampilkan aplikasi.',
        '- Lampiran gambar/dokumen biner tidak disalin; rujukan dan konteks teks tetap tersimpan.',
        '- Laporan tanpa akhir ditandai dalam plan.json; jangan menganggap pekerjaan tersebut selesai.',
        '- Saat pekerjaan dilanjutkan, periksa kondisi source/runtime baru karena catatan adalah riwayat.', '']
    index_name = STAMP + '-index.md'
    for dest in DESTS:
        write_new(dest/index_name, '\n'.join(index))
    assert (DESTS[0]/index_name).read_bytes() == (DESTS[1]/index_name).read_bytes()
    for item in manifest:
        assert sha(Path(item['e']))==item['sha256']==sha(Path(item['c']))
        assert Path(item['e']).stat().st_size>0 and sha(Path(item['transcript']))==item['transcript_sha256']
    verification = {'chats':len(rows), 'note_pairs_verified':len(manifest), 'index_pairs_verified':1, 'mismatched_hashes':0, 'old_memories_verified_unchanged':len(previous_hashes), 'empty_files':0, 'actions':dict(collections.Counter(r['action'] for r in rows)), 'projects':dict(collections.Counter(r['project'] for r in rows)), 'source_errors':[(r['id'],r['errors']) for r in rows if r['errors']], 'no_final':[(r['id'],r['title']) for r in rows if not r['final_count']], 'index_e':str(DESTS[0]/index_name), 'index_c':str(DESTS[1]/index_name), 'runtime_retested':False, 'graphify_updated':False}
    (BASE/'manifest.json').write_text(json.dumps(manifest, ensure_ascii=False, indent=2), encoding='utf-8')
    (BASE/'previous-hashes.json').write_text(json.dumps(previous_hashes, ensure_ascii=False, indent=2), encoding='utf-8')
    (BASE/'verification.json').write_text(json.dumps(verification, ensure_ascii=False, indent=2), encoding='utf-8')
    print(json.dumps(verification, ensure_ascii=False))

