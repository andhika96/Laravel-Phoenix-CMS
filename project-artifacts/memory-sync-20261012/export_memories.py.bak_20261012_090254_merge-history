    titles = {}
    for line in (CODEX / 'session_index.jsonl').read_text(encoding='utf-8').splitlines():
        value = json.loads(line)
        titles[value['id']] = value.get('thread_name', '')
    sidebar = json.loads((BASE / 'sidebar.json').read_text(encoding='utf-8'))
    labels = {p['path'].lower(): p['label'] for p in json.loads((BASE / 'projects.json').read_text(encoding='utf-8'))['projects']}
    visible = {r['id']: r for r in sidebar['threads'] + sidebar.get('pinnedThreads', [])}
    for row in rows:
        row['cwd'] = row['cwd'].removeprefix('\\\\?\\')
        row['title'] = visible.get(row['id'], {}).get('title') or row.get('name') or titles.get(row['id']) or row['title'].splitlines()[-1][:140]
        row['title'] = clean(row['title'])
        row['project'] = labels.get(row['cwd'].lower()) or (Path(row['cwd']).name if 'laragon' in row['cwd'].lower() or 'Age of Empire' in row['cwd'] or 'LaraPhoenix Web Game' in row['cwd'] else 'Tanpa project')
        row['kind'] = 'codex-local'
        extract(row)
    for remote in json.loads((BASE / 'remote-chats.json').read_text(encoding='utf-8')):
        thread = remote['thread']
        row = {'id':thread['id'], 'title':thread.get('title') or visible.get(thread['id'], {}).get('title') or thread['id'], 'cwd':thread.get('cwd') or '', 'created_at':thread['createdAt'], 'updated_at':thread['updatedAt'], 'archived':0, 'project':'Tanpa project (cloud)', 'kind':thread.get('kind', 'cloud'), 'rollout_path':'codex://threads/' + thread['id'], 'messages':[], 'patches':[], 'errors':[], 'attachment_count':0}
        assert not remote['page']['hasMore']
        for turn in reversed(remote['turns']):
            for item in turn['items']:
                if item['type'] == 'userMessage':
                    text = '\n'.join(c.get('text', '') for c in item.get('content', []) if isinstance(c, dict))
                    role = 'user'
                elif item['type'] == 'agentMessage':
                    text, role = item.get('text', ''), 'assistant'
                else:
                    continue
                row['messages'].append({'role':role, 'timestamp':date(turn.get('startedAt') or thread['createdAt']), 'text':clean(text)})
        rows.append(row)
    assert len({r['id'] for r in rows}) == len(rows)
    old = previous_memories()
    for row in rows:
        previous = set(old.get(row['id'], []))
        for message in row['messages']:
            if message['role'] != 'assistant':
                continue
            for match in re.finditer(r'E:[/\\]+AI[/\\]+Memories[/\\]+[^\r\n' + chr(96) + r'"<>]+?\.md\b', message['text'], re.I):
                candidate = Path(unquote(match[0]).replace('\\', '/'))
                if candidate.is_file() and 'index' not in candidate.name.lower() and candidate.name.lower() not in ('memory.md', 'memory_summary.md', 'readme.md'):
                    previous.add(str(candidate))
        row['previous'] = sorted(previous)
        if row['project'] == 'Tanpa project':
            topic = row['title'] + '\n' + '\n'.join(m['text'][:1500] for m in row['messages'] if m['role']=='user')
            if re.search(r'AoE2? ?II?|Age of Empire|ArunikaAI', topic, re.I):
                row['project'] = 'Age of Empire II DE'
                row['project_attribution'] = 'Topik eksplisit pada chat tanpa project; cwd asli dipertahankan.'
            elif re.search(r'newmg|MG ?Motor', row['title'], re.I):
                row['project'] = 'New MG (chat tanpa project)'
                row['project_attribution'] = 'Topik eksplisit; lokasi laptop dan SSD tidak disamakan.'
        row.setdefault('project_attribution', 'Metadata cwd saat chat.')
        row['action'] = 'pembaruan-memori' if row['previous'] else 'memori-baru-belum-terhubung-ID'
        row['final_count'] = sum(m['role']=='assistant' for m in row['messages'])
        row['user_count'] = sum(m['role']=='user' for m in row['messages'])
        row['evidence_sha256'] = hashlib.sha256(json.dumps(row['messages'], ensure_ascii=False, sort_keys=True).encode()).hexdigest()
    (BASE / 'prepared.json').write_text(json.dumps(rows, ensure_ascii=False, indent=2), encoding='utf-8')
    plan = {'chats':len(rows), 'actions':dict(collections.Counter(r['action'] for r in rows)), 'projects':dict(collections.Counter(r['project'] for r in rows)), 'errors':[(r['id'],r['errors']) for r in rows if r['errors']], 'no_final':[(r['id'],r['title']) for r in rows if not r['final_count']], 'messages':sum(len(r['messages']) for r in rows), 'history_sources':dict(collections.Counter('database-history' if 'thread_items' in r.get('history_source','') else 'rollout-or-cloud' for r in rows)), 'current_chat_excluded':CURRENT}
    (BASE / 'plan.json').write_text(json.dumps(plan, ensure_ascii=False, indent=2), encoding='utf-8')
    review = [{'id':r['id'],'title':r['title'],'project':r['project'],'action':r['action'],'users':r['user_count'],'finals':r['final_count'],'latest':next((m['text'][:1200] for m in reversed(r['messages']) if m['role']=='assistant'),''),'last_request':next((m['text'][:500] for m in reversed(r['messages']) if m['role']=='user'),'')} for r in rows]
    (BASE / 'review.json').write_text(json.dumps(review, ensure_ascii=False, indent=2), encoding='utf-8')
    print(json.dumps(plan, ensure_ascii=False))

