SECRET_LINE = re.compile(r'(?im)^.*\b' + SECRET_LABEL + r'\b\s*[:=]\s*[^\r\n]*$')
SENSITIVE_REQUEST = re.compile(r'(?i)\b(?:password|passwd|kata sandi|credential|kredensial)\b.{0,30}[:=]')
REDACT = '[REDACTED_SECRET]'

def clean(text):
    text = re.sub(r'<oai-mem-citation>.*?</oai-mem-citation>', '', text, flags=re.S)
    text = re.sub(r'-----BEGIN [^-]*PRIVATE KEY-----.*?-----END [^-]*PRIVATE KEY-----', REDACT, text, flags=re.S)
    text = SECRET_LINE.sub(REDACT, text)
    text = re.sub(r'(?i)(\b' + SECRET_LABEL + r'\b\s*(?:[:=]|\badalah\b|\byaitu\b)\s*)(?:[^\s,;]+)', lambda m: m[1] + REDACT, text)
    text = re.sub(r'(?i)(\bBearer\s+)[A-Za-z0-9_.~+/-]{8,}', lambda m: m[1] + REDACT, text)
    text = re.sub(r'\b(?:sk-[A-Za-z0-9_-]{12,}|gh[pousr]_[A-Za-z0-9_]{15,}|github_pat_[A-Za-z0-9_]{15,})\b', REDACT, text)
    text = re.sub(r'\beyJ[A-Za-z0-9_-]{10,}\.[A-Za-z0-9_-]{10,}\.[A-Za-z0-9_-]{10,}\b', REDACT, text)
    text = re.sub(r'(?i)(https?://)[^/\s:@]+:[^/@\s]+@', lambda m: m[1] + REDACT + '@', text)
    text = re.sub(r'(?i)([?&](?:token|key|password|secret|signature|access_token)=)[^&\s)]+', lambda m: m[1] + REDACT, text)
    return text.strip()

def date(value):
    if isinstance(value, (int, float)):
        value = dt.datetime.fromtimestamp(value, TZ)
    elif isinstance(value, str):
        try:
            value = dt.datetime.fromisoformat(value.replace('Z', '+00:00')).astimezone(TZ)
        except ValueError:
            return value
    return value.strftime('%Y-%m-%d %H:%M:%S WIB')

def sha(path):
    return hashlib.sha256(path.read_bytes()).hexdigest()

def write_new(path, body):
    data = body.encode('utf-8')
    if path.exists():
        assert path.read_bytes() == data, 'Refuse to overwrite existing content: ' + str(path)
    else:
        path.parent.mkdir(parents=True, exist_ok=True)
        with path.open('xb') as stream:
            stream.write(data)

def extract_rollout(row):
    path = Path(row['rollout_path'].removeprefix('\\\\?\\'))
    row.update(messages=[], patches=[], errors=[], attachment_count=0)
    if not path.exists():
        row['errors'].append('Rollout lokal tidak ditemukan.')
        return row
    seen = set()
    for n, line in enumerate(path.open(encoding='utf-8'), 1):
        try:
            event = json.loads(line)
        except json.JSONDecodeError:
            row['errors'].append('JSON tidak valid pada baris ' + str(n))
            continue
        payload = event.get('payload', {})
        if event.get('type') == 'response_item' and payload.get('type') == 'message':
            role, channel = payload.get('role'), payload.get('channel')
            if role != 'user' and not (role == 'assistant' and channel == 'final'):
                continue
            content = payload.get('content', [])
            row['attachment_count'] += sum(c.get('type') not in ('input_text', 'output_text', 'text') for c in content if isinstance(c, dict))
            text = '\n'.join(c.get('text', '') for c in content if isinstance(c, dict))
            if role == 'user':
                if '## My request:' in text:
                    text = text.split('## My request:', 1)[1].strip()
                text = re.sub(r'<recommended_plugins>.*?</recommended_plugins>', '', text, flags=re.S).strip()
                if '# AGENTS.md' in text or '<INSTRUCTIONS>' in text or text.lstrip().startswith(('<environment_context>', '<permissions', '<external_codex', '<user_instructions>', '<turn_aborted>')):
                    continue
                if SENSITIVE_REQUEST.search(text):
                    text = '[Pesan pemberian kredensial disembunyikan; tujuan login/verifikasi tetap tercatat pada laporan akhir.]'
            text = clean(text)
            key = (role, text, event.get('timestamp', '')[:19])
            if text and key not in seen:
                row['messages'].append({'role': role, 'timestamp': event.get('timestamp', ''), 'text': text})
                seen.add(key)
        elif event.get('type') == 'event_msg' and payload.get('type') == 'task_complete':
            text = clean(payload.get('last_agent_message', '') or '')
            if text and not any(m['role'] == 'assistant' and m['text'] == text for m in row['messages'][-3:]):
                row['messages'].append({'role': 'assistant', 'timestamp': event.get('timestamp', ''), 'text': text})
        elif event.get('type') == 'response_item' and payload.get('type') in ('function_call', 'custom_tool_call'):
            args = payload.get('arguments', payload.get('input', ''))
            if not isinstance(args, str):
                args = json.dumps(args)
            for match in re.finditer(r'\*\*\* (Update|Add|Delete) File: ([^\r\n";]+)', args.replace('\\n', '\n')):
                row['patches'].append({'operation': match[1], 'path': clean(match[2].strip())})
    row['patches'] = list({(p['operation'], p['path']): p for p in row['patches']}.values())
    return row

def extract(row):
    database = CODEX/'thread_history_1.sqlite'
    conn=sqlite3.connect('file:'+database.as_posix()+'?mode=ro',uri=True)
    conn.execute('pragma temp_store=MEMORY')
    conn.row_factory=sqlite3.Row
    final_ids={r[0] for r in conn.execute('SELECT final_agent_item_id FROM thread_turns WHERE thread_id=?',(row['id'],)) if r[0]}
    items=conn.execute("SELECT item_id,item_type,created_at_ms,item_json FROM thread_items WHERE thread_id=? AND item_type IN ('userMessage','agentMessage','fileChange') ORDER BY rollout_ordinal,created_at_ms",(row['id'],)).fetchall()
    if not items:
        conn.close()
        row['history_source']='Rollout fallback; tidak ada item pada database riwayat.'
        return extract_rollout(row)
    row.update(messages=[],patches=[],errors=[],attachment_count=0,history_source=str(database)+' / thread_items + thread_turns')
    for item_row in items:
        item=json.loads(item_row['item_json'])
        typ=item_row['item_type']
        if typ=='fileChange':
            for change in item.get('changes',[]):
                row['patches'].append({'operation':change.get('kind',{}).get('type','unknown')+' (status '+str(item.get('status','unknown'))+')','path':clean(change.get('path',''))})
            continue
        if typ=='agentMessage':
            if item.get('phase') not in ('final_answer','final') and item_row['item_id'] not in final_ids:
                continue
            role,text='assistant',item.get('text','')
        else:
            role='user'
            content=item.get('content',[])
            row['attachment_count']+=sum(c.get('type')!='text' for c in content if isinstance(c,dict))
            text='\n'.join(c.get('text','') for c in content if isinstance(c,dict))
            if '## My request:' in text:
                text=text.split('## My request:',1)[1].strip()
            elif '## My request for Codex:' in text:
                text=text.split('## My request for Codex:',1)[1].strip()
            text=re.sub(r'<recommended_plugins>.*?</recommended_plugins>','',text,flags=re.S).strip()
            if '# AGENTS.md' in text or '<INSTRUCTIONS>' in text or text.lstrip().startswith(('<environment_context>','<permissions','<external_codex','<user_instructions>','<turn_aborted>')):
                continue
            if SENSITIVE_REQUEST.search(text):
                text='[Pesan pemberian kredensial disembunyikan; tujuan login/verifikasi tetap tercatat pada laporan akhir.]'
        text=clean(text)
        if text:
            row['messages'].append({'role':role,'timestamp':dt.datetime.fromtimestamp(item_row['created_at_ms']/1000,TZ).isoformat(),'text':text})
    row['patches']=list({(p['operation'],p['path']):p for p in row['patches']}.values())
    conn.close()
    return row

def previous_memories():
    result = collections.defaultdict(list)
    paths = list(DESTS[0].glob('*.md')) + list((DESTS[0] / 'rollout_summaries').glob('*.md')) + list((DESTS[0] / 'extensions/ad_hoc/notes').glob('*.md'))
    for path in paths:
        if '.bak' in path.name or path.name.startswith(STAMP) or 'index' in path.name.lower():
            continue
        text = path.read_text(encoding='utf-8-sig', errors='replace')[:3500]
        patterns = [r'(?im)^(?:Chat ID|Thread ID|thread_id|Source thread|Source chat)\s*:\s*.{0,10}?(' + UUID + ')',
                    r'(?im)^-?\s*Chat sumber:.*codex://threads/(' + UUID + ')']
        ids = {m[1] for pattern in patterns for m in re.finditer(pattern, text)}
        for ident in ids:
            result[ident].append(str(path))
    return result

def bullets(lines, limit=20, width=1000):
    lines = list(dict.fromkeys(clean(line).strip(' -*') for line in lines if clean(line).strip(' -*')))
    if not lines:
        return '- Tidak tercatat eksplisit; jangan mengasumsikan telah dilakukan.'
    value = '\n'.join('- ' + line[:width] for line in lines[:limit])
    if len(lines) > limit:
        value += '\n- Rujukan tambahan tersedia di transkrip kronologis.'
    return value

