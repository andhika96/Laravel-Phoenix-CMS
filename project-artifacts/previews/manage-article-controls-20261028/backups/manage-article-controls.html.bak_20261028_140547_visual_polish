  const statusBadge = article => `<span class="ma-status" data-status="${article.status}">${icon(article.status==='publish'?'circle-check':'clock-3')}${labels[article.status]}</span>`;
  const schedule = article => article.scheduled ? `<span class="ma-schedule">${icon('calendar-clock')}Terjadwal</span>` : '';
  const refreshIcons = () => { if (globalThis.lucide) lucide.createIcons({attrs:{width:16,height:16}}); };

  function save() {
    if (!window.openai?.setWidgetState) return;
    const entries = [...states].map(([layout,state])=>({layout,status:state.status,search:state.search,sort:state.sort,expanded:[...state.expanded],selected:[...state.selected]}));
    window.openai.setWidgetState({modelContent:{device:design.device,status:Object.fromEntries(entries.map(item=>[item.layout,item.status]))},privateContent:{entries}}).catch(()=>{});
  }
  function applySaved(snapshot) {
    const model = snapshot?.modelContent || snapshot || {};
    if (['Desktop','Tablet','Mobile'].includes(model.device)) design.device=model.device;
    for (const entry of snapshot?.privateContent?.entries || []) {
      const state=states.get(entry.layout);
      if (!state) continue;
      if (labels[entry.status]) state.status=entry.status;
      state.search=typeof entry.search==='string'?entry.search:'';
      state.sort=['newest','title'].includes(entry.sort)?entry.sort:'newest';
      state.expanded=new Set((entry.expanded||[]).filter(id=>articles.some(a=>a.id===id)));
      state.selected=new Set((entry.selected||[]).filter(id=>articles.some(a=>a.id===id)));
    }
  }
  function renderDevice() {
    for (const stage of states.keys()) {
      const element=root.querySelector(`[data-layout="${stage}"]`);
      element.style.maxWidth=design.device==='Mobile'?'390px':design.device==='Tablet'?'780px':'100%';
      element.dataset.device=design.device;
    }
  }
  function visibleArticles(state) {
    const rows=articles.filter(a=>(state.status==='all'||a.status===state.status)&&a.title.toLocaleLowerCase('id-ID').includes(state.search.toLocaleLowerCase('id-ID'))&&(!state.category||a.category===state.category)&&(!state.scheduled||String(a.scheduled)===state.scheduled));
    return state.sort==='title'?rows.sort((a,b)=>a.title.localeCompare(b.title)):rows;
  }
  function statusOptions(state) {
    return Object.keys(labels).map(code=>`<button type="button" class="ma-status-option cursor-interaction" data-status-choice="${code}" aria-pressed="${state.status===code}"><span class="ma-option-check">${state.status===code?icon('check'):''}</span><span>${labels[code]}</span><span class="ma-count">${num(counts[code])}</span></button>`).join('');
  }
  function makeRow(article,state,layout) {
    const expanded=state.expanded.has(article.id), selected=state.selected.has(article.id), detailId=`ma-${layout}-detail-${article.id}`;
    return `<tr data-row="${article.id}" class="${expanded?'ma-expanded':''} ${selected?'ma-selected':''}">
      <td class="ma-detail-col"><button type="button" class="ma-detail-button cursor-interaction" data-detail="${article.id}" aria-expanded="${expanded}" aria-controls="${detailId}" aria-label="${expanded?'Tutup':'Buka'} detail ${esc(article.title)}">${icon(expanded?'chevron-down':'chevron-right')}</button></td>
      <td class="ma-check-col"><label class="ma-check-target cursor-interaction"><input type="checkbox" data-check="${article.id}" ${selected?'checked':''} aria-label="Pilih ${esc(article.title)}"></label></td>
      <td class="ma-title-col"><button type="button" class="ma-article-title cursor-interaction" data-detail="${article.id}">${esc(article.title)}</button><span class="ma-meta">${esc(article.category)}<span class="ma-author-inline"> · Administrator</span></span><div class="ma-inline-state">${statusBadge(article)}${schedule(article)}<span class="ma-meta">${article.date}</span></div></td>
      <td class="ma-author-col">Administrator</td><td class="ma-state-col">${statusBadge(article)}${schedule(article)}</td>
      <td class="ma-date-col">${article.date}<span class="ma-meta">15:42 WIB</span></td>
      <td class="ma-action-col"><div class="ma-row-actions"><button type="button" class="ma-row-menu cursor-interaction" data-options="${article.id}" aria-expanded="false" aria-label="Opsi ${esc(article.title)}">${icon('ellipsis')}</button><div class="ma-popover" data-row-popover="${article.id}" hidden><button type="button" class="cursor-interaction" data-demo="Edit artikel">Edit artikel</button><button type="button" class="cursor-interaction" data-demo="Lihat artikel">Lihat artikel</button></div></div></td>
    </tr><tr class="ma-detail-row" id="${detailId}" ${expanded?'':'hidden'}><td colspan="7"><section class="ma-detail" aria-label="Detail ${esc(article.title)}"><div><span class="ma-detail-label">Ringkasan artikel</span><p>${esc(article.excerpt)}</p><span class="ma-detail-label">Alamat artikel</span><span class="ma-detail-url">/article/${article.id===1?'load-test-science-performance-insight-00004':`artikel-contoh-${article.id}`}</span></div><dl><div><dt>Status publikasi</dt><dd>${statusBadge(article)}</dd></div><div><dt>Penjadwalan</dt><dd>${article.scheduled?'Terjadwal':'Tanpa jadwal'}</dd></div><div><dt>Author</dt><dd>Administrator</dd></div><div><dt>Category</dt><dd>${esc(article.category)}</dd></div></dl></section></td></tr>`;
  }
  function build(stage) {
    const layout=stage.dataset.layout, state=states.get(layout);
    stage.innerHTML=`<div class="ma-app">
      <aside class="ma-nav" aria-label="Navigasi CMS"><div class="ma-identity"><span class="ma-logo">${icon('flame')}</span>Administrator</div><div class="ma-nav-list"><span class="ma-nav-item">${icon('house')}Dashboard</span><span class="ma-nav-item">${icon('external-link')}View site</span><span class="ma-nav-item" aria-current="page">${icon('newspaper')}Manage Articles</span><span class="ma-nav-item">${icon('image')}Cover Image</span><span class="ma-nav-item">${icon('calendar-days')}Manage Event</span></div><div class="ma-nav-list ma-nav-end"><span class="ma-nav-item">${icon('shield-check')}Awesome Admin</span><span class="ma-nav-item">${icon('settings')}Settings</span></div></aside>
      <main class="ma-page"><div class="ma-mobile-chrome">${icon('panel-left')}Phoenix CMS<span class="ma-user">Administrator</span></div><header class="ma-heading"><div><h2>Manage Article</h2><p>Ruang kerja untuk cerita dan ide tim Anda.</p></div><div class="ma-header-actions"><button type="button" class="ma-button ma-primary cursor-interaction" data-demo="Add Post">${icon('plus')}Add Post</button><button type="button" class="ma-button ma-icon-button cursor-interaction" aria-label="Menu pengelolaan artikel" data-demo="Pengelolaan kategori dan template">${icon('ellipsis')}</button></div></header>
        <div class="ma-layout">${layout==='rail'?`<aside class="ma-status-rail" aria-label="Filter status artikel"><span class="ma-rail-label">Publikasi</span>${Object.keys(labels).map(code=>`<button type="button" class="cursor-interaction" data-status-choice="${code}" aria-pressed="${state.status===code}"><span>${labels[code]}</span><span class="ma-count">${num(counts[code])}</span></button>`).join('')}</aside>`:''}
          <section class="ma-board" aria-label="Daftar artikel"><div class="ma-toolbar">${layout==='toolbar'?`<div class="ma-status-wrap"><button type="button" class="ma-button ma-status-trigger cursor-interaction" data-status-menu aria-expanded="false" aria-controls="ma-${layout}-status-menu"><span class="ma-status-name"><span data-active-status>${labels[state.status]}</span><span class="ma-count" data-active-count>${num(counts[state.status])}</span></span>${icon('chevron-down')}</button><div id="ma-${layout}-status-menu" class="ma-status-menu" hidden><div class="ma-menu-heading">Status publikasi</div><div data-status-options>${statusOptions(state)}</div></div></div>`:''}
            <label class="ma-search">${icon('search')}<span class="ma-sr">Cari judul artikel</span><input type="search" placeholder="Cari judul artikel…" data-search></label><button type="button" class="ma-button ma-filter-button cursor-interaction" data-filter-toggle aria-expanded="false" aria-controls="ma-${layout}-filters" aria-label="Filter kategori dan jadwal">${icon('sliders-horizontal')}<span class="ma-filter-label">Filter</span></button><select class="ma-sort cursor-interaction" data-sort aria-label="Urutkan artikel"><option value="newest">Terbaru</option><option value="title">Judul A–Z</option></select>
          </div><div class="ma-filters" id="ma-${layout}-filters" hidden><label class="ma-field">Kategori<select data-category><option value="">Semua kategori</option>${[...new Set(articles.map(a=>a.category))].map(c=>`<option>${esc(c)}</option>`).join('')}</select></label><label class="ma-field">Penjadwalan<select data-schedule><option value="">Semua jadwal</option><option value="true">Terjadwal</option><option value="false">Tanpa jadwal</option></select></label><button type="button" class="ma-button cursor-interaction" data-reset>Reset</button></div>
          <div class="ma-results"><span class="ma-result-label"><strong data-result-status>${labels[state.status]==='All'?'Semua artikel':labels[state.status]}</strong><span data-result-total>${num(counts[state.status])} artikel</span></span><label class="ma-select-all-mobile cursor-interaction"><input type="checkbox" data-all aria-label="Pilih semua artikel contoh"><span>Pilih semua</span></label></div><div class="ma-bulk" hidden><span data-selected-count aria-live="polite"></span><button type="button" class="ma-link-button cursor-interaction" data-clear-selection>Batalkan pilihan</button></div><div class="ma-notice" role="status" hidden></div>
          <table class="ma-table"><caption class="ma-sr">Buka detail, pilih artikel, lalu judul artikel.</caption><thead><tr><th class="ma-detail-col"><span class="ma-sr">Detail</span></th><th class="ma-check-col"><label class="ma-check-target cursor-interaction"><input type="checkbox" data-all aria-label="Pilih semua artikel contoh"></label></th><th>Title</th><th class="ma-author-col">Author</th><th class="ma-state-col">Status</th><th class="ma-date-col">Date</th><th class="ma-action-col"><span class="ma-sr">Opsi</span></th></tr></thead><tbody></tbody></table><div class="ma-empty" hidden><strong>Artikel tidak ditemukan</strong><p>Ubah pencarian atau pilih status lain.</p><button type="button" class="ma-button cursor-interaction" data-reset>Reset filter</button></div><footer class="ma-footer"><span data-footer-count></span><div class="ma-pagination" aria-label="Halaman artikel contoh"><button type="button" class="cursor-interaction" data-page="1" aria-label="Halaman contoh 1" aria-current="page">1</button><button type="button" class="cursor-interaction" data-page="2" aria-label="Halaman contoh 2">2</button></div></footer>
        </section></div></main></div>`;
    stage.querySelector('[data-search]').value=state.search;
    stage.querySelector('[data-sort]').value=state.sort;
    updateRows(stage);
    stage.addEventListener('click',event=>handleClick(event,stage));
    stage.addEventListener('input',event=>{if(event.target.matches('[data-search]')){state.search=event.target.value;state.page=1;state.selected.clear();updateRows(stage);save();}});
    stage.addEventListener('change',event=>{
      const target=event.target;
      if(target.matches('[data-check]')) {const id=Number(target.dataset.check);target.checked?state.selected.add(id):state.selected.delete(id);updateSelection(stage);save();}
      if(target.matches('[data-all]')) {const current=visibleArticles(state).slice((state.page-1)*5,state.page*5);current.forEach(a=>target.checked?state.selected.add(a.id):state.selected.delete(a.id));updateSelection(stage);save();}
      if(target.matches('[data-sort],[data-category],[data-schedule]')) {state.sort=stage.querySelector('[data-sort]').value;state.category=stage.querySelector('[data-category]').value;state.scheduled=stage.querySelector('[data-schedule]').value;state.page=1;state.selected.clear();updateRows(stage);save();}
    });
    stage.addEventListener('keydown',event=>{if(event.key==='Escape'){stage.querySelector('.ma-status-menu')?.setAttribute('hidden','');stage.querySelector('[data-status-menu]')?.setAttribute('aria-expanded','false');stage.querySelectorAll('[data-row-popover]').forEach(el=>el.hidden=true);stage.querySelectorAll('[data-options]').forEach(el=>el.setAttribute('aria-expanded','false'));}});
  }
  function updateRows(stage) {
    const layout=stage.dataset.layout,state=states.get(layout),all=visibleArticles(state),rows=all.slice((state.page-1)*5,state.page*5);
    stage.querySelector('tbody').innerHTML=rows.map(a=>makeRow(a,state,layout)).join('');
    stage.querySelector('.ma-table').hidden=!rows.length;
    stage.querySelector('.ma-empty').hidden=!!rows.length;
    stage.querySelector('[data-footer-count]').textContent=rows.length?`${(state.page-1)*5+1}–${(state.page-1)*5+rows.length} dari ${all.length} artikel contoh`:'0 artikel contoh';
    stage.querySelectorAll('[data-page]').forEach(button=>{const page=Number(button.dataset.page);button.hidden=page>Math.ceil(all.length/5);state.page===page?button.setAttribute('aria-current','page'):button.removeAttribute('aria-current');});
    stage.querySelector('[data-active-status]')?.replaceChildren(labels[state.status]);
    stage.querySelector('[data-active-count]')?.replaceChildren(num(counts[state.status]));
    if(stage.querySelector('[data-status-options]')) stage.querySelector('[data-status-options]').innerHTML=statusOptions(state);
    stage.querySelectorAll('.ma-status-rail [data-status-choice]').forEach(button=>button.setAttribute('aria-pressed',String(button.dataset.statusChoice===state.status)));
    stage.querySelector('[data-result-status]').textContent=state.status==='all'?'Semua artikel':labels[state.status];
    stage.querySelector('[data-result-total]').textContent=`${num(counts[state.status])} artikel`;
    updateSelection(stage);syncColumns(stage);refreshIcons();
  }
  function syncColumns(stage) {
    const row=stage.querySelector('tr[data-row]');
    if (!row) return;
    const count=[...row.cells].filter(cell=>getComputedStyle(cell).display!=='none').length;
    stage.querySelectorAll('.ma-detail-row > td').forEach(cell=>cell.colSpan=count);
  }
  function updateSelection(stage) {
    const state=states.get(stage.dataset.layout),current=visibleArticles(state).slice((state.page-1)*5,state.page*5),selected=current.filter(a=>state.selected.has(a.id)).length;
    stage.querySelectorAll('[data-all]').forEach(input=>{input.checked=!!current.length&&selected===current.length;input.indeterminate=selected>0&&selected<current.length;});
    stage.querySelectorAll('tr[data-row]').forEach(row=>{const checked=state.selected.has(Number(row.dataset.row));row.classList.toggle('ma-selected',checked);row.querySelector('[data-check]').checked=checked;});
    stage.querySelector('.ma-bulk').hidden=!selected;
    stage.querySelector('[data-selected-count]').textContent=`${selected} artikel dipilih`;
  }
  function handleClick(event,stage) {
    const state=states.get(stage.dataset.layout),button=event.target.closest('button');
    if(!button) return;
    if(button.hasAttribute('data-status-menu')) {const menu=stage.querySelector('.ma-status-menu');menu.hidden=!menu.hidden;button.setAttribute('aria-expanded',String(!menu.hidden));}
    if(button.dataset.statusChoice) {state.status=button.dataset.statusChoice;state.page=1;state.selected.clear();stage.querySelector('.ma-status-menu')?.setAttribute('hidden','');stage.querySelector('[data-status-menu]')?.setAttribute('aria-expanded','false');updateRows(stage);stage.querySelector('[data-status-menu]')?.focus();save();}
    if(button.dataset.detail) {const id=Number(button.dataset.detail),expanded=!state.expanded.has(id);expanded?state.expanded.add(id):state.expanded.delete(id);stage.querySelector(`tr[data-row="${id}"]`).classList.toggle('ma-expanded',expanded);const trigger=stage.querySelector(`tr[data-row="${id}"] .ma-detail-button`);trigger.setAttribute('aria-expanded',String(expanded));trigger.setAttribute('aria-label',`${expanded?'Tutup':'Buka'} detail ${articles.find(a=>a.id===id).title}`);trigger.innerHTML=icon(expanded?'chevron-down':'chevron-right');stage.querySelector(`#ma-${stage.dataset.layout}-detail-${id}`).hidden=!expanded;refreshIcons();save();}
    if(button.hasAttribute('data-filter-toggle')) {const panel=stage.querySelector('.ma-filters');panel.hidden=!panel.hidden;button.setAttribute('aria-expanded',String(!panel.hidden));}
    if(button.hasAttribute('data-reset')) {Object.assign(state,{status:'all',search:'',category:'',scheduled:'',page:1});state.selected.clear();stage.querySelector('[data-search]').value='';stage.querySelector('[data-category]').value='';stage.querySelector('[data-schedule]').value='';updateRows(stage);save();}
    if(button.hasAttribute('data-clear-selection')) {state.selected.clear();updateSelection(stage);save();}
    if(button.dataset.page) {state.page=Number(button.dataset.page);state.selected.clear();updateRows(stage);save();}
    if(button.dataset.options) {const popover=stage.querySelector(`[data-row-popover="${button.dataset.options}"]`);popover.hidden=!popover.hidden;button.setAttribute('aria-expanded',String(!popover.hidden));}
    if(button.dataset.demo) {const notice=stage.querySelector('.ma-notice');notice.hidden=false;notice.textContent=`${button.dataset.demo} · hanya simulasi preview`;stage.querySelectorAll('[data-row-popover]').forEach(el=>el.hidden=true);stage.querySelectorAll('[data-options]').forEach(el=>el.setAttribute('aria-expanded','false'));}
  }
  root.querySelectorAll('.ma-stage').forEach(stage=>states.set(stage.dataset.layout,{status:'all',search:'',sort:'newest',category:'',scheduled:'',page:1,expanded:new Set([1]),selected:new Set()}));
  applySaved(window.openai?.widgetState);
  root.querySelectorAll('.ma-stage').forEach(build);
  const resize=new ResizeObserver(entries=>entries.forEach(entry=>syncColumns(entry.target.closest('.ma-stage'))));
  root.querySelectorAll('.ma-board').forEach(board=>resize.observe(board));
  renderDevice();refreshIcons();
  if(globalThis.Tweak) {const tweak=new Tweak({container:root,onChange:()=>{renderDevice();save();}});tweak.addSelect(design,'device',{label:'Perangkat',options:['Desktop','Tablet','Mobile']});}
  window.addEventListener('openai:set_globals',event=>{if(event.detail?.globals?.widgetState){applySaved(event.detail.globals.widgetState);renderDevice();root.querySelectorAll('.ma-stage').forEach(stage=>{const state=states.get(stage.dataset.layout);stage.querySelector('[data-search]').value=state.search;stage.querySelector('[data-sort]').value=state.sort;updateRows(stage);});}});
})();
</script>
