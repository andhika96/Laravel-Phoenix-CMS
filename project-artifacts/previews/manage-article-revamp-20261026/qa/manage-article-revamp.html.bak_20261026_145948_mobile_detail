    [8,'Kolaborasi lintas tim, dari ide menjadi cerita','Berita','Nadia Putri','pending',false,'2026-10-19T08:00:00','Bagaimana tim merangkum pekerjaan menjadi cerita yang mudah dipahami.'],
    [9,'Mengenal pengaturan kategori artikel','Panduan','Administrator','publish',false,'2026-10-18T15:30:00','Gunakan kategori untuk membuat susunan konten yang jelas.'],
    [10,'Catatan pengembangan fitur berikutnya','Teknologi','Raka Pratama','draft',true,'2026-10-17T11:10:00','Catatan editorial untuk pembaruan fitur yang sedang dipersiapkan.'],
    [11,'Desain yang membantu pekerjaan terasa ringan','Desain','Nadia Putri','publish',false,'2026-10-16T09:00:00','Pilihan desain kecil yang mempermudah pekerjaan sehari-hari.'],
    [12,'Menyusun kalender konten yang realistis','Panduan','Administrator','pending',true,'2026-10-15T14:30:00','Merencanakan jadwal penerbitan bersama tim editorial.']
  ].map(([id,title,category,author,status,scheduled,date,excerpt]) => ({id,title,category,author,status,scheduled,date,excerpt}));
  const formatDate = value => new Intl.DateTimeFormat('id-ID',{day:'2-digit',month:'short',year:'numeric',timeZone:'Asia/Jakarta'}).format(new Date(value+'+07:00'));
  const formatTime = value => value.slice(11,16).replace(':','.');
  const slug = row => row.title.toLowerCase().replace(/[^a-z0-9]+/g,'-').replace(/^-|-$/g,'');
  const preview = { device: 'Otomatis', density: 'Nyaman' };
  const instances = [];
  const saved = window.openai?.widgetState;
  const restored = saved?.privateContent || saved?.modelContent || {};
  if (['Otomatis','Tablet','Ponsel'].includes(restored.device)) preview.device = restored.device;
  if (['Nyaman','Rapat'].includes(restored.density)) preview.density = restored.density;

  function save() {
    const views=instances.map(({state})=>({search:state.search,status:state.status,category:state.category,scheduled:state.scheduled,sort:state.sort,page:state.page,size:state.size}));
    const modelContent = { device: preview.device, density: preview.density, konsep: 'Tabel detail adaptif', filter: views[0] || null };
    window.openai?.setWidgetState?.({modelContent,privateContent:{...preview,views}})?.catch(() => {});
  }
  function appearance(persist = false) {
    root.querySelectorAll('.ar-viewport').forEach(el => {
      el.style.maxWidth = preview.device === 'Ponsel' ? '390px' : preview.device === 'Tablet' ? '768px' : '100%';
      el.style.setProperty('--ar-pad', preview.density === 'Rapat' ? '10px' : '16px');
    });
    if (persist) save();
  }
  const statusBadge = row => `<span class="ar-status" data-status="${row.status}">${icon(row.status === 'publish' ? 'circle-check' : row.status === 'pending' ? 'clock-3' : 'file-pen-line')}${statusNames[row.status]}</span>`;
  const scheduleBadge = row => row.scheduled ? `<span class="ar-schedule">${icon('calendar-clock')}Terjadwal</span>` : '';
  function details(row) {
    return `<section class="ar-expanded" aria-label="Detail artikel ${safe(row.title)}"><p class="ar-detail-heading">Detail artikel<span>#${String(row.id).padStart(4,'0')}</span></p><div class="ar-detail-body"><div class="ar-summary"><h3>Ringkasan</h3><p>${safe(row.excerpt)}</p><h3>Alamat artikel</h3><p class="ar-slug">/${safe(slug(row))}</p></div><dl class="ar-detail-list"><div><dt>Status publikasi</dt><dd>${statusBadge(row)}</dd></div><div><dt>Penjadwalan</dt><dd>${row.scheduled ? 'Terjadwal' : 'Tanpa jadwal'}</dd></div><div><dt>Penulis</dt><dd>${safe(row.author)}</dd></div><div><dt>Kategori</dt><dd>${safe(row.category)}</dd></div><div class="ar-detail-wide"><dt>Tanggal dibuat</dt><dd>${formatDate(row.date)}, ${formatTime(row.date)} WIB</dd></div></dl></div></section>`;
  }

  for (const [index, el] of [...root.querySelectorAll('.ar-viewport')].entries()) {
    const id = `ar-concept-${index}`;
    const state = { rows: seed.map(row=>({...row})), search:'', status:'all', category:'all', scheduled:'all', sort:'newest', page:1, size:5, selected:new Set(), expanded:new Set([1]), bulk:'', confirm:false };
    const priorView=restored.views?.[index];
    if(priorView){
      if(typeof priorView.search==='string')state.search=priorView.search.slice(0,200);
      if(['all','publish','draft','pending'].includes(priorView.status))state.status=priorView.status;
      if(['all','Berita','Desain','Panduan','Teknologi'].includes(priorView.category))state.category=priorView.category;
      if(['all','yes','no'].includes(priorView.scheduled))state.scheduled=priorView.scheduled;
      if(['newest','oldest','title-asc','title-desc'].includes(priorView.sort))state.sort=priorView.sort;
      if([5,10,15].includes(priorView.size))state.size=priorView.size;
      if(Number.isInteger(priorView.page)&&priorView.page>0)state.page=priorView.page;
    }
    el.innerHTML = `
      <div class="ar-app">
        <aside class="ar-sidebar" aria-label="Navigasi CMS">
          <div class="ar-identity"><span class="ar-avatar">AA</span><span class="ar-brand">Administrator<small>Phoenix CMS</small></span></div>
          <nav class="ar-nav"><span class="ar-nav-item">${icon('layout-dashboard')}<span class="ar-nav-text">Dashboard</span></span><span class="ar-nav-item">${icon('external-link')}<span class="ar-nav-text">View site</span></span><span class="ar-nav-item" aria-current="page">${icon('newspaper')}<span class="ar-nav-text">Manage Articles</span></span><span class="ar-nav-item">${icon('image')}<span class="ar-nav-text">Cover Image</span></span><span class="ar-nav-item">${icon('calendar-days')}<span class="ar-nav-text">Manage Event</span></span></nav>
          <div class="ar-nav ar-nav-bottom"><span class="ar-nav-item">${icon('shield-user')}<span class="ar-nav-text">Awesome Admin</span></span><span class="ar-nav-item">${icon('settings-2')}<span class="ar-nav-text">Settings</span></span></div>
        </aside>
        <main class="ar-main">
          <div class="ar-mobile-top"><button type="button" class="ar-button ar-icon-button ar-button-quiet cursor-interaction" data-demo="Navigasi CMS" aria-label="Buka navigasi">${icon('panel-left')}</button><span>Phoenix CMS</span><span class="ar-avatar">AA</span></div>
          <header class="ar-pagehead"><div class="ar-heading"><h2>Manage Article</h2><p>Ruang kerja untuk cerita dan ide tim Anda.</p></div><div class="ar-head-actions"><button type="button" class="ar-button ar-button-primary cursor-interaction" data-demo="Add Post">${icon('plus')}Add Post</button><details class="ar-overflow"><summary class="ar-button ar-icon-button cursor-interaction" aria-label="Menu pengelolaan artikel">${icon('ellipsis')}</summary><div class="ar-menu"><button type="button" class="ar-button cursor-interaction" data-demo="Article Templates">${icon('layers')}Article Templates</button><button type="button" class="ar-button cursor-interaction" data-demo="Category List">${icon('folder-open')}Category List</button></div></details></div></header>
          <span class="ar-demo-label">${icon('flask-conical')}Preview desain · 12 artikel contoh</span>
          <section class="ar-board" aria-label="Daftar artikel">
            <div class="ar-tabs" role="group" aria-label="Filter status publikasi"></div>
            <div class="ar-toolbar"><label class="ar-search">${icon('search')}<span class="ar-visually-hidden">Cari judul artikel</span><input type="search" class="ar-field" data-field="search" placeholder="Cari judul artikel..." autocomplete="off"></label><button type="button" class="ar-button cursor-interaction" data-action="filters" aria-expanded="false" aria-controls="${id}-filters">${icon('sliders-horizontal')}Filter<span data-filter-count></span></button><label class="ar-sort-control"><span class="ar-visually-hidden">Urutkan artikel</span><select class="ar-field" data-field="sort" aria-label="Urutkan artikel"><option value="newest">Terbaru dahulu</option><option value="oldest">Terlama dahulu</option><option value="title-asc">Judul A–Z</option><option value="title-desc">Judul Z–A</option></select></label></div>
            <div class="ar-filter-grid" id="${id}-filters" hidden><label class="ar-label">Kategori<select class="ar-field" data-field="category"><option value="all">Semua kategori</option><option>Berita</option><option>Desain</option><option>Panduan</option><option>Teknologi</option></select></label><label class="ar-label">Penjadwalan<select class="ar-field" data-field="scheduled"><option value="all">Semua jadwal</option><option value="yes">Terjadwal</option><option value="no">Tanpa jadwal</option></select></label><button type="button" class="ar-button ar-button-quiet cursor-interaction" data-action="reset">Hapus filter</button></div>
            <div class="ar-filter-chips" hidden></div>
            <div class="ar-bulk" hidden><span class="ar-bulk-label"></span><button type="button" class="ar-button ar-button-quiet cursor-interaction" data-action="clear-selection" aria-label="Batalkan pilihan artikel">Batal</button><label><span class="ar-visually-hidden">Ubah status artikel terpilih</span><select class="ar-field" data-field="bulk"><option value="">Ubah status...</option><option value="publish">Publish</option><option value="draft">Draft</option><option value="pending">Pending</option></select></label><button type="button" class="ar-button ar-button-primary cursor-interaction" data-action="apply" disabled>Terapkan</button></div>
            <div class="ar-confirm" hidden role="group" aria-label="Konfirmasi perubahan status contoh"><p></p><button type="button" class="ar-button cursor-interaction" data-action="cancel-confirm">Batal</button><button type="button" class="ar-button ar-button-primary cursor-interaction" data-action="confirm">Ya, ubah</button></div>
            <div class="ar-table-region"><table class="ar-table"><caption class="ar-visually-hidden">Artikel contoh. Kolom pertama membuka detail, kolom kedua memilih artikel.</caption><thead><tr><th class="ar-col-expand" scope="col"><span class="ar-visually-hidden">Detail</span></th><th class="ar-col-check" scope="col"><label class="ar-check-target"><input class="ar-check" type="checkbox" data-all aria-label="Pilih semua artikel di halaman ini"></label></th><th scope="col" data-title-sort aria-sort="none"><button type="button" class="ar-sort-button cursor-interaction" data-action="sort-title">Artikel ${icon('arrow-down-up')}</button></th><th class="ar-col-author" scope="col">Penulis</th><th class="ar-col-status" scope="col">Status</th><th class="ar-col-date" scope="col" data-date-sort aria-sort="descending"><button type="button" class="ar-sort-button cursor-interaction" data-action="sort-date">Tanggal ${icon('arrow-down')}</button></th><th class="ar-col-actions" scope="col">Aksi</th></tr></thead><tbody></tbody></table></div>
            <div class="ar-empty" hidden><h3>Artikel tidak ditemukan</h3><p>Coba kata kunci lain atau hapus filter aktif.</p><button type="button" class="ar-button cursor-interaction" data-action="reset">Hapus pencarian & filter</button></div>
            <footer class="ar-footer"><label class="ar-page-size"><span data-range></span><span><select class="ar-field" data-field="size" aria-label="Artikel per halaman"><option value="5">5</option><option value="10">10</option><option value="15">15</option></select> / halaman</span></label><nav class="ar-pagination" aria-label="Halaman artikel"></nav></footer>
          </section>
          <div class="ar-feedback" role="status" aria-live="polite" hidden></div>
          <span class="ar-visually-hidden" data-live role="status" aria-live="polite" aria-atomic="true"></span>
        </main>
      </div>`;
    function filtered() {
      return state.rows.filter(row => (state.status==='all'||row.status===state.status) && (state.category==='all'||row.category===state.category) && (state.scheduled==='all'||row.scheduled===(state.scheduled==='yes')) && row.title.toLocaleLowerCase('id').includes(state.search.toLocaleLowerCase('id'))).sort((a,b) => state.sort.startsWith('title') ? (state.sort==='title-asc'?1:-1)*a.title.localeCompare(b.title,'id') : (state.sort==='newest'?-1:1)*a.date.localeCompare(b.date));
    }
    function pageRows() { return filtered().slice((state.page-1)*state.size,state.page*state.size); }
    function notice(text) { const box=el.querySelector('.ar-feedback'); box.textContent=text; box.hidden=false; }
    function selection() {
      const rows=pageRows();
      el.querySelectorAll('[data-all]').forEach(input => { input.checked=rows.length>0&&rows.every(row=>state.selected.has(row.id)); input.indeterminate=rows.some(row=>state.selected.has(row.id))&&!input.checked; input.disabled=rows.length===0; });
      el.querySelectorAll('[data-select]').forEach(input=>input.checked=state.selected.has(Number(input.dataset.select)));
      el.querySelectorAll('[data-row]').forEach(row=>row.classList.toggle('ar-selected',state.selected.has(Number(row.dataset.row))));
      el.querySelector('.ar-bulk').hidden=state.selected.size===0;
      el.querySelector('.ar-bulk-label').textContent=`${state.selected.size} artikel dipilih · halaman ini`;
      el.querySelector('[data-action="apply"]').disabled=!state.bulk||!state.selected.size;
      el.querySelector('.ar-confirm').hidden=!state.confirm;
      el.querySelector('.ar-confirm p').textContent=`Ubah ${state.selected.size} artikel contoh menjadi ${statusNames[state.bulk]||''}?`;
    }
    function syncColumns() {
      const visible=[...el.querySelectorAll('thead th')].filter(th=>getComputedStyle(th).display!=='none').length;
      el.querySelectorAll('.ar-detail-cell').forEach(cell=>{cell.colSpan=visible;});
    }
    function render(announce=true) {
      const items=filtered();
      const pages=Math.max(1,Math.ceil(items.length/state.size));
      state.page=Math.min(state.page,pages);
      el.querySelector('.ar-tabs').innerHTML=[['all','Semua'],...Object.entries(statusNames)].map(([key,label])=>`<button type="button" class="ar-tab cursor-interaction" data-status="${key}" aria-pressed="${state.status===key}">${label}<span class="ar-count">${key==='all'?state.rows.length:state.rows.filter(row=>row.status===key).length}</span></button>`).join('');
      const rows=pageRows();
      el.querySelector('tbody').innerHTML=rows.map(row=>`<tr data-row="${row.id}" class="${state.expanded.has(row.id)?'ar-expanded-row':''}"><td class="ar-col-expand"><button type="button" class="ar-button ar-expand-button cursor-interaction" data-detail="${row.id}" aria-label="${state.expanded.has(row.id)?'Tutup':'Buka'} detail ${safe(row.title)}" aria-expanded="${state.expanded.has(row.id)}" aria-controls="${id}-detail-${row.id}">${icon(state.expanded.has(row.id)?'chevron-down':'chevron-right')}</button></td><td class="ar-col-check"><label class="ar-check-target"><input type="checkbox" class="ar-check" data-select="${row.id}" aria-label="Pilih ${safe(row.title)}"></label></td><td><button type="button" class="ar-title-button cursor-interaction" data-edit="${row.id}">${safe(row.title)}</button><div class="ar-subline">${safe(row.category)}<span class="ar-author-inline"> · ${safe(row.author)}</span></div><div class="ar-mobile-meta">${statusBadge(row)}${scheduleBadge(row)}</div></td><td class="ar-col-author">${safe(row.author)}</td><td class="ar-col-status">${statusBadge(row)}${scheduleBadge(row)}</td><td class="ar-col-date">${formatDate(row.date)}<div class="ar-subline">${formatTime(row.date)} WIB</div></td><td class="ar-col-actions"><div class="ar-row-actions"><button type="button" class="ar-button ar-button-quiet cursor-interaction" data-edit="${row.id}">Edit</button><details class="ar-overflow"><summary class="ar-button ar-icon-button ar-button-quiet cursor-interaction" aria-label="Aksi untuk ${safe(row.title)}">${icon('ellipsis')}</summary><div class="ar-menu"><button type="button" class="ar-button cursor-interaction" data-demo="Lihat artikel: ${safe(row.title)}">${icon('external-link')}Lihat artikel</button><button type="button" class="ar-button ar-button-danger cursor-interaction" data-delete="${row.id}">${icon('trash-2')}Hapus artikel</button></div></details></div></td></tr><tr id="${id}-detail-${row.id}" ${state.expanded.has(row.id)?'':'hidden'}><td colspan="7" class="ar-detail-cell">${details(row)}</td></tr>`).join('');
      const empty=!items.length;
      el.querySelector('.ar-empty').hidden=!empty;
      el.querySelector('.ar-table').hidden=empty;
      el.querySelector('[data-range]').textContent=empty?'0 artikel':`${(state.page-1)*state.size+1}–${Math.min(state.page*state.size,items.length)} dari ${items.length} artikel`;
      el.querySelector('.ar-pagination').innerHTML=`<button type="button" class="ar-button cursor-interaction" data-page="${state.page-1}" aria-label="Halaman sebelumnya" ${state.page===1?'disabled':''}>${icon('chevron-left')}</button>${Array.from({length:pages},(_,i)=>`<button type="button" class="ar-button cursor-interaction" data-page="${i+1}" ${state.page===i+1?'aria-current="page"':''}>${i+1}</button>`).join('')}<button type="button" class="ar-button cursor-interaction" data-page="${state.page+1}" aria-label="Halaman berikutnya" ${state.page===pages?'disabled':''}>${icon('chevron-right')}</button>`;
      el.querySelector('[data-title-sort]').setAttribute('aria-sort',state.sort==='title-asc'?'ascending':state.sort==='title-desc'?'descending':'none');
      el.querySelector('[data-date-sort]').setAttribute('aria-sort',state.sort==='newest'?'descending':state.sort==='oldest'?'ascending':'none');
      el.querySelector('[data-field="sort"]').value=state.sort;
      const chips=[];
      if(state.category!=='all')chips.push([state.category,'category']);
      if(state.scheduled!=='all')chips.push([state.scheduled==='yes'?'Terjadwal':'Tanpa jadwal','scheduled']);
      const chipBox=el.querySelector('.ar-filter-chips');
      chipBox.hidden=!chips.length;
      chipBox.innerHTML=chips.map(([label,key])=>`<button type="button" class="ar-button cursor-interaction" data-clear="${key}" aria-label="Hapus filter ${safe(label)}">${safe(label)} ${icon('x')}</button>`).join('');
      el.querySelector('[data-filter-count]').textContent=chips.length?`(${chips.length})`:'';
      syncColumns();
      selection();
      if(announce) { el.querySelector('[data-live]').textContent=`${items.length} artikel contoh, halaman ${state.page} dari ${pages}.`; save(); }
      globalThis.lucide?.createIcons({attrs:{width:16,height:16}});
    }
    function resetScope() { state.page=1; state.selected.clear(); state.expanded.clear(); state.confirm=false; }
    el.addEventListener('input', event => {
      if(event.target.dataset.field!=='search')return;
      state.search=event.target.value.trim(); resetScope(); render();
    });
    el.addEventListener('change',event=>{
      const field=event.target.dataset.field;
      if(field==='bulk'){state.bulk=event.target.value;state.confirm=false;selection();return;}
      if(['category','scheduled','sort','size'].includes(field)) {state[field]=field==='size'?Number(event.target.value):event.target.value;resetScope();render();return;}
      if(event.target.matches('[data-all]')) {state.selected=new Set(event.target.checked?pageRows().map(row=>row.id):[]);state.confirm=false;selection();el.querySelector('[data-live]').textContent=`${state.selected.size} artikel dipilih.`;}
      if(event.target.dataset.select) {const n=Number(event.target.dataset.select);event.target.checked?state.selected.add(n):state.selected.delete(n);state.confirm=false;selection();el.querySelector('[data-live]').textContent=`${state.selected.size} artikel dipilih.`;}
    });
    el.addEventListener('click',event=>{
      const button=event.target.closest('button');
      if(!button)return;
      if(button.dataset.demo){notice(`Simulasi ${button.dataset.demo}. Preview ini tidak terhubung ke CMS.`);button.closest('details')?.removeAttribute('open');return;}
      if(button.dataset.status){state.status=button.dataset.status;resetScope();render();el.querySelector(`[data-status="${state.status}"]`)?.focus({preventScroll:true});return;}
      if(button.dataset.detail){const n=Number(button.dataset.detail);state.expanded.has(n)?state.expanded.delete(n):state.expanded.add(n);render(false);el.querySelector(`button[data-detail="${n}"]`)?.focus({preventScroll:true});el.querySelector('[data-live]').textContent=`Detail artikel ${state.expanded.has(n)?'dibuka':'ditutup'}.`;return;}
      if(button.dataset.edit){const row=state.rows.find(row=>row.id===Number(button.dataset.edit));notice(`Simulasi edit: ${row.title}. Belum ada perubahan pada CMS.`);return;}
      if(button.dataset.delete){notice('Hapus artikel akan membuka konfirmasi penghapusan di CMS. Penghapusan tidak dijalankan dalam preview desain.');button.closest('details')?.removeAttribute('open');return;}
      if(button.dataset.page){state.page=Number(button.dataset.page);state.selected.clear();state.expanded.clear();state.confirm=false;render();el.querySelector('.ar-pagination [aria-current]')?.focus({preventScroll:true});return;}
      if(button.dataset.clear){state[button.dataset.clear]='all';el.querySelector(`[data-field="${button.dataset.clear}"]`).value='all';resetScope();render();el.querySelector('[data-action="filters"]').focus({preventScroll:true});return;}
      switch(button.dataset.action){
        case 'filters': {const panel=el.querySelector('.ar-filter-grid');panel.hidden=!panel.hidden;button.setAttribute('aria-expanded',String(!panel.hidden));break;}
        case 'reset': state.search='';state.status='all';state.category='all';state.scheduled='all';['search','category','scheduled'].forEach(key=>el.querySelector(`[data-field="${key}"]`).value=state[key]);resetScope();render();el.querySelector('[data-field="search"]').focus({preventScroll:true});break;
        case 'sort-title':state.sort=state.sort==='title-asc'?'title-desc':'title-asc';resetScope();render();break;
        case 'sort-date':state.sort=state.sort==='newest'?'oldest':'newest';resetScope();render();break;
        case 'clear-selection':state.selected.clear();state.confirm=false;selection();el.querySelector('[data-live]').textContent='Pilihan artikel dibatalkan.';el.querySelector('[data-field="search"]').focus({preventScroll:true});break;
        case 'apply':if(state.selected.size&&state.bulk){state.confirm=true;selection();el.querySelector('[data-action="confirm"]').focus({preventScroll:true});}break;
        case 'cancel-confirm':state.confirm=false;selection();el.querySelector('[data-action="apply"]').focus({preventScroll:true});break;
        case 'confirm':if(state.confirm&&state.selected.size&&state.bulk){const total=state.selected.size;state.rows.forEach(row=>{if(state.selected.has(row.id))row.status=state.bulk;});state.selected.clear();state.confirm=false;state.bulk='';el.querySelector('[data-field="bulk"]').value='';render();notice(`Simulasi selesai: status ${total} artikel contoh diubah. Data CMS tetap utuh.`);el.querySelector('[data-field="search"]').focus({preventScroll:true});}break;
      }
    });
    el.addEventListener('keydown',event=>{if(event.key==='Escape'){el.querySelectorAll('details[open]').forEach(menu=>{menu.open=false;menu.querySelector('summary')?.focus({preventScroll:true});});}});
    render(false);
    ['search','category','scheduled','size'].forEach(key=>{el.querySelector(`[data-field="${key}"]`).value=state[key];});
    instances.push({el,state,render});
    new ResizeObserver(syncColumns).observe(el);
  }
  appearance();
  window.addEventListener('openai:set_globals',event=>{
    const incoming=event.detail?.globals?.widgetState;
    if(!incoming)return;
    const data=incoming.privateContent||incoming.modelContent||{};
    if(['Otomatis','Tablet','Ponsel'].includes(data.device))preview.device=data.device;
    if(['Nyaman','Rapat'].includes(data.density))preview.density=data.density;
    appearance();
  });
  if(globalThis.Tweak){
    const tweak=new Tweak({container:root,onChange:()=>appearance(true)});
    tweak.addSelect(preview,'device',{label:'Perangkat',options:['Otomatis','Tablet','Ponsel']});
    tweak.addSelect(preview,'density',{label:'Kepadatan baris',options:['Nyaman','Rapat']});
  }
})();
</script>
