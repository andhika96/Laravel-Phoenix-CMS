import fs from 'node:fs/promises';
import path from 'node:path';
import assert from 'node:assert/strict';
import crypto from 'node:crypto';
import postcss from 'postcss';
import {chromium} from 'playwright-core';
const dir=path.resolve('project-artifacts/shared-css-auth-fixes-20261117');
const originals=Object.fromEntries(await Promise.all(['extending-css-bootstrap-5.css','phoenix-cms.css','theme-responsive-typography.css'].map(async n=>[n,await fs.readFile(path.join(dir,'retired-sources',n),'utf8')])));
const sectionChecks=[];
for(const [name,original] of Object.entries(originals)) {
 const r=await fetch(`http://laravel-13-phoenix.aruna/assets/css/shared/${name}?qa=equivalence`);
 const css=await r.text();
 assert.equal(r.status,200);
 const expected=name==='phoenix-cms.css'?original.replaceAll('background-color: var(--ph-content-bg); !important;','background-color: var(--ph-content-bg);'):original;
 assert.equal(css,expected);
 postcss.parse(css);
 sectionChecks.push({name,bytes:Buffer.byteLength(css),sha256:crypto.createHash('sha256').update(css).digest('hex'),ignoredSyntaxTokensRemoved:name==='phoenix-cms.css'?2:0});
}
postcss.parse(await fs.readFile('public/assets/css/shared/phoenix-shared.css','utf8'));
const browser=await chromium.launch({channel:'chrome',headless:true}),results=[],errors=[];
let before=false;
try {
 const page=await browser.newPage({reducedMotion:'reduce'});
 await page.route('**/*',route=>{
  const request=route.request(),name=new URL(request.url()).pathname.split('/').pop();
  if(before&&originals[name])return route.fulfill({status:200,contentType:'text/css',body:originals[name]});
  return request.method()==='GET'?route.continue():route.abort();
 });
 page.on('pageerror',e=>errors.push(e.message));
 page.on('response',r=>{if(r.status()>=400)errors.push(`${r.status()} ${r.url()}`);});
 for(const file of (await fs.readdir(path.join(dir,'rendered'))).filter(f=>f.endsWith('.html')).sort())for(const width of [390,820,1440])for(const mode of ['light','dark']) {
  await page.setViewportSize({width,height:900});
  const readings=[];
  for(const baseline of [true,false]) {
   before=baseline;
   await page.goto(`http://laravel-13-phoenix.aruna/__shared_css_qa_20261117/${file}`,{waitUntil:'load'});
   await page.addStyleTag({content:'*,*::before,*::after{transition:none!important;animation:none!important;caret-color:transparent!important}'});
   await page.evaluate(async mode=>{
    document.documentElement.dataset.bsTheme=mode;document.body.dataset.bsTheme=mode;
    await new Promise(r=>requestAnimationFrame(()=>requestAnimationFrame(r)));
    await document.fonts.ready;
    await new Promise(r=>requestAnimationFrame(()=>requestAnimationFrame(r)));
   },mode);
   await page.waitForTimeout(80);
   readings.push(await page.evaluate(()=>[...document.querySelectorAll('html,body,body *')].filter(e=>e.getBoundingClientRect().width>0).map(e=>{
    const r=e.getBoundingClientRect(),s=getComputedStyle(e);
    return [e.tagName,e.className,r.x,r.y,r.width,r.height,...['fontSize','fontFamily','fontWeight','lineHeight','color','backgroundColor','padding','marginTop','marginRight','marginBottom','marginLeft','border','display','position','gap','opacity','transform'].map(p=>s[p])];
   })));
  }
  if(JSON.stringify(readings[0])!==JSON.stringify(readings[1]))await fs.writeFile(path.join(dir,'consumer-difference.json'),JSON.stringify({file,width,mode,readings},null,2));
  assert.ok(JSON.stringify(readings[1])===JSON.stringify(readings[0]),`${file}/${width}/${mode}; inspect consumer-difference.json`);
  results.push({file,width,mode,elements:readings[0].length,unchanged:true});
 }
 assert.deepEqual(errors,[]);
 console.log(`3 CSS sections valid/equivalent; ${results.length} paired browser comparisons passed, no resource/page errors.`);
} finally {
 await fs.writeFile(path.join(dir,'consumer-parity.json'),JSON.stringify({sectionChecks,results,errors},null,2));
 await browser.close();
}
